#!/bin/sh

# Background action worker for LuCI and other non-blocking callers.

umask 077

PROG="apn-autoconfig-action"
ACTION="${1:-}"
STATE_DIR="${2:-}"
STARTED="${3:-}"
TARGET="${4:-}"
# Optional: the launcher hands over its start lock so action-status can see a
# live owner between the launcher's exit and the first "running" record.
START_LOCK="${5:-}"
COMMAND="${APN_AUTOCONFIG_ACTION_COMMAND:-/usr/sbin/apn-autoconfig}"
DATABASE_COMMAND="${APN_AUTOCONFIG_DATABASE_COMMAND:-/usr/libexec/apn-autoconfig-database}"
STATE_FILE="$STATE_DIR/state.tsv"
CHILD_PID=""

case "$START_LOCK" in
	'') : ;;
	*/../*|*/..) exit 2 ;;
	/*.start-lock) : ;;
	*) exit 2 ;;
esac

cleanup_start_lock() {
	[ -n "$START_LOCK" ] || return 0
	rm -f "$START_LOCK" 2>/dev/null || :
}

trap cleanup_start_lock 0

case "$ACTION" in reconcile|modem-reset|apply-manual|roaming-default|roaming-allow|roaming-block|database-check|database-install) : ;; *) exit 2 ;; esac
case "$STATE_DIR" in /|*/../*|*/..) exit 2 ;; /*) : ;; *) exit 2 ;; esac
case "$ACTION:$TARGET" in
	database-*:) : ;;
	*:network:*) target_interface="${TARGET#network:}"; case "$target_interface" in ''|*[!A-Za-z0-9_]*) exit 2 ;; esac ;;
	*) exit 2 ;;
esac
timestamp() {
	date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date
}

sanitize() {
	printf '%s' "$*" | tr '\t\r\n' '   '
}

write_state() {
	state="$1"
	exit_code="$2"
	message="$(sanitize "$3")"
	finished=""
	case "$state" in success|blocked|retryable|failed) finished="$(timestamp)" ;; esac
	tmp="$STATE_DIR/.state.tmp.$$"
	printf 'v2\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$state" "$ACTION" "$$" "$STARTED" "$finished" "$exit_code" "$message" "$TARGET" >"$tmp" || exit 1
	mv "$tmp" "$STATE_FILE" || exit 1
}

on_signal() {
	trap - HUP INT TERM
	if [ -n "$CHILD_PID" ]; then
		kill -TERM "$CHILD_PID" 2>/dev/null || :
		wait "$CHILD_PID" 2>/dev/null || :
		CHILD_PID=""
	fi
	write_state failed 143 "background operation was interrupted"
	cleanup_start_lock
	logger -t "$PROG" -p user.err -- "operation $ACTION was interrupted" 2>/dev/null || :
	exit 143
}

trap on_signal HUP INT TERM

case "$ACTION" in
	database-*) executable="$DATABASE_COMMAND" ;;
	*) executable="$COMMAND" ;;
esac
[ -x "$executable" ] || {
	write_state failed 127 "action command is not executable"
	exit 127
}

write_state running "" "operation is running"
logger -t "$PROG" -p user.notice -- "starting background operation: $ACTION" 2>/dev/null || :
case "$ACTION" in
	roaming-default) "$COMMAND" roaming-policy-set default --target "$TARGET" & ;;
	roaming-allow) "$COMMAND" roaming-policy-set allow --target "$TARGET" & ;;
	roaming-block) "$COMMAND" roaming-policy-set block --target "$TARGET" & ;;
	database-check) "$DATABASE_COMMAND" check & ;;
	database-install) "$DATABASE_COMMAND" install & ;;
	apply-manual)
		# The manual profile arrives in the environment, because rpcd can pass
		# an environment table but not standard input, and a password must
		# never become an argument: /proc/<pid>/cmdline is world-readable while
		# /proc/<pid>/environ is not.
		#
		# Everything is captured and then removed from the environment before
		# the engine runs, so the profile does not reach curl, mmcli, ifup or
		# any other child the engine spawns. The password reaches the engine
		# only through a pipe from a shell builtin.
		manual_apn="${APN_AUTOCONFIG_MANUAL_APN:-}"
		manual_username="${APN_AUTOCONFIG_MANUAL_USERNAME:-}"
		manual_password="${APN_AUTOCONFIG_MANUAL_PASSWORD:-}"
		manual_auth="${APN_AUTOCONFIG_MANUAL_AUTH:-}"
		manual_ip_type="${APN_AUTOCONFIG_MANUAL_IP_TYPE:-}"
		unset APN_AUTOCONFIG_MANUAL_APN APN_AUTOCONFIG_MANUAL_USERNAME \
			APN_AUTOCONFIG_MANUAL_PASSWORD APN_AUTOCONFIG_MANUAL_AUTH \
			APN_AUTOCONFIG_MANUAL_IP_TYPE
		set -- apply-manual --target "$TARGET" --apn "$manual_apn"
		[ -z "$manual_auth" ] || set -- "$@" --auth "$manual_auth"
		[ -z "$manual_ip_type" ] || set -- "$@" --ip-type "$manual_ip_type"
		[ -z "$manual_username" ] || set -- "$@" --username "$manual_username"
		if [ -n "$manual_password" ]; then
			printf '%s\n' "$manual_password" | "$COMMAND" "$@" --password-stdin &
		else
			"$COMMAND" "$@" </dev/null &
		fi
		manual_password=""
	;;
	*) "$COMMAND" "$ACTION" --target "$TARGET" & ;;
esac
CHILD_PID=$!
status=0
wait "$CHILD_PID" || status=$?
CHILD_PID=""
if [ "$status" -eq 0 ]; then
	write_state success 0 "operation completed successfully"
	logger -t "$PROG" -p user.notice -- "background operation completed: $ACTION" 2>/dev/null || :
elif [ "$status" -eq 2 ]; then
	write_state blocked 2 "operation was intentionally blocked by the roaming policy"
	logger -t "$PROG" -p user.notice -- "background operation blocked by policy: $ACTION" 2>/dev/null || :
elif [ "$status" -eq 3 ]; then
	case "$ACTION" in
		database-*) message="another APN or database operation is running" ;;
		*) message="mobile registration or SIM state is temporarily unavailable" ;;
	esac
	write_state retryable 3 "$message"
	logger -t "$PROG" -p user.warning -- "background operation may be retried: $ACTION" 2>/dev/null || :
else
	write_state failed "$status" "operation failed; inspect apn-autoconfig logs"
	logger -t "$PROG" -p user.err -- "background operation failed: $ACTION (exit $status)" 2>/dev/null || :
fi
exit "$status"
