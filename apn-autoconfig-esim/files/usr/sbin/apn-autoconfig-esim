#!/bin/sh

# Read-only eUICC and slot inventory, and the transport that makes it real.
# POSIX shell; intended for OpenWrt 25.12 and BusyBox ash.
#
# See docs/esim-contract-v1.md for the schema, the endpoint identity model, the
# cache rules, the lock order and the matrix of what may be read while a bearer
# is up. This script implements that document and settles nothing on its own.
#
# What it is not: it is not an LPA, and it is not a card tool. It resolves one
# unambiguous target, decides whether that target may be spoken to at all, takes
# the locks, and then drives a pinned LPA across a bridge it owns. Every refusal
# lives above the LPA, because the LPA connects to the card before it parses its
# own subcommand and therefore cannot carry one.

umask 077

PROG="apn-autoconfig-esim"
CONFIG="apn-autoconfig-esim"
SELF_PID=$$

TAB="$(printf '\t')"
CR="$(printf '\r')"
NEWLINE='
'

STATE_DIR="/var/run/apn-autoconfig-esim"
LOCK_ROOT="/var/lock/apn-autoconfig-esim"
ACTION_STATE_DIR="/tmp/apn-autoconfig-esim-action"
# Levels 1, 2 and 4 of the lock order already exist and keep their exact
# meanings and their exact paths. A fourth implementation of the same protocol
# at a different path would exclude nothing, which is the whole point of
# naming them here rather than inventing a namespace.
APN_LOCK_DIR="/var/lock/apn-autoconfig.lock"
MODEM_LOCK_ROOT="/var/lock/apn-autoconfig-modem"
AT_PORT_LOCK_ROOT="/var/lock/apn-autoconfig-at-port"
QMI_IDENTITY_LOCK_ROOT="/var/lock/apn-autoconfig-qmi-identity"

MODEM_BIN="${APN_AUTOCONFIG_ESIM_MODEM_BIN:-/usr/sbin/apn-autoconfig-modem}"
# The APN engine. This package never writes an APN field, a netifd section or a
# route metric; it asks the engine what the subscription it just changed is now
# entitled to, and reads back the one answer it publishes.
APN_BIN="${APN_AUTOCONFIG_ESIM_APN_BIN:-/usr/sbin/apn-autoconfig}"
ACTION_WORKER="${APN_AUTOCONFIG_ESIM_ACTION_WORKER:-/usr/libexec/apn-autoconfig-esim-action}"
SETSID="${APN_AUTOCONFIG_ESIM_SETSID:-setsid}"
REQUIRE_DETACHED_SESSION="${APN_AUTOCONFIG_ESIM_DETACHED:-0}"
unset APN_AUTOCONFIG_ESIM_DETACHED
INHIBIT_HELPER="${APN_AUTOCONFIG_ESIM_INHIBIT_HELPER:-/usr/libexec/apn-autoconfig-esim-inhibit}"
LPAC_RUN="${APN_AUTOCONFIG_ESIM_LPAC_RUN:-/usr/libexec/apn-autoconfig-lpac/lpac-run}"
LPAC_MODELS="${APN_AUTOCONFIG_LPAC_MODELS:-/usr/share/apn-autoconfig-lpac/at-apdu-models}"
MMCLI="${APN_AUTOCONFIG_ESIM_MMCLI:-mmcli}"
UBUS="${APN_AUTOCONFIG_ESIM_UBUS:-ubus}"
# netifd's own bring-up and tear-down, for the one composition where the bearer
# holds the only channel the card can be reached through. This package never
# writes a netifd section; it asks netifd to stop and start one it already owns.
IFUP="${APN_AUTOCONFIG_ESIM_IFUP:-ifup}"
IFDOWN="${APN_AUTOCONFIG_ESIM_IFDOWN:-ifdown}"
HTTP_CLIENT="${APN_AUTOCONFIG_ESIM_HTTP_CLIENT:-/usr/libexec/apn-autoconfig-esim-http}"
UIM_CLIENT="${APN_AUTOCONFIG_ESIM_UIM_CLIENT:-/usr/libexec/apn-autoconfig-esim-uim}"
# Where a modem's control device may live. The directory is overridable and the
# name is not: a fixture cannot create `/dev/cdc-wdm0` without root, and the AT
# half of the suite already solves the same problem by giving its pty a name
# under /dev that the rule accepts. What is being checked -- that the node is a
# character device whose name is a modem control device and nothing else -- is
# unchanged either way.
CONTROL_DEV_ROOT="${APN_AUTOCONFIG_ESIM_CONTROL_DEV_ROOT:-/dev}"
SHA256="${APN_AUTOCONFIG_ESIM_SHA256:-sha256sum}"
# Resolved through an override so a fixture can give the watchdog a real sleep
# while the rest of the suite keeps an instant mock. A watchdog that calls
# `sleep` directly is disarmed by any harness that stubs it, and the bound it
# claims to prove is then never taken. The reference router has no `timeout`
# executable at all, so this is the only bound there is.
SLEEP="${APN_AUTOCONFIG_ESIM_SLEEP:-sleep}"

ESIM_CACHE_TTL_SECONDS="60"
# What a consented takeover leaves behind is not the same kind of entry as an
# inventory read, and giving both the same lifetime charged the wrong price for
# it. An inventory read is cheap and is repeated whenever a page is drawn, so
# sixty seconds keeps it close to the hardware. Reading a card behind
# ModemManager costs a bearer interruption and an inhibit, and a minute is
# shorter than the operation that produced it plus the time a person takes to
# look at the answer -- measured on the reference router, where a read five
# minutes after a successful takeover found the entry already deleted and the
# page back to `unknown`. The entry is keyed by endpoint, modem, attachment,
# slot, owner and operation, so a change to any of them still invalidates it
# immediately; this bound is only how long an unchanged one stays displayable.
ESIM_CARD_READ_TTL_SECONDS="900"
ESIM_INHIBIT_MAX_SECONDS="240"
APDU_TIMEOUT_SECONDS="10"
AT_PROBE_TIMEOUT_SECONDS="3"
# The overall bound on one AT exchange, as a multiple of its per-line bound.
#
# `read -t` bounds the gap between lines, not the exchange. A port that keeps
# talking never lets it expire, and a loop that only has a per-line bound has
# no bound at all. This is not hypothetical: an inventory read against a
# wedged FM350-GL on the reference router ran for three hours at eight percent
# of a core, consuming an unsolicited stream that never paused long enough for
# the per-line bound to fire once.
#
# Three, because a real reply arrives as a burst and the per-line bound is
# already generous; a factor that is too tight would end a legitimate reply
# that trickles.
AT_EXCHANGE_BOUND_FACTOR="3"
# The same bound for a host whose clock cannot be read. Far past any real
# reply -- the longest one here is a few dozen lines -- and still an end.
AT_LINE_CAP="4096"
INSTALL_SETTLE_SECONDS="0"
LPA_TIMEOUT_SECONDS="120"
HTTP_TIMEOUT_SECONDS="60"
# How long a switch waits for the endpoint to become addressable again after it
# has handed the modem back. Measured on the reference router: ModemManager
# needs 7 to 13 seconds to re-enumerate an inhibited modem, against a 60-second
# cache entry. The bound is generous because the alternative to waiting is
# reporting a subscription change nobody can see yet.
ESIM_REATTACH_WAIT_SECONDS="90"
# How long a switch waits for the modem package's convergence to publish a
# verdict for the target it just invalidated. That worker refreshes identity,
# reconciles the one target and restores the bearer, and its own budget for the
# engine's answer is ten minutes; this is the outer bound on all of it, after
# which the switch reports what it knows rather than waiting further.
ESIM_RECOVERY_WAIT_SECONDS="300"
# How long the bearer is given to come up after a reconcile that succeeded,
# before the switch concludes the new subscription did not connect.
ESIM_BEARER_WAIT_SECONDS="60"
# How long the wait above may be extended **while the modem says it is still
# working**, and not one second longer.
#
# A fixed budget is a guess in both directions, and A8's hardware gate showed
# both edges of it. Roaming registration after a modem reset, on a profile that
# modem had never used, took 61 s; the same modem returning to its home network
# took 5. Sixty seconds is right for one and impossible for the other, and no
# single number is right for both -- so the number stops deciding. The modem
# publishes whether it is still searching, and this is only the point at which
# this operation stops believing it.
#
# Generous on purpose. It costs nothing when the wait ends on its own, which it
# does whenever the modem reaches any state that settles the question.
ESIM_BEARER_CEILING_SECONDS="300"
# A conservative planning estimate for one successful switch, separate from
# every watchdog above. Four successful switches involving the reference
# roaming profile measured 118, 120, 132 and 162 seconds; the largest is rounded up to three
# minutes. This is what a consent dialog leads with. It is not enforced, does
# not shorten a wait and never replaces the published hard bounds.
ESIM_SWITCH_EXPECTED_SECONDS="180"
# The bound on the *second* inhibit -- the short one a switch takes after the
# connection is back, to read what the card produced and tell the issuer. It is
# smaller than the first on purpose: the work inside it is two list reads and a
# delivery, each measured at 22 to 26 seconds on the reference router, and the
# number a user consents to should not be the download bound for an operation
# that cannot take a download's time.
ESIM_REPORT_INHIBIT_SECONDS="120"
# How long the confirming read may keep asking a card that has just been told to
# change which profile is active.
#
# Measured on the reference FM350-GL on 2026-08-31: an enable took effect and
# the read that followed it found nothing, so a completed change was published
# as `card_state_unknown` -- a `partial` that understated what had happened. The
# card re-initialises after the REFRESH an enable causes and is not readable for
# a while. This is the same shape C3 met for installs and the same answer:
# the card is the authority, so ask it again rather than believe the first
# silence.
#
# It is spent only where this operation is *not* holding the modem away from its
# owner. Inside an inhibit, C3 measured that the card does not finish at all
# until it is handed back, so waiting there buys nothing and costs the user the
# outage they consented to.
ESIM_CARD_SETTLE_SECONDS="60"
# How long netifd is given to take the selected bearer down, and to bring it
# back afterwards. Small: this is one interface being asked to stop, not a
# network coming back.
ESIM_BEARER_STOP_SECONDS="30"
# How long a `delete-plan` token stays claimable.
#
# Long enough for a person to read a confirmation and type it out; short enough
# that the state the plan bound cannot plausibly have changed unobserved. The
# range is enforced rather than clamped: a value outside it says the token may
# do something it may not.
# Headroom, not a fix for a dialog that is too long to read.
#
# 120 ran out once during the 2026-09-03 run, but the reason was the run: every
# click there waits for a person who is not at the screen. Somebody actually
# deleting a subscription is sitting in front of the dialog they just opened
# and does not go and make tea between pressing Delete and typing four digits.
# What did change is that planning is a job now and honestly spends part of the
# budget on itself -- 24 seconds of it on the FM350-GL -- so the budget grew to
# cover that with room, and for no other reason. Do not read this number as a
# licence to shorten the dialog: the text is what makes the confirmation
# informed, and it is the cheapest thing in the transaction.
DELETE_PLAN_TTL_SECONDS="300"

# How long to wait for a lock before refusing. Contention is normal and brief --
# another component of this suite is reading identity, or the AT-dial handler
# holds the port for a bring-up -- and waiting is what keeps an ordinary overlap
# from surfacing as a failure. Zero refuses immediately. Failing to acquire is
# always a refusal and never a licence to proceed without the lock.
LOCK_WAIT_SECONDS="15"

# The same total the APN engine observes, for the same reason: rpcd SIGKILLs a
# helper that outlives its exec budget, no trap covers that, and the page then
# gets nothing at all instead of a document that says what is missing.
READ_DEADLINE_SECONDS="${APN_AUTOCONFIG_READ_DEADLINE_SECONDS:-20}"
RPCD_EXEC_BUDGET_SECONDS="${APN_AUTOCONFIG_RPCD_EXEC_BUDGET_SECONDS:-30}"
READ_DEADLINE_AT=""
PROBE_WATCHDOG_PID=""
PROBE_DEADLINE_EXPIRED=0
READ_INCOMPLETE=0
READ_INCOMPLETE_READS=""

EXIT_USAGE=2
EXIT_RETRYABLE=3
EXIT_BLOCKED=4
EXIT_PARTIAL=5
# The APN engine's exit class for "the modem answered and reports no SIM",
# which is a different namespace from the four above. Kept as a name so that a
# reader never mistakes it for EXIT_PARTIAL, which happens to share the digit.
ENGINE_EXIT_NO_SIM=5

COMMAND_NAME=""
REQUESTED_MODEM=""
REQUESTED_ENDPOINT=""
REQUESTED_PROFILE=""
REQUESTED_SEQUENCE=""
REQUESTED_OPERATION=""
REQUESTED_REFRESH=0
REQUESTED_ACTION=""
TARGET_LINE=""

# Request inputs are captured before this process starts any child. Secrets are
# then carried to the background worker on descriptor 5; they never become a
# worker argument, inherited environment member, state field or log message.
CAPTURED_ACTIVATION_CODE=""
CAPTURED_CONFIRMATION_CODE=""
CAPTURED_MATCHING_ID=""
CAPTURED_NICKNAME=""
CAPTURED_NICKNAME_SET=0
CAPTURED_ALLOW_UNVERIFIED_TRANSPORT=0
CAPTURED_CONFIRM_DISCARD=0
# Consent for one bounded inhibit, given to `delete-plan` so it can read the
# card it is about to describe. Never remembered, never inherited by anything
# else, and refused for any other verb.
CAPTURED_ALLOW_TAKEOVER=0
ACTION_SECRET_FD_OPEN=0
ACTION_SECRET_DIR=""

TMP_DIR="${APN_AUTOCONFIG_ESIM_TMP_DIR:-/tmp}"
TMP_BASE="$TMP_DIR/$PROG.$SELF_PID"
SLOTS_FILE="$TMP_BASE.slots"
LPA_OUTPUT_FILE="$TMP_BASE.lpa-output"
BOUNDED_OUTPUT_FILE="$TMP_BASE.bounded"
BOUNDED_TIMEOUT_MARKER="$TMP_BASE.bounded-timeout"
HTTP_BODY_FILE="$TMP_BASE.http-body"
HTTP_REPLY_FILE="$TMP_BASE.http-reply"
HTTP_HEADER_FILE="$TMP_BASE.http-headers"
# Every scratch suffix this process can create, in one list, because the exit
# trap removes them by exact name and the sweep recognises a dead predecessor's
# files by the same names. A suffix added to only one of the two leaks again.
TMP_SUFFIXES="bearer-state slots lpa-output bounded bounded-status bounded-input bounded-timeout http-body http-reply http-headers endpoints modem-lines slot-lines active-slot lpa-data lpa-profiles lpa-notifications slots-indexed notify-before notify-after notify-raw notify-remaining"

BOUNDED_CHILD_PID=""
BOUNDED_WATCHDOG_PID=""
BOUNDED_TIMED_OUT=0

# Locks held by this process, innermost last. Released in reverse.
APN_LOCK_HELD=0
APN_LOCK_BORROWED=0
MODEM_LOCK_HELD=0
MODEM_LOCK_PATH=""
ENDPOINT_LOCK_HELD=0
ENDPOINT_LOCK_PATH=""
TRANSPORT_LOCK_HELD=0
TRANSPORT_LOCK_PATH=""
# The order in which they were actually acquired, so a fixture can assert the
# order rather than grep the source for it.
LOCK_TRACE_FILE="${APN_AUTOCONFIG_ESIM_LOCK_TRACE:-}"

# The claimed delete plan this process owns, if it is a deletion worker. Set
# before any cleanup path can run, because the trap that removes it is armed
# before the record is read.
DELETE_CLAIMED_FILE=""

BRIDGE_RUN_DIR=""
BRIDGE_CHILD_PID=""
BRIDGE_LPAC_PID_FILE=""
BRIDGE_AT_FD_OPEN=0
BRIDGE_FIFO_FD_OPEN=0
BRIDGE_CHANNEL=""
# Which transport this bridge run resolved, and the QMI client session that goes
# with it. `at` keeps every byte of the behaviour C2 proved; `qmi` is P5's, and
# the two never run at once.
BRIDGE_TRANSPORT=at
UIM_CLIENT_PID=""
UIM_CLIENT_FD_OPEN=0
UIM_CLIENT_DIR=""

# ---- logging and masking ----
#
# Masked to the last four characters, which is the convention `maskedIdentifier`
# renders in LuCI and the one the contract publishes as `eid_suffix`. The
# helper is duplicated rather than sourced because these packages ship
# separately and share no library, exactly as `log` already is.

mask_identifier() {
	mask_value="${1:-}"
	if [ -z "$mask_value" ]; then
		printf '<unknown>'
	elif [ "${#mask_value}" -le 4 ]; then
		printf '...'
	else
		printf '...%s' "${mask_value#"${mask_value%????}"}"
	fi
}

mask_modem_id() {
	case "${1:-}" in
		imei:*) printf 'imei:%s' "$(mask_identifier "${1#imei:}")" ;;
		usb-serial:*) printf 'usb-serial:%s' "$(mask_identifier "${1#usb-serial:}")" ;;
		'') printf '<unknown>' ;;
		*) printf '%s' "$1" ;;
	esac
}

log() {
	level="$1"
	shift
	message="$*"
	case "$level" in warning) priority="warn" ;; *) priority="$level" ;; esac
	logger -t "$PROG" -p "user.$priority" -- "$message" 2>/dev/null || :
	printf '%s: %s\n' "$PROG" "$message" >&2
}

die() {
	log err "$*"
	exit 1
}

die_code() {
	code="$1"
	shift
	log err "$*"
	exit "$code"
}

command_exists() {
	command -v "$1" >/dev/null 2>&1
}

# ---- cleanup, armed before anything is created ----
#
# Order is the reverse of creation, and it is not a matter of taste. The LPA is
# killed and reaped first because it is the thing holding a logical channel open
# on the card; then the bridge's own descriptors and run directory; then the
# locks, outermost last. A logical channel left open is the one piece of state
# this script cannot repair afterwards.

reap_child() {
	[ -n "$1" ] || return 0
	kill -0 "$1" 2>/dev/null || return 0
	kill "-$2" "$1" 2>/dev/null || :
	return 0
}

cleanup_bridge() {
	bridge_lpa_pid="$(sed -n '1p' "${BRIDGE_LPAC_PID_FILE:-}" 2>/dev/null || :)"
	case "$bridge_lpa_pid" in ''|*[!0-9]*) bridge_lpa_pid="" ;; esac
	if [ -n "$bridge_lpa_pid" ]; then
		# The LPA has no signal cleanup protocol of its own. Killing the exact
		# child closes all of its inherited card descriptors atomically; signalling
		# the surrounding launcher instead leaves that child running while two
		# shell cleanup paths race each other.
		reap_child "$bridge_lpa_pid" KILL
	fi
	if [ -n "$BRIDGE_CHILD_PID" ]; then
		# The launcher normally exits when the LPA above does. KILL is only the
		# final bound for a broken launcher; signalling the launcher first leaves
		# its actual card child one process removed from this cleanup.
		reap_child "$BRIDGE_CHILD_PID" KILL
		wait "$BRIDGE_CHILD_PID" 2>/dev/null || :
		BRIDGE_CHILD_PID=""
	fi
	# Closed after the LPA is gone: the LPA is the process on the other end, and
	# closing underneath it turns an orderly disconnect into a broken pipe.
	#
	# Only when they were opened, and only inside a group. Both halves matter
	# and both were learned the hard way. `exec 6>&-` on a descriptor that was
	# never opened is an error, and an `exec` whose redirection fails ends a
	# non-interactive shell -- so a cleanup that closed unconditionally died on
	# its first step whenever the bridge had not started, leaving the inhibit
	# taken and every lock held. And `exec 6>&- 2>/dev/null` applies *both*
	# redirections to the shell, permanently, so the process loses its standard
	# error for good and the failure is invisible while it happens.
	if [ "$BRIDGE_FIFO_FD_OPEN" -eq 1 ]; then
		{ exec 6>&-; } 2>/dev/null || :
		{ exec 7<&-; } 2>/dev/null || :
		BRIDGE_FIFO_FD_OPEN=0
	fi
	if [ "${BRIDGE_KEEP_TRANSPORT:-0}" -ne 1 ]; then
		at_close_port
		uim_close_client
	fi
	# Exact paths only. Never a wildcard, and never a recursive delete of a root
	# this process did not create in this run.
	if [ -n "$BRIDGE_RUN_DIR" ] && [ -d "$BRIDGE_RUN_DIR" ]; then
		rm -f "$BRIDGE_RUN_DIR/lpa-child.pid" 2>/dev/null || :
		rm -f "$BRIDGE_RUN_DIR/to-lpa" 2>/dev/null || :
		rm -f "$BRIDGE_RUN_DIR/from-lpa" 2>/dev/null || :
		rmdir "$BRIDGE_RUN_DIR" 2>/dev/null || :
		BRIDGE_RUN_DIR=""
	fi
	BRIDGE_LPAC_PID_FILE=""
}

# Levels 4 and 3 only, in that order. A read-only transaction takes exactly
# these, and an operation that took 1 and 2 before it is still standing on them
# when the transaction inside it ends -- so the transaction may not release
# them on its way out.
release_read_locks() {
	if [ -n "$TRANSPORT_LOCK_PATH" ]; then
		[ "$TRANSPORT_LOCK_HELD" -eq 1 ] && lock_trace "release" "4-transport" "$TRANSPORT_LOCK_PATH"
		lock_release_if_ours "$TRANSPORT_LOCK_PATH"
		TRANSPORT_LOCK_HELD=0
		TRANSPORT_LOCK_PATH=""
	fi
	if [ -n "$ENDPOINT_LOCK_PATH" ]; then
		[ "$ENDPOINT_LOCK_HELD" -eq 1 ] && lock_trace "release" "3-endpoint" "$ENDPOINT_LOCK_PATH"
		lock_release_if_ours "$ENDPOINT_LOCK_PATH"
		ENDPOINT_LOCK_HELD=0
		ENDPOINT_LOCK_PATH=""
	fi
	return 0
}

release_all_locks() {
	# 4 -> 3 -> 2 -> 1, always.
	release_read_locks
	if [ -n "$MODEM_LOCK_PATH" ]; then
		[ "$MODEM_LOCK_HELD" -eq 1 ] && lock_trace "release" "2-modem" "$MODEM_LOCK_PATH"
		lock_release_if_ours "$MODEM_LOCK_PATH"
		MODEM_LOCK_HELD=0
		MODEM_LOCK_PATH=""
	fi
	# A borrower never releases what it borrowed, and the ownership check says
	# so on its own: a borrowed lock records the lender's PID, not ours.
	if [ "$APN_LOCK_BORROWED" -eq 0 ]; then
		[ "$APN_LOCK_HELD" -eq 1 ] && lock_trace "release" "1-global" "$APN_LOCK_DIR"
		lock_release_if_ours "$APN_LOCK_DIR"
	fi
	APN_LOCK_HELD=0
	APN_LOCK_BORROWED=0
}

cleanup_files() {
	card_probe_deadline_cancel
	BRIDGE_KEEP_TRANSPORT=0
	# Keep the watchdog alive until the command is gone. A TERM-resistant
	# helper must not hold up restoration and lock release indefinitely.
	if [ -n "$BOUNDED_CHILD_PID" ]; then
		reap_child "$BOUNDED_CHILD_PID" TERM
		"$SLEEP" 1 2>/dev/null || :
		reap_child "$BOUNDED_CHILD_PID" KILL
		wait "$BOUNDED_CHILD_PID" 2>/dev/null || :
		BOUNDED_CHILD_PID=""
	fi
	if [ -n "$BOUNDED_WATCHDOG_PID" ]; then
		reap_child "$BOUNDED_WATCHDOG_PID" TERM
		wait "$BOUNDED_WATCHDOG_PID" 2>/dev/null || :
		BOUNDED_WATCHDOG_PID=""
	fi
	cleanup_bridge
	takeover_rollback
	if [ "$ACTION_SECRET_FD_OPEN" -eq 1 ]; then
		{ exec 5<&-; } 2>/dev/null || :
		ACTION_SECRET_FD_OPEN=0
	fi
	if [ -n "$ACTION_SECRET_DIR" ] && [ -d "$ACTION_SECRET_DIR" ]; then
		rm -f "$ACTION_SECRET_DIR/params" 2>/dev/null || :
		rmdir "$ACTION_SECRET_DIR" 2>/dev/null || :
		ACTION_SECRET_DIR=""
	fi
	for tmp_suffix in $TMP_SUFFIXES; do
		rm -f "$TMP_BASE.$tmp_suffix"
	done
	# The claimed delete plan, by the exact path this worker was handed. It is
	# removed here rather than at the moment it was read, so that a status read
	# between the worker's death and its result still finds the record a sweep
	# would otherwise have taken. Never a glob, and never the directory.
	if [ -n "$DELETE_CLAIMED_FILE" ]; then
		rm -f "$DELETE_CLAIMED_FILE" 2>/dev/null || :
		DELETE_CLAIMED_FILE=""
	fi
	release_all_locks
}

capture_request_inputs() {
	CAPTURED_ACTIVATION_CODE="${APN_ESIM_ACTIVATION_CODE:-}"
	CAPTURED_CONFIRMATION_CODE="${APN_ESIM_CONFIRMATION_CODE:-}"
	CAPTURED_MATCHING_ID="${APN_ESIM_MATCHING_ID:-}"
	if [ "${APN_ESIM_NICKNAME+x}" = x ]; then
		CAPTURED_NICKNAME_SET=1
		CAPTURED_NICKNAME="$APN_ESIM_NICKNAME"
	fi
	# The worker-side spelling is not a secret, but it is still removed before
	# inventory, lock and transport helpers are started.
	if [ "${APN_AUTOCONFIG_ESIM_NICKNAME_SET:-0}" = 1 ]; then
		CAPTURED_NICKNAME_SET=1
		CAPTURED_NICKNAME="${APN_AUTOCONFIG_ESIM_NICKNAME_VALUE:-}"
	fi
	case "${APN_ESIM_ALLOW_UNVERIFIED_TRANSPORT:-0}" in
		0|'') CAPTURED_ALLOW_UNVERIFIED_TRANSPORT=0 ;;
		1) CAPTURED_ALLOW_UNVERIFIED_TRANSPORT=1 ;;
		*) CAPTURED_ALLOW_UNVERIFIED_TRANSPORT=invalid ;;
	esac
	case "${APN_ESIM_CONFIRM_DISCARD:-0}" in
		0|'') CAPTURED_CONFIRM_DISCARD=0 ;;
		1) CAPTURED_CONFIRM_DISCARD=1 ;;
		*) CAPTURED_CONFIRM_DISCARD=invalid ;;
	esac
	case "${APN_ESIM_ALLOW_TAKEOVER:-0}" in
		0|'') CAPTURED_ALLOW_TAKEOVER=0 ;;
		1) CAPTURED_ALLOW_TAKEOVER=1 ;;
		*) CAPTURED_ALLOW_TAKEOVER=invalid ;;
	esac
	unset APN_ESIM_CONFIRM_DISCARD APN_ESIM_ALLOW_TAKEOVER
	unset APN_ESIM_ACTIVATION_CODE APN_ESIM_CONFIRMATION_CODE APN_ESIM_MATCHING_ID
	unset APN_ESIM_NICKNAME APN_AUTOCONFIG_ESIM_NICKNAME_SET
	unset APN_AUTOCONFIG_ESIM_NICKNAME_VALUE
	unset APN_ESIM_ALLOW_UNVERIFIED_TRANSPORT
}

# No trap covers SIGKILL, so a scratch file can outlive the process that made
# it: rpcd SIGKILLs a helper that exceeds its exec timeout and the OOM killer
# asks nobody. Every path removed here is one this function rebuilt itself from
# a validated PID and a known suffix; the glob only finds candidates, because
# /tmp is shared and a wildcard removal there is what this project forbids.
sweep_dead_scratch_files() {
	case "$TMP_DIR" in /*) : ;; *) return 0 ;; esac
	[ -d "$TMP_DIR" ] || return 0
	sweep_count=0
	for sweep_suffix in $TMP_SUFFIXES; do
		for sweep_path in "$TMP_DIR/$PROG."[0-9]*".$sweep_suffix"; do
			[ -e "$sweep_path" ] || continue
			sweep_pid="${sweep_path##*/}"
			sweep_pid="${sweep_pid#"$PROG."}"
			sweep_pid="${sweep_pid%".$sweep_suffix"}"
			case "$sweep_pid" in ''|*[!0-9]*) continue ;; esac
			if [ "$sweep_pid" != "$SELF_PID" ] && kill -0 "$sweep_pid" 2>/dev/null; then
				continue
			fi
			[ -L "$sweep_path" ] && continue
			[ -f "$sweep_path" ] || continue
			rm -f "$TMP_DIR/$PROG.$sweep_pid.$sweep_suffix" || continue
			sweep_count=$((sweep_count + 1))
		done
	done
	[ "$sweep_count" -eq 0 ] || \
		log notice "removed $sweep_count scratch file(s) left by an interrupted earlier run"
}

# An asynchronous subshell can receive a signal before resetting inherited
# traps. Its $$ still names this operation, but it owns none of our resources.
# Read procfs with the shell builtin: an external cat would identify cat itself.
cleanup_owner_is_current() {
	if [ -r /proc/self/stat ]; then
		IFS=' ' read -r cleanup_current_pid cleanup_stat_rest </proc/self/stat || return 1
		[ "$cleanup_current_pid" = "$$" ]
		return $?
	fi
	# Development on macOS uses bash, including the system version without
	# BASHPID. Deployment always uses the Linux procfs check above.
	[ "${BASH_SUBSHELL:-0}" -eq 0 ]
}

on_exit() {
	on_exit_status=$?
	# Kept where the cleanup can reach it. An operation that did not publish a
	# result of its own has one written for it, and it must say how the process
	# actually ended rather than assume a signal: "interrupted" with a hardcoded
	# 143 hid a failure that was not a signal at all, and cost a hardware run to
	# notice.
	EXIT_STATUS_OBSERVED="$on_exit_status"
	trap - 0
	# Signals are ignored for the duration of cleanup rather than restored to
	# their defaults. The first signal has already selected the exit status; a
	# second one can arrive while the bridge child is being terminated, and it
	# must not stop the inhibit release or the reverse lock unwind halfway.
	# PIPE belongs to the same rule: the reader that went away may have been
	# reading standard error too.
	trap '' HUP INT TERM PIPE USR1
	cleanup_owner_is_current || exit "$on_exit_status"
	cleanup_files
	exit "$on_exit_status"
}

# Which signal ended an operation is worth saying. An interrupted takeover
# otherwise reports only that it was interrupted, and on a router the next
# question is always "by what" -- a service stop, a reboot, an operator, or
# something this process did to itself.
#
# On 2026-09-04 that question had no answer. A plan worker died to a SIGTERM
# two seconds after launch, on a path that had run to completion the day
# before, and four attempts to reproduce it all survived: a shell launcher
# exiting, an `ubus file exec` returning, a session-scoped page call, and a
# page navigating away mid-request. Every signal this project sends goes to a
# child it forked itself, except the orphan-inhibit recovery, which is guarded
# by a process birth token and an exact `mmcli` argv match.
#
# So the next occurrence is made to describe itself rather than be guessed at.
# None of this changes behaviour: it is one log line on a path that was already
# ending. It names no identifier -- pids, a process group, a session and the
# parent's command name are not anybody's -- so it is safe on a router whose
# log is read by people.
#
# See docs/work-items/D5-a-worker-that-outlives-its-launch.md.
signal_diagnostic() {
	# Everything here is best-effort by construction: the fixtures run on hosts
	# with no /proc at all, and a diagnostic that breaks the unwind it is
	# describing would be worse than no diagnostic.
	diagnostic_ppid=""
	diagnostic_pgrp=""
	diagnostic_sid=""
	diagnostic_stat="$(cat "/proc/$SELF_PID/stat" 2>/dev/null || :)"
	if [ -n "$diagnostic_stat" ]; then
		# The comm field is parenthesised and may contain spaces, so the fields
		# are taken from after the last ')': ppid, pgrp and session are the
		# first three.
		diagnostic_rest="${diagnostic_stat##*) }"
		diagnostic_ppid="$(printf '%s\n' "$diagnostic_rest" | awk '{print $2}')"
		diagnostic_pgrp="$(printf '%s\n' "$diagnostic_rest" | awk '{print $3}')"
		diagnostic_sid="$(printf '%s\n' "$diagnostic_rest" | awk '{print $4}')"
	else
		# No /proc. The target has one, but the fixtures do not, and a
		# diagnostic nothing can exercise is a diagnostic that turns out to be
		# broken on the day it is needed. `ps` gives the two fields that matter
		# most -- who the parent is and which group could have been signalled.
		diagnostic_rest="$(ps -o ppid=,pgid= -p "$SELF_PID" 2>/dev/null || :)"
		diagnostic_ppid="$(printf '%s\n' "$diagnostic_rest" | awk '{print $1}')"
		diagnostic_pgrp="$(printf '%s\n' "$diagnostic_rest" | awk '{print $2}')"
	fi
	[ -n "$diagnostic_ppid" ] || return 0
	diagnostic_parent="$(cat "/proc/${diagnostic_ppid}/comm" 2>/dev/null || :)"
	[ -n "$diagnostic_parent" ] || \
		diagnostic_parent="$(ps -o comm= -p "$diagnostic_ppid" 2>/dev/null || :)"
	[ -n "$diagnostic_parent" ] || diagnostic_parent=gone
	diagnostic_parent="${diagnostic_parent##*/}"
	diagnostic_lived=""
	diagnostic_now="$(monotonic_seconds 2>/dev/null || :)"
	if [ -n "$diagnostic_now" ] && [ -n "${SIGNAL_DIAGNOSTIC_START:-}" ]; then
		diagnostic_lived=" after $((diagnostic_now - SIGNAL_DIAGNOSTIC_START))s"
	fi
	diagnostic_session=""
	[ -z "$diagnostic_sid" ] || diagnostic_session=", session $diagnostic_sid"
	log warning "signalled as pid $SELF_PID (parent $diagnostic_ppid ${diagnostic_parent}, group ${diagnostic_pgrp}${diagnostic_session})${diagnostic_lived}"
	return 0
}

on_signal() {
	if ! cleanup_owner_is_current; then
		trap - 0
		exit 143
	fi
	log warning "interrupted by SIG${1:-unknown}"
	signal_diagnostic || :
	# Do the unwind while this is still an ordinary command path. Some shells
	# terminate an EXIT trap when a child being reaped receives the same signal
	# that initiated the exit, even after the signal disposition was changed.
	# That leaves the later inhibit and lock cleanup unreachable. Clearing the
	# traps and completing the unwind before `exit` makes the order explicit and
	# keeps a second signal from selecting a different path halfway through it.
	EXIT_STATUS_OBSERVED=143
	trap - 0
	trap '' HUP INT TERM PIPE USR1
	cleanup_files
	exit 143
}

# Every read gathers its whole answer before it writes the first byte, so a
# reader that has already gone away kills this process at exactly the moment
# when there is the most to put down. 141 is the status the default action
# already produced, so no caller sees a new one; what changes is that the exit
# trap runs.
on_pipe() {
	exit 141
}

trap on_exit 0
trap 'on_signal HUP' HUP
trap 'on_signal INT' INT
trap 'on_signal TERM' TERM
trap 'PROBE_DEADLINE_EXPIRED=1; on_signal USR1' USR1
trap on_pipe PIPE

# ---- configuration ----

load_config() {
	command_exists uci || die "uci is required"
	value="$(uci -q get "${CONFIG}.main.state_dir")" && [ -n "$value" ] && STATE_DIR="$value"
	value="$(uci -q get "${CONFIG}.main.lock_root")" && [ -n "$value" ] && LOCK_ROOT="$value"
	value="$(uci -q get "${CONFIG}.main.action_state_dir")" && [ -n "$value" ] && ACTION_STATE_DIR="$value"
	value="$(uci -q get "${CONFIG}.main.esim_cache_ttl_seconds")" && [ -n "$value" ] && ESIM_CACHE_TTL_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.esim_card_read_ttl_seconds")" && [ -n "$value" ] && ESIM_CARD_READ_TTL_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.esim_port_silence_retry_seconds")" && [ -n "$value" ] && ESIM_PORT_SILENCE_RETRY_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.esim_inhibit_max_seconds")" && [ -n "$value" ] && ESIM_INHIBIT_MAX_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.apdu_timeout_seconds")" && [ -n "$value" ] && APDU_TIMEOUT_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.at_probe_timeout_seconds")" && [ -n "$value" ] && AT_PROBE_TIMEOUT_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.install_settle_seconds")" && [ -n "$value" ] && INSTALL_SETTLE_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.esim_reattach_wait_seconds")" && [ -n "$value" ] && ESIM_REATTACH_WAIT_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.esim_recovery_wait_seconds")" && [ -n "$value" ] && ESIM_RECOVERY_WAIT_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.esim_bearer_wait_seconds")" && [ -n "$value" ] && ESIM_BEARER_WAIT_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.esim_bearer_ceiling_seconds")" && [ -n "$value" ] && ESIM_BEARER_CEILING_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.esim_report_inhibit_seconds")" && [ -n "$value" ] && ESIM_REPORT_INHIBIT_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.esim_card_settle_seconds")" && [ -n "$value" ] && ESIM_CARD_SETTLE_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.esim_bearer_stop_seconds")" && [ -n "$value" ] && ESIM_BEARER_STOP_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.lpa_timeout_seconds")" && [ -n "$value" ] && LPA_TIMEOUT_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.http_timeout_seconds")" && [ -n "$value" ] && HTTP_TIMEOUT_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.lock_wait_seconds")" && [ -n "$value" ] && LOCK_WAIT_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.delete_plan_ttl_seconds")" && [ -n "$value" ] && DELETE_PLAN_TTL_SECONDS="$value"
	# The lock namespaces are shared with the other packages, so all of them
	# must resolve identically or the lock silently stops excluding anything.
	# Env, then UCI, then the built-in default, in that order, in every package.
	value="$(uci -q get apn-autoconfig.main.lock_dir)" && [ -n "$value" ] && APN_LOCK_DIR="$value"
	value="$(uci -q get apn-autoconfig-modem.main.lock_root)" && [ -n "$value" ] && MODEM_LOCK_ROOT="$value"
	value="$(uci -q get apn-autoconfig.main.qmi_identity_lock_root)" && [ -n "$value" ] && QMI_IDENTITY_LOCK_ROOT="$value"
	[ -n "${APN_AUTOCONFIG_AT_PORT_LOCK_ROOT:-}" ] || {
		value="$(uci -q get apn-autoconfig-modem.main.at_port_lock_root)" && [ -n "$value" ] && AT_PORT_LOCK_ROOT="$value"
	}
	[ -z "${APN_AUTOCONFIG_AT_PORT_LOCK_ROOT:-}" ] || AT_PORT_LOCK_ROOT="$APN_AUTOCONFIG_AT_PORT_LOCK_ROOT"
	[ -n "${APN_AUTOCONFIG_READ_DEADLINE_SECONDS:-}" ] || {
		value="$(uci -q get apn-autoconfig.main.read_deadline_seconds)" && [ -n "$value" ] && READ_DEADLINE_SECONDS="$value"
	}
	TAKEOVER_INHIBIT_BOUND="$ESIM_INHIBIT_MAX_SECONDS"
}

validate_config() {
	for config_path in "$STATE_DIR" "$LOCK_ROOT" "$APN_LOCK_DIR" "$MODEM_LOCK_ROOT" \
		"$AT_PORT_LOCK_ROOT" "$QMI_IDENTITY_LOCK_ROOT"; do
		case "$config_path" in
			/|*/../*|*/..) die "unsafe path in configuration: $config_path" ;;
			/*) : ;;
			*) die "configuration paths must be absolute: $config_path" ;;
		esac
	done
	case "$ACTION_STATE_DIR" in /tmp/?*) : ;; *) die "action_state_dir must be a child of /tmp" ;; esac
	case "$ACTION_STATE_DIR" in */../*|*/..) die "unsafe action_state_dir" ;; esac
	# Rejected rather than clamped. A cache lifetime outside the contract's
	# range is a configuration that says the cache may do something it may not,
	# and running anyway would be obeying it.
	case "$ESIM_CACHE_TTL_SECONDS" in
		''|*[!0-9]*) die_code "$EXIT_USAGE" "esim_cache_ttl_seconds must be a whole number of seconds" ;;
	esac
	[ "$ESIM_CACHE_TTL_SECONDS" -le 900 ] || \
		die_code "$EXIT_USAGE" "esim_cache_ttl_seconds must be between 0 and 900"
	case "$LOCK_WAIT_SECONDS" in
		''|*[!0-9]*) die_code "$EXIT_USAGE" "lock_wait_seconds must be a non-negative integer" ;;
	esac
	for config_seconds in "$ESIM_INHIBIT_MAX_SECONDS" "$APDU_TIMEOUT_SECONDS" \
		"$AT_PROBE_TIMEOUT_SECONDS" "$LPA_TIMEOUT_SECONDS" "$HTTP_TIMEOUT_SECONDS" \
		"$ESIM_REATTACH_WAIT_SECONDS" "$ESIM_RECOVERY_WAIT_SECONDS" \
		"$ESIM_BEARER_WAIT_SECONDS" "$ESIM_BEARER_CEILING_SECONDS" \
		"$ESIM_REPORT_INHIBIT_SECONDS" \
		"$ESIM_BEARER_STOP_SECONDS" "$ESIM_CARD_SETTLE_SECONDS"; do
		case "$config_seconds" in
			''|*[!0-9]*) die_code "$EXIT_USAGE" "every timeout must be a whole number of seconds" ;;
		esac
		[ "$config_seconds" -gt 0 ] || \
			die_code "$EXIT_USAGE" "every timeout must be greater than zero"
	done
	[ "$ESIM_BEARER_CEILING_SECONDS" -ge "$ESIM_BEARER_WAIT_SECONDS" ] || \
		die_code "$EXIT_USAGE" \
			"esim_bearer_ceiling_seconds must be at least esim_bearer_wait_seconds"
	# The settle budget is the one duration here whose zero is an answer rather
	# than a mistake, and it is the shipped default: on the reference eUICC the
	# card cannot finish an install while this operation still holds it, so
	# waiting for it inside the inhibit is outage that buys nothing. Validating
	# it with the others made every command on a default installation die at
	# startup with "every timeout must be greater than zero".
	case "$INSTALL_SETTLE_SECONDS" in
		''|*[!0-9]*) die_code "$EXIT_USAGE" "install_settle_seconds must be a whole number of seconds" ;;
	esac
	# Rejected rather than clamped, for the same reason the cache lifetime is:
	# a token that lives ten times as long as the contract allows is a
	# capability to destroy a subscription lying around for an afternoon, and
	# running anyway would be obeying a configuration that says that is fine.
	case "$DELETE_PLAN_TTL_SECONDS" in
		''|*[!0-9]*) die_code "$EXIT_USAGE" "delete_plan_ttl_seconds must be a whole number of seconds" ;;
	esac
	[ "$DELETE_PLAN_TTL_SECONDS" -ge 30 ] && [ "$DELETE_PLAN_TTL_SECONDS" -le 600 ] || \
		die_code "$EXIT_USAGE" "delete_plan_ttl_seconds must be between 30 and 600"
}

# ---- process and lock primitives ----
#
# A lock is a regular file whose first line is the owner PID. `ln` publishes the
# name and the owner together in one atomic step, so a competitor can never
# observe a created-but-unowned lock. This is the protocol in
# docs/modem-contract-v1.md, unchanged and deliberately not reimplemented: a
# fourth implementation is a fourth chance to get it wrong.

process_is_alive() {
	case "$1" in ''|*[!0-9]*|0) return 1 ;; esac
	kill -0 "$1" 2>/dev/null
}

# Numeric PID alone is never process identity. Linux start ticks do not change
# during exec and cannot be inherited by a later process that reuses the PID,
# which makes the pair suitable for an exact, persisted cleanup decision.
process_birth() {
	process_pid="$1"
	case "$process_pid" in ''|*[!0-9]*|0) return 1 ;; esac
	if [ -r "/proc/$process_pid/stat" ]; then
		process_stat="$(sed -n '1p' "/proc/$process_pid/stat" 2>/dev/null)" || return 1
		process_rest="${process_stat##*) }"
		set -- $process_rest
		[ "$#" -ge 20 ] || return 1
		shift 19
		printf '%s\n' "$1"
		return 0
	fi
	# Development-host fallback. The target is Linux and always uses procfs;
	# this keeps the exact same fixtures meaningful on macOS.
	process_started="$(ps -o lstart= -p "$process_pid" 2>/dev/null | sed -n '1p')" || return 1
	[ -n "$process_started" ] || return 1
	printf '%s' "$process_pid:$process_started" | cksum | awk '{print $1}'
}

process_matches() {
	[ -n "${2:-}" ] || return 1
	[ "$(process_birth "$1" 2>/dev/null || :)" = "$2" ]
}

process_has_exact_arg() {
	arg_pid="$1"
	arg_wanted="$2"
	if [ -r "/proc/$arg_pid/cmdline" ]; then
		tr '\000' '\n' <"/proc/$arg_pid/cmdline" 2>/dev/null | grep -F -x -q -- "$arg_wanted"
		return $?
	fi
	ps -ww -o command= -p "$arg_pid" 2>/dev/null | grep -F -q -- "$arg_wanted"
}

stop_exact_process() {
	stop_pid="$1"
	stop_birth="$2"
	stop_signal="$3"
	process_matches "$stop_pid" "$stop_birth" || return 0
	kill "-$stop_signal" "$stop_pid" 2>/dev/null || :
	return 0
}

lock_owner_pid() {
	if [ -d "$1" ]; then
		lock_owner_value="$(sed -n '1p' "$1/pid" 2>/dev/null || :)"
	else
		lock_owner_value="$(sed -n '1p' "$1" 2>/dev/null || :)"
	fi
	case "$lock_owner_value" in ''|*[!0-9]*|0) return 1 ;; esac
	printf '%s\n' "$lock_owner_value"
}

# 0 acquired, 1 unusable path, 2 already present
lock_try_acquire() {
	acquire_path="$1"
	[ -d "$acquire_path" ] && return 2
	acquire_tmp="${acquire_path}.tmp.$SELF_PID"
	printf '%s\n' "$SELF_PID" >"$acquire_tmp" 2>/dev/null || return 1
	if ln "$acquire_tmp" "$acquire_path" 2>/dev/null; then
		if [ -f "$acquire_path" ] && [ "$(sed -n '1p' "$acquire_path" 2>/dev/null)" = "$SELF_PID" ]; then
			rm -f "$acquire_tmp"
			return 0
		fi
		rm -f "$acquire_path/${acquire_tmp##*/}" 2>/dev/null || :
		rm -f "$acquire_tmp"
		return 2
	fi
	rm -f "$acquire_tmp"
	return 2
}

lock_release() {
	[ -n "$1" ] || return 0
	rm -f "$1" 2>/dev/null || :
}

# Hands an already-held lock to another process. rename(2) replaces the whole
# file, so a concurrent reader sees either the old owner or the new one and
# never an empty lock it could mistake for a crashed one. This is what makes
# the launcher/worker handoff observable: the launcher exits, and a status read
# in the gap before the worker writes its own state still finds a live owner.
lock_set_owner() {
	set_owner_path="$1"
	set_owner_tmp="${set_owner_path}.own.$SELF_PID"
	printf '%s\n' "$2" >"$set_owner_tmp" 2>/dev/null || return 1
	mv "$set_owner_tmp" "$set_owner_path" 2>/dev/null || {
		rm -f "$set_owner_tmp"
		return 1
	}
}

# Releases a lock this process actually owns, judged by what the lock says
# rather than by a variable this process set afterwards.
#
# The distinction is a real window, not a hypothetical one: acquiring records
# the owner inside the lock and *then* returns, and the caller sets its "held"
# flag after that. A signal arriving in between leaves a lock owned by this
# process that no flag admits to holding, and cleanup keyed on the flag walks
# past it. Keying on the recorded owner closes that window, and refusing to
# remove a lock owned by anyone else is what keeps it from opening a worse one.
lock_release_if_ours() {
	[ -n "${1:-}" ] || return 0
	release_owner="$(lock_owner_pid "$1" 2>/dev/null || :)"
	[ "$release_owner" = "$SELF_PID" ] || return 0
	lock_release "$1"
	return 0
}

lock_reclaim_if_stale() {
	reclaim_path="$1"
	reclaim_guard="${reclaim_path}.reclaim"
	reclaim_guard_owner="$(lock_owner_pid "$reclaim_guard" 2>/dev/null || :)"
	if [ -n "$reclaim_guard_owner" ] && ! process_is_alive "$reclaim_guard_owner"; then
		rm -f "$reclaim_guard" 2>/dev/null || :
	fi
	lock_try_acquire "$reclaim_guard" || return 1
	reclaim_result=1
	reclaim_owner="$(lock_owner_pid "$reclaim_path" 2>/dev/null || :)"
	if [ -n "$reclaim_owner" ] && process_is_alive "$reclaim_owner"; then
		reclaim_result=1
	elif [ -d "$reclaim_path" ]; then
		rm -f "$reclaim_path/pid" 2>/dev/null || :
		rmdir "$reclaim_path" 2>/dev/null && reclaim_result=0
	else
		rm -f "$reclaim_path" 2>/dev/null && reclaim_result=0
	fi
	rm -f "$reclaim_guard" 2>/dev/null || :
	return "$reclaim_result"
}

# 0 acquired, 1 unusable path, 3 held by a live owner.
lock_try_acquire_or_reclaim() {
	attempt_path="$1"
	lock_try_acquire "$attempt_path"
	attempt_status=$?
	[ "$attempt_status" -eq 0 ] && return 0
	[ "$attempt_status" -eq 1 ] && return 1
	attempt_owner="$(lock_owner_pid "$attempt_path" 2>/dev/null || :)"
	if [ -n "$attempt_owner" ] && process_is_alive "$attempt_owner"; then
		return 3
	fi
	lock_reclaim_if_stale "$attempt_path" || return 3
	lock_try_acquire "$attempt_path"
	attempt_status=$?
	[ "$attempt_status" -eq 0 ] && return 0
	[ "$attempt_status" -eq 1 ] && return 1
	return 3
}

# Bounded wait, in whole seconds, for one lock. Failing to acquire is a refusal
# and never a licence to proceed without it.
lock_acquire_waiting() {
	waiting_path="$1"
	waiting_seconds="${2:-0}"
	waiting_elapsed=0
	while :; do
		lock_try_acquire_or_reclaim "$waiting_path"
		waiting_status=$?
		[ "$waiting_status" -eq 0 ] && return 0
		[ "$waiting_status" -eq 3 ] || return 1
		[ "$waiting_elapsed" -lt "$waiting_seconds" ] || return 3
		"$SLEEP" 1 2>/dev/null || return 3
		waiting_elapsed=$((waiting_elapsed + 1))
	done
}

# The acquisition and release order, recorded when a fixture asks for it. The
# test plan requires the order to be asserted by order rather than by grepping
# the source, and a claim about lock ordering that is checked by reading the
# code is not checked at all.
lock_trace() {
	[ -n "$LOCK_TRACE_FILE" ] || return 0
	printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >>"$LOCK_TRACE_FILE" 2>/dev/null || :
}

sanitize_token() {
	printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

safe_token() {
	case "$1" in ''|*[!A-Za-z0-9_.:-]*) return 1 ;; esac
	[ "${#1}" -le 200 ] || return 1
	return 0
}

safe_single_line() {
	case "$1" in *"$TAB"*) return 1 ;; esac
	case "$1" in *"$CR"*) return 1 ;; esac
	case "${1%"$NEWLINE"}" in *"$NEWLINE"*) return 1 ;; esac
	return 0
}

# ---- the lock order ----
#
#   1. global APN/suite operation lock
#   2. selected per-modem_id lock
#   3. selected eUICC logical lock       (per endpoint_id)
#   4. canonical control-transport lock  (the AT port lock, or the QMI/MBIM
#                                         per-control-device identity lock)
#
# Level 3 is the only new one, and it sits between two adjacent existing levels
# on purpose: every path in the tree today takes 1 -> 2 -> 4, or 4 alone, so
# there is no pair that becomes acquirable in two orders. Do not move it.
#
# A read-only transaction that starts no operation and needs no ownership or
# slot change takes levels 3 and 4 only, exactly as a read-only AT identity
# transaction already takes the port lock alone. The global lock is still
# system-wide, so requiring it for a read would report the eSIM area of one
# modem busy whenever anything at all was running on the other.

acquire_global_lock() {
	# Borrowed on exactly the terms the existing packages use: the variable
	# names a PID, the lock's recorded owner is exactly that PID, and that
	# process is alive. The presence of the variable is not ownership and the
	# presence of the lock file is not ownership.
	if [ -n "${APN_AUTOCONFIG_LOCK_OWNER_PID:-}" ]; then
		case "$APN_AUTOCONFIG_LOCK_OWNER_PID" in
			''|*[!0-9]*|0) : ;;
			*)
				borrowed_owner="$(lock_owner_pid "$APN_LOCK_DIR" 2>/dev/null || :)"
				if [ "$borrowed_owner" = "$APN_AUTOCONFIG_LOCK_OWNER_PID" ] && \
					process_is_alive "$borrowed_owner"; then
					APN_LOCK_HELD=1
					APN_LOCK_BORROWED=1
					lock_trace "borrow" "1-global" "$APN_LOCK_DIR"
					return 0
				fi
			;;
		esac
		return 3
	fi
	mkdir -p "$(dirname "$APN_LOCK_DIR")" 2>/dev/null || :
	lock_acquire_waiting "$APN_LOCK_DIR" "${1:-0}" || return 3
	APN_LOCK_HELD=1
	APN_LOCK_BORROWED=0
	lock_trace "acquire" "1-global" "$APN_LOCK_DIR"
	return 0
}

acquire_modem_lock() {
	# The coordinator's own namespace and its own key derivation, so this lock
	# and the coordinator's are the same lock rather than two names for one
	# modem.
	MODEM_LOCK_PATH="${MODEM_LOCK_ROOT}.$(sanitize_token "$1")"
	mkdir -p "$(dirname "$MODEM_LOCK_ROOT")" 2>/dev/null || :
	lock_acquire_waiting "$MODEM_LOCK_PATH" "${2:-0}" || { MODEM_LOCK_PATH=""; return 3; }
	MODEM_LOCK_HELD=1
	lock_trace "acquire" "2-modem" "$MODEM_LOCK_PATH"
	return 0
}

acquire_endpoint_lock() {
	# Keyed by the chip, not by the slot: one eUICC moved between two modems is
	# one lock wherever it is, and two modems each holding their own eUICC do
	# not serialise against each other. A slot-weak endpoint still takes a lock,
	# under its `slot:` handle, because a read of it is still an exclusive
	# transaction — a lock on a position, which is honest about what it is.
	ENDPOINT_LOCK_PATH="${LOCK_ROOT}.endpoint.$(sanitize_token "$1")"
	mkdir -p "$(dirname "$LOCK_ROOT")" 2>/dev/null || :
	lock_acquire_waiting "$ENDPOINT_LOCK_PATH" "${2:-0}" || { ENDPOINT_LOCK_PATH=""; return 3; }
	ENDPOINT_LOCK_HELD=1
	lock_trace "acquire" "3-endpoint" "$ENDPOINT_LOCK_PATH"
	return 0
}

acquire_transport_lock() {
	# Shared, not merely equivalent. An APDU exchange on /dev/ttyUSB2 must
	# exclude the AT identity reader on the same node, so this is the namespace
	# that reader already uses, resolved the same way. A second namespace at the
	# same path would exclude nothing at all.
	transport_kind="$1"
	transport_device="$2"
	case "$transport_kind" in
		at)
			transport_name="${transport_device#/dev/}"
			# The property being enforced is that the lock name is one simple
			# path component under a device root, so a name can never build a
			# path anywhere else. It is deliberately not the list of names the
			# modem package discovers: which ports exist is that package's
			# decision, taken from sysfs, and this one's job is to lock the port
			# it was handed -- in the namespace the AT identity reader already
			# uses, derived the same way, or the lock excludes nothing.
			case "$transport_name" in
				*/*|*..*|'') return 1 ;;
				tty*) : ;;
				*) return 1 ;;
			esac
			TRANSPORT_LOCK_PATH="${AT_PORT_LOCK_ROOT}.${transport_name}"
		;;
		qmi|mbim)
			transport_name="${transport_device#"$CONTROL_DEV_ROOT"/}"
			case "$transport_name" in
				*/*|*..*|'') return 1 ;;
				cdc-wdm[0-9]*) : ;;
				*) return 1 ;;
			esac
			TRANSPORT_LOCK_PATH="${QMI_IDENTITY_LOCK_ROOT}.${transport_name}"
		;;
		*) return 1 ;;
	esac
	mkdir -p "$(dirname "$TRANSPORT_LOCK_PATH")" 2>/dev/null || :
	lock_acquire_waiting "$TRANSPORT_LOCK_PATH" "${3:-0}" || { TRANSPORT_LOCK_PATH=""; return 3; }
	TRANSPORT_LOCK_HELD=1
	lock_trace "acquire" "4-transport" "$TRANSPORT_LOCK_PATH"
	return 0
}

# ---- JSON and record helpers ----

json_escape() {
	awk 'BEGIN { ORS="" }
	{
		if (NR > 1) printf "\\n"
		gsub(/\\/, "\\\\")
		gsub(/"/, "\\\"")
		gsub(/\t/, "\\t")
		gsub(/\r/, "\\r")
		printf "%s", $0
	}'
}

json_string() {
	case "$1" in
		*\\*|*\"*|*"$TAB"*|*"$CR"*|*"$NEWLINE"*)
			printf '"'
			printf '%s' "$1" | json_escape
			printf '"'
		;;
		*) printf '"%s"' "$1" ;;
	esac
}

json_key_string() {
	printf '"%s":' "$1"
	json_string "$2"
}

json_key_boolean() {
	printf '"%s":%s' "$1" "$([ "$2" = 1 ] || [ "$2" = true ] && printf true || printf false)"
}

json_key_number() {
	case "$2" in
		''|*[!0-9-]*) printf '"%s":null' "$1" ;;
		*) printf '"%s":%s' "$1" "$2" ;;
	esac
}

# Tab-delimited records legitimately contain empty fields, and POSIX `read`
# collapses runs of IFS whitespace, so a multi-variable read would silently
# misalign them. Everything here splits on the separator explicitly.
field() {
	field_rest="$1"
	field_index="$2"
	while [ "$field_index" -gt 1 ]; do
		case "$field_rest" in
			*"$TAB"*) field_rest="${field_rest#*"$TAB"}" ;;
			*) printf '\n'; return 0 ;;
		esac
		field_index=$((field_index - 1))
	done
	printf '%s\n' "${field_rest%%"$TAB"*}"
}

# ---- bounded external commands ----
#
# A backend's own timeout option is not proof that its process cannot hang, and
# the reference router has no `timeout` executable at all — not in PATH and not
# as a BusyBox applet. On that board this watchdog is the only bound there is,
# so it gets the same care as the branch that has one.

run_bounded_to_file() {
	seconds="$1"
	output_file="$2"
	shift 2
	BOUNDED_TIMED_OUT=0
	# Always own the actual child and its TERM/KILL watchdog. Delegating to
	# an optional timeout program leaves signal cleanup unable to reap the
	# command and some timeout implementations wait forever after TERM.
	# The verdict travels in a marker file rather than in the child's exit
	# status, because a child killed by the watchdog reports 143 exactly like a
	# child killed by an external TERM, and a caller that must tell "it hung"
	# from "it answered with an error" cannot work from 143.
	rm -f "$BOUNDED_TIMEOUT_MARKER" 2>/dev/null || :
	"$@" >"$output_file" 2>/dev/null &
	BOUNDED_CHILD_PID=$!
	# The sleeper is the watchdog's own background child with a TERM trap, so
	# retiring the watchdog once the call has answered also retires the sleeper.
	# Killing the subshell alone leaves the sleeper to run out the whole budget
	# and charges every fast call its entire deadline.
	(
		watchdog_sleep_pid=""
		# `$!` rather than the recorded PID alone. `$!` is set when the sleep is
		# forked, so it names the sleep one command before the assignment does,
		# and a TERM arriving in between would otherwise find the variable empty,
		# kill nothing, and leave the sleep to run out the whole budget as an
		# orphan. Before the first fork `$!` still names the caller's own child,
		# which this must never kill, so it is compared rather than trusted.
		trap 'watchdog_target="${watchdog_sleep_pid:-$!}"; [ "$watchdog_target" = "$BOUNDED_CHILD_PID" ] || kill -TERM "$watchdog_target" 2>/dev/null; exit 0' TERM
		"$SLEEP" "$seconds" &
		watchdog_sleep_pid=$!
		wait "$watchdog_sleep_pid" 2>/dev/null || exit 0
		: >"$BOUNDED_TIMEOUT_MARKER" 2>/dev/null || :
		kill -TERM "$BOUNDED_CHILD_PID" 2>/dev/null || exit 0
		watchdog_sleep_pid=""
		"$SLEEP" 1 &
		watchdog_sleep_pid=$!
		wait "$watchdog_sleep_pid" 2>/dev/null || exit 0
		kill -9 "$BOUNDED_CHILD_PID" 2>/dev/null || :
	) >/dev/null 2>&1 &
	BOUNDED_WATCHDOG_PID=$!
	bounded_status=0
	wait "$BOUNDED_CHILD_PID" 2>/dev/null || bounded_status=$?
	BOUNDED_CHILD_PID=""
	kill -TERM "$BOUNDED_WATCHDOG_PID" 2>/dev/null || :
	wait "$BOUNDED_WATCHDOG_PID" 2>/dev/null || :
	BOUNDED_WATCHDOG_PID=""
	if [ -e "$BOUNDED_TIMEOUT_MARKER" ]; then
		rm -f "$BOUNDED_TIMEOUT_MARKER" 2>/dev/null || :
		BOUNDED_TIMED_OUT=1
		return 124
	fi
	return "$bounded_status"
}

# ---- the read-path deadline ----
#
# The same total the APN engine observes, on the same terms: a call gets the
# lesser of its own bound and the time remaining, a call with no time remaining
# is not attempted at all, and the command still returns a well-formed document
# saying what it abandoned.

read_deadline_arm() {
	case "$READ_DEADLINE_SECONDS" in
		''|*[!0-9]*) die "read_deadline_seconds must be a whole number of seconds" ;;
	esac
	case "$RPCD_EXEC_BUDGET_SECONDS" in
		''|*[!0-9]*) die "the rpcd exec budget must be a whole number of seconds" ;;
	esac
	[ "$READ_DEADLINE_SECONDS" -gt 0 ] || die "read_deadline_seconds must be greater than zero"
	[ "$READ_DEADLINE_SECONDS" -lt "$RPCD_EXEC_BUDGET_SECONDS" ] || \
		die "read_deadline_seconds ${READ_DEADLINE_SECONDS} must stay below the ${RPCD_EXEC_BUDGET_SECONDS}s rpcd exec budget it exists to fit inside"
	READ_DEADLINE_AT=$(($(date +%s) + READ_DEADLINE_SECONDS))
}

read_deadline_remaining() {
	deadline_remaining=$((READ_DEADLINE_AT - $(date +%s)))
	[ "$deadline_remaining" -gt 0 ] || deadline_remaining=0
	printf '%s\n' "$deadline_remaining"
}

# Named once however often the same reading is retried: the document lists what
# could not be read, not how many times it was attempted.
read_abandon() {
	case " $READ_INCOMPLETE_READS " in *" $1 "*) return 0 ;; esac
	READ_INCOMPLETE_READS="${READ_INCOMPLETE_READS:+$READ_INCOMPLETE_READS }$1"
	READ_INCOMPLETE=1
	case "${2:-deadline}" in
		deadline) log warning "the read deadline of ${READ_DEADLINE_SECONDS}s was reached; abandoned $1" ;;
		*) log warning "$1 ran out of its own time budget and was abandoned" ;;
	esac
}

read_was_abandoned() {
	case " $READ_INCOMPLETE_READS " in *" $1 "*) return 0 ;; esac
	return 1
}

run_read_bounded() {
	read_label="$1"
	read_budget="$2"
	read_output="$3"
	shift 3
	read_clipped=0
	if [ -n "$READ_DEADLINE_AT" ]; then
		read_remaining="$(read_deadline_remaining)"
		if [ "$read_remaining" -le 0 ]; then
			read_abandon "$read_label"
			return 124
		fi
		if [ -z "$read_budget" ] || [ "$read_remaining" -lt "$read_budget" ]; then
			read_budget="$read_remaining"
			read_clipped=1
		fi
	fi
	if [ -z "$read_budget" ]; then
		"$@" >"$read_output" 2>/dev/null
		return
	fi
	read_status=0
	run_bounded_to_file "$read_budget" "$read_output" "$@" || read_status=$?
	if [ -n "$READ_DEADLINE_AT" ] && [ "$read_status" -ne 0 ]; then
		case "$read_status" in
			124|137|143)
				if [ "$read_clipped" -eq 1 ]; then
					read_abandon "$read_label" deadline
				else
					read_abandon "$read_label" budget
				fi
			;;
		esac
	fi
	return "$read_status"
}

# Printed only when something was abandoned, so a document from a backend that
# answered is byte-for-byte what the same version produced with no deadline
# armed.
print_incomplete_fields() {
	[ "$READ_INCOMPLETE" -eq 1 ] || return 0
	printf ',"incomplete":true,"incomplete_reads":['
	incomplete_separator=""
	for incomplete_name in $READ_INCOMPLETE_READS; do
		printf '%s' "$incomplete_separator"
		json_string "$incomplete_name"
		incomplete_separator=','
	done
	printf ']'
}

# ---- endpoint identity ----
#
# Two evidence tiers, strongest first, in the same shape as the modem
# contract's three:
#
#   eid        the EID was read from the eUICC during the current attachment
#              generation and normalises to exactly 32 decimal digits. An eUICC
#              carries the same EID in any slot of any modem, so a removable
#              card that moved is recognised as the same endpoint.
#   slot-weak  a slot reports an eUICC and no EID has been read from it. This is
#              a position, not a chip, and no mutation may target one.
#
# Normalisation is exact and is part of the contract, because two spellings of
# one identifier would be two endpoints. A value that does not normalise is not
# evidence and does not downgrade to a guess.

normalise_eid() {
	normalise_value="$(printf '%s' "${1:-}" | tr -d ' \t\r\n')"
	case "$normalise_value" in ''|*[!0-9]*) return 1 ;; esac
	[ "${#normalise_value}" -eq 32 ] || return 1
	printf '%s\n' "$normalise_value"
}

normalise_iccid() {
	normalise_value="$(printf '%s' "${1:-}" | tr -d ' \t\r\n')"
	# A single trailing F is padding, and exactly one is dropped.
	case "$normalise_value" in *[Ff]) normalise_value="${normalise_value%?}" ;; esac
	case "$normalise_value" in ''|*[!0-9]*) return 1 ;; esac
	[ "${#normalise_value}" -ge 18 ] && [ "${#normalise_value}" -le 20 ] || return 1
	printf '%s\n' "$normalise_value"
}

# The handle, and why it is not the identifier.
#
# An operation must name its endpoint on a command line and /proc/<pid>/cmdline
# is world-readable, so a handle that contained the EID would put it there on
# every read the page performs, and then in every operation state file, every
# diagnostic bundle and every log line naming an operation. The first 64 bits of
# the SHA-256 carry none of it and are otherwise as good: deterministic, stable
# for as long as the eUICC exists, and recomputable by anyone holding the EID.
#
# There is deliberately no per-router salt. A salt would resist an offline
# search and would add a persistent file whose loss silently renames every
# endpoint and orphans every per-endpoint override — a worse failure than the
# one it prevents, against an attacker who does not need to attack.
handle_for_identifier() {
	# The value reaches sha256sum on standard input, never in an argument.
	handle_digest="$(printf '%s' "$1" | "$SHA256" 2>/dev/null | sed -n '1s/^\([0-9a-f]*\).*/\1/p')"
	case "$handle_digest" in
		''|*[!0-9a-f]*) return 1 ;;
	esac
	[ "${#handle_digest}" -ge 16 ] || return 1
	printf '%s\n' "$(printf '%s' "$handle_digest" | cut -c1-16)"
}

endpoint_handle_from_eid() {
	handle_value="$(handle_for_identifier "$1")" || return 1
	printf 'eid:%s\n' "$handle_value"
}

profile_handle_from_iccid() {
	handle_value="$(handle_for_identifier "$1")" || return 1
	printf 'iccid:%s\n' "$handle_value"
}

slot_weak_handle() {
	printf 'slot:%s:%s\n' "$1" "$2"
}

suffix_of() {
	suffix_value="${1:-}"
	[ "${#suffix_value}" -gt 4 ] || { printf ''; return 0; }
	printf '%s' "${suffix_value#"${suffix_value%????}"}"
}

# ---- the modem record this package consumes ----
#
# Identity, ownership, transport candidates and the slot table all come from
# `apn-autoconfig-modem sim-slots`, which is a v1 key/value document in the
# same shape as `attachment` and `at-identity`. Reading a sibling package's
# JSON from a shell script would need a JSON parser; reading its key/value
# document needs the field extractor that is already here.
#
# What it deliberately does not carry is a raw EID. The modem package publishes
# `eid_known` and a four-character suffix, and every raw read of the identifier
# happens here, in the one package that is allowed to hold it.

load_modem_records() {
	: >"$SLOTS_FILE"
	command_exists "$MODEM_BIN" || {
		[ -x "$MODEM_BIN" ] || return 1
	}
	slots_status=0
	# A deliberate refresh permits the modem package one bounded vendor query
	# for a modem whose slots ModemManager does not publish. A poll never sets
	# it, for the same reason a poll never opens a card: the page that polls
	# this path is fork-bound.
	slots_probe=""
	[ "$REQUESTED_REFRESH" -eq 0 ] || slots_probe=--probe
	# shellcheck disable=SC2086
	if [ -n "${1:-}" ]; then
		run_read_bounded slot-status 10 "$SLOTS_FILE" "$MODEM_BIN" sim-slots \
			--modem "$1" $slots_probe || slots_status=$?
	else
		run_read_bounded slot-status 10 "$SLOTS_FILE" "$MODEM_BIN" sim-slots \
			$slots_probe || slots_status=$?
	fi
	[ "$slots_status" -eq 0 ] || return 1
	[ -s "$SLOTS_FILE" ] || return 1
	case "$(sed -n '1p' "$SLOTS_FILE")" in
		v1) : ;;
		*) return 1 ;;
	esac
	index_modem_sections
	return 0
}

# Sections are addressed by position, not by `modem_id`, and that is the whole
# point of this indexing step.
#
# Two modems can legitimately carry the same identity -- that is precisely what
# `weak-vidpid` ambiguity is -- and a lookup keyed by the identity then returns
# both sections joined together. The endpoints of one modem would be attributed
# to the other, and every slot would be enumerated once per modem sharing the
# id. Position is unique by construction.
SLOTS_INDEXED_FILE=""

index_modem_sections() {
	SLOTS_INDEXED_FILE="$TMP_BASE.slots-indexed"
	awk -F '\t' -v OFS='\t' '
		$1 == "modem" { index_number++ }
		{ print index_number, $0 }
	' "$SLOTS_FILE" >"$SLOTS_INDEXED_FILE" 2>/dev/null || :
}

# Every `modem` line, prefixed with its section index, in document order.
modem_record_lines() {
	awk -F '\t' '$2 == "modem" { print }' "$SLOTS_INDEXED_FILE" 2>/dev/null || :
}

# The lines belonging to the section at one position: its `modem` line and
# everything up to the next one, with the index prefix removed.
modem_section_at() {
	awk -F '\t' -v want="$1" '
		$1 != want { next }
		{ sub(/^[0-9]*\t/, ""); print }
	' "$SLOTS_INDEXED_FILE" 2>/dev/null || :
}

# Field <3> of the first line of section <1> whose first field is <2>.
#
# Pure shell, with no pipeline, and that is not a micro-optimisation. The form
# this replaces was `printf '%s\n' "$section" | awk '... { print; exit }'`, and
# an awk that exits on the first match closes the pipe while the shell is still
# writing the rest of the section -- so the writing side takes an EPIPE, which
# with a PIPE trap installed becomes a "write error: Broken pipe" on standard
# error in the middle of an otherwise correct read. A section is a dozen short
# lines, so walking it costs less than the two forks it removes anyway.
section_field() {
	section_rest="$1"
	section_key="$2"
	section_index="$3"
	while [ -n "$section_rest" ]; do
		section_line="${section_rest%%"$NEWLINE"*}"
		case "$section_rest" in
			*"$NEWLINE"*) section_rest="${section_rest#*"$NEWLINE"}" ;;
			*) section_rest="" ;;
		esac
		[ -n "$section_line" ] || continue
		[ "${section_line%%"$TAB"*}" = "$section_key" ] || continue
		field "$section_line" "$section_index"
		return 0
	done
	printf '\n'
	return 0
}

section_value() {
	section_field "$1" "$2" 2
}

# The `device` line for one role, which needs a match on two fields rather than
# one.
section_device() {
	section_rest="$1"
	section_role="$2"
	while [ -n "$section_rest" ]; do
		section_line="${section_rest%%"$NEWLINE"*}"
		case "$section_rest" in
			*"$NEWLINE"*) section_rest="${section_rest#*"$NEWLINE"}" ;;
			*) section_rest="" ;;
		esac
		[ -n "$section_line" ] || continue
		[ "${section_line%%"$TAB"*}" = device ] || continue
		[ "$(field "$section_line" 2)" = "$section_role" ] || continue
		field "$section_line" 3
		return 0
	done
	printf '\n'
	return 0
}

# ---- the AT transport under the bridge ----
#
# The five APDU operations the LPA asks for, carried over a modem's AT control
# port by this package rather than by the LPA. lpac's own AT backend opens the
# device itself, holds no lock and probes `AT+CCHO=?` on whatever node it was
# handed, which is the probe that wedged a SIM upstream; with `LPAC_APDU=stdio`
# it opens nothing at all and the choice of how those operations reach the card
# becomes ours — made by code that has already done owner discovery, already
# holds the right lock and already bounds every exchange.
#
# The port is opened read/write on one descriptor and held for the whole
# session. `sms_tool` is deliberately not used: it re-opens the port per
# command, which cannot hold a logical channel open across the many exchanges
# one ES10 read takes.

AT_TRANSPORT_DEVICE=""
AT_REPLY=""
AT_STATUS_LINE=""

# `read -t` is the per-exchange bound, so a shell without it has no bound at
# all. That is a refusal rather than an unbounded read.
at_read_timeout_supported() {
	printf 'x\n' | { IFS= read -t 1 -r at_probe_line; } 2>/dev/null
}

# ---- the QMI UIM card session ----
#
# One client process for a whole bridge run, spoken to through a pair of FIFOs,
# because a Bound Profile Package is hundreds of exchanges and a process per
# APDU costs both time and a world-readable command line. The client itself is
# `apn-autoconfig-esim-uim`, which knows three messages of one QMI service and
# decides nothing: every refusal above it is still this script's.
#
# Descriptor 3 is what this process writes to it and descriptor 9 is what it
# reads back. Both are closed in every LPA child, exactly as the AT port's
# descriptor 8 is, because the LPA has no business holding either end.

uim_open_client() {
	uim_device="$1"
	[ -c "$uim_device" ] || return 1
	[ -x "$UIM_CLIENT" ] || return 1

	( umask 077 && mkdir -p "$STATE_DIR/uim" ) || return 1
	UIM_CLIENT_DIR="$STATE_DIR/uim/$SELF_PID"
	rm -rf "$UIM_CLIENT_DIR" 2>/dev/null || :
	( umask 077 && mkdir "$UIM_CLIENT_DIR" ) || { UIM_CLIENT_DIR=""; return 1; }
	( umask 077 && mkfifo "$UIM_CLIENT_DIR/to" "$UIM_CLIENT_DIR/from" ) || {
		uim_close_client
		return 1
	}

	# Armed before the child exists. A signal between the fork and the
	# assignment would otherwise leave a process holding the control device
	# with nothing recording that it does.
	UIM_CLIENT_FD_OPEN=1
	"$UIM_CLIENT" --device "$uim_device" --slot 1 --timeout "$APDU_TIMEOUT_SECONDS" \
		<"$UIM_CLIENT_DIR/to" >"$UIM_CLIENT_DIR/from" 2>/dev/null &
	UIM_CLIENT_PID=$!
	{ exec 3>"$UIM_CLIENT_DIR/to"; } 2>/dev/null || { uim_close_client; return 1; }
	{ exec 9<"$UIM_CLIENT_DIR/from"; } 2>/dev/null || { uim_close_client; return 1; }

	# It says `ready` once it holds the device and the modem has given it a
	# client id. Anything else, including silence, means this transport is not
	# available and the caller tries the next candidate.
	uim_ready=""
	IFS= read -t "$APDU_TIMEOUT_SECONDS" -r uim_ready <&9 2>/dev/null || uim_ready=""
	[ "$uim_ready" = ready ] || { uim_close_client; return 1; }
	return 0
}

# One line to the client, without letting its death end this process.
#
# A write to a channel whose reader has gone raises SIGPIPE, and the default
# disposition would kill the shell -- the shell holding the ModemManager
# inhibit and the whole lock order. A client that has gone is a failed exchange
# this layer reports and unwinds from, so the signal is ignored for exactly the
# length of the write and restored immediately. Nothing is forked in between,
# so no child inherits the ignored disposition.
uim_write_line() {
	trap '' PIPE
	uim_write_status=0
	printf '%s\n' "$1" >&3 2>/dev/null || uim_write_status=$?
	trap - PIPE
	return "$uim_write_status"
}

uim_close_client() {
	if [ "$UIM_CLIENT_FD_OPEN" -eq 1 ]; then
		# `quit` first, so the client closes its own logical channel and
		# releases its client id rather than being killed holding both. The
		# write is allowed to fail: if it has already gone, the signal below is
		# a no-op and the reap is what matters.
		uim_write_line quit || :
		# Then wait for it to go, on the shell's own timer rather than on a
		# `sleep`. The client closes its logical channel and releases its client
		# id on the way out, so being killed here instead would leave the card
		# holding a channel nothing above can reach -- and the reap below is a
		# bound, not the normal path. `read` ends at end of file, which is what
		# an orderly exit looks like from this side, so the usual cost is none.
		IFS= read -t 2 -r uim_farewell <&9 2>/dev/null || :
		{ exec 3>&-; } 2>/dev/null || :
		{ exec 9<&-; } 2>/dev/null || :
		UIM_CLIENT_FD_OPEN=0
	fi
	if [ -n "$UIM_CLIENT_PID" ]; then
		reap_child "$UIM_CLIENT_PID" TERM
		"$SLEEP" 1 2>/dev/null || :
		reap_child "$UIM_CLIENT_PID" KILL
		wait "$UIM_CLIENT_PID" 2>/dev/null || :
		UIM_CLIENT_PID=""
	fi
	if [ -n "$UIM_CLIENT_DIR" ] && [ -d "$UIM_CLIENT_DIR" ]; then
		# Exact paths only, and only the two this run created.
		rm -f "$UIM_CLIENT_DIR/to" "$UIM_CLIENT_DIR/from" 2>/dev/null || :
		rmdir "$UIM_CLIENT_DIR" 2>/dev/null || :
	fi
	UIM_CLIENT_DIR=""
	BRIDGE_CHANNEL=""
	return 0
}

# One line in, one line out, on a deadline. UIM_REPLY holds the answer.
#
# The bound is the caller's `apdu_timeout_seconds` plus a margin, because the
# client already applies that same budget to the modem: if the card is slow the
# client says `err timeout` and this read must be there to hear it, rather than
# expiring first and leaving an answer in the pipe for the next exchange to
# mistake for its own.
uim_exchange() {
	UIM_REPLY=""
	[ "$UIM_CLIENT_FD_OPEN" -eq 1 ] || return 1
	uim_write_line "$1" || return 1
	IFS= read -t "$(( APDU_TIMEOUT_SECONDS + 5 ))" -r UIM_REPLY <&9 2>/dev/null || return 1
	[ -n "$UIM_REPLY" ] || return 1
	return 0
}

at_open_port() {
	AT_TRANSPORT_DEVICE="$1"
	# A regular file or a pipe is not a control port. The check stays here
	# rather than in the caller because this is the only place that opens one.
	[ -c "$AT_TRANSPORT_DEVICE" ] || return 1
	# The braces are load-bearing. `exec 8<>dev 2>/dev/null` applies *both*
	# redirections to the shell itself and permanently: every later diagnostic,
	# every `log` line and every message from a failing command would go to
	# /dev/null for the rest of the process, silently. Grouping scopes the
	# stderr redirection to the group while fd 8 still lands on the shell,
	# which is the asymmetry that makes this work.
	{ exec 8<>"$AT_TRANSPORT_DEVICE"; } 2>/dev/null || return 1
	BRIDGE_AT_FD_OPEN=1
	return 0
}

at_close_port() {
	[ "$BRIDGE_AT_FD_OPEN" -eq 1 ] || return 0
	{ exec 8<&-; } 2>/dev/null || :
	BRIDGE_AT_FD_OPEN=0
	AT_TRANSPORT_DEVICE=""
	return 0
}

# Is the port that is open on descriptor 8 this modem's command channel?
#
# Two questions, in the order the modem contract asks them: does the node speak
# AT at all, and is it the control channel rather than a GNSS, debug or
# diagnostic port that also answers. A port that returns OK to a bare AT and
# nothing resembling a model is the second kind.
# Asking a port whether it is the control channel, on its own bound.
#
# It used to borrow `apdu_timeout_seconds`, which is the budget for an exchange
# with a *card* and is far too generous for "are you there". Measured on the
# reference router: a live port answers `AT` in under a second, while a silent
# one costs the whole bound -- twice, because `ATE0` pays it before `AT` does.
# With four silent ports of six on that modem, that was twenty-one seconds per
# silent port, repeated for every LPA invocation, and it was the largest single
# cost in an eSIM operation.
#
# A probe that is too short fails closed: the port is skipped, and if none
# answers the bridge refuses rather than opening a channel it has not proven.
at_probe_control_port() {
	AT_DEADLINE_OVERRIDE="$AT_PROBE_TIMEOUT_SECONDS"
	at_drain
	at_exchange 'ATE0' >/dev/null 2>&1 || :
	if ! at_exchange 'AT' || ! at_exchange 'AT+CGMM'; then
		AT_DEADLINE_OVERRIDE=""
		return 1
	fi
	AT_DEADLINE_OVERRIDE=""
	probe_model="$(at_reply_line 1)"
	[ -n "$probe_model" ] || return 1
	case "$probe_model" in *[A-Za-z0-9]*) return 0 ;; esac
	return 1
}

# The overall bound that `read -t` is not.
#
# The clock is consulted once per block of lines rather than once per line: on
# the target `monotonic_seconds` is a builtin redirect and costs nothing, but
# on a host without /proc/uptime it forks `date`, and a flood would then fork
# once per line. The line cap is the cheap gate for that, and it is the whole
# bound on a host whose clock cannot be read at all.
AT_LOOP_DEADLINE=""
AT_LOOP_LINES=0
# How many lines pass between two readings of the clock. One, where reading it
# is a builtin redirect and costs nothing -- which is the target. Sixty-four,
# where it forks `date`, which is the fixture host. Checking every line matters
# for the other shape of a stream that outlasts its bound: not a flood, but a
# trickle that keeps arriving just inside the per-line bound. A block of lines
# would let that one run for the block's worth of per-line bounds past the
# deadline before anyone looked.
if [ -r /proc/uptime ]; then
	AT_LOOP_BLOCK=1
else
	AT_LOOP_BLOCK=64
fi

at_loop_begin() {
	AT_LOOP_LINES=0
	AT_LOOP_DEADLINE=""
	at_loop_now="$(monotonic_seconds)" || return 0
	AT_LOOP_DEADLINE=$(( at_loop_now + $1 ))
	return 0
}

# 0 when the loop has reached its end, 1 to keep going.
#
# Asked at the top of the body, so the line it is asked about is the one that
# is given up on. That is what a bound means: past it there is no budget left
# to spend on a line, including a line that might have been the final result
# code. A caller that gets 124 has no answer, which is the truth.
at_loop_over() {
	AT_LOOP_LINES=$(( AT_LOOP_LINES + 1 ))
	[ "$AT_LOOP_LINES" -ge "$AT_LINE_CAP" ] && return 0
	[ $(( AT_LOOP_LINES % AT_LOOP_BLOCK )) -eq 0 ] || return 1
	[ -n "$AT_LOOP_DEADLINE" ] || return 1
	at_loop_now="$(monotonic_seconds)" || return 1
	[ "$at_loop_now" -ge "$AT_LOOP_DEADLINE" ]
}

at_drain() {
	# Whatever the port had to say before we asked. A reply stream that starts
	# with somebody else's unsolicited notification is a reply stream that is
	# already one message out of step.
	#
	# Bounded by the same budget the exchange that follows will use, because a
	# port that cannot be drained inside that budget is not a port the exchange
	# was going to get an answer from either.
	at_loop_begin "${AT_DEADLINE_OVERRIDE:-$APDU_TIMEOUT_SECONDS}"
	while IFS= read -t 1 -r at_drain_line <&8; do
		at_loop_over && break
	done 2>/dev/null || :
	return 0
}

# Sends one command and collects the reply up to its final result code.
#
# Returns 0 with AT_REPLY holding the informational lines and AT_STATUS_LINE the
# final code, 124 when the bound expired, and 1 when the port gave a final code
# that is not OK.
at_exchange() {
	at_command="$1"
	AT_REPLY=""
	AT_STATUS_LINE=""
	# CR *and* LF, and the LF is not decoration. V.250 terminates a command
	# line with S3 (CR) alone, which is what this sent for three releases and
	# what the RM520N-GL accepts. The FM350-GL does not: measured on the
	# reference board, three commands in one open answered 0 times out of 5
	# with CR, and 5 times out of 5 with CRLF, on both of the two ports that
	# speak AT -- unchanged by the line discipline, tested at the tty's
	# defaults and with cfmakeraw, which is how CRLF was told apart from
	# termios as the cause. `sms_tool`, which answers on both ports where this
	# transport did not, sends CRLF too.
	printf '%s\r\n' "$at_command" >&8 2>/dev/null || return 1
	at_deadline_seconds="${AT_DEADLINE_OVERRIDE:-$APDU_TIMEOUT_SECONDS}"
	at_loop_begin $(( at_deadline_seconds * AT_EXCHANGE_BOUND_FACTOR ))
	while IFS= read -t "$at_deadline_seconds" -r at_line <&8; do
		at_loop_over && return 124
		at_line="$(printf '%s' "$at_line" | tr -d '\r')"
		# The echo of the command itself, which a port whose echo is still on
		# returns first. Echo is a per-port property, not a per-modem one, so it
		# cannot be decided once for the device and then assumed.
		[ "$at_line" = "$at_command" ] && continue
		[ -z "$at_line" ] && continue
		case "$at_line" in
			OK)
				AT_STATUS_LINE="$at_line"
				return 0
			;;
			ERROR|+CME\ ERROR:*|+CMS\ ERROR:*)
				AT_STATUS_LINE="$at_line"
				return 1
			;;
		esac
		AT_REPLY="${AT_REPLY}${AT_REPLY:+$NEWLINE}${at_line}"
	done
	return 124
}

at_reply_line() {
	printf '%s\n' "$AT_REPLY" | sed -n "${1}p"
}

# `AT+CCHO="<AID>"` answers with the session id of the channel it opened.
# Upstream accepts only a `+CCHO: `-prefixed reply; the FM350-GL answers with a
# bare decimal, which is one of the two reasons the pinned LPA carries patches.
# The bridge parses both, because it is the side that reads the port now.
at_parse_channel() {
	parse_value="$(printf '%s' "$1" | tr -d ' \t\r')"
	case "$parse_value" in
		+CCHO:*) parse_value="${parse_value#+CCHO:}" ;;
	esac
	case "$parse_value" in ''|*[!0-9]*) return 1 ;; esac
	[ "$parse_value" -ge 1 ] && [ "$parse_value" -le 19 ] || return 1
	printf '%s\n' "$parse_value"
}

# `+CGLA: <length>,"<hex>"`. The length is the count of hex characters, and a
# reply whose declared length disagrees with what arrived is a truncated read
# rather than a short answer.
at_parse_cgla() {
	parse_line="$(printf '%s' "$1" | tr -d ' \t\r')"
	case "$parse_line" in
		+CGLA:*) parse_line="${parse_line#+CGLA:}" ;;
		*) return 1 ;;
	esac
	parse_length="${parse_line%%,*}"
	case "$parse_length" in ''|*[!0-9]*) return 1 ;; esac
	parse_data="${parse_line#*,}"
	# The payload is normally quoted; some firmware omits the quotes.
	parse_data="${parse_data#\"}"
	parse_data="${parse_data%\"}"
	case "$parse_data" in ''|*[!0-9A-Fa-f]*) return 1 ;; esac
	[ "${#parse_data}" -eq "$parse_length" ] || return 1
	printf '%s\n' "$parse_data"
}

# ---- the stdio bridge ----
#
# Both of lpac's stdio backends share one channel — this process's pipe to the
# LPA's standard input and output — dispatched on the JSON `type` field, one
# object per line. There is no second pipe to separate them, which is why the
# secret channel is a *separate* inherited descriptor and why nothing here may
# assume standard input is free.
#
# Message shapes, from lpac 2.3.0 `driver/apdu/stdio.c` and
# `driver/http/stdio.c`:
#
#   out  {"type":"apdu","payload":{"func":"connect","param":null}}
#   in   {"type":"apdu","payload":{"ecode":0,"data":"9000"}}
#   out  {"type":"http","payload":{"url":"...","tx":"...","headers":[...]}}
#   in   {"type":"http","payload":{"rcode":200,"rx":"..."}}
#   out  {"type":"lpa","payload":{"code":0,"message":"success","data":...}}
#
# The parser below is exact rather than general. lpac serialises with cJSON in
# a fixed field order, so a request either matches its shape exactly or it is
# malformed — and a malformed line fails the read instead of being guessed at.

BRIDGE_TYPE=""
BRIDGE_FUNC=""
BRIDGE_PARAM=""
BRIDGE_URL=""
BRIDGE_TX=""
BRIDGE_HEADERS=""
BRIDGE_RESULT=""
BRIDGE_RESULT_CODE=""
BRIDGE_RESULT_MESSAGE=""
BRIDGE_RESULT_DETAIL=""
BRIDGE_HTTP_FAILURE=""
BRIDGE_TRANSPORT_SECURITY=""
BRIDGE_UNVERIFIED_AUTHORITY=""

bridge_parse_line() {
	bridge_line="$1"
	BRIDGE_TYPE=""
	BRIDGE_FUNC=""
	BRIDGE_PARAM=""
	BRIDGE_URL=""
	BRIDGE_TX=""
	BRIDGE_HEADERS=""
	case "$bridge_line" in
		'{"type":"apdu","payload":{"func":"'*)
			bridge_rest="${bridge_line#\{\"type\":\"apdu\",\"payload\":\{\"func\":\"}"
			BRIDGE_FUNC="${bridge_rest%%\"*}"
			bridge_rest="${bridge_rest#*\"}"
			case "$bridge_rest" in
				',"param":null}}') BRIDGE_PARAM="" ;;
				',"param":"'*)
					bridge_rest="${bridge_rest#,\"param\":\"}"
					BRIDGE_PARAM="${bridge_rest%%\"*}"
				;;
				*) return 1 ;;
			esac
			case "$BRIDGE_PARAM" in *[!0-9A-Fa-f]*) return 1 ;; esac
			BRIDGE_TYPE=apdu
			return 0
		;;
		'{"type":"http","payload":{"url":"'*)
			bridge_rest="${bridge_line#\{\"type\":\"http\",\"payload\":\{\"url\":\"}"
			BRIDGE_URL="${bridge_rest%%\"*}"
			bridge_rest="${bridge_rest#*\",\"tx\":}"
			case "$bridge_rest" in
				'"'*)
					bridge_rest="${bridge_rest#\"}"
					BRIDGE_TX="${bridge_rest%%\"*}"
					bridge_rest="${bridge_rest#*\"}"
				;;
				'null'*) BRIDGE_TX=""; bridge_rest="${bridge_rest#null}" ;;
				*) return 1 ;;
			esac
			case "$BRIDGE_TX" in *[!0-9A-Fa-f]*) return 1 ;; esac
			case "$bridge_rest" in
				',"headers":['*) BRIDGE_HEADERS="${bridge_rest#,\"headers\":\[}" ;;
				*) return 1 ;;
			esac
			BRIDGE_HEADERS="${BRIDGE_HEADERS%\]\}\}}"
			BRIDGE_TYPE=http
			return 0
		;;
		'{"type":"lpa","payload":{"code":'*)
			bridge_rest="${bridge_line#\{\"type\":\"lpa\",\"payload\":\{\"code\":}"
			BRIDGE_RESULT_CODE="${bridge_rest%%,*}"
			case "$BRIDGE_RESULT_CODE" in ''|*[!0-9-]*) return 1 ;; esac
			bridge_message_rest="${bridge_rest#*,\"message\":\"}"
			if [ "$bridge_message_rest" = "$bridge_rest" ]; then
				BRIDGE_RESULT_MESSAGE=unclassified
			else
				BRIDGE_RESULT_MESSAGE="${bridge_message_rest%%\"*}"
				# Only lpac's bounded machine-readable error token may enter a
				# diagnostic. Its raw result and data remain withheld because they
				# can contain profile or card material.
				case "$BRIDGE_RESULT_MESSAGE" in
					''|*[!A-Za-z0-9_.:-]*|?????????????????????????????????????????????????????????????????????????????????*)
						BRIDGE_RESULT_MESSAGE=unclassified
					;;
				esac
			fi
			BRIDGE_RESULT_DETAIL=""
			if [ "$BRIDGE_RESULT_CODE" != 0 ] && \
				[ "$BRIDGE_RESULT_MESSAGE" = es10b_load_bound_profile_package ]; then
				bridge_detail_rest="${bridge_message_rest#*,\"data\":\"}"
				if [ "$bridge_detail_rest" != "$bridge_message_rest" ]; then
					BRIDGE_RESULT_DETAIL="${bridge_detail_rest%%\"*}"
					# lpac emits two enum names here. Do not accept a free-form
					# server message or an identifier merely because it is data.
					case "$BRIDGE_RESULT_DETAIL" in
						''|*[!a-z0-9_,]*|?????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*)
							BRIDGE_RESULT_DETAIL=""
						;;
					esac
				fi
			fi
			BRIDGE_RESULT="$bridge_line"
			BRIDGE_TYPE=lpa
			return 0
		;;
		'{"type":"progress",'*|'{"type":"driver",'*)
			# Informational, and never forwarded to a consumer: the contract
			# withholds the LPA's raw output, so these are dropped rather than
			# logged verbatim.
			BRIDGE_TYPE=ignore
			return 0
		;;
	esac
	return 1
}

# One APDU operation, answered on the QMI UIM transport.
#
# The client holds the channel, so this layer keeps only the number, and it
# keeps it for the same reason the AT half does: lpac builds the class byte of
# every later APDU out of it.
bridge_answer_apdu_qmi() {
	case "$BRIDGE_FUNC" in
		connect)
			# The session already exists -- it was opened and answered `ready`
			# before this bridge run chose the transport -- so this is a
			# liveness check and not a probe of the card.
			if uim_exchange ping && [ "$UIM_REPLY" = ok ]; then
				printf '{"type":"apdu","payload":{"ecode":0}}\n'
			else
				printf '{"type":"apdu","payload":{"ecode":-1}}\n'
			fi
			return 0
		;;
		disconnect)
			printf '{"type":"apdu","payload":{"ecode":0}}\n'
			return 0
		;;
		logic_channel_open)
			[ -n "$BRIDGE_PARAM" ] || { printf '{"type":"apdu","payload":{"ecode":-1}}\n'; return 0; }
			if ! uim_exchange "open $BRIDGE_PARAM"; then
				log err 'the QMI card session stopped answering'
				printf '{"type":"apdu","payload":{"ecode":-1}}\n'
				return 0
			fi
			case "$UIM_REPLY" in
				'ok channel '*)
					bridge_channel="${UIM_REPLY#ok channel }"
					bridge_channel="${bridge_channel%% *}"
				;;
				*) bridge_channel="" ;;
			esac
			case "$bridge_channel" in
				''|*[!0-9]*)
					# `err qmi 26` here is a card with no ISD-R applet, which is
					# the correct answer for an eUICC in an inactive slot and not
					# a fault. The refusal is the same either way.
					printf '{"type":"apdu","payload":{"ecode":-1}}\n'
					return 0
				;;
			esac
			[ "$bridge_channel" -ge 1 ] && [ "$bridge_channel" -le 19 ] || {
				printf '{"type":"apdu","payload":{"ecode":-1}}\n'
				return 0
			}
			BRIDGE_CHANNEL="$bridge_channel"
			printf '{"type":"apdu","payload":{"ecode":%s}}\n' "$bridge_channel"
			return 0
		;;
		logic_channel_close)
			case "$BRIDGE_PARAM" in
				[0-9A-Fa-f][0-9A-Fa-f]) : ;;
				*) printf '{"type":"apdu","payload":{"ecode":-1}}\n'; return 0 ;;
			esac
			bridge_channel="$(printf '%d' "0x$BRIDGE_PARAM" 2>/dev/null || printf '')"
			case "$bridge_channel" in ''|*[!0-9]*) printf '{"type":"apdu","payload":{"ecode":-1}}\n'; return 0 ;; esac
			if uim_exchange "close $bridge_channel" && [ "$UIM_REPLY" = ok ]; then
				BRIDGE_CHANNEL=""
				printf '{"type":"apdu","payload":{"ecode":0}}\n'
			else
				printf '{"type":"apdu","payload":{"ecode":-1}}\n'
			fi
			return 0
		;;
		transmit)
			[ -n "$BRIDGE_PARAM" ] || { printf '{"type":"apdu","payload":{"ecode":-1}}\n'; return 0; }
			[ -n "$BRIDGE_CHANNEL" ] || { printf '{"type":"apdu","payload":{"ecode":-1}}\n'; return 0; }
			apdu_started=""
			read -r apdu_uptime apdu_ignored 2>/dev/null </proc/uptime && \
				apdu_started="${apdu_uptime%%.*}"
			if ! uim_exchange "transmit $BRIDGE_PARAM"; then
				log err "the card APDU transport stopped answering after a ${#BRIDGE_PARAM}-character request"
				printf '{"type":"apdu","payload":{"ecode":-1}}\n'
				return 0
			fi
			apdu_elapsed=unknown
			if [ -n "$apdu_started" ] && \
				read -r apdu_uptime apdu_ignored 2>/dev/null </proc/uptime; then
				apdu_elapsed=$(( ${apdu_uptime%%.*} - apdu_started ))
			fi
			case "$UIM_REPLY" in
				'ok data '*) bridge_data="${UIM_REPLY#ok data }" ;;
				*) bridge_data="" ;;
			esac
			case "$bridge_data" in
				''|*[!0-9A-Fa-f]*)
					# The client's own token and nothing else. Its vocabulary is
					# bounded on purpose -- usage, device, timeout, qmi,
					# protocol, state -- so this cannot become a channel for
					# card material to reach a log.
					uim_detail="${UIM_REPLY#err }"
					uim_detail="${uim_detail%% *}"
					case "$uim_detail" in
						usage|device|timeout|qmi|protocol|state) : ;;
						*) uim_detail=unclassified ;;
					esac
					log err "the card APDU transport failed over QMI after a ${#BRIDGE_PARAM}-character request and ${apdu_elapsed}s ($uim_detail)"
					printf '{"type":"apdu","payload":{"ecode":-1}}\n'
					return 0
				;;
			esac
			printf '{"type":"apdu","payload":{"ecode":0,"data":"%s"}}\n' "$bridge_data"
			return 0
		;;
	esac
	printf '{"type":"apdu","payload":{"ecode":-1}}\n'
	return 0
}

# One APDU operation, answered on the AT transport.
bridge_answer_apdu() {
	if [ "$BRIDGE_TRANSPORT" = qmi ]; then
		bridge_answer_apdu_qmi
		return 0
	fi
	case "$BRIDGE_FUNC" in
		connect)
			# Deliberately no `AT+CCHO=?`, `AT+CCHC=?` or `AT+CGLA=?` probe. The
			# allow list has already decided that this model supports the command
			# set, and a test-form probe of exactly that kind wedged a SIM
			# upstream until physical intervention. The port is proved to be a
			# command channel and nothing more is asked of the card.
			at_drain
			if at_exchange 'ATE0'; then :; fi
			if at_exchange 'AT'; then
				printf '{"type":"apdu","payload":{"ecode":0}}\n'
			else
				printf '{"type":"apdu","payload":{"ecode":-1}}\n'
			fi
			return 0
		;;
		disconnect)
			printf '{"type":"apdu","payload":{"ecode":0}}\n'
			return 0
		;;
		logic_channel_open)
			[ -n "$BRIDGE_PARAM" ] || { printf '{"type":"apdu","payload":{"ecode":-1}}\n'; return 0; }
			at_status=0
			at_exchange "AT+CCHO=\"$BRIDGE_PARAM\"" || at_status=$?
			if [ "$at_status" -ne 0 ]; then
				# `+CME ERROR: 100` here is not a fault. On a modem whose eUICC
				# sits in an inactive slot there is no ISD-R applet on the card
				# the modem is talking to, and refusing is the correct answer.
				printf '{"type":"apdu","payload":{"ecode":-1}}\n'
				return 0
			fi
			bridge_channel="$(at_parse_channel "$(at_reply_line 1)")" || {
				printf '{"type":"apdu","payload":{"ecode":-1}}\n'
				return 0
			}
			BRIDGE_CHANNEL="$bridge_channel"
			printf '{"type":"apdu","payload":{"ecode":%s}}\n' "$bridge_channel"
			return 0
		;;
		logic_channel_close)
			# The parameter is one byte: the channel number, in hex.
			case "$BRIDGE_PARAM" in
				[0-9A-Fa-f][0-9A-Fa-f]) : ;;
				*) printf '{"type":"apdu","payload":{"ecode":-1}}\n'; return 0 ;;
			esac
			bridge_channel="$(printf '%d' "0x$BRIDGE_PARAM" 2>/dev/null || printf '')"
			case "$bridge_channel" in ''|*[!0-9]*) printf '{"type":"apdu","payload":{"ecode":-1}}\n'; return 0 ;; esac
			if at_exchange "AT+CCHC=$bridge_channel"; then
				BRIDGE_CHANNEL=""
				printf '{"type":"apdu","payload":{"ecode":0}}\n'
			else
				printf '{"type":"apdu","payload":{"ecode":-1}}\n'
			fi
			return 0
		;;
		transmit)
			[ -n "$BRIDGE_PARAM" ] || { printf '{"type":"apdu","payload":{"ecode":-1}}\n'; return 0; }
			[ -n "$BRIDGE_CHANNEL" ] || { printf '{"type":"apdu","payload":{"ecode":-1}}\n'; return 0; }
			at_status=0
			# How long the modem thought before answering, read from
			# /proc/uptime through a builtin redirect so it costs no process --
			# this runs once per APDU and a Bound Profile Package is hundreds of
			# them. Whole seconds are enough for the only question being asked:
			# a modem that refuses a command it will not parse answers at once,
			# while one whose own patience with a busy card ran out answers
			# after a fixed delay. The distinction decides whether the refusal
			# that ends every profile load here is ours to fix at all.
			apdu_started=""
			read -r apdu_uptime apdu_ignored 2>/dev/null </proc/uptime && \
				apdu_started="${apdu_uptime%%.*}"
			at_exchange "AT+CGLA=$BRIDGE_CHANNEL,${#BRIDGE_PARAM},\"$BRIDGE_PARAM\"" || at_status=$?
			if [ "$at_status" -ne 0 ]; then
				apdu_elapsed=unknown
				if [ -n "$apdu_started" ] && \
					read -r apdu_uptime apdu_ignored 2>/dev/null </proc/uptime; then
					apdu_elapsed=$(( ${apdu_uptime%%.*} - apdu_started ))
				fi
				# The request's hex length and the modem's own status line, and
				# nothing else. A refused exchange during a profile install is
				# the one place where the size of the command matters -- an AT
				# line the modem will not accept looks exactly like a card that
				# refused -- and the content is card material either way.
				at_failure_detail="$AT_STATUS_LINE"
				case "$at_failure_detail" in
					''|*[!A-Za-z0-9\ :+,-]*|??????????????????????????????????*)
						at_failure_detail=unclassified
					;;
				esac
				log err "the card APDU transport failed with status $at_status after a ${#BRIDGE_PARAM}-character request and ${apdu_elapsed}s ($at_failure_detail)"
				printf '{"type":"apdu","payload":{"ecode":-1}}\n'
				return 0
			fi
			bridge_data="$(at_parse_cgla "$(at_reply_line 1)")" || {
				log err 'the card APDU response framing was invalid'
				printf '{"type":"apdu","payload":{"ecode":-1}}\n'
				return 0
			}
			printf '{"type":"apdu","payload":{"ecode":0,"data":"%s"}}\n' "$bridge_data"
			return 0
		;;
	esac
	printf '{"type":"apdu","payload":{"ecode":-1}}\n'
	return 0
}

# ---- the HTTP side of the bridge ----
#
# The HTTPS request to an SM-DP+ is this project's, not the LPA's. lpac's own
# curl backend set CURLOPT_SSL_VERIFYPEER and CURLOPT_SSL_VERIFYHOST to zero on
# every request with no way to re-enable them, so it is not built at all — and
# the normal path below verifies against both OpenWrt's public web roots and the
# packaged live Consumer CI roots. A download may retry one exact authority
# without transport verification only after an unknown-issuer failure and an
# explicit per-operation choice. Hostname, time and all other certificate
# failures remain refusals, and the choice is neither default nor remembered.
#
# RSP is not naked without TLS — the eUICC authenticates the SM-DP+ against the
# GSMA CI chain and the profile package is bound to that eUICC — but the ES9+
# request bodies carry the activation code, the matching ID and the confirmation
# code. Fixing the argv leak while leaving the transport unverified would move
# the secret out of the process list and hand it to the network.

# Hex to bytes, in chunks, appended to a file. Chunked because a Bound Profile
# Package is tens of kilobytes and the escaped form of one whole is far past
# what an argument list will hold — which is a C3 problem written into C2's
# code because the alternative is discovering it during a download.
hex_to_file() {
	hex_rest="$1"
	hex_target="$2"
	: >"$hex_target" || return 1
	case "$hex_rest" in *[!0-9A-Fa-f]*) return 1 ;; esac
	[ $(( ${#hex_rest} % 2 )) -eq 0 ] || return 1
	while [ -n "$hex_rest" ]; do
		hex_chunk="$(printf '%s' "$hex_rest" | cut -c1-2048)"
		hex_rest="$(printf '%s' "$hex_rest" | cut -c2049-)"
		printf '%b' "$(printf '%s' "$hex_chunk" | sed 's/../\\x&/g')" >>"$hex_target" || return 1
	done
	return 0
}

file_to_hex() {
	[ -f "$1" ] || { printf ''; return 0; }
	hexdump -v -e '/1 "%02x"' "$1" 2>/dev/null || return 1
}

# An ES9+ failure response can contain identifiers and free-form provider text.
# Keep those private, but retain the two short numeric status codes SGP.22
# defines for support diagnostics. Anything outside their narrow grammar is
# discarded rather than copied into the log.
log_es9_failure_codes() {
	[ -s "$HTTP_REPLY_FILE" ] || return 0
	command_exists jsonfilter || return 0
	es9_status="$(jsonfilter -i "$HTTP_REPLY_FILE" \
		-e '@.header.functionExecutionStatus.status' 2>/dev/null || :)"
	[ "$es9_status" = Failed ] || return 0
	es9_subject="$(jsonfilter -i "$HTTP_REPLY_FILE" \
		-e '@.header.functionExecutionStatus.statusCodeData.subjectCode' 2>/dev/null || :)"
	es9_reason="$(jsonfilter -i "$HTTP_REPLY_FILE" \
		-e '@.header.functionExecutionStatus.statusCodeData.reasonCode' 2>/dev/null || :)"
	case "$es9_subject" in ''|*[!0-9.]*|?????????????????????????????????*) es9_subject=unknown ;; esac
	case "$es9_reason" in ''|*[!0-9.]*|?????????????????????????????????*) es9_reason=unknown ;; esac
	log err "the SM-DP+ rejected an ES9+ request (subject code $es9_subject, reason code $es9_reason)"
	return 0
}

# One header string out of the JSON array lpac sends. The array is a list of
# complete `Name: value` strings, so each is passed to the narrow client as one
# --header argument and nothing here composes a header out of parts.
bridge_answer_http() {
	# https only, and the scheme is checked before anything is spent on the
	# request. A plain-http SM-DP+ address is not a downgrade to tolerate.
	case "$BRIDGE_URL" in
		https://*) : ;;
		*)
			BRIDGE_HTTP_FAILURE=scheme
			log err 'refusing a bridge HTTP request that is not https'
			printf '{"type":"http","payload":{"rcode":0,"rx":""}}\n'
			return 0
		;;
	esac
	[ -x "$HTTP_CLIENT" ] || {
		BRIDGE_HTTP_FAILURE=unavailable
		log err 'no HTTP client is installed; the bridge cannot make the request'
		printf '{"type":"http","payload":{"rcode":0,"rx":""}}\n'
		return 0
	}
	hex_to_file "$BRIDGE_TX" "$HTTP_BODY_FILE" || {
		BRIDGE_HTTP_FAILURE=malformed
		printf '{"type":"http","payload":{"rcode":0,"rx":""}}\n'
		return 0
	}
	# Headers, one --header each, rebuilt from the JSON array by splitting on the
	# separator between quoted strings. A header carrying an escaped quote or a
	# backslash is refused rather than unescaped by hand.
	set --
	headers_rest="$BRIDGE_HEADERS"
	while [ -n "$headers_rest" ]; do
		case "$headers_rest" in
			'"'*) headers_rest="${headers_rest#\"}" ;;
			,*) headers_rest="${headers_rest#,}"; continue ;;
			*) break ;;
		esac
		header_value="${headers_rest%%\"*}"
		headers_rest="${headers_rest#*\"}"
		case "$header_value" in
			*\\*)
				BRIDGE_HTTP_FAILURE=malformed
				log err 'refusing a bridge HTTP header this parser will not reproduce exactly'
				printf '{"type":"http","payload":{"rcode":0,"rx":""}}\n'
				return 0
			;;
		esac
		set -- "$@" --header "$header_value"
	done
	set -- --timeout "$HTTP_TIMEOUT_SECONDS" --output "$HTTP_REPLY_FILE" \
		"$@" --data "$HTTP_BODY_FILE" -- "$BRIDGE_URL"
	http_status=0
	run_bounded_to_file "$HTTP_TIMEOUT_SECONDS" "$HTTP_HEADER_FILE" \
		"$HTTP_CLIENT" "$@" || http_status=$?
	# Only an unknown issuer is eligible. The verified handshake fails before
	# the request body is sent, so this retry is the first disclosure of it.
	bridge_retry_eligible=0
	case "$OPERATION_ACTION" in download|notification-send) bridge_retry_eligible=1 ;; esac
	if [ "$http_status" -eq 60 ] && [ "$bridge_retry_eligible" -eq 1 ] && \
		[ "$CAPTURED_ALLOW_UNVERIFIED_TRANSPORT" = 1 ]; then
		bridge_authority="${BRIDGE_URL#https://}"
		bridge_authority="${bridge_authority%%/*}"
		bridge_authority="${bridge_authority%%\?*}"
		if [ -z "$BRIDGE_UNVERIFIED_AUTHORITY" ] || \
			[ "$BRIDGE_UNVERIFIED_AUTHORITY" = "$bridge_authority" ]; then
			BRIDGE_UNVERIFIED_AUTHORITY="$bridge_authority"
			BRIDGE_TRANSPORT_SECURITY=unverified
			rm -f "$HTTP_REPLY_FILE" "$HTTP_HEADER_FILE"
			http_status=0
			run_bounded_to_file "$HTTP_TIMEOUT_SECONDS" "$HTTP_HEADER_FILE" \
				"$HTTP_CLIENT" --unverified-transport "$@" || http_status=$?
		else
			BRIDGE_HTTP_FAILURE=authority_changed
		fi
	fi
	if [ "$http_status" -ne 0 ]; then
		if [ -z "$BRIDGE_HTTP_FAILURE" ]; then
			case "$http_status" in
				60) BRIDGE_HTTP_FAILURE=tls_untrusted_issuer ;;
				61) BRIDGE_HTTP_FAILURE=tls_hostname ;;
				62) BRIDGE_HTTP_FAILURE=tls_time ;;
				63) BRIDGE_HTTP_FAILURE=tls_revoked ;;
				64) BRIDGE_HTTP_FAILURE=tls_verification ;;
				65) BRIDGE_HTTP_FAILURE=trust_store ;;
				66) BRIDGE_HTTP_FAILURE=tls_chain_unparseable ;;
				*) BRIDGE_HTTP_FAILURE=tls_or_transport ;;
			esac
		fi
		log err "the bridge HTTP request failed with status $http_status"
		printf '{"type":"http","payload":{"rcode":0,"rx":""}}\n'
		rm -f "$HTTP_BODY_FILE" "$HTTP_REPLY_FILE" "$HTTP_HEADER_FILE"
		return 0
	fi
	if [ "$BRIDGE_TRANSPORT_SECURITY" != unverified ]; then
		BRIDGE_TRANSPORT_SECURITY=verified
	fi
	log_es9_failure_codes
	http_code="$(tr -dc '0-9' <"$HTTP_HEADER_FILE" 2>/dev/null || :)"
	case "$http_code" in ''|*[!0-9]*) http_code=0 ;; esac
	http_hex="$(file_to_hex "$HTTP_REPLY_FILE" || printf '')"
	rm -f "$HTTP_BODY_FILE" "$HTTP_REPLY_FILE" "$HTTP_HEADER_FILE"
	printf '{"type":"http","payload":{"rcode":%s,"rx":"%s"}}\n' "$http_code" "$http_hex"
	return 0
}

# ---- driving the LPA across the bridge ----
#
# The LPA is started by `lpac-run`, never directly: every refusal C1 established
# lives in that launcher, and calling the binary would walk around all of them.
# lpac connects to the card before it parses its own subcommand, so by the time
# the process exists it is too late to decide anything.
#
# Two FIFOs rather than one pipe pair, because a POSIX shell has no coprocess.
# The open order matters: the child is started first and blocks opening its
# standard input, this process opening the write end releases it, the child then
# blocks opening its standard output, and this process opening the read end
# releases that. Reversing the order deadlocks both.
#
# LPA_RESULT holds the one `lpa` line the LPA finished with. Its raw text never
# reaches a consumer: the contract withholds the LPA's own output, and what is
# published is built from allowlisted fields.
LPA_RESULT=""
LPA_EXIT_STATUS=0

# The port that answered last, for the life of this process.
#
# An operation is several LPA invocations and each one used to rediscover the
# control port from scratch, paying the probe for every silent port before it,
# every time. Which port answers cannot change while the modem stays attached,
# so the last answer is tried first. It is not trusted: it is still probed like
# any other candidate, and a modem that came back on different ports simply
# fails that probe and the full list is walked as before. Deliberately in
# memory and deliberately not written anywhere -- a remembered port that
# outlived an attachment generation would be a claim about hardware rather than
# an ordering hint.
BRIDGE_LAST_DEVICE=""

BRIDGE_KEEP_TRANSPORT=0
BRIDGE_IDENTITY_FAILED=0

# Whether the last attempt reached a port that answered at all.
#
# A candidate that never answered is not evidence about a card, and the two were
# reported identically: a walk in which one AT-speaking port gave a verdict and
# the rest said nothing was published as that verdict, with no sign that most of
# the modem had been silent. On the reference FM350-GL that is the difference
# between "this card refuses" and "the one port that routes APDUs was not
# reached this time" -- measured 2026-09-09, where the port that opens ISD-R
# answers `AT+CGMM` in under a second and then, for tens of seconds at a
# stretch, answers nothing. The silence reproduces outside this package with the
# same open and the same reads, so it is the modem's and not this reader's.
BRIDGE_PORT_ANSWERED=0
# How long to keep re-walking a candidate list whose ports were merely silent.
# Re-asking a read-only control probe changes nothing on a card, one walk of the
# reference modem's six ports costs under a minute, and the operation's declared
# probe budget is several times that -- so a silence that passes is paid for
# out of a budget the operation already announced, and a silence that does not
# is reported as itself.
ESIM_PORT_SILENCE_RETRY_SECONDS="60"

# A modem may expose more than one port that answers ordinary AT commands while
# only one of them routes logical-channel commands to the active card. The
# FM350-GL does exactly that: both ports answer CGMM, but only the bearer's port
# opens ISD-R. A control-port probe therefore proves that a node is safe to ask;
# it does not prove that this node is the card transport.
#
# Try the read-only LPA exchange on each candidate until one establishes a card
# session. A meaningful card verdict stops the search. A missing verdict or
# `euicc_init` does not: those are also the observable result of choosing an
# AT-speaking port that has no route to the card. Mutations still run exactly
# once -- bridge_run() uses this only for their read-only identity preflight and
# retains the successful transport for the subsequent command.
bridge_run_candidates() {
	candidate_endpoint="$1"
	candidate_owner="$2"
	candidate_ports="$3"
	candidate_bearer="$4"
	shift 4

	# The mutation immediately following a successful identity preflight must
	# stay on that same open, locked transport. There is nothing to select again.
	if [ "$BRIDGE_KEEP_TRANSPORT" -eq 1 ] && [ "$TRANSPORT_LOCK_HELD" -eq 1 ]; then
		bridge_run_raw "$candidate_endpoint" "$candidate_owner" "$candidate_ports" \
			"$candidate_bearer" "$@"
		return $?
	fi

	candidate_order="$candidate_ports"
	if [ -n "$BRIDGE_LAST_DEVICE" ]; then
		case " $candidate_ports " in
			*" $BRIDGE_LAST_DEVICE "*)
				candidate_order="$BRIDGE_LAST_DEVICE"
				for candidate_item in $candidate_ports; do
					[ "$candidate_item" = "$BRIDGE_LAST_DEVICE" ] || \
						candidate_order="$candidate_order $candidate_item"
				done
			;;
		esac
	fi

	candidate_status=3
	candidate_reason=""
	candidate_total=0
	for candidate_item in $candidate_order; do
		candidate_total=$((candidate_total + 1))
	done

	# A walk that ended only because ports were silent has not asked the card
	# anything, so it is worth asking again before saying anything about a card.
	# The budget is wall-clock rather than a pass count: what is being waited out
	# is an episode of the modem's, and a walk of six silent ports costs a
	# different amount on different hardware. A clock that cannot be read at all
	# leaves exactly one walk, which is the behaviour this replaces.
	# Only an operation that has already interrupted something may spend time
	# waiting out a silence. A read verb answers a page inside a deadline of a
	# few seconds and must keep failing closed at it; stretching *that* to wait
	# for a port would turn a bounded read into an unbounded one, which is a
	# worse defect than the one being fixed. The two markers are exactly the
	# operations that stopped a bearer or took an inhibit for this, and they are
	# the ones whose declared worst case is minutes rather than seconds.
	candidate_deadline=""
	if [ "${CARD_BEARER_RELEASED:-0}" -eq 1 ] || \
		[ "${TAKEOVER_INHIBIT_CREATED:-0}" -eq 1 ]; then
		candidate_started="$(monotonic_seconds 2>/dev/null || :)"
		case "$candidate_started" in
			''|*[!0-9]*) candidate_started="" ;;
			*) candidate_deadline=$((candidate_started + ESIM_PORT_SILENCE_RETRY_SECONDS)) ;;
		esac
	fi
	candidate_answered=0
	candidate_silent=0
	while :; do
	candidate_answered=0
	candidate_silent=0
	candidate_index=0
	for candidate_item in $candidate_order; do
		candidate_index=$((candidate_index + 1))
		BRIDGE_RESULT_MESSAGE=""
		candidate_status=0
		bridge_run_raw "$candidate_endpoint" "$candidate_owner" "$candidate_item" \
			"$candidate_bearer" "$@" || candidate_status=$?
		[ "$candidate_status" -ne 0 ] || return 0
		# Whether this node said anything at all, which is a different fact from
		# what it said. Counted before any early return, because a walk that
		# stops on a verdict still has to say how much of the modem it reached.
		if [ "$BRIDGE_PORT_ANSWERED" -eq 1 ]; then
			candidate_answered=$((candidate_answered + 1))
		else
			candidate_silent=$((candidate_silent + 1))
		fi
		# QMI UIM is itself the card service. Its refusal is a card verdict, not
		# evidence that another device node might route the same request better.
		# The ambiguity measured on FM350 exists only between AT-speaking ttys.
		[ "$BRIDGE_TRANSPORT" = at ] || return "$candidate_status"
		# Exit 4 is this layer's policy refusal (unknown bearer, unsupported
		# ownership, missing bounded-read capability). A different port cannot
		# repair a permission that was never granted, so never search around it.
		[ "$candidate_status" -ne 4 ] || return "$candidate_status"

		case "$BRIDGE_RESULT_MESSAGE" in
			''|euicc_init)
				[ -n "$candidate_reason" ] || candidate_reason="$BRIDGE_RESULT_MESSAGE"
			;;
			*) return "$candidate_status" ;;
		esac
		[ "$candidate_index" -lt "$candidate_total" ] || break
		log notice 'an AT candidate did not establish a card session; trying the next candidate'

		# A mutation identity preflight keeps a successful transport open. This
		# attempt was not successful, so close and unlock it before trying another
		# physical node; no two transport locks are ever held together.
		if [ "$BRIDGE_KEEP_TRANSPORT" -eq 1 ]; then
			at_close_port
			uim_close_client
			release_read_locks
		fi
	done
	# Said where it is evidence and nowhere else: an operation that paid for
	# exclusive access has to record how much of the modem it actually reached.
	[ -z "$candidate_deadline" ] || \
		log notice "$candidate_answered of $candidate_total control ports answered"
	[ "$candidate_silent" -gt 0 ] || break
	[ -n "$candidate_deadline" ] || break
	candidate_now="$(monotonic_seconds 2>/dev/null || :)"
	case "$candidate_now" in ''|*[!0-9]*) break ;; esac
	[ "$candidate_now" -lt "$candidate_deadline" ] || break
	log notice 'a candidate port said nothing; asking the silent ports again'
	"$SLEEP" 2 2>/dev/null || break
	done

	# What to call a walk that found no card. A port that never answered is not
	# a card refusing: reporting it as one is what sent a hardware review to the
	# wrong hypothesis, so the two are named apart even though neither is a
	# success. Nothing answering is already `card-unreachable`, whose sentence
	# ("no port that could carry the question answered") is exactly this and
	# needs no second word for it. The gap in the vocabulary was the walk that
	# reached part of the modem: a verdict from one port while others said
	# nothing is not a verdict about the card, and `card-search-incomplete` is
	# the name for that and keeps the LPA's step out of the answer.
	if [ "$candidate_answered" -eq 0 ]; then
		BRIDGE_RESULT_MESSAGE=card-unreachable
	elif [ "$candidate_silent" -gt 0 ]; then
		BRIDGE_RESULT_MESSAGE=card-search-incomplete
	else
		[ -n "$BRIDGE_RESULT_MESSAGE" ] || BRIDGE_RESULT_MESSAGE="$candidate_reason"
	fi
	return "$candidate_status"
}

bridge_run() {
	case "${5:-} ${6:-}" in
		'profile download'|'profile nickname'|'profile enable'|'profile disable'|'profile delete'|\
		'notification process'|'notification remove') ;;
		*) bridge_run_candidates "$@"; return $? ;;
	esac
	# Identity belongs to the actual card session, not to the display cache.
	# Keep the same open device and transport/endpoint locks between chip info
	# and the command. A reconnect or a later command must prove identity again.
	case "$1" in eid:*) : ;; *) return "$EXIT_BLOCKED" ;; esac
	[ "$MODEM_LOCK_HELD" -eq 1 ] && \
		{ [ "$APN_LOCK_HELD" -eq 1 ] || [ "$APN_LOCK_BORROWED" -eq 1 ]; } || return "$EXIT_BLOCKED"
	BRIDGE_KEEP_TRANSPORT=1
	BRIDGE_IDENTITY_FAILED=1
	verified_bridge_status=0
	bridge_run_candidates "$1" "$2" "$3" "$4" chip info || verified_bridge_status=$?
	if [ "$verified_bridge_status" -eq 0 ]; then
		verified_card_data="$(lpa_result_data 2>/dev/null || :)"
		verified_card_eid="$(normalise_eid "$(json_query "$verified_card_data" '@.eidValue')" 2>/dev/null || :)"
		verified_card_handle="$(endpoint_handle_from_eid "$verified_card_eid" 2>/dev/null || :)"
		verified_card_eid=""
		verified_card_data=""
		if [ "$verified_card_handle" != "$1" ]; then
			verified_bridge_status="$EXIT_BLOCKED"
			OPERATION_REASON=endpoint_identity_changed
			BRIDGE_RESULT_MESSAGE='the selected card identity could not be confirmed; no change was sent'
			rm -f "$(identity_record_path "$REQUESTED_MODEM")"
			cache_invalidate_endpoint "$1"
		fi
	fi
	if [ "$verified_bridge_status" -eq 0 ]; then
		BRIDGE_IDENTITY_FAILED=0
		# Arm before dispatch, but not before the read-only identity preflight.
		OPERATION_MUTATE_STARTED=1
		bridge_run_raw "$@" || verified_bridge_status=$?
	else
		[ "$OPERATION_REASON" = endpoint_identity_changed ] || OPERATION_REASON=endpoint_identity_unverified
	fi
	BRIDGE_KEEP_TRANSPORT=0
	cleanup_bridge
	release_read_locks
	return "$verified_bridge_status"
}

bridge_run_raw() {
	# $1 endpoint, $2 owner, $3 the candidate control ports in preference
	# order, $4 the device the bearer holds, then the LPA's own arguments.
	#
	# The bearer device is passed on even though this transport opens nothing:
	# `lpac-run` refuses a `netifd-direct` caller that has not named it, so that
	# the separate-port rule can be checked rather than asserted. Leaving it out
	# would make every netifd-direct read fail at the launcher.
	bridge_endpoint="$1"
	bridge_owner="$2"
	bridge_candidates="$3"
	bridge_bearer="$4"
	shift 4
	bridge_device=""
	[ "$TRANSPORT_LOCK_HELD" -eq 1 ] || BRIDGE_TRANSPORT=at
	LPA_RESULT=""
	LPA_EXIT_STATUS=0
	BRIDGE_CHANNEL=""
	BRIDGE_HTTP_FAILURE=""
	BRIDGE_TRANSPORT_SECURITY=""
	BRIDGE_RESULT_CODE=""
	BRIDGE_RESULT_MESSAGE=""
	BRIDGE_RESULT_DETAIL=""
	# BRIDGE_UNVERIFIED_AUTHORITY is deliberately not reset here. The consent is
	# given per operation, and an operation is now several LPA invocations: the
	# profile fetch and then the notification that tells the same SM-DP+ what
	# became of it. Resetting per invocation would either strand every consented
	# download with an undeliverable notification -- the exact divergence this
	# project must not cause -- or let each invocation pick its own authority to
	# downgrade to. Pinned across the operation, a second host is refused.

	[ -x "$LPAC_RUN" ] || {
		log err "the pinned LPA launcher is not installed at $LPAC_RUN"
		return 4
	}
	# Levels 3 and 4, in that order, and nothing above them. A read-only eUICC
	# transaction that starts no coordinator operation and needs no ownership
	# or slot change takes exactly these, as a read-only AT identity
	# transaction already takes the port lock alone. Requiring the system-wide
	# global lock for a read would report the eSIM area of one modem busy
	# whenever anything at all was running on the other.
	if [ "$BRIDGE_KEEP_TRANSPORT" -eq 1 ] && [ "$TRANSPORT_LOCK_HELD" -eq 1 ]; then
		bridge_device="${BRIDGE_LAST_DEVICE#qmi:}"
	else
		acquire_endpoint_lock "$bridge_endpoint" "$LOCK_WAIT_SECONDS" || {
			log err "another operation holds endpoint $bridge_endpoint"
			return 3
		}
		at_read_timeout_supported || {
			log err 'this shell cannot bound a read; refusing to open a card channel without one'
			release_read_locks
			return 4
		}
		# Which of the candidate ports is actually the control channel.
		#
		# A modem presents several ttys and only some of them answer: the RM520N-GL
		# on the reference router offers four and replies on two. The read path may
		# not probe -- it publishes a candidate, not a verdict -- so the choice is
		# made here, where a lock is held and a bound is armed, and it is made by
		# asking rather than by taking the lowest port number.
		if [ -n "$BRIDGE_LAST_DEVICE" ]; then
			case " $bridge_candidates " in
				*" $BRIDGE_LAST_DEVICE "*)
					bridge_reordered="$BRIDGE_LAST_DEVICE"
					for bridge_try in $bridge_candidates; do
						[ "$bridge_try" = "$BRIDGE_LAST_DEVICE" ] || \
							bridge_reordered="$bridge_reordered $bridge_try"
					done
					bridge_candidates="$bridge_reordered"
				;;
			esac
		fi
		bridge_found=0
		BRIDGE_PORT_ANSWERED=0
		for bridge_try in $bridge_candidates; do
			# A `qmi:` token names the modem's control device; a bare path is an AT
			# port. The lock is taken in the namespace that transport's existing
			# reader already uses -- the AT identity reader for a tty, the QMI
			# identity transaction for a control device -- because a second
			# namespace at the same node would exclude nothing.
			bridge_kind=at
			bridge_node="$bridge_try"
			case "$bridge_try" in
				qmi:*) bridge_kind=qmi; bridge_node="${bridge_try#qmi:}" ;;
			esac
			acquire_transport_lock "$bridge_kind" "$bridge_node" "$LOCK_WAIT_SECONDS" || {
				# A control channel is effectively exclusive: a reader that waits,
				# fails and proceeds anyway corrupts both its own reply stream and
				# the holder's. Another component holding this one is not a reason
				# to skip to the next: it is a reason to stop.
				log err "another component holds $bridge_node"
				release_read_locks
				return 3
			}
			if [ "$bridge_kind" = qmi ]; then
				if uim_open_client "$bridge_node"; then
					bridge_device="$bridge_node"
					BRIDGE_LAST_DEVICE="$bridge_try"
					BRIDGE_TRANSPORT=qmi
					bridge_found=1
					break
				fi
				uim_close_client
			elif at_open_port "$bridge_node" && at_probe_control_port; then
				bridge_device="$bridge_node"
				BRIDGE_LAST_DEVICE="$bridge_try"
				BRIDGE_TRANSPORT=at
				bridge_found=1
				break
			else
				at_close_port
			fi
			release_read_locks
			acquire_endpoint_lock "$bridge_endpoint" "$LOCK_WAIT_SECONDS" || {
				log err "another operation holds endpoint $bridge_endpoint"
				return 3
			}
		done
		if [ "$bridge_found" -ne 1 ]; then
			log err 'no candidate control port answered'
			release_read_locks
			return 3
		fi
		BRIDGE_PORT_ANSWERED=1
	fi
	# Which transport this operation actually used. It is not a diagnostic: a
	# hardware record has to quote it, the two paths report a failing card
	# differently, and "which one answered" is the first question asked of any
	# eSIM operation that behaved unexpectedly. The device is named because
	# there can be several and the choice is made per run.
	log notice "card transport $BRIDGE_TRANSPORT on $bridge_device"
	( umask 077 && mkdir -p "$STATE_DIR/bridge" ) || { cleanup_bridge; release_read_locks; return 3; }
	BRIDGE_RUN_DIR="$STATE_DIR/bridge/$SELF_PID"
	( umask 077 && mkdir "$BRIDGE_RUN_DIR" ) || {
		BRIDGE_RUN_DIR=""; cleanup_bridge; release_read_locks; return 3
	}
	( umask 077 && mkfifo "$BRIDGE_RUN_DIR/to-lpa" ) || { cleanup_bridge; release_read_locks; return 3; }
	( umask 077 && mkfifo "$BRIDGE_RUN_DIR/from-lpa" ) || { cleanup_bridge; release_read_locks; return 3; }
	BRIDGE_LPAC_PID_FILE="$BRIDGE_RUN_DIR/lpa-child.pid"
	: >"$BRIDGE_LPAC_PID_FILE" || { cleanup_bridge; release_read_locks; return 3; }
	exec 4>"$BRIDGE_LPAC_PID_FILE" || { cleanup_bridge; release_read_locks; return 3; }

	# Descriptor 8 is this process's card channel and is closed in the child:
	# the LPA has no business holding the port, and inheriting it would leave a
	# second writer on a tty whose whole protocol is one exchange at a time.
	# Two branches rather than an argument list assembled by hand: a launcher
	# invocation is the one place where getting the arguments subtly wrong
	# silently disables a refusal, so each shape is written out in full.
	# The protected descriptor belongs to the one invocation that needs it.
	#
	# A download is several LPA invocations now -- the pending notifications
	# before and after it, then one delivery and one removal per notification --
	# and the descriptor was being named to all of them. That is wrong twice
	# over: it widens a secret's reach past its only consumer, which is the
	# thing C1's whole ladder exists to prevent, and the channel is a one-shot
	# pipe, so the first reader drains what the download still needs. It was
	# latent only because a download used to make exactly one invocation.
	#
	# For everything else the descriptor is closed rather than merely left
	# unnamed, so an invocation that has no business with the activation code
	# cannot reach it at all. Each redirection shape is written out in full,
	# because a redirection cannot be built out of a variable and a clever
	# construction that hid one of these would hide a refusal.
	bridge_wants_secret=0
	[ "$1 ${2:-}" != 'profile download' ] || bridge_wants_secret=1
	bridge_secret_fd_saved="${APN_AUTOCONFIG_LPAC_SECRET_FD:-}"
	[ "$bridge_wants_secret" -eq 1 ] || unset APN_AUTOCONFIG_LPAC_SECRET_FD
	if [ "$bridge_owner" = netifd-direct ]; then
		[ -n "$bridge_bearer" ] || {
			# The launcher refuses this too. Refusing here says why: a bearer
			# whose control port is unknown cannot be shown to be a different
			# port from the one we are about to open, and "probably different"
			# is not evidence.
			log err 'the bearer device is unknown; refusing to open a channel beside it'
			cleanup_bridge
			release_read_locks
			return 4
		}
		if [ "$bridge_wants_secret" -eq 1 ]; then
			"$LPAC_RUN" --child-pid-fd 4 --transport stdio --owner "$bridge_owner" \
				--bearer-device "$bridge_bearer" --timeout "$LPA_TIMEOUT_SECONDS" -- "$@" \
				<"$BRIDGE_RUN_DIR/to-lpa" >"$BRIDGE_RUN_DIR/from-lpa" 2>/dev/null 3>&- 8<&- 9<&- &
		else
			"$LPAC_RUN" --child-pid-fd 4 --transport stdio --owner "$bridge_owner" \
				--bearer-device "$bridge_bearer" --timeout "$LPA_TIMEOUT_SECONDS" -- "$@" \
				<"$BRIDGE_RUN_DIR/to-lpa" >"$BRIDGE_RUN_DIR/from-lpa" 2>/dev/null 3>&- 8<&- 9<&- 5<&- &
		fi
	else
		if [ "$bridge_wants_secret" -eq 1 ]; then
			"$LPAC_RUN" --child-pid-fd 4 --transport stdio --owner "$bridge_owner" \
				--timeout "$LPA_TIMEOUT_SECONDS" -- "$@" \
				<"$BRIDGE_RUN_DIR/to-lpa" >"$BRIDGE_RUN_DIR/from-lpa" 2>/dev/null 3>&- 8<&- 9<&- &
		else
			"$LPAC_RUN" --child-pid-fd 4 --transport stdio --owner "$bridge_owner" \
				--timeout "$LPA_TIMEOUT_SECONDS" -- "$@" \
				<"$BRIDGE_RUN_DIR/to-lpa" >"$BRIDGE_RUN_DIR/from-lpa" 2>/dev/null 3>&- 8<&- 9<&- 5<&- &
		fi
	fi
	BRIDGE_CHILD_PID=$!
	if [ -n "$bridge_secret_fd_saved" ]; then
		APN_AUTOCONFIG_LPAC_SECRET_FD="$bridge_secret_fd_saved"
		export APN_AUTOCONFIG_LPAC_SECRET_FD
	fi
	{ exec 4>&-; } 2>/dev/null || :
	# Armed before the first open, not after both: a signal between the two
	# would otherwise leave a descriptor nothing admits to holding.
	BRIDGE_FIFO_FD_OPEN=1
	exec 6>"$BRIDGE_RUN_DIR/to-lpa" || { cleanup_bridge; release_read_locks; return 3; }
	exec 7<"$BRIDGE_RUN_DIR/from-lpa" || { cleanup_bridge; release_read_locks; return 3; }

	bridge_status=0
	while IFS= read -t "$LPA_TIMEOUT_SECONDS" -r bridge_message <&7; do
		if ! bridge_parse_line "$bridge_message"; then
			# A malformed or truncated line is a failed read, never a guess.
			# There is no recovery that does not involve inventing what the LPA
			# meant, and an APDU exchange invented from a damaged message is
			# sent to a card.
			log err 'the LPA sent a message this bridge will not interpret'
			bridge_status=3
			break
		fi
		case "$BRIDGE_TYPE" in
			apdu) bridge_answer_apdu >&6 || { bridge_status=3; break ;} ;;
			http) bridge_answer_http >&6 || { bridge_status=3; break ;} ;;
			lpa) LPA_RESULT="$BRIDGE_RESULT" ;;
			ignore) : ;;
		esac
	done
	bridge_read_status=$?
	# A `read` that ends because the child went away is an ordinary end of
	# exchange; one that ends on its own bound is not.
	if [ "$bridge_status" -eq 0 ] && [ "$bridge_read_status" -gt 128 ]; then
		log err 'the LPA stopped answering within its bound'
		bridge_status=3
	fi

	# Closing the write end is the LPA's end-of-file, and a well-behaved one
	# exits on it. Then the child is reaped on a bound rather than waited for:
	# an LPA that has already sent a malformed line, or that is sitting in a
	# sleep, would otherwise hold this process for as long as it liked, and
	# "cleanup must terminate and reap the active child" is the rule that
	# exists for exactly that.
	{ exec 6>&-; } 2>/dev/null || :
	bridge_reap_child "$bridge_status"
	{ exec 7<&-; } 2>/dev/null || :
	BRIDGE_FIFO_FD_OPEN=0
	cleanup_bridge
	# A mutating invocation retains these until its identity check and command
	# have both ended; ordinary reads release them here.
	[ "$BRIDGE_KEEP_TRANSPORT" -eq 1 ] || release_read_locks

	[ "$bridge_status" -eq 0 ] || return "$bridge_status"
	# The launcher's exit classes are the contract's, so they pass through
	# rather than being flattened into "it did not work".
	[ "$LPA_EXIT_STATUS" -eq 0 ] || return "$LPA_EXIT_STATUS"
	[ -n "$LPA_RESULT" ] || return 3
	[ "$BRIDGE_RESULT_CODE" = 0 ] || return 3
	return 0
}

# Reaps the LPA, bounded. `$1` is the bridge's own verdict: an exchange that
# already went wrong gets no grace period, because the LPA has stopped speaking
# the protocol and waiting for it to think better of that is waiting for
# nothing.
bridge_reap_child() {
	[ -n "$BRIDGE_CHILD_PID" ] || return 0
	if [ "${1:-0}" -eq 0 ]; then
		bridge_waited=0
		while kill -0 "$BRIDGE_CHILD_PID" 2>/dev/null && [ "$bridge_waited" -lt 1 ]; do
			"$SLEEP" 1 2>/dev/null || break
			bridge_waited=$((bridge_waited + 1))
		done
	fi
	if kill -0 "$BRIDGE_CHILD_PID" 2>/dev/null; then
		bridge_lpa_pid="$(sed -n '1p' "$BRIDGE_LPAC_PID_FILE" 2>/dev/null || :)"
		case "$bridge_lpa_pid" in ''|*[!0-9]*) bridge_lpa_pid="" ;; esac
		[ -z "$bridge_lpa_pid" ] || reap_child "$bridge_lpa_pid" KILL
		reap_child "$BRIDGE_CHILD_PID" KILL
	fi
	wait "$BRIDGE_CHILD_PID" 2>/dev/null || LPA_EXIT_STATUS=$?
	BRIDGE_CHILD_PID=""
	return 0
}

# The `data` member of the LPA's final result, as raw JSON. It is the one part
# of the LPA's output this script reads, and every field taken out of it is
# named explicitly below rather than passed through.
lpa_result_data() {
	lpa_rest="${LPA_RESULT#*\"data\":}"
	[ "$lpa_rest" != "$LPA_RESULT" ] || return 1
	# The trailing "}}" closes the payload and the root object.
	printf '%s\n' "${lpa_rest%\}\}}"
}

# ---- reachability ----
#
# Which combinations of control owner and transport permit an eUICC read
# without disturbing a live bearer. This is the contract's matrix, and the two
# rows worth restating are the two that look like maturity gaps and are not:
#
#   netifd-direct over the bearer's own control device is refused because the
#   MBIM contract already forbids disturbing a control session netifd opened
#   for a live bearer, and an APDU exchange is not gentler than an identity
#   query; and
#
#   modemmanager is refused for the same reason the modem contract refuses to
#   probe an AT port under it. Ownership is of the modem, not of one node, and
#   for eSIM the cost of being wrong is higher: an APDU exchange holds a logical
#   channel open across many commands, and a foreign reader landing inside it
#   breaks the channel rather than losing a reply.
#
# Two token values are additive to the contract's published lists and are named
# here so a reader can find them: `owner-transitioning`, because an operation
# already running is not the same answer as conflicting ownership; and
# `requires-bearer-stop`, because a netifd bearer holding the only control
# device is reachable by a takeover with a different mechanism -- stopping that
# one interface under consent -- rather than by the ownership handover, and
# saying `no` would claim there is no way to reach it at all.

REACHABLE=""
REACHABLE_REASON=""
ESIM_TRANSPORT=""
ESIM_TRANSPORT_DEVICE=""

# Is this vendor:product allowed to receive an AT APDU channel at all?
#
# The same allow list `lpac-run` consults, for the same reason and with the same
# rule: no wildcard, and "unknown" and "generic" are the same answer. The list
# lives in the LPA package because that is where the refusal had to live for the
# native backend; it is honoured here too, because a bridge that sent APDUs to
# an unlisted modem would walk straight around it.
at_apdu_model_allowed() {
	allow_vendor="$1"
	allow_product="$2"
	[ -n "$allow_vendor" ] && [ -n "$allow_product" ] || return 1
	[ -r "$LPAC_MODELS" ] || return 1
	while IFS="$TAB" read -r table_vendor table_product table_model table_state; do
		case "$table_vendor" in ''|\#*) continue ;; esac
		[ "$table_vendor" = "$allow_vendor" ] || continue
		[ "$table_product" = "$allow_product" ] || continue
		printf '%s\n' "${table_state:-candidate}"
		return 0
	done <"$LPAC_MODELS"
	return 1
}

# Every AT candidate port of this modem that is not the one the bearer holds.
# The control channels this endpoint's modem offers, best first.
#
# QMI's UIM service leads where the modem publishes a control device this
# operation may open, because the AT command handler on the reference modem
# gives up on a busy card after three seconds and the last exchange of a profile
# install needs four -- measured in P4 and recorded in
# docs/router-test-0.16.0.md. A `qmi:` token names it; a bare path is an AT
# port, which is what every caller and every fixture already produces.
#
# The bearer's own control device is never offered. `mbim-contract-v1.md`
# forbids disturbing a control session netifd opened for a live bearer, and an
# APDU exchange is not gentler than an identity query.
control_candidates() {
	control_section="$1"
	control_bearer="$2"
	control_device="$(section_device "$control_section" control)"
	if [ -n "$control_device" ] && [ "$control_device" != "$control_bearer" ]; then
		case "$control_device" in
			"$CONTROL_DEV_ROOT"/cdc-wdm[0-9]*)
				case "${control_device#"$CONTROL_DEV_ROOT"/}" in
					*/*|*..*) : ;;
					*) printf 'qmi:%s\n' "$control_device" ;;
				esac
			;;
		esac
	fi
	at_free_candidate_ports "$control_section" "$control_bearer"
}

at_free_candidate_ports() {
	transport_section="$1"
	transport_bearer="$2"
	printf '%s\n' "$transport_section" | awk -F '\t' -v bearer="$transport_bearer" '
		$1 == "at-port" && $3 != "" && $3 != bearer { print $3 }
	'
}

# Is the node this modem is known to answer on the node its own bearer dials
# over?
#
# Not "is there a bearer", and not "is the bearer the only port listed". An
# AT-dialed modem looks like this: the interface dials on the one port that
# answers, and `apn-autoconfig-modem` reports that same node as both the
# modem's AT device and the bearer's. Other AT ports stay listed and are still
# tried -- on the reference FM350-GL six of seven are, and none of them
# answers, because the seventh is this one.
#
# Where that is true, "the card could not be reached" is true and useless: it
# describes the card, and the card is fine. An operation would change the
# answer, which is the whole difference between a dead end and a step.
bearer_is_the_modems_own_control_port() {
	holds_section="$1"
	holds_bearer="$(section_device "$holds_section" bearer)"
	[ -n "$holds_bearer" ] || return 1
	[ "$(section_device "$holds_section" at)" = "$holds_bearer" ]
}

# Decides REACHABLE, REACHABLE_REASON, ESIM_TRANSPORT and ESIM_TRANSPORT_DEVICE
# for one endpoint. Fails closed at every step: an unanswerable question is
# `unknown`, never permission.
resolve_reachability() {
	reach_section="$1"
	reach_slot_active="$2"
	reach_ambiguous="$3"
	REACHABLE=unknown
	REACHABLE_REASON=""
	ESIM_TRANSPORT=""
	ESIM_TRANSPORT_DEVICE=""

	if [ "$reach_ambiguous" = 1 ]; then
		REACHABLE=unknown
		REACHABLE_REASON=endpoint-ambiguous
		return 0
	fi
	reach_owner="$(section_field "$reach_section" modem 3)"
	case "$reach_owner" in
		conflicting) REACHABLE=unknown; REACHABLE_REASON=owner-conflicting; return 0 ;;
		transitioning) REACHABLE=unknown; REACHABLE_REASON=owner-transitioning; return 0 ;;
		'') REACHABLE=unknown; REACHABLE_REASON=owner-conflicting; return 0 ;;
	esac
	# An endpoint in an inactive slot is `requires-slot-change` regardless of
	# owner, and this step's whole answer to it is that sentence. No read
	# changes a slot: not to reach an endpoint, not to identify one, not to
	# check one.
	if [ "$reach_slot_active" != 1 ]; then
		REACHABLE=requires-slot-change
		REACHABLE_REASON=slot-inactive
		return 0
	fi
	# Before the owner, deliberately. A modem that no transport in this release
	# could read is `not-supported` whoever owns it, and answering
	# `requires-inhibit` for one would offer the user an outage that buys
	# nothing: the inhibit would be taken, the connection interrupted, and the
	# read refused on the far side of it.
	if [ ! -x "$LPAC_RUN" ]; then
		REACHABLE=no
		REACHABLE_REASON=lpa-unavailable
		return 0
	fi
	reach_vendor="$(section_field "$reach_section" usb 2)"
	reach_product="$(section_field "$reach_section" usb 3)"
	if ! at_apdu_model_allowed "$reach_vendor" "$reach_product" >/dev/null; then
		REACHABLE=no
		REACHABLE_REASON=not-supported
		return 0
	fi
	if [ "$reach_owner" = modemmanager ]; then
		REACHABLE=requires-inhibit
		REACHABLE_REASON=owner-modemmanager
		return 0
	fi
	reach_bearer="$(section_device "$reach_section" bearer)"
	reach_free="$(control_candidates "$reach_section" "$reach_bearer" | sed -n '1p')"
	if [ -z "$reach_free" ]; then
		reach_any="$(section_field "$reach_section" at-port 3)"
		if [ -n "$reach_any" ] && [ -n "$reach_bearer" ]; then
			# The bearer holds the only control channel there is. Stopping that
			# one interface under consent reaches it, which is a takeover with
			# its own mechanism rather than a refusal.
			REACHABLE=requires-bearer-stop
			REACHABLE_REASON=transport-unavailable
		else
			REACHABLE=no
			REACHABLE_REASON=transport-unavailable
		fi
		return 0
	fi
	# What this endpoint would actually be reached over, which the frontend
	# publishes and a hardware record quotes. The AT APDU allow list above still
	# gates every transport, deliberately: it is a statement about which modems
	# this project will speak to a card through at all, and widening it because
	# a second transport exists is a policy change with its own evidence.
	case "$reach_free" in
		qmi:*)
			ESIM_TRANSPORT=qmi
			ESIM_TRANSPORT_DEVICE="${reach_free#qmi:}"
		;;
		*)
			ESIM_TRANSPORT=at
			ESIM_TRANSPORT_DEVICE="$reach_free"
		;;
	esac
	REACHABLE=yes
	REACHABLE_REASON=""
	return 0
}

# ---- reading the EID ----
#
# The raw EID is held only here, in the one package allowed to hold it, and only
# for as long as it takes to derive a handle and a four-character suffix from
# it. It is never published, never logged, never written to state and never
# passed as an argument to anything.
#
# Two sources, and they are different situations rather than a preference:
# ModemManager's own API answers for a modem ModemManager owns, which is the one
# way to learn anything about such a modem without violating the single-owner
# rule; the LPA answers over the bridge once a takeover has made the modem ours.

ENDPOINT_EID=""
ENDPOINT_EID_SOURCE=none

# ---- the second EID producer, and why it is not ModemManager's ----
#
# ModemManager's API answers for a modem ModemManager owns, which is the one way
# to learn anything about such a modem without breaking the single-owner rule.
# It is also the only producer this project had, and that had a consequence
# nobody intended: a modem on direct QMI, on direct MBIM or speaking only AT --
# every composition where netifd owns the modem and ModemManager therefore does
# not -- could never reach evidence tier `eid`, so its endpoints stayed
# `slot-weak`, which is read-only inventory that no operation may target. The
# transports were never the limit; AT has been proven since C2 and QMI since P5,
# and such a modem already publishes `reachable: yes`.
#
# So the card is asked. Three rules bound it, and none of them is optional.
#
# **Only where the matrix already permits a read.** `yes` means exactly "a read
# may proceed now, under the locks below, with no ownership or slot change", so
# this adds no consent surface, no takeover and no new disruption. Every other
# value opens nothing.
#
# **Never from a poll.** P1 measured the page that polls this path as
# fork-bound, and a card open per scan would undo that work. The probe happens
# on `--refresh`, which is a deliberate user action by contract and is never
# what a poll sets.
#
# **The answer outlives the read cache and dies with the attachment
# generation.** An EID changes when somebody swaps a card, and a swap makes the
# modem re-enumerate, which is what moves the generation. So the record is keyed
# by modem, generation and operation id -- the same tuple the read cache uses --
# and lives in /var/run, so a reboot re-probes. It authorises nothing on its
# own: every operation still revalidates under its own locks.
ENDPOINT_IDENTITY_SCHEMA=v2

# What this run learned about each modem's *active* slot, as
# `<modem><TAB><yes|no|unknown><TAB><reason>`.
#
# This is the question a page actually asks. The eSIM area exists for every
# modem; opening it asks the active slot what is in it, and the answer is either
# an eUICC to manage, "there is no eUICC in the active slot", or "nobody could
# ask, and here is why". The third is not the second: telling somebody they have
# no eSIM when the truth is that the modem was busy sends them away from a
# subscription they own.
#
# Nothing here is about inactive slots. Which card sits in a slot the modem is
# not using cannot be read without switching to it, and the maintainer's
# decision on 2026-08-30 is that the product does not need to: the active slot
# is the question, and changing slots is a separate user action.
ACTIVE_SLOT_FILE=""

active_slot_note() {
	[ -n "$ACTIVE_SLOT_FILE" ] || return 0
	printf '%s\t%s\t%s\n' "$1" "$2" "$3" >>"$ACTIVE_SLOT_FILE" 2>/dev/null || :
	return 0
}

identity_binding() {
	# Only stable routing context, never a raw card identifier. A slot or
	# owner change invalidates display identity even within one attachment.
	printf '%s\n' "$1" | awk -F '\t' '
		$1 == "modem" {print $3}
		$1 == "slots" {print $2, $3, $4}
		$1 == "slot" {print $2, $4}
		$1 == "device" {print $2, $3}
	' | "$SHA256" | awk 'NF {print $1; found=1} END {exit !found}'
}

identity_record_path() {
	printf '%s/identity/%s\n' "$STATE_DIR" "$(sanitize_token "$1")"
}

# The record for this modem at this attachment, or nothing. A mismatch is
# discarded rather than refreshed: a stale identity is worse than none, because
# an operation would target it.
identity_record_load() {
	identity_line="$(sed -n '1p' "$(identity_record_path "$1")" 2>/dev/null || :)"
	[ -n "$identity_line" ] || return 1
	[ "$(field "$identity_line" 1)" = "$ENDPOINT_IDENTITY_SCHEMA" ] || return 1
	[ "$(field "$identity_line" 2)" = "$2" ] || return 1
	[ -n "${3:-}" ] && [ "$(field "$identity_line" 5)" = "$3" ] || return 1
	# Field 3 is the endpoint handle, or the literal `none` for a card that was
	# asked and is not an eUICC. Both are answers; an empty field is not.
	[ -n "$(field "$identity_line" 3)" ] || return 1
	printf '%s\n' "$identity_line"
	return 0
}

identity_record_store() {
	# The handle and the four-character suffix, never the identifier they were
	# derived from. This file is the one place the answer persists, and the raw
	# EID is not in it.
	( umask 077 && mkdir -p "$STATE_DIR/identity" ) || return 0
	identity_path="$(identity_record_path "$1")"
	identity_tmp="${identity_path}.tmp.$SELF_PID"
	printf '%s\t%s\t%s\t%s\t%s\n' \
		"$ENDPOINT_IDENTITY_SCHEMA" "$2" "$3" "$4" "$5" >"$identity_tmp" 2>/dev/null || {
		rm -f "$identity_tmp"
		return 0
	}
	mv "$identity_tmp" "$identity_path" 2>/dev/null || rm -f "$identity_tmp"
	return 0
}

# One card transaction, under levels 3 and 4, asking the eUICC who it is.
#
# The lock is taken under a provisional `slot:` handle because the real one is
# what this read is for. Nothing is ever published under the provisional name --
# it excludes other readers of the same chip and nothing else.
# Why the card did not identify itself.
#
# Measured on the reference FM350-GL on 2026-08-30: the read reached the modem
# over a free AT port, the LPA opened its exchange and failed at `euicc_init`,
# which is the step that opens a logical channel to the ISD-R applet. That
# failure has two causes and this path cannot tell them apart -- there is no
# eUICC in the active slot, or the modem will not open a logical channel at all,
# which is what this one does (it answers `AT+CCHO` with `+CME ERROR: 100`).
#
# So **a failure here is `unknown`, never `no`.** Over a channel that failed to
# open, "this is not an eUICC" is not a fact anybody established; it is the
# absence of one. `no` stays in the vocabulary for a producer that can state it
# -- QMI UIM's slot status reports `is_euicc` per slot without opening any
# channel -- and until such a producer exists nothing publishes it.
#
# The step that failed travels with the answer, because "could not open a
# channel to the applet" and "the port stopped answering" are different things
# to tell somebody, and because it is what a later reader needs.
EID_CARD_REASON=""

# What the modem says is in its active slot, asked of the modem rather than of
# the card.
#
# This is the only honest producer of "there is no eUICC here". Over an APDU
# channel a card with no ISD-R applet and a modem that will not open a channel
# fail at the same step with the same message -- measured on the reference
# FM350-GL, whose active slot holds an ordinary SIM and whose APDU transport is
# demonstrably fine. QMI's UIM service answers the question without opening
# anything: it reports, per physical slot, whether a card is present and whether
# it is a eUICC.
#
# Prints `euicc`, `uicc` or `unknown` for the active slot. `unknown` covers
# every way of not knowing -- no client, a modem whose firmware has no slot
# status, an answer that did not parse, no slot reported active -- because each
# of them is "nobody could tell", and none of them is "there is no eSIM".
qmi_active_slot_kind() {
	[ -x "$UIM_CLIENT" ] || { printf 'unknown\n'; return 0; }
	kind_device="$1"
	[ -n "$kind_device" ] || { printf 'unknown\n'; return 0; }
	acquire_transport_lock qmi "$kind_device" "$LOCK_WAIT_SECONDS" || {
		printf 'unknown\n'
		return 0
	}
	kind_file="$TMP_BASE.bounded-status"
	kind_input="$TMP_BASE.bounded-input"
	kind_answer=unknown
	printf 'slots\nquit\n' >"$kind_input" 2>/dev/null || {
		release_read_locks
		printf 'unknown\n'
		return 0
	}
	# One invocation, two lines in and one line out. No co-process is needed for
	# a question that is not part of a card session, and not holding a session
	# open is what makes this safe to ask before deciding to open one.
	#
	# The input is a file the child opens for itself, and a pipe would not do.
	# POSIX assigns /dev/null to the standard input of an asynchronous command
	# when job control is off, which is exactly how the bounded runner launches
	# a child on a system with no `timeout` -- the reference router being one.
	# The client would then read end-of-file on its first line and exit, and the
	# answer would silently become "the modem could not say". `lpac-run` carries
	# the same trap and the same note; this is the second time it has been paid
	# for.
	if run_bounded_to_file 15 "$kind_file" \
		/bin/sh -c 'exec "$0" --device "$1" --timeout 10 <"$2"' \
		"$UIM_CLIENT" "$kind_device" "$kind_input"; then
		# The answer, not the first line. The client announces `ready` before
		# it accepts anything, exactly as the bridge's own session does, and a
		# reader that took line one would take the greeting every time.
		kind_line="$(sed -n 's/^\(ok slots .*\)$/\1/p' "$kind_file" 2>/dev/null | sed -n '1p')"
		case "$kind_line" in
			'ok slots '*)
				# The active slot, by the state the modem reported for it, not
				# by its position in the list.
				kind_answer="$(printf '%s\n' "$kind_line" | awk '
					{
						for (i = 1; i <= NF - 4; i++)
							if ($i == "slot" && $(i + 3) == "active") {
								print $(i + 4)
								exit
							}
					}
				')"
				case "$kind_answer" in euicc|uicc) : ;; *) kind_answer=unknown ;; esac
			;;
		esac
	fi
	release_read_locks
	printf '%s\n' "$kind_answer"
	return 0
}

read_eid_from_card() {
	ENDPOINT_EID=""
	ENDPOINT_EID_SOURCE=none
	EID_CARD_REASON=card-unreachable
	eid_card_modem="$1"
	eid_card_section="$2"
	eid_card_handle="$(slot_weak_handle "$eid_card_modem" 0)"
	eid_card_bearer="$(section_device "$eid_card_section" bearer)"
	eid_card_owner="$(section_field "$eid_card_section" modem 3)"
	# Stopped for this operation, under consent, so it is holding nothing now.
	if [ "$CARD_BEARER_RELEASED" -eq 1 ]; then
		eid_card_bearer=""
		eid_card_owner=none
	fi
	eid_card_candidates="$(control_candidates "$eid_card_section" \
		"$eid_card_bearer" | tr '\n' ' ')"
	if [ -z "$eid_card_candidates" ]; then
		if [ "$CARD_BEARER_RELEASED" -ne 1 ] && \
			bearer_is_the_modems_own_control_port "$eid_card_section"; then
			EID_CARD_REASON=requires-bearer-stop
		fi
		return 1
	fi
	BRIDGE_RESULT_MESSAGE=""
	eid_card_status=0
	bridge_run "$eid_card_handle" "$eid_card_owner" \
		"$eid_card_candidates" "$eid_card_bearer" \
		chip info || eid_card_status=$?
	if [ "$eid_card_status" -ne 0 ]; then
		# If this modem's own answering port is still occupied by its bearer,
		# failure on a different AT-speaking port does not prove the card is
		# unreachable. Stopping that one bearer is still the operation that can
		# change the answer, regardless of whether the spare port failed before or
		# during eUICC initialisation.
		if [ "$CARD_BEARER_RELEASED" -ne 1 ] && \
			bearer_is_the_modems_own_control_port "$eid_card_section"; then
			EID_CARD_REASON=requires-bearer-stop
			return 1
		fi
		# A verdict means the card answered; the answer was simply not an EID,
		# which is what a plain SIM with no ISD-R applet does. No verdict means
		# nothing was reached, and the LPA's own message is carried through
		# either way so a human can tell the two apart in a log.
		if [ -n "$BRIDGE_RESULT_MESSAGE" ]; then
			EID_CARD_REASON="$BRIDGE_RESULT_MESSAGE"
		fi
		return 1
	fi
	eid_card_data="$(lpa_result_data 2>/dev/null || :)"
	[ -n "$eid_card_data" ] || { EID_CARD_REASON=no-eid-in-answer; return 1; }
	# Held exactly as long as it takes to normalise it; the caller derives a
	# handle and a suffix and clears it immediately, as the ModemManager path
	# already does.
	ENDPOINT_EID="$(normalise_eid "$(json_query "$eid_card_data" '@.eidValue')" 2>/dev/null || :)"
	[ -n "$ENDPOINT_EID" ] || { EID_CARD_REASON=no-eid-in-answer; return 1; }
	ENDPOINT_EID_SOURCE=card
	EID_CARD_REASON=""
	return 0
}

read_eid_from_modemmanager() {
	ENDPOINT_EID=""
	ENDPOINT_EID_SOURCE=none
	eid_mm_index="$1"
	eid_sim_index="$2"
	case "$eid_mm_index" in ''|*[!0-9]*) return 1 ;; esac
	case "$eid_sim_index" in ''|*[!0-9]*) return 1 ;; esac
	command_exists "$MMCLI" || return 1
	eid_file="$STATE_DIR/.mmcli-sim.$SELF_PID"
	eid_status=0
	run_read_bounded euicc-eid 8 "$eid_file" \
		"$MMCLI" -m "$eid_mm_index" --sim "$eid_sim_index" --output-keyvalue || eid_status=$?
	if [ "$eid_status" -ne 0 ]; then
		rm -f "$eid_file"
		return 1
	fi
	eid_raw="$(awk -F ':' '
		{
			key = $1
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
			if (key != "sim.properties.eid") next
			$1 = ""
			sub(/^:[[:space:]]*/, "", $0)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
			if ($0 == "--" || $0 == "unknown") next
			print $0
			exit
		}
	' "$eid_file" 2>/dev/null || :)"
	rm -f "$eid_file"
	ENDPOINT_EID="$(normalise_eid "$eid_raw" 2>/dev/null || :)"
	[ -n "$ENDPOINT_EID" ] || return 1
	ENDPOINT_EID_SOURCE=modemmanager
	return 0
}

# ---- endpoint enumeration ----
#
# One endpoint per slot that is evidenced to hold an eUICC. A slot whose class
# is `unknown` produces no endpoint, because an endpoint is a claim that a chip
# is there and `unknown` is the absence of that claim — never its negation. The
# modem it belongs to still appears in the `modems` list with its slot source,
# so a page can say "this modem's slots could not be determined" rather than
# "this modem has no eSIM".

ENDPOINT_FILE=""
MODEM_LINES_FILE=""
SLOT_LINES_FILE=""

# Nothing below loops through a pipeline, and that is not a style preference.
# A `while read` on the right-hand side of a pipe runs in a subshell, and two
# things this function depends on live in variables: the bounded-call child and
# watchdog PIDs the exit trap must kill, and the abandoned-reading list the
# document is built from. Both would be assigned in the subshell and discarded
# with it -- so `euicc-eid` would never appear in `incomplete_reads` however
# often the deadline stopped it, and a killed `mmcli` would be left behind.
# One endpoint published from the card's own answer rather than from a slot row.
#
# It runs only where nothing else produced a proven endpoint for this modem, so
# a ModemManager composition is untouched: there the slot table carries the EID
# and this never fires.
enumerate_probed() {
	probed_index="$1"
	probed_modem="$2"
	probed_section="$3"
	probed_generation="$4"
	probed_ambiguous="$5"
	# Nothing is probed for an ambiguous modem, ever. Two modems that cannot be
	# told apart must not be given a card channel between them.
	[ "$probed_ambiguous" != 1 ] || {
		active_slot_note "$probed_modem" unknown modem-ambiguous
		return 0
	}
	# A modem that already has a proven endpoint needs nothing from this, and
	# the question a page asks about its active slot is already answered.
	if awk -F '\t' -v modem="$probed_modem" \
		'$3 == modem && $2 == "eid" { found = 1 } END { exit found ? 0 : 1 }' \
		"$ENDPOINT_FILE" 2>/dev/null; then
		active_slot_note "$probed_modem" yes ""
		return 0
	fi
	# The matrix, for the slot that is active by definition: the card this would
	# read is the card the modem is using. Anything but `yes` opens nothing --
	# no inhibit, no bearer stop, no slot change, and no consent surface that
	# did not already exist.
	resolve_reachability "$probed_section" 1 0
	probed_binding="$(identity_binding "$probed_section")"
	probed_record="$(identity_record_load "$probed_modem" "$probed_generation" \
		"$probed_binding" 2>/dev/null || :)"
	if [ "$REQUESTED_REFRESH" -eq 1 ]; then
		# A deliberate refresh never relabels the previous answer as fresh.
		probed_record=""
		rm -f "$(identity_record_path "$probed_modem")"
	fi
	if [ -z "$probed_record" ]; then
		[ "$REACHABLE" = yes ] || {
			active_slot_note "$probed_modem" unknown "${REACHABLE_REASON:-$REACHABLE}"
			return 0
		}
		# Never from a poll. `--refresh` is a deliberate user action by
		# contract, and a card open per scan would undo P1's work on the page
		# that polls this path.
		[ "$REQUESTED_REFRESH" -eq 1 ] || {
			active_slot_note "$probed_modem" unknown not-asked
			return 0
		}
		# Where the transport is QMI, the modem is asked first. It answers
		# without opening anything, and its answer is the one that can be
		# negative: a card it reports as an ordinary UICC is not an eUICC, and
		# that is worth keeping so the next read does not ask again.
		if [ "$ESIM_TRANSPORT" = qmi ]; then
			probed_kind="$(qmi_active_slot_kind "$ESIM_TRANSPORT_DEVICE")"
			if [ "$probed_kind" = uicc ]; then
				identity_record_store "$probed_modem" "$probed_generation" \
					none not-a-euicc "$probed_binding"
				active_slot_note "$probed_modem" no ""
				return 0
			fi
			# A modem that could not say is not a reason to stop. Its firmware
			# may have no slot status at all, and the card can still prove the
			# positive answer for itself -- which is how this worked before the
			# modem could be asked. Only a definite `uicc` short-circuits.
		fi
		if ! read_eid_from_card "$probed_modem" "$probed_section"; then
			# Nothing is known and nothing is kept. A failure is not an answer,
			# so it is not stored as one: the next deliberate refresh asks
			# again rather than remembering it.
			active_slot_note "$probed_modem" unknown "$EID_CARD_REASON"
			return 0
		fi
		probed_handle="$(endpoint_handle_from_eid "$ENDPOINT_EID" 2>/dev/null || :)"
		probed_suffix="$(suffix_of "$ENDPOINT_EID")"
		# Held no longer than it took to derive a handle and a suffix from it.
		ENDPOINT_EID=""
		[ -n "$probed_handle" ] || {
			# An answer that does not normalise is not an answer. Nothing is
			# stored, so a later refresh asks again rather than remembering a
			# value nobody could read.
			active_slot_note "$probed_modem" unknown eid-unreadable
			return 0
		}
		identity_record_store "$probed_modem" "$probed_generation" \
			"$probed_handle" "$probed_suffix" "$probed_binding"
		probed_record="$(printf '%s\t%s\t%s\t%s' "$ENDPOINT_IDENTITY_SCHEMA" \
			"$probed_generation" "$probed_handle" "$probed_suffix")"
	fi
	probed_id="$(field "$probed_record" 3)"
	[ -n "$probed_id" ] || return 0
	# `none` is the record a producer that can state "this is not an eUICC"
	# would write. Nothing writes one today -- see read_eid_from_card -- and the
	# branch is here so that when one does, a kept negative is honoured rather
	# than re-probed on every refresh.
	if [ "$probed_id" = none ]; then
		active_slot_note "$probed_modem" no "$(field "$probed_record" 4)"
		return 0
	fi
	active_slot_note "$probed_modem" yes ""
	# Which physical slot this is, where somebody has asked. The read went
	# through the active slot by definition -- a card that answers is a card
	# that is present -- so the modem's own slot table names it, and where there
	# is no table the honest answer is null rather than 1.
	#
	# It is not cosmetic. The count and the slot are what a slot change is
	# offered against, and publishing neither meant the modem this was built
	# for was never offered one. Found on the reference FM350-GL, which
	# publishes a table of its own and was still told it had nowhere to go.
	probed_slot="$(printf '%s\n' "$probed_section" | \
		awk -F '\t' '$1 == "slot" && $4 == 1 { print $2; exit }')"
	probed_count="$(section_field "$probed_section" slots 3)"
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$probed_id" eid "$probed_modem" "$probed_generation" \
		"$probed_slot" "$probed_count" 1 euicc \
		1 "$(field "$probed_record" 4)" \
		"$ESIM_TRANSPORT" "$ESIM_TRANSPORT_DEVICE" \
		"$(section_field "$probed_section" modem 3)" \
		"$REACHABLE" "$REACHABLE_REASON" \
		0 "" card \
		"$probed_index" \
		>>"$ENDPOINT_FILE"
	return 0
}

enumerate_endpoints() {
	ENDPOINT_FILE="$TMP_BASE.endpoints"
	MODEM_LINES_FILE="$TMP_BASE.modem-lines"
	SLOT_LINES_FILE="$TMP_BASE.slot-lines"
	ACTIVE_SLOT_FILE="$TMP_BASE.active-slot"
	: >"$ENDPOINT_FILE"
	: >"$ACTIVE_SLOT_FILE"
	modem_record_lines >"$MODEM_LINES_FILE"
	while IFS= read -r enumerate_indexed; do
		enumerate_index="${enumerate_indexed%%"$TAB"*}"
		enumerate_line="${enumerate_indexed#*"$TAB"}"
		enumerate_modem="$(field "$enumerate_line" 2)"
		[ -n "$enumerate_modem" ] || continue
		enumerate_section="$(modem_section_at "$enumerate_index")"
		enumerate_owner="$(field "$enumerate_line" 3)"
		enumerate_ambiguous="$(field "$enumerate_line" 5)"
		enumerate_generation="$(field "$enumerate_line" 6)"
		enumerate_mm="$(section_field "$enumerate_section" mm 2)"
		enumerate_count="$(section_field "$enumerate_section" slots 3)"
		printf '%s\n' "$enumerate_section" | awk -F '\t' '$1 == "slot" { print }' >"$SLOT_LINES_FILE"
		while IFS= read -r slot_line; do
			slot_number="$(field "$slot_line" 2)"
			slot_class="$(field "$slot_line" 3)"
			slot_active="$(field "$slot_line" 4)"
			slot_eid_known="$(field "$slot_line" 5)"
			slot_eid_suffix="$(field "$slot_line" 6)"
			slot_sim_index="$(field "$slot_line" 7)"
			# A slot whose class is `unknown` produces no endpoint. An endpoint
			# is a claim that a chip is there, and `unknown` is the absence of
			# that claim rather than its negation; the modem still appears in
			# the `modems` list with its slot source, so a page can say the
			# slots could not be determined instead of saying there is no eSIM.
			[ "$slot_class" = euicc ] || continue

			endpoint_tier=slot-weak
			endpoint_id="$(slot_weak_handle "$enumerate_modem" "$slot_number")"
			endpoint_eid_known=0
			endpoint_eid_suffix=""
			endpoint_eid_source=none
			if [ "$slot_eid_known" = 1 ] && [ "$enumerate_owner" = modemmanager ]; then
				# A failure here leaves the endpoint at `slot-weak`, which is
				# honest: the slot said it holds an eUICC and no EID was read
				# from it. `euicc-eid` reaches `incomplete_reads` from inside
				# run_read_bounded, so a reader can tell a card that has no
				# readable EID from a read that ran out of time.
				if read_eid_from_modemmanager "$enumerate_mm" "$slot_sim_index"; then
					endpoint_handle="$(endpoint_handle_from_eid "$ENDPOINT_EID" 2>/dev/null || :)"
					if [ -n "$endpoint_handle" ]; then
						endpoint_id="$endpoint_handle"
						endpoint_tier=eid
						endpoint_eid_known=1
						endpoint_eid_suffix="$(suffix_of "$ENDPOINT_EID")"
						endpoint_eid_source="$ENDPOINT_EID_SOURCE"
					fi
					# Held no longer than it took to derive a handle and a
					# suffix from it.
					ENDPOINT_EID=""
				fi
			fi

			endpoint_ambiguous=0
			endpoint_ambiguity_reason=""
			if [ "$enumerate_ambiguous" = 1 ]; then
				endpoint_ambiguous=1
				endpoint_ambiguity_reason=modem_ambiguous
			fi
			resolve_reachability "$enumerate_section" "$slot_active" "$endpoint_ambiguous"
			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
				"$endpoint_id" "$endpoint_tier" "$enumerate_modem" "$enumerate_generation" \
				"$slot_number" "$enumerate_count" "$slot_active" "$slot_class" \
				"$endpoint_eid_known" "$endpoint_eid_suffix" \
				"$ESIM_TRANSPORT" "$ESIM_TRANSPORT_DEVICE" "$enumerate_owner" \
				"$REACHABLE" "$REACHABLE_REASON" \
				"$endpoint_ambiguous" "$endpoint_ambiguity_reason" "$endpoint_eid_source" \
				"$enumerate_index" \
				>>"$ENDPOINT_FILE"
		done <"$SLOT_LINES_FILE"

		# The modems whose owner is not ModemManager, which is every direct QMI,
		# direct MBIM and AT-only composition. Their slot table is empty or
		# their slots carry no EID, so the loop above produced nothing that any
		# operation may target -- while the matrix already says their card may
		# be read. The card is asked instead, once per attachment, and only
		# where a deliberate refresh asked for it.
		enumerate_probed "$enumerate_index" "$enumerate_modem" "$enumerate_section" \
			"$enumerate_generation" "$enumerate_ambiguous"
	done <"$MODEM_LINES_FILE"
	# Kept, not removed: the modem list is what tells a consumer that a modem
	# was looked at and its slots could not be determined, which is a different
	# answer from "this modem has no eUICC". The exit trap owns both files.
	mark_colliding_endpoints
	return 0
}

# Two present endpoints whose handles collide cannot be told apart, so both are
# ambiguous and neither may be targeted. At 64 bits and the handful of eUICCs a
# router can hold this is a rule for completeness rather than an expected event
# — but a `slot:` handle is not a hash, and two modems that are themselves
# indistinguishable produce indistinguishable slot handles, which is the case
# this actually catches.
mark_colliding_endpoints() {
	[ -s "$ENDPOINT_FILE" ] || return 0
	collision_list="$(cut -f1 "$ENDPOINT_FILE" | sort | uniq -d)"
	[ -n "$collision_list" ] || return 0
	collision_tmp="$ENDPOINT_FILE.tmp"
	awk -F '\t' -v OFS='\t' -v dupes="$collision_list" '
		BEGIN { n = split(dupes, list, "\n"); for (i = 1; i <= n; i++) if (list[i] != "") bad[list[i]] = 1 }
		{
			if ($1 in bad) {
				$16 = 1
				$17 = "handle_collision"
				$14 = "unknown"
				$15 = "endpoint-ambiguous"
			}
			print
		}
	' "$ENDPOINT_FILE" >"$collision_tmp" && mv "$collision_tmp" "$ENDPOINT_FILE"
	rm -f "$collision_tmp"
	return 0
}

# ---- the cache ----
#
# An eUICC read is expensive and the page polls, so there is a cache, and the
# whole of its contract is in what it is not allowed to do. A cache authorises
# nothing: no mutation revalidates against one, a cached capability map never
# permits an operation, a cached owner state never permits opening a channel,
# and an entry is never written from a prediction of what an operation is about
# to do. It is written from a read that happened.
#
# The key is the tuple the contract names. Any difference in any element is a
# miss rather than a stale hit to be refreshed: the generation catches a modem
# that went away and came back, the slot and its active flag catch the eUICC
# moving or the mapping changing underneath us, the owner catches a modem
# ModemManager has claimed since the read, and the schema version catches an
# upgrade. The operation id is this package's answer to "a modem reset from a
# path outside this package invalidates the entry": every reset produces one,
# whoever started it.
CACHE_SCHEMA=v1

cache_dir() {
	printf '%s\n' "$STATE_DIR/cache"
}

cache_key_hash() {
	# endpoint, modem, generation, slot, slot_active, owner, operation, schema
	handle_for_identifier "$1|$2|$3|$4|$5|$6|$7|$CACHE_SCHEMA"
}

cache_path() {
	# <kind>.<endpoint>.<keyhash>, so pruning every other entry for one endpoint
	# is an exact prefix match rather than a wildcard over a shared directory.
	printf '%s/%s.%s.%s\n' "$(cache_dir)" "$1" "$(sanitize_token "$2")" "$3"
}

CACHE_READ_STATE=unknown
CACHE_READ_AGE=0

cache_load() {
	CACHE_READ_STATE=unknown
	CACHE_READ_AGE=0
	[ "$REQUESTED_REFRESH" -eq 0 ] || return 1
	[ "$ESIM_CACHE_TTL_SECONDS" -gt 0 ] || return 1
	cache_file="$1"
	[ -f "$cache_file" ] || return 1
	cache_header="$(sed -n '1p' "$cache_file" 2>/dev/null || :)"
	case "$cache_header" in
		"$CACHE_SCHEMA$TAB"*) : ;;
		*)
			# An entry written by a different schema version is discarded rather
			# than interpreted.
			rm -f "$cache_file"
			return 1
		;;
	esac
	cache_written="$(field "$cache_header" 2)"
	case "$cache_written" in ''|*[!0-9]*) rm -f "$cache_file"; return 1 ;; esac
	# The lifetime the entry was written with, or the ordinary one for an entry
	# from before entries carried theirs. An unreadable value is not trusted
	# upward: it falls back rather than granting an unbounded life.
	cache_entry_life="$(field "$cache_header" 3)"
	case "$cache_entry_life" in ''|*[!0-9]*) cache_entry_life="$ESIM_CACHE_TTL_SECONDS" ;; esac
	cache_age=$(($(date +%s) - cache_written))
	[ "$cache_age" -ge 0 ] || cache_age=0
	if [ "$cache_age" -gt "$cache_entry_life" ]; then
		rm -f "$cache_file"
		return 1
	fi
	CACHE_READ_STATE=cached
	CACHE_READ_AGE="$cache_age"
	sed -n '2,$p' "$cache_file"
	return 0
}

# The fourth argument is what this entry is worth in seconds, for the entries
# that cost more to obtain than a page redraw. It is written into the entry
# rather than looked up at read time, so an entry keeps the lifetime it was
# promised when it was made even if the setting changes underneath it. Omitted
# means the ordinary read lifetime, and an entry written before this field
# existed has two header fields and is read the same way.
cache_store() {
	cache_file="$1"
	cache_kind="$2"
	cache_endpoint="$3"
	cache_entry_ttl="${4:-$ESIM_CACHE_TTL_SECONDS}"
	case "$cache_entry_ttl" in ''|*[!0-9]*) cache_entry_ttl="$ESIM_CACHE_TTL_SECONDS" ;; esac
	[ "$ESIM_CACHE_TTL_SECONDS" -gt 0 ] || return 0
	( umask 077 && mkdir -p "$(cache_dir)" ) || return 0
	cache_prune "$cache_kind" "$cache_endpoint"
	# Atomically, through a temporary file and a rename, so a concurrent reader
	# sees either the whole old entry or the whole new one.
	cache_tmp="${cache_file}.tmp.$SELF_PID"
	{
		printf '%s\t%s\t%s\n' "$CACHE_SCHEMA" "$(date +%s)" "$cache_entry_ttl"
		cat
	} >"$cache_tmp" 2>/dev/null || { rm -f "$cache_tmp"; return 0; }
	mv "$cache_tmp" "$cache_file" 2>/dev/null || rm -f "$cache_tmp"
	return 0
}

# Every entry of one kind for one endpoint, whatever key it was written under.
# Exact project-owned names only: never a wildcard over a shared root, and never
# a recursive delete.
cache_prune() {
	prune_prefix="$1.$(sanitize_token "$2")."
	prune_dir="$(cache_dir)"
	[ -d "$prune_dir" ] || return 0
	for prune_path in "$prune_dir/$prune_prefix"*; do
		[ -f "$prune_path" ] || continue
		[ -L "$prune_path" ] && continue
		rm -f "$prune_path" 2>/dev/null || :
	done
	return 0
}

# Called by every mutation at its *start*, not at its end. An entry that
# describes the state a running operation is changing is already wrong, and a
# page that refreshes mid-operation must not be shown what was true before it.
cache_invalidate_endpoint() {
	for invalidate_kind in endpoint profiles notifications; do
		cache_prune "$invalidate_kind" "$1"
	done
	return 0
}

# ---- reading an eUICC through the LPA ----
#
# The LPA's own result document is parsed with `jsonfilter`, one query per field
# of one small array, rather than by the string surgery the bridge loop uses.
# The two are different problems: the bridge sees dozens of messages of a shape
# lpac generates identically every time, where a fork per message is the cost
# this project measures; a profile name is arbitrary text a subscription chose,
# and hand-parsing that is how a quote in an operator's name becomes a defect.
JSONFILTER="${APN_AUTOCONFIG_ESIM_JSONFILTER:-jsonfilter}"

json_query() {
	# Empty rather than an error when the member is absent. jsonfilter exits 1
	# and prints nothing for an absent member and for a JSON null alike, which
	# is exactly the distinction this package does not need: missing means
	# unknown, and a consumer that cannot find a field is told nothing rather
	# than told `false`.
	"$JSONFILTER" -s "$1" -e "$2" 2>/dev/null || :
}

json_array_length() {
	json_length="$("$JSONFILTER" -s "$1" -e '@.*' 2>/dev/null | wc -l | tr -d ' ')"
	case "$json_length" in ''|*[!0-9]*) printf '0\n'; return 0 ;; esac
	printf '%s\n' "$json_length"
}

# One field of one array element, in one query. Asking for the element and then
# querying it again costs a second fork per field and a round trip through
# jsonfilter's own serialisation; an indexed path avoids both.
json_element_field() {
	json_query "$1" "@[$2].$3"
}

# `profile list`, once, over the bridge, into a tab-separated record per
# profile:
#   <profile_id><TAB><iccid_suffix><TAB><state><TAB><class><TAB><nickname>
#   <TAB><profile_name><TAB><provider_name><TAB><icon_present>
#
# `state` and `class` are exact normalised values or `unknown`; a profile whose
# state is not exactly `enabled` or `disabled` may not be targeted, so the
# nearest match is never taken.
read_profiles_through_lpa() {
	profiles_endpoint="$1"
	profiles_owner="$2"
	profiles_candidates="$3"
	profiles_bearer="$4"
	profiles_out="$5"
	: >"$profiles_out"
	command_exists "$JSONFILTER" || return 3
	bridge_status=0
	bridge_run "$profiles_endpoint" "$profiles_owner" "$profiles_candidates" "$profiles_bearer" profile list || bridge_status=$?
	[ "$bridge_status" -eq 0 ] || return "$bridge_status"
	profiles_data="$(lpa_result_data 2>/dev/null || :)"
	[ -n "$profiles_data" ] || return 3
	profiles_count="$(json_array_length "$profiles_data")"
	profiles_index=0
	while [ "$profiles_index" -lt "$profiles_count" ]; do
		profiles_at="$profiles_index"
		profiles_index=$((profiles_index + 1))
		profiles_iccid_raw="$(json_element_field "$profiles_data" "$profiles_at" iccid)"
		profiles_iccid="$(normalise_iccid "$profiles_iccid_raw" 2>/dev/null || :)"
		if [ -n "$profiles_iccid" ]; then
			profiles_handle="$(profile_handle_from_iccid "$profiles_iccid" 2>/dev/null || :)"
			profiles_suffix="$(suffix_of "$profiles_iccid")"
		else
			# An ICCID that does not normalise is not evidence, so the profile
			# gets no handle and cannot be targeted. It is still listed, because
			# hiding it would report an eUICC as holding less than it does.
			profiles_handle=""
			profiles_suffix=""
		fi
		profiles_iccid=""
		# Exact normalised values only. A state that is not exactly `enabled` or
		# `disabled` is `unknown` and the profile may not be targeted, so the
		# nearest match is never taken -- and a class this version does not
		# recognise is not resolved to the closest one either.
		profiles_state="$(json_element_field "$profiles_data" "$profiles_at" profileState)"
		case "$profiles_state" in enabled|disabled) : ;; *) profiles_state=unknown ;; esac
		profiles_class="$(json_element_field "$profiles_data" "$profiles_at" profileClass)"
		case "$profiles_class" in operational|provisioning|test) : ;; *) profiles_class=unknown ;; esac
		# Whether an icon exists, never the image data. Carrying it through a
		# read the page polls is a cost with no matching benefit, and v1 has no
		# verb that returns one.
		profiles_icon="$(json_element_field "$profiles_data" "$profiles_at" icon)"
		profiles_icon_present=0
		[ -z "$profiles_icon" ] || profiles_icon_present=1
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
			"$profiles_handle" "$profiles_suffix" "$profiles_state" "$profiles_class" \
			"$(json_element_field "$profiles_data" "$profiles_at" profileNickname | tr -d '\t\r\n')" \
			"$(json_element_field "$profiles_data" "$profiles_at" profileName | tr -d '\t\r\n')" \
			"$(json_element_field "$profiles_data" "$profiles_at" serviceProviderName | tr -d '\t\r\n')" \
			"$profiles_icon_present" >>"$profiles_out"
	done
	return 0
}

# `notification list`, once, over the bridge, into a record per notification:
#   <sequence><TAB><operation><TAB><address><TAB><profile_id>
#
# A notification's profile handle is present only when its ICCID normalises; a
# notification about a profile that is gone keeps its sequence number and
# reports no profile, because the sequence number is what sending and removing
# it need.
read_notifications_through_lpa() {
	notifications_endpoint="$1"
	notifications_owner="$2"
	notifications_candidates="$3"
	notifications_bearer="$4"
	notifications_out="$5"
	: >"$notifications_out"
	command_exists "$JSONFILTER" || return 3
	bridge_status=0
	bridge_run "$notifications_endpoint" "$notifications_owner" "$notifications_candidates" "$notifications_bearer" notification list || bridge_status=$?
	[ "$bridge_status" -eq 0 ] || return "$bridge_status"
	notifications_data="$(lpa_result_data 2>/dev/null || :)"
	[ -n "$notifications_data" ] || return 3
	notifications_count="$(json_array_length "$notifications_data")"
	notifications_index=0
	notifications_parsed=0
	while [ "$notifications_index" -lt "$notifications_count" ]; do
		notifications_at="$notifications_index"
		notifications_index=$((notifications_index + 1))
		notifications_seq="$(json_element_field "$notifications_data" "$notifications_at" seqNumber)"
		case "$notifications_seq" in ''|*[!0-9]*) continue ;; esac
		notifications_operation="$(json_element_field "$notifications_data" "$notifications_at" profileManagementOperation)"
		case "$notifications_operation" in
			install|enable|disable|delete) : ;;
			*) notifications_operation=unknown ;;
		esac
		notifications_iccid="$(normalise_iccid \
			"$(json_element_field "$notifications_data" "$notifications_at" iccid)" 2>/dev/null || :)"
		notifications_handle=""
		if [ -n "$notifications_iccid" ]; then
			notifications_handle="$(profile_handle_from_iccid "$notifications_iccid" 2>/dev/null || :)"
		fi
		notifications_iccid=""
		notifications_parsed=$((notifications_parsed + 1))
		printf '%s\t%s\t%s\t%s\n' \
			"$notifications_seq" "$notifications_operation" \
			"$(json_element_field "$notifications_data" "$notifications_at" notificationAddress | tr -d '\t\r\n')" \
			"$notifications_handle" >>"$notifications_out"
	done
	# An answer with entries in it that yielded not one notification is an
	# answer this bridge could not interpret, and publishing it as an empty list
	# would say the card holds no pending notification -- a statement about the
	# card made out of a failure to read one.
	if [ "$notifications_count" -gt 0 ] && [ "$notifications_parsed" -eq 0 ]; then
		: >"$notifications_out"
		return 3
	fi
	return 0
}

# ---- the published documents ----
#
# Runtime capability, implementation maturity and validation evidence are three
# separate fields and stay separate. A reader who finds a capability described
# in detail must not read that detail as a claim that it works, and a green
# fixture suite moves the evidence field to `synthetic` and no further.
#
# The evidence field says `hardware` from 2026-09-10, and only because a card
# answered: every verb in this package's capability table has now been driven
# from the page against a real eUICC on the reference board -- reading,
# downloading, renaming, enabling, disabling, deleting, and both notification
# verbs including the refusal that guards the destructive one. The maturity
# field deliberately stays `alpha` beside it, because evidence is not maturity:
# the AT-driven path on the second modem has known defects, the direct QMI and
# MBIM producers are a gap rather than an untested path, and no board here has
# a second SIM slot to prove a slot change on.
#
# Nothing published here carries a raw EID, a raw ICCID or an IMSI. `eid_suffix`
# and `iccid_suffix` are the last four characters and are the whole of what a
# display gets.
IMPLEMENTATION_STATE=alpha
VALIDATION_STATE=hardware
HARDWARE_VALIDATED=1

print_endpoint_capabilities() {
	capability_reachable="$1"
	capability_tier="$2"
	capability_read=0
	[ "$capability_reachable" = yes ] && [ -x "$LPAC_RUN" ] && capability_read=1
	capability_takeover=0
	[ "$capability_reachable" = requires-inhibit ] && capability_takeover=1
	printf '"capabilities":{'
	json_key_boolean inventory 1; printf ','
	json_key_boolean profile_list "$capability_read"; printf ','
	json_key_boolean notification_list "$capability_read"; printf ','
	json_key_boolean read_takeover "$capability_takeover"; printf ','
	capability_additive=0
	if [ "$capability_tier" = eid ] && [ -x "$LPAC_RUN" ]; then
		case "$capability_reachable" in yes|requires-inhibit) capability_additive=1 ;; esac
	fi
	json_key_boolean download "$capability_additive"; printf ','
	json_key_boolean nickname "$capability_additive"; printf ','
	json_key_boolean enable "$capability_additive"; printf ','
	json_key_boolean disable "$capability_additive"; printf ','
	json_key_boolean delete "$capability_additive"; printf ','
	json_key_boolean notification_send "$capability_additive"; printf ','
	json_key_boolean notification_remove "$capability_additive"
	# There is deliberately no slot-change capability here. A modem has slots
	# whether or not either holds an eUICC, and both may hold ordinary SIMs, so
	# the question is not one an eSIM endpoint can answer. It is published on
	# the modem record as `capabilities.slot_switch`, and it is performed by
	# `apn-autoconfig-modem action-start slot-switch`.
	printf '}'
	# A slot-weak endpoint is read-only inventory whatever the matrix says: no
	# mutation may target it and no operation may be started against it, not to
	# fix it and not to make it identifiable.
	[ "$capability_tier" = eid ] || :
}

print_endpoint_json() {
	endpoint_line="$1"
	endpoint_profile_count="${2:-}"
	endpoint_enabled_profile="${3:-}"
	endpoint_notification_count="${4:-}"
	endpoint_read_state="${5:-unknown}"
	endpoint_read_age="${6:-0}"
	endpoint_free_memory="${7:-}"
	endpoint_installed_applications="${8:-}"
	printf '{'
	json_key_string endpoint_id "$(field "$endpoint_line" 1)"; printf ','
	json_key_string evidence_tier "$(field "$endpoint_line" 2)"; printf ','
	json_key_string modem_id "$(field "$endpoint_line" 3)"; printf ','
	json_key_number attachment_generation "$(field "$endpoint_line" 4)"; printf ','
	json_key_number slot "$(field "$endpoint_line" 5)"; printf ','
	json_key_number slot_count "$(field "$endpoint_line" 6)"; printf ','
	json_key_boolean slot_active "$(field "$endpoint_line" 7)"; printf ','
	json_key_string slot_class "$(field "$endpoint_line" 8)"; printf ','
	json_key_boolean eid_known "$(field "$endpoint_line" 9)"; printf ','
	json_key_string eid_suffix "$(field "$endpoint_line" 10)"; printf ','
	json_key_string eid_source "$(field "$endpoint_line" 18)"; printf ','
	json_key_string transport "$(field "$endpoint_line" 11)"; printf ','
	json_key_string transport_device "$(field "$endpoint_line" 12)"; printf ','
	json_key_string owner_state "$(field "$endpoint_line" 13)"; printf ','
	json_key_string reachable "$(field "$endpoint_line" 14)"; printf ','
	json_key_string reachable_reason "$(field "$endpoint_line" 15)"; printf ','
	# Counts are null when nothing was read. An abandoned or refused read may
	# never be reported as an observation of emptiness, so this is `null` and
	# never `0`.
	json_key_number profile_count "$endpoint_profile_count"; printf ','
	json_key_string enabled_profile_id "$endpoint_enabled_profile"; printf ','
	json_key_number notification_count "$endpoint_notification_count"; printf ','
	# What the card says it has left, and how many applications it is carrying.
	# Both are `null` until a read of the card produced them, and both are an
	# observation about the eUICC rather than a prediction about any download:
	# how large a profile is is not knowable before it arrives, which is why
	# SGP.22 has the card refuse at install time.
	json_key_number free_memory_bytes "$endpoint_free_memory"; printf ','
	json_key_number installed_applications "$endpoint_installed_applications"; printf ','
	print_endpoint_capabilities "$(field "$endpoint_line" 14)" "$(field "$endpoint_line" 2)"
	printf ','
	# Where a `requires-slot-change` endpoint stops being a dead end.
	#
	# This package no longer changes slots and never should have: a modem has
	# slots whether or not either holds an eUICC. But an endpoint sitting in an
	# inactive slot still has to say what would reach it, or a page can only
	# report a state with no way out of it. So it names the operation that can:
	# `apn-autoconfig-modem action-start slot-switch`, on this modem, to this
	# slot, described first by `slot-switch-plan`.
	#
	# `required` is false for every endpoint a read can already reach. The
	# modem, the slot and the operation are published either way, because a
	# consumer that has to branch on presence to learn shape is a consumer that
	# will get it wrong once.
	printf '"slot_change":{'
	json_key_boolean required \
		"$([ "$(field "$endpoint_line" 14)" = requires-slot-change ] && printf 1 || printf 0)"
	printf ','
	json_key_string operation slot-switch; printf ','
	json_key_string performed_by apn-autoconfig-modem; printf ','
	json_key_string modem_id "$(field "$endpoint_line" 3)"; printf ','
	json_key_number slot "$(field "$endpoint_line" 5)"
	printf '},'
	json_key_string implementation_state "$IMPLEMENTATION_STATE"; printf ','
	json_key_string validation_state "$VALIDATION_STATE"; printf ','
	json_key_boolean hardware_validated "$HARDWARE_VALIDATED"; printf ','
	json_key_string read_state "$endpoint_read_state"; printf ','
	json_key_number read_age_seconds "$endpoint_read_age"; printf ','
	json_key_boolean ambiguous "$(field "$endpoint_line" 16)"; printf ','
	json_key_string ambiguity_reason "$(field "$endpoint_line" 17)"
	printf '}'
}

# The modems this package looked at, and what it was able to learn about their
# slots. Present so that a modem whose owner will not discuss its slots is
# visibly unread rather than absent: "no endpoint" and "could not determine
# whether there is one" are different answers and a page must be able to tell
# them apart.
print_modems_json() {
	printf '"modems":['
	modems_separator=""
	while IFS= read -r modems_indexed; do
		modems_index="${modems_indexed%%"$TAB"*}"
		modems_line="${modems_indexed#*"$TAB"}"
		modems_id="$(field "$modems_line" 2)"
		[ -n "$modems_id" ] || continue
		modems_section="$(modem_section_at "$modems_index")"
		modems_source="$(section_field "$modems_section" slots 2)"
		[ -n "$modems_source" ] || modems_source=none
		modems_count="$(section_field "$modems_section" slots 3)"
		modems_active="$(section_field "$modems_section" slots 4)"
		modems_reason=""
		if [ "$modems_source" = none ]; then
			case "$(field "$modems_line" 3)" in
				modemmanager) modems_reason=slots-not-published ;;
				conflicting|transitioning) modems_reason=owner-conflicting ;;
				*) modems_reason=owner-does-not-publish-slots ;;
			esac
		fi
		printf '%s{' "$modems_separator"
		json_key_string modem_id "$modems_id"; printf ','
		json_key_string owner_state "$(field "$modems_line" 3)"; printf ','
		json_key_string slot_source "$modems_source"; printf ','
		json_key_boolean slots_read "$([ "$modems_source" = none ] && printf 0 || printf 1)"; printf ','
		json_key_number slot_count "$modems_count"; printf ','
		json_key_number active_slot "$modems_active"; printf ','
		json_key_string slots_unread_reason "$modems_reason"; printf ','
		# The question the eSIM area of a page actually asks. It exists for
		# every modem; opening it asks the active slot what is in it, and there
		# are three answers rather than two -- an eUICC to manage, no eUICC
		# there, or nobody could ask and here is why. Telling somebody they
		# have no eSIM when the modem was merely busy sends them away from a
		# subscription they own.
		# The file name is checked, not assumed. `awk` with an empty operand
		# reads standard input, which in a command substitution inside a loop
		# is a hang rather than an error.
		modems_active_euicc="unknown$TAB"
		if [ -n "$ACTIVE_SLOT_FILE" ] && [ -f "$ACTIVE_SLOT_FILE" ]; then
			modems_active_euicc="$(awk -F '\t' -v modem="$modems_id" \
				'$1 == modem { answer = $2; reason = $3 }
				 END { print (answer == "" ? "unknown" : answer) "\t" reason }' \
				"$ACTIVE_SLOT_FILE" 2>/dev/null || printf 'unknown\t')"
		fi
		json_key_string active_slot_euicc "${modems_active_euicc%%"$TAB"*}"; printf ','
		json_key_string active_slot_reason "${modems_active_euicc#*"$TAB"}"
		printf '}'
		modems_separator=','
	done <"$MODEM_LINES_FILE"
	printf ']'
}

# ---- verbs ----

require_endpoint_target() {
	[ -n "$REQUESTED_MODEM" ] || die_code "$EXIT_USAGE" "$COMMAND_NAME requires --modem"
	[ -n "$REQUESTED_ENDPOINT" ] || die_code "$EXIT_USAGE" "$COMMAND_NAME requires --endpoint"
	safe_token "$REQUESTED_MODEM" || die_code "$EXIT_USAGE" "invalid modem identity"
	safe_token "$REQUESTED_ENDPOINT" || die_code "$EXIT_USAGE" "invalid endpoint identity"
	load_modem_records "$REQUESTED_MODEM" || \
		die_code "$EXIT_RETRYABLE" "the modem inventory could not be read"
	enumerate_endpoints
	# An operation names both a modem and an endpoint and both are revalidated,
	# because naming only the endpoint leaves the path to it unproven and naming
	# only the modem leaves the chip unproven. A removable eUICC that moved
	# between two attached modems is the case that makes that concrete.
	TARGET_LINE="$(awk -F '\t' -v modem="$REQUESTED_MODEM" -v endpoint="$REQUESTED_ENDPOINT" '
		$3 == modem && $1 == endpoint { print; count++ }
		END { if (count != 1) exit 3 }
	' "$ENDPOINT_FILE")" || \
		die_code "$EXIT_BLOCKED" "no single endpoint matches $REQUESTED_ENDPOINT on the named modem"
	[ -n "$TARGET_LINE" ] || \
		die_code "$EXIT_BLOCKED" "no single endpoint matches $REQUESTED_ENDPOINT on the named modem"
	[ "$(field "$TARGET_LINE" 16)" = 0 ] || \
		die_code "$EXIT_BLOCKED" "endpoint $REQUESTED_ENDPOINT is ambiguous and may not be targeted"
	return 0
}

# The modem alone, for the one operation that cannot name an endpoint because it
# exists to find out whether there is one.
#
# It revalidates exactly what an endpoint target does, minus the endpoint: one
# unambiguous modem, and its section. Two modems that cannot be told apart are
# refused here for the reason they are refused there -- a card channel must
# never be reached from the wrong modem's record.
TARGET_MODEM_LINE=""
TARGET_MODEM_INDEX=""
TARGET_MODEM_SECTION=""

# The same resolution, reporting rather than dying, because a worker that dies
# publishes nothing and a caller polling its result would wait for a terminal
# state that never comes. `require_modem_target` is this plus the refusals, for
# the read verbs where dying *is* the report.
#
#   1  no such modem, or more than one, or an ambiguous one
#   2  the inventory could not be read
resolve_modem_target() {
	TARGET_MODEM_LINE=""
	TARGET_MODEM_INDEX=""
	TARGET_MODEM_SECTION=""
	[ -n "$REQUESTED_MODEM" ] || return 1
	safe_token "$REQUESTED_MODEM" || return 1
	load_modem_records "$REQUESTED_MODEM" || return 2
	modem_target_matches=0
	# A here-document rather than a pipe: a `while read` on the right of a pipe
	# runs in a subshell and every assignment below would be discarded with it.
	while IFS= read -r modem_target_indexed; do
		[ -n "$modem_target_indexed" ] || continue
		modem_target_index="${modem_target_indexed%%"$TAB"*}"
		modem_target_line="${modem_target_indexed#*"$TAB"}"
		[ "$(field "$modem_target_line" 2)" = "$REQUESTED_MODEM" ] || continue
		modem_target_matches=$((modem_target_matches + 1))
		TARGET_MODEM_LINE="$modem_target_line"
		TARGET_MODEM_INDEX="$modem_target_index"
	done <<MODEM_TARGETS
$(modem_record_lines)
MODEM_TARGETS
	[ "$modem_target_matches" -eq 1 ] || return 1
	[ "$(field "$TARGET_MODEM_LINE" 5)" != 1 ] || return 1
	TARGET_MODEM_SECTION="$(modem_section_at "$TARGET_MODEM_INDEX")"
	[ -n "$TARGET_MODEM_SECTION" ] || return 2
	return 0
}

require_modem_target() {
	[ -n "$REQUESTED_MODEM" ] || die_code "$EXIT_USAGE" "$COMMAND_NAME requires --modem"
	safe_token "$REQUESTED_MODEM" || die_code "$EXIT_USAGE" "invalid modem identity"
	modem_require_status=0
	resolve_modem_target || modem_require_status=$?
	case "$modem_require_status" in
		0) return 0 ;;
		2) die_code "$EXIT_RETRYABLE" "the modem inventory could not be read" ;;
		*) die_code "$EXIT_BLOCKED" "no single unambiguous modem matches $(mask_modem_id "$REQUESTED_MODEM")" ;;
	esac
}

capabilities_json_cmd() {
	printf '{'
	json_key_string version v1; printf ','
	json_key_string implementation_state "$IMPLEMENTATION_STATE"; printf ','
	json_key_string validation_state "$VALIDATION_STATE"; printf ','
	json_key_boolean hardware_validated "$HARDWARE_VALIDATED"; printf ','
	printf '"present":{'
	json_key_boolean lpa "$([ -x "$LPAC_RUN" ] && printf 1 || printf 0)"; printf ','
	json_key_boolean modem_inventory "$(command_exists "$MODEM_BIN" && printf 1 || printf 0)"; printf ','
	json_key_boolean digest "$(command_exists "$SHA256" && printf 1 || printf 0)"; printf ','
	json_key_boolean json_reader "$(command_exists "$JSONFILTER" && printf 1 || printf 0)"; printf ','
	json_key_boolean http_client "$([ -x "$HTTP_CLIENT" ] && printf 1 || printf 0)"; printf ','
	json_key_boolean bounded_read "$(at_read_timeout_supported && printf 1 || printf 0)"
	printf '},'
	printf '"transports":{'
	json_key_boolean at 1; printf ','
	# QMI is P5's and is present exactly when its client is installed: it is a
	# separate executable, and a package that shipped without it would otherwise
	# claim a transport it cannot open. MBIM is still this project's to write
	# and is not written -- naming it false is the difference between a
	# transport that failed and one that was never built.
	json_key_boolean qmi "$([ -x "$UIM_CLIENT" ] && printf 1 || printf 0)"; printf ','
	json_key_boolean mbim 0
	printf '},'
	json_key_number cache_ttl_seconds "$ESIM_CACHE_TTL_SECONDS"
	printf '}\n'
}

trust_store_json_cmd() {
	[ -x "$HTTP_CLIENT" ] || die_code "$EXIT_BLOCKED" "the ES9+ HTTP client is not installed"
	exec "$HTTP_CLIENT" --inspect-trust
}

esim_inventory_json_cmd() {
	read_deadline_arm
	inventory_status=0
	if [ -n "$REQUESTED_MODEM" ]; then
		safe_token "$REQUESTED_MODEM" || die_code "$EXIT_USAGE" "invalid modem identity"
		load_modem_records "$REQUESTED_MODEM" || inventory_status=$?
	else
		load_modem_records || inventory_status=$?
	fi
	if [ "$inventory_status" -ne 0 ]; then
		# A read that ran out of time is not an error and is not an
		# observation. It returns a well-formed document that says what it
		# abandoned, and it says nothing about what is there -- so `endpoints`
		# is null and never the empty array, which would claim this router has
		# no eUICC.
		read_was_abandoned slot-status || \
			die_code "$EXIT_RETRYABLE" "the modem inventory could not be read"
		read_abandon esim-endpoints
		printf '{'
		json_key_string version v1; printf ','
		printf '"endpoints":null,"modems":null'
		print_incomplete_fields
		printf '}\n'
		return 0
	fi
	enumerate_endpoints
	printf '{'
	json_key_string version v1; printf ','
	printf '"endpoints":['
	inventory_separator=""
	while IFS= read -r inventory_line; do
		[ -n "$inventory_line" ] || continue
		printf '%s' "$inventory_separator"
		# The inventory publishes no profile or notification counts. Obtaining
		# one means opening a channel to the card, which a list of endpoints is
		# not entitled to do on every poll; `esim-status-json` is where a
		# consumer asks for one endpoint and pays for it.
		print_endpoint_json "$inventory_line" "" "" "" unknown 0
		inventory_separator=','
	done <"$ENDPOINT_FILE"
	printf '],'
	print_modems_json
	print_incomplete_fields
	printf '}\n'
}

# One endpoint, with the counts a read can obtain. The read happens only where
# the matrix permits it; everywhere else the counts stay unknown and the reason
# says why, which is the whole of this step's answer to an endpoint it cannot
# reach.
esim_status_json_cmd() {
	read_deadline_arm
	require_endpoint_target
	status_reachable="$(field "$TARGET_LINE" 14)"
	status_endpoint="$(field "$TARGET_LINE" 1)"
	status_profile_count=""
	status_enabled_profile=""
	status_notification_count=""
	status_read_state=unknown
	status_read_age=0
	status_free_memory=""
	status_installed_applications=""
	if [ "$status_reachable" = yes ]; then
		if esim_read_endpoint "$TARGET_LINE"; then
			status_profile_count="$ENDPOINT_PROFILE_COUNT"
			status_enabled_profile="$ENDPOINT_ENABLED_PROFILE"
			status_notification_count="$ENDPOINT_NOTIFICATION_COUNT"
			status_read_state="$CACHE_READ_STATE"
			status_read_age="$CACHE_READ_AGE"
			status_free_memory="$ENDPOINT_FREE_MEMORY"
			status_installed_applications="$ENDPOINT_INSTALLED_APPLICATIONS"
		fi
	fi
	printf '{'
	json_key_string version v1; printf ','
	printf '"endpoint":'
	print_endpoint_json "$TARGET_LINE" "$status_profile_count" "$status_enabled_profile" \
		"$status_notification_count" "$status_read_state" "$status_read_age" \
		"$status_free_memory" "$status_installed_applications"
	print_incomplete_fields
	printf '}\n'
}

ENDPOINT_PROFILE_COUNT=""
ENDPOINT_ENABLED_PROFILE=""
ENDPOINT_NOTIFICATION_COUNT=""
ENDPOINT_PROFILES_FILE=""

# The counts for one reachable endpoint, from the cache when the whole key
# matches and from the card otherwise. Returns non-zero when neither answered,
# and leaves every count empty rather than zero when it does.
# What the card says it has left, from the answer this package already asks for.
#
# `chip info` returns EUICCInfo2, and the pinned LPA publishes
# `extCardResource.freeNonVolatileMemory` and `.installedApplication` inside it
# -- so the number costs one more invocation of a call whose shape is already
# understood, and nothing new is opened.
#
# It is deliberately *not* a prediction. Nothing in SGP.22 says how large a
# profile will be before it is downloaded, which is exactly why the standard has
# an `installFailedDueToInsufficientMemoryForProfile` result at install time:
# the card decides when it has the package. So this is published as an
# observation about the card and never as "this download will fit".
ENDPOINT_FREE_MEMORY=""
ENDPOINT_INSTALLED_APPLICATIONS=""

read_card_resource_through_lpa() {
	resource_endpoint="$1"
	resource_owner="$2"
	resource_candidates="$3"
	resource_bearer="$4"
	ENDPOINT_FREE_MEMORY=""
	ENDPOINT_INSTALLED_APPLICATIONS=""
	command_exists "$JSONFILTER" || return 3
	resource_status=0
	bridge_run "$resource_endpoint" "$resource_owner" "$resource_candidates" \
		"$resource_bearer" chip info || resource_status=$?
	[ "$resource_status" -eq 0 ] || return "$resource_status"
	resource_data="$(lpa_result_data 2>/dev/null || :)"
	[ -n "$resource_data" ] || return 3
	resource_free="$(json_query "$resource_data" '@.EUICCInfo2.extCardResource.freeNonVolatileMemory')"
	resource_apps="$(json_query "$resource_data" '@.EUICCInfo2.extCardResource.installedApplication')"
	# A card that does not publish the resource extension is not a card with no
	# room: an unparseable or absent answer stays unknown.
	case "$resource_free" in ''|*[!0-9]*) resource_free="" ;; esac
	case "$resource_apps" in ''|*[!0-9]*) resource_apps="" ;; esac
	ENDPOINT_FREE_MEMORY="$resource_free"
	ENDPOINT_INSTALLED_APPLICATIONS="$resource_apps"
	return 0
}

# The resource figures a previous read left in the cache, and nothing else. It
# opens no channel: a document that would have to take the modem to answer says
# nothing instead.
# What a read of the card produced, written where the read path looks for it.
#
# An operation that changed the card invalidates the cache first -- the old list
# is a lie the moment anything is written -- and until 2026-09-03 nothing put a
# new one back. So a person who added a subscription was told the card "could
# not be determined" and had to consent to a second interruption to see what
# they had just bought. The operation is already holding the card; leaving what
# it read is free, and the alternative is charging the user an outage for it.
cache_store_card_read() {
	store_endpoint="$1"
	store_line="$2"
	store_profiles="$3"
	store_notifications="$4"
	store_free="$5"
	store_apps="$6"
	[ -s "$store_profiles" ] || return 1
	cache_store "$(profiles_cache_file_for "$store_line")" profiles \
		"$store_endpoint" "$ESIM_CARD_READ_TTL_SECONDS" <"$store_profiles" || :
	store_notification_count=""
	if [ -n "$store_notifications" ] && [ -f "$store_notifications" ]; then
		cache_store "$(notifications_cache_file_for "$store_line")" notifications \
			"$store_endpoint" "$ESIM_CARD_READ_TTL_SECONDS" <"$store_notifications" || :
		store_notification_count="$(wc -l <"$store_notifications" | tr -d ' ')"
	fi
	store_key="$(cache_key_hash "$store_endpoint" "$(field "$store_line" 3)" \
		"$(field "$store_line" 4)" "$(field "$store_line" 5)" "$(field "$store_line" 7)" \
		"$(field "$store_line" 13)" "$(modem_operation_id "$(field "$store_line" 19)")" \
		2>/dev/null || :)"
	[ -n "$store_key" ] || return 0
	printf '%s\t%s\t%s\t%s\t%s\n' "$(wc -l <"$store_profiles" | tr -d ' ')" \
		"$(awk -F '\t' '$3 == "enabled" { print $1; exit }' "$store_profiles")" \
		"$store_notification_count" "$store_free" "$store_apps" | \
		cache_store "$(cache_path endpoint "$store_endpoint" "$store_key")" \
			endpoint "$store_endpoint" "$ESIM_CARD_READ_TTL_SECONDS" || :
	return 0
}

esim_cached_endpoint_resources() {
	resources_line="$1"
	ENDPOINT_FREE_MEMORY=""
	ENDPOINT_INSTALLED_APPLICATIONS=""
	resources_key="$(cache_key_hash "$(field "$resources_line" 1)" "$(field "$resources_line" 3)" \
		"$(field "$resources_line" 4)" "$(field "$resources_line" 5)" "$(field "$resources_line" 7)" \
		"$(field "$resources_line" 13)" "$(modem_operation_id "$(field "$resources_line" 19)")")" || return 1
	resources_cached="$(cache_load \
		"$(cache_path endpoint "$(field "$resources_line" 1)" "$resources_key")" 2>/dev/null || :)"
	[ -n "$resources_cached" ] || return 1
	ENDPOINT_FREE_MEMORY="$(field "$resources_cached" 4)"
	ENDPOINT_INSTALLED_APPLICATIONS="$(field "$resources_cached" 5)"
	return 0
}

esim_read_endpoint() {
	read_line="$1"
	ENDPOINT_PROFILE_COUNT=""
	ENDPOINT_ENABLED_PROFILE=""
	ENDPOINT_NOTIFICATION_COUNT=""
	ENDPOINT_FREE_MEMORY=""
	ENDPOINT_INSTALLED_APPLICATIONS=""
	read_endpoint_id="$(field "$read_line" 1)"
	read_key="$(cache_key_hash "$read_endpoint_id" "$(field "$read_line" 3)" \
		"$(field "$read_line" 4)" "$(field "$read_line" 5)" "$(field "$read_line" 7)" \
		"$(field "$read_line" 13)" "$(modem_operation_id "$(field "$read_line" 19)")")" || return 1
	read_cache_file="$(cache_path endpoint "$read_endpoint_id" "$read_key")"
	read_cached="$(cache_load "$read_cache_file" 2>/dev/null || :)"
	if [ -n "$read_cached" ]; then
		ENDPOINT_PROFILE_COUNT="$(field "$read_cached" 1)"
		ENDPOINT_ENABLED_PROFILE="$(field "$read_cached" 2)"
		ENDPOINT_NOTIFICATION_COUNT="$(field "$read_cached" 3)"
		ENDPOINT_FREE_MEMORY="$(field "$read_cached" 4)"
		ENDPOINT_INSTALLED_APPLICATIONS="$(field "$read_cached" 5)"
		return 0
	fi
	esim_load_profiles "$read_line" || return 1
	read_notifications_file="$TMP_BASE.lpa-data"
	if read_notifications_through_lpa "$(field "$read_line" 1)" "$(esim_lpa_owner "$read_line")" \
		"$(esim_transport_candidates "$read_line")" "$(esim_bearer_device "$read_line")" \
		"$read_notifications_file"; then
		ENDPOINT_NOTIFICATION_COUNT="$(wc -l <"$read_notifications_file" | tr -d ' ')"
	fi
	ENDPOINT_PROFILE_COUNT="$(wc -l <"$ENDPOINT_PROFILES_FILE" | tr -d ' ')"
	ENDPOINT_ENABLED_PROFILE="$(awk -F '\t' '$3 == "enabled" { print $1; exit }' "$ENDPOINT_PROFILES_FILE")"
	# The card is already open and the locks are already held; a card that will
	# not answer this leaves it unknown rather than failing the read.
	read_card_resource_through_lpa "$(field "$read_line" 1)" "$(esim_lpa_owner "$read_line")" \
		"$(esim_transport_candidates "$read_line")" "$(esim_bearer_device "$read_line")" || :
	printf '%s\t%s\t%s\t%s\t%s\n' "$ENDPOINT_PROFILE_COUNT" "$ENDPOINT_ENABLED_PROFILE" \
		"$ENDPOINT_NOTIFICATION_COUNT" "$ENDPOINT_FREE_MEMORY" \
		"$ENDPOINT_INSTALLED_APPLICATIONS" | cache_store "$read_cache_file" endpoint "$read_endpoint_id"
	CACHE_READ_STATE=fresh
	CACHE_READ_AGE=0
	return 0
}

# The owner the launcher is told about. It is the modem's observed owner, not a
# preference: `lpac-run` refuses `modemmanager`, refuses an unstated owner and
# refuses a netifd bearer its own control port, and passing anything other than
# what was observed would be walking around those refusals from the inside.
esim_lpa_owner() {
	printf '%s\n' "$(field "$1" 13)"
}

# The node the bearer is holding, which the launcher needs so it can check that
# the port we are about to open is not that one. Resolved through the endpoint's
# own section index rather than through its modem_id, for the reason
# index_modem_sections records.
esim_bearer_device() {
	printf '%s\n' "$(section_device "$(modem_section_at "$(field "$1" 19)")" bearer)"
}

# Every control port this endpoint's modem offers that the bearer is not
# holding, in port order.
#
# A list rather than the one port the record publishes, because the record is
# produced by a read that may not probe: it names a candidate, and only the
# transaction that holds a lock and a bound may find out which candidate
# answers. On the reference router's RM520N-GL four ports are offered and two
# reply, and the two that reply are not the two with the lowest numbers.
esim_transport_candidates() {
	candidates_section="$(modem_section_at "$(field "$1" 19)")"
	control_candidates "$candidates_section" "$(section_device "$candidates_section" bearer)" |
		tr '\n' ' '
}

modem_operation_id() {
	section_field "$(modem_section_at "$1")" operation 2
}

esim_load_profiles() {
	profiles_line="$1"
	ENDPOINT_PROFILES_FILE="$TMP_BASE.lpa-profiles"
	profiles_status=0
	read_profiles_through_lpa "$(field "$profiles_line" 1)" "$(esim_lpa_owner "$profiles_line")" \
		"$(esim_transport_candidates "$profiles_line")" "$(esim_bearer_device "$profiles_line")" \
		"$ENDPOINT_PROFILES_FILE" || profiles_status=$?
	if [ "$profiles_status" -ne 0 ]; then
		read_abandon esim-profiles budget
		return 1
	fi
	return 0
}

# Where a profile list for this endpoint is cached.
#
# Derived in one place because two callers must agree on it exactly: the read
# path looks here, and a consented takeover writes here. When they disagreed,
# the takeover interrupted the bearer, read the card, counted what it found and
# dropped it, and the next read still had nothing to show.
profiles_cache_file_for() {
	cache_path profiles "$(field "$1" 1)" "$(cache_key_hash "$(field "$1" 1)" \
		"$(field "$1" 3)" "$(field "$1" 4)" "$(field "$1" 5)" "$(field "$1" 7)" \
		"$(field "$1" 13)" "$(modem_operation_id "$(field "$1" 19)")")"
}

# The same arrangement for notifications, and for the same reason. It was
# missing, and the consequence was not cosmetic: a notification's sequence
# number is the only way to name it in `notification-send`, the number comes
# only from this list, and on a ModemManager-owned endpoint the list was
# unobtainable -- so the verb that tells an SM-DP+ what happened to its profile
# could not be driven at all on the hardware this project targets.
notifications_cache_file_for() {
	cache_path notifications "$(field "$1" 1)" "$(cache_key_hash "$(field "$1" 1)" \
		"$(field "$1" 3)" "$(field "$1" 4)" "$(field "$1" 5)" "$(field "$1" 7)" \
		"$(field "$1" 13)" "$(modem_operation_id "$(field "$1" 19)")")"
}

profiles_json_cmd() {
	read_deadline_arm
	require_endpoint_target
	profiles_reachable="$(field "$TARGET_LINE" 14)"
	profiles_endpoint="$(field "$TARGET_LINE" 1)"
	profiles_state=unknown
	profiles_age=0
	profiles_have=0
	profiles_cache_file="$(profiles_cache_file_for "$TARGET_LINE")"
	ENDPOINT_PROFILES_FILE="$TMP_BASE.lpa-profiles"
	if cache_load "$profiles_cache_file" >"$ENDPOINT_PROFILES_FILE" 2>/dev/null && \
		[ "$CACHE_READ_STATE" = cached ]; then
		# Served whatever the endpoint's reachability is now. An endpoint behind
		# ModemManager cannot be read at this moment, but a consented takeover
		# may have read it already, and handing that back is the entire reason
		# the takeover was allowed to interrupt anything. It is published as
		# `cached` with its age, never as a current observation.
		profiles_have=1
		profiles_state=cached
		profiles_age="$CACHE_READ_AGE"
	elif [ "$profiles_reachable" = yes ] && esim_load_profiles "$TARGET_LINE"; then
		profiles_have=1
		profiles_state=fresh
		profiles_age=0
		cache_store "$profiles_cache_file" profiles "$profiles_endpoint" <"$ENDPOINT_PROFILES_FILE"
	fi
	esim_cached_endpoint_resources "$TARGET_LINE" || :
	printf '{'
	json_key_string version v1; printf ','
	json_key_string endpoint_id "$profiles_endpoint"; printf ','
	json_key_string modem_id "$(field "$TARGET_LINE" 3)"; printf ','
	json_key_string reachable "$profiles_reachable"; printf ','
	# What the card said it had left when it was last read, so a page that shows
	# the subscriptions can show it beside them without opening anything. Null
	# until a read produced it, and an observation about the eUICC rather than a
	# claim about any download.
	json_key_number free_memory_bytes "$ENDPOINT_FREE_MEMORY"; printf ','
	json_key_number installed_applications "$ENDPOINT_INSTALLED_APPLICATIONS"; printf ','
	json_key_string reachable_reason "$(field "$TARGET_LINE" 15)"; printf ','
	json_key_string read_state "$profiles_state"; printf ','
	json_key_number read_age_seconds "$profiles_age"; printf ','
	# A read that did not happen publishes no list at all, rather than an empty
	# one. An empty array here would say the eUICC holds no subscriptions, which
	# is a statement about the card and not about the read.
	if [ "$profiles_have" -eq 0 ]; then
		printf '"profiles":null'
	else
		printf '"profiles":['
		profiles_separator=""
		while IFS= read -r profiles_line; do
			[ -n "$profiles_line" ] || continue
			printf '%s{' "$profiles_separator"
			json_key_string profile_id "$(field "$profiles_line" 1)"; printf ','
			json_key_string iccid_suffix "$(field "$profiles_line" 2)"; printf ','
			json_key_string state "$(field "$profiles_line" 3)"; printf ','
			json_key_string class "$(field "$profiles_line" 4)"; printf ','
			json_key_string nickname "$(field "$profiles_line" 5)"; printf ','
			json_key_string profile_name "$(field "$profiles_line" 6)"; printf ','
			json_key_string provider_name "$(field "$profiles_line" 7)"; printf ','
			# The LPA's profile list carries no operator code, so this is
			# unknown rather than absent-and-therefore-empty. It is published
			# because it is what would let a page name an operator before a
			# profile is enabled, and because the APN database is keyed on it.
			json_key_string provider_mccmnc ""; printf ','
			json_key_boolean icon_present "$(field "$profiles_line" 8)"
			printf '}'
			profiles_separator=','
		done <"$ENDPOINT_PROFILES_FILE"
		printf ']'
	fi
	print_incomplete_fields
	printf '}\n'
}

notifications_json_cmd() {
	read_deadline_arm
	require_endpoint_target
	notifications_reachable="$(field "$TARGET_LINE" 14)"
	notifications_endpoint="$(field "$TARGET_LINE" 1)"
	notifications_state=unknown
	notifications_age=0
	notifications_have=0
	notifications_file="$TMP_BASE.lpa-data"
	notifications_cache_file="$(notifications_cache_file_for "$TARGET_LINE")"
	# Cache first, whatever the endpoint's reachability is now, exactly as the
	# profile list is served: an endpoint behind ModemManager cannot be read at
	# this moment, and handing back what a consented takeover already read is
	# the whole reason the takeover was allowed to interrupt anything. Published
	# as `cached` with its age, never as a current observation.
	if cache_load "$notifications_cache_file" >"$notifications_file" 2>/dev/null && \
		[ "$CACHE_READ_STATE" = cached ]; then
		notifications_have=1
		notifications_state=cached
		notifications_age="$CACHE_READ_AGE"
	elif [ "$notifications_reachable" = yes ]; then
		if read_notifications_through_lpa "$(field "$TARGET_LINE" 1)" \
			"$(esim_lpa_owner "$TARGET_LINE")" \
			"$(esim_transport_candidates "$TARGET_LINE")" \
			"$(esim_bearer_device "$TARGET_LINE")" \
			"$notifications_file"; then
			notifications_have=1
			notifications_state=fresh
			cache_store "$notifications_cache_file" notifications "$notifications_endpoint" \
				<"$notifications_file"
		else
			read_abandon esim-notifications budget
		fi
	fi
	printf '{'
	json_key_string version v1; printf ','
	json_key_string endpoint_id "$notifications_endpoint"; printf ','
	json_key_string modem_id "$(field "$TARGET_LINE" 3)"; printf ','
	json_key_string reachable "$notifications_reachable"; printf ','
	json_key_string reachable_reason "$(field "$TARGET_LINE" 15)"; printf ','
	json_key_string read_state "$notifications_state"; printf ','
	json_key_number read_age_seconds "$notifications_age"; printf ','
	if [ "$notifications_have" -eq 0 ]; then
		printf '"notifications":null'
	else
		printf '"notifications":['
		notifications_separator=""
		while IFS= read -r notifications_line; do
			[ -n "$notifications_line" ] || continue
			printf '%s{' "$notifications_separator"
			json_key_number sequence "$(field "$notifications_line" 1)"; printf ','
			json_key_string operation "$(field "$notifications_line" 2)"; printf ','
			json_key_string address "$(field "$notifications_line" 3)"; printf ','
			json_key_string profile_id "$(field "$notifications_line" 4)"
			printf '}'
			notifications_separator=','
		done <"$notifications_file"
		printf ']'
	fi
	print_incomplete_fields
	printf '}\n'
}

# ---- the read takeover, described before it is offered ----
#
# Where the matrix refuses, the answer is not to refuse forever: reaching the
# eUICC requires changing something about the modem, and changing something
# about the modem is an operation. It takes the full lock order, it requires
# explicit consent obtained before it starts and named in the units the user
# experiences it in, it publishes an operation id and its stages, and it
# restores the exact captured state on every exit path.
#
# This verb is the read-only half: what a takeover *would* do, so a frontend
# can ask before it offers one. A frontend that cannot get a plan does not
# offer the takeover.

# Whether any uplink other than this modem's own interface is up. Answered
# through ubus, which is netifd's own view; `unknown` when ubus cannot be
# reached, because a guess here would be a guess about whether the user is
# about to lose their connection entirely.
other_uplink_state() {
	takeover_interface="$1"
	command_exists "$UBUS" || { printf 'unknown\n'; return 0; }
	takeover_dump="$TMP_BASE.bounded"
	takeover_status=0
	run_read_bounded uplink-state 5 "$takeover_dump" \
		"$UBUS" call network.interface dump || takeover_status=$?
	if [ "$takeover_status" -ne 0 ]; then
		printf 'unknown\n'
		return 0
	fi
	# One "up": true with a default route, on an interface that is not this
	# modem's. The dump is netifd's own JSON, so it is read with the JSON
	# reader rather than by pattern-matching braces.
	command_exists "$JSONFILTER" || { printf 'unknown\n'; return 0; }
	takeover_names="$("$JSONFILTER" -i "$takeover_dump" \
		-e '@.interface[@.up=true].interface' 2>/dev/null || :)"
	takeover_other=false
	for takeover_name in $takeover_names; do
		[ "$takeover_name" = "$takeover_interface" ] && continue
		# netifd publishes the IPv6 half of one interface as a separate object
		# named `<name>_6`. It is the same bearer, so counting it as a second
		# uplink would tell the user their connection survives a takeover that
		# is about to take it away.
		[ -n "$takeover_interface" ] && \
			{ [ "$takeover_name" = "${takeover_interface}_6" ] || \
			  [ "$takeover_name" = "${takeover_interface}_4" ]; } && continue
		case "$takeover_name" in loopback|lo|lan) continue ;; esac
		takeover_other=true
		break
	done
	printf '%s\n' "$takeover_other"
	return 0
}

# What a consented card probe would do, for the dialog that asks for consent.
#
# A sibling of `read-takeover-plan` and deliberately not the same verb. That one
# refreshes an endpoint somebody already has; this one asks whether there is an
# endpoint at all, which is a different question and cannot be addressed the
# same way: the modem this is for has no endpoint precisely because the port
# that would prove one is the port its own bearer dials over.
#
# Availability is decided by the same predicate that produces the
# `requires-bearer-stop` reason a page renders, so the control a reader is
# offered and the answer they were given cannot disagree.
card_probe_plan_cmd() {
	read_deadline_arm
	require_modem_target
	probe_plan_interface="$(section_field "$TARGET_MODEM_SECTION" interface 2)"
	probe_plan_bearer="$(section_device "$TARGET_MODEM_SECTION" bearer)"
	probe_plan_available=0
	probe_plan_reason=""
	if [ "$(field "$TARGET_MODEM_LINE" 3)" = modemmanager ]; then
		# A ModemManager modem's ports are ModemManager's, and the mechanism
		# for those is the inhibit. Stopping an interface would not free a
		# thing here.
		probe_plan_reason=owner-modemmanager
	elif ! bearer_is_the_modems_own_control_port "$TARGET_MODEM_SECTION"; then
		probe_plan_reason=no-bearer-in-the-way
	elif [ -z "$probe_plan_interface" ]; then
		probe_plan_reason=no_interface
	elif ! command_exists "$IFDOWN" || ! command_exists "$IFUP"; then
		probe_plan_reason=netifd_unavailable
	else
		probe_plan_available=1
	fi
	printf '{'
	json_key_string version v1; printf ','
	json_key_string modem_id "$REQUESTED_MODEM"; printf ','
	json_key_boolean available "$probe_plan_available"; printf ','
	json_key_string mechanism bearer-stop; printf ','
	json_key_string unavailable_reason "$probe_plan_reason"; printf ','
	json_key_boolean consent_required 1; printf ','
	json_key_string interrupts_interface "$probe_plan_interface"; printf ','
	json_key_string bearer_device "$probe_plan_bearer"; printf ','
	# One enforced stop/read budget, plus bounded cleanup and restoration of
	# netifd's request. This is not a promise of Internet connectivity by then.
	json_key_number worst_case_seconds "$((ESIM_INHIBIT_MAX_SECONDS + ESIM_BEARER_STOP_SECONDS + 15))"; printf ','
	json_key_number probe_seconds "$ESIM_INHIBIT_MAX_SECONDS"; printf ','
	json_key_number restore_seconds "$((ESIM_BEARER_STOP_SECONDS + 15))"; printf ','
	json_key_string other_uplink_up "$(other_uplink_state "$probe_plan_interface")"; printf ','
	json_key_boolean changes_slot 0; printf ','
	# It reads. Nothing on the card is written, enabled, disabled or removed.
	json_key_boolean mutates_card 0
	printf '}\n'
	[ "$probe_plan_available" -eq 1 ] || return "$EXIT_BLOCKED"
	return 0
}

read_takeover_plan_cmd() {
	read_deadline_arm
	require_endpoint_target
	plan_reachable="$(field "$TARGET_LINE" 14)"
	plan_modem="$(field "$TARGET_LINE" 3)"
	plan_section="$(modem_section_at "$(field "$TARGET_LINE" 19)")"
	plan_interface="$(section_field "$plan_section" interface 2)"
	plan_mechanism=none
	plan_available=0
	plan_reason=""
	case "$plan_reachable" in
		yes)
			plan_reason=already-reachable
		;;
		requires-inhibit)
			plan_mechanism=modemmanager-inhibit
			plan_available="$TAKEOVER_IMPLEMENTED"
			[ "$plan_available" -eq 1 ] || plan_reason=not-implemented
		;;
		requires-slot-change)
			# No slot change, ever, by any path. Not to reach an endpoint, not
			# to identify one, not to check one.
			plan_reason=slot-change-refused
		;;
		requires-bearer-stop)
			plan_mechanism=bearer-stop
			plan_available=1
		;;
		*)
			plan_reason="$(field "$TARGET_LINE" 15)"
		;;
	esac
	plan_other_uplink="$(other_uplink_state "$plan_interface")"
	# Whether an inhibit for this exact modem is already held by another
	# component. One that this package did not create is reused, never stopped:
	# provisioning owns a long-lived inhibit for a modem it dials over AT, and
	# releasing it would hand the modem back to ModemManager underneath a live
	# dial.
	plan_existing=0
	if [ "$plan_mechanism" = modemmanager-inhibit ] && command_exists "$MODEM_BIN"; then
		plan_targets="$TMP_BASE.bounded"
		if run_read_bounded inhibit-targets 5 "$plan_targets" "$MODEM_BIN" inhibit-targets; then
			awk -F '\t' -v modem="$plan_modem" '$2 == modem { found = 1 } END { exit found ? 0 : 1 }' \
				"$plan_targets" && plan_existing=1
		fi
	fi
	printf '{'
	json_key_string version v1; printf ','
	json_key_string endpoint_id "$(field "$TARGET_LINE" 1)"; printf ','
	json_key_string modem_id "$plan_modem"; printf ','
	json_key_string reachable "$plan_reachable"; printf ','
	json_key_boolean available "$plan_available"; printf ','
	json_key_string mechanism "$plan_mechanism"; printf ','
	json_key_string unavailable_reason "$plan_reason"; printf ','
	json_key_boolean consent_required 1; printf ','
	json_key_string interrupts_interface "$plan_interface"; printf ','
	# The disruption, in the unit the user experiences it in. The frontend
	# contract owns the wording; this is the number it puts in the sentence.
	json_key_number worst_case_seconds "$ESIM_INHIBIT_MAX_SECONDS"; printf ','
	json_key_string other_uplink_up "$plan_other_uplink"; printf ','
	json_key_boolean reuses_existing_inhibit "$plan_existing"; printf ','
	json_key_boolean changes_slot 0
	print_incomplete_fields
	printf '}\n'
}

TAKEOVER_IMPLEMENTED=1

# ---- the switch, described before it is offered ----
#
# The read-only half of enable, disable and the slot change: what one would do,
# what it would interrupt, for how long, and whether it could be undone. A
# frontend that cannot get a plan does not offer the operation, exactly as it
# does not offer a read takeover without one.
#
# The hard durations are the sums of the bounds the operation actually
# enforces. They stay separate from the evidence-based expected duration: a
# frontend leads with what successful switches involving roaming have measured and names
# the hard bound second, without presenting a watchdog sum as a schedule. Each
# bound component remains published beside the total.
switch_plan_cmd() {
	read_deadline_arm
	require_endpoint_target
	plan_action="${REQUESTED_ACTION:-enable}"
	case "$plan_action" in
		enable|disable) : ;;
		*) die_code "$EXIT_USAGE" "switch-plan describes enable or disable" ;;
	esac
	plan_reachable="$(field "$TARGET_LINE" 14)"
	plan_tier="$(field "$TARGET_LINE" 2)"
	plan_section="$(modem_section_at "$(field "$TARGET_LINE" 19)")"
	plan_interface="$(section_field "$plan_section" interface 2)"
	# Whether this operation may have to reset the modem, and what that costs.
	# A modem that will not adopt an enabled profile from a REFRESH needs one,
	# and a reset is a bigger outage than the change itself -- so it is named
	# here, before consent, rather than discovered by whoever was watching.
	plan_reset_method="$(section_field "$plan_section" reset 2)"
	[ -n "$plan_reset_method" ] || plan_reset_method=none
	plan_reset="$(section_field "$plan_section" reset 3)"
	case "$plan_reset" in ''|*[!0-9]*) plan_reset=0 ;; esac
	# Only an enable can need one: a disable asks for no subscription, so there
	# is nothing for the modem to adopt.
	[ "$plan_action" = enable ] && [ "$plan_reset_method" != none ] || plan_reset=0
	plan_available=0
	plan_reason=""
	if [ "$plan_tier" != eid ]; then
		plan_reason=endpoint-unproven
	elif [ ! -x "$LPAC_RUN" ]; then
		plan_reason=lpa-unavailable
	else
		case "$plan_reachable" in
			yes|requires-inhibit) plan_available=1 ;;
			*) plan_reason="$plan_reachable" ;;
		esac
	fi
	# What the operation would hold the modem for, and what it would then wait
	# for with the modem already handed back.
	plan_outage="$ESIM_INHIBIT_MAX_SECONDS"
	plan_report="$ESIM_REPORT_INHIBIT_SECONDS"
	# The ceiling, not the ordinary budget: the ceiling is what actually bounds
	# the wait now that it ends on its own when the modem settles.
	plan_recovery=$((ESIM_REATTACH_WAIT_SECONDS + ESIM_RECOVERY_WAIT_SECONDS + ESIM_BEARER_CEILING_SECONDS))
	# The reset, where one is possible, costs its own bound and a second
	# recovery after it. Both are inside the number a user consents to: consent
	# that does not cover the reset is not consent to the operation that may
	# perform one.
	plan_reset_total=0
	[ "$plan_reset" -eq 0 ] || plan_reset_total=$((plan_reset + plan_recovery))
	plan_worst=$((plan_outage + plan_recovery + plan_report + plan_reset_total))
	# A rollback is one more inhibit and one more recovery, and it happens at
	# most once.
	plan_worst_rollback=$((plan_worst + ESIM_REPORT_INHIBIT_SECONDS + plan_recovery))
	# Computed before the document rather than inside it. A `case` inside a
	# `$( )` whose first pattern ends in `)` closes the substitution at that
	# parenthesis in this shell, and the document then carries the rest of the
	# case statement as its value -- which the suite caught once, and which no
	# amount of reading the source would have made obvious.
	case "$plan_action" in
		disable) plan_reported_at=after-recovery-if-other-uplink ;;
		*) plan_reported_at=after-recovery ;;
	esac
	printf '{'
	json_key_string version v1; printf ','
	json_key_string endpoint_id "$(field "$TARGET_LINE" 1)"; printf ','
	json_key_string modem_id "$(field "$TARGET_LINE" 3)"; printf ','
	json_key_string action "$plan_action"; printf ','
	json_key_boolean available "$plan_available"; printf ','
	json_key_string unavailable_reason "$plan_reason"; printf ','
	json_key_boolean consent_required 1; printf ','
	json_key_string interrupts_interface "$plan_interface"; printf ','
	json_key_number expected_seconds "$ESIM_SWITCH_EXPECTED_SECONDS"; printf ','
	json_key_number worst_case_seconds "$plan_worst"; printf ','
	json_key_number worst_case_with_rollback_seconds "$plan_worst_rollback"; printf ','
	json_key_number modem_held_seconds "$plan_outage"; printf ','
	json_key_number recovery_seconds "$plan_recovery"; printf ','
	json_key_number report_held_seconds "$plan_report"; printf ','
	# The two halves of the bearer wait, published apart because they mean
	# different things. The budget is how long this waits with no evidence
	# either way; the ceiling is how long it may wait while the modem itself
	# reports that it is still working, and it is only ever reached when
	# something is stuck. A home attach ends in seconds and pays neither.
	json_key_number bearer_budget_seconds "$ESIM_BEARER_WAIT_SECONDS"; printf ','
	json_key_number bearer_ceiling_seconds "$ESIM_BEARER_CEILING_SECONDS"; printf ','
	# Capability, so a frontend can say in advance whether this operation can
	# finish. A modem with no reset method cannot adopt a profile it refused,
	# and the honest end there is `partial` -- which is worth knowing before
	# starting, not after.
	json_key_boolean may_reset "$([ "$plan_reset" -gt 0 ] && printf 1 || printf 0)"; printf ','
	json_key_string reset_method "$plan_reset_method"; printf ','
	json_key_number reset_seconds "$plan_reset_total"; printf ','
	json_key_string other_uplink_up "$(other_uplink_state "$plan_interface")"; printf ','
	# Whether a working bearer is part of what this operation is measured by. A
	# disable deliberately leaves the modem with no active subscription, so a
	# page must not present the connection failing to return as this operation
	# having gone wrong.
	json_key_boolean expects_bearer "$([ "$plan_action" = disable ] && printf 0 || printf 1)"; printf ','
	# Automatic rollback is the default where there is something to roll back
	# to: enabling a profile the card already holds has no billing consequence
	# and no consent question, and leaving the modem on a subscription that
	# could not connect is the worse outcome for somebody watching a page. A
	# disable has nothing to undo that the user did not ask for.
	json_key_boolean rollback_default "$([ "$plan_action" = enable ] && printf 1 || printf 0)"; printf ','
	# When the issuer is told, which is not when a download tells it. The
	# network an enable needs to report itself is the network the enable brings
	# back, so the report happens after the connection is up rather than inside
	# the outage -- and `sole_uplink` is therefore not a refusal here. A disable
	# has no such luck: it takes its own uplink away, so it can only report
	# through another one.
	json_key_string issuer_reported_at "$plan_reported_at"
	print_incomplete_fields
	printf '}\n'
}

# ---- the operation coordinator ----
#
# The same shape the modem coordinator publishes, because a second operation
# model would be a second thing to reason about: an atomic start lock that
# survives the parent/worker handoff, a state record carrying schema version,
# operation id, modem, endpoint, action, PID and terminal result, detection of
# an operation started outside this API, reaping of a stale owner, and exactly
# one accepted worker when two starts race.

ACTION_STATUS=idle
ACTION_ACTION=""
ACTION_PID=""
ACTION_STARTED=""
ACTION_FINISHED=""
ACTION_EXIT_CODE=""
ACTION_MESSAGE=""
ACTION_ENDPOINT=""
ACTION_OPERATION_ID=""
ACTION_STAGES=""
ACTION_REASON=""
ACTION_PROFILE=""
ACTION_SEQUENCE=""
ACTION_TRANSPORT_SECURITY=""
ACTION_TRANSPORT_RETRY_ALLOWED=false
ACTION_NOTIFICATION_DELIVERY=""
ACTION_BUSY=false

action_state_dir_for() {
	printf '%s/%s\n' "$ACTION_STATE_DIR" "$(sanitize_token "$1")"
}

action_write_state() {
	write_dir="$1"
	shift
	write_operation="$9"
	mkdir -p "$write_dir" "$write_dir/operations" 2>/dev/null || return 1
	write_state_tmp="$write_dir/.state.tmp.$SELF_PID"
	write_operation_tmp="$write_dir/operations/.${write_operation}.tmp.$SELF_PID"
	printf 'v1\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$@" "${OPERATION_TRANSPORT_SECURITY:-}" \
		"${OPERATION_TRANSPORT_RETRY_ALLOWED:-false}" \
		"${OPERATION_NOTIFICATION_DELIVERY:-}" \
		>"$write_state_tmp" 2>/dev/null || return 1
	# A terminal result remains addressable after the browser and even a later
	# operation have gone away. The filename is the already validated operation
	# token; the document contains no secret or raw card identifier.
	printf 'v1\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$@" "${OPERATION_TRANSPORT_SECURITY:-}" \
		"${OPERATION_TRANSPORT_RETRY_ALLOWED:-false}" \
		"${OPERATION_NOTIFICATION_DELIVERY:-}" \
		>"$write_operation_tmp" 2>/dev/null || { rm -f "$write_state_tmp"; return 1; }
	mv "$write_operation_tmp" "$write_dir/operations/$write_operation.tsv" 2>/dev/null || {
		rm -f "$write_state_tmp" "$write_operation_tmp"
		return 1
	}
	mv "$write_state_tmp" "$write_dir/state.tsv" 2>/dev/null || {
		rm -f "$write_state_tmp"
		return 1
	}
	return 0
}

inhibit_lease_write_adopted() {
	lease_dir="$1"
	lease_operation="$2"
	lease_modem="$3"
	lease_worker_birth="$(process_birth "$SELF_PID" 2>/dev/null || :)"
	[ -n "$lease_worker_birth" ] || return 1
	lease_path="$lease_dir/inhibit.tsv"
	lease_tmp="${lease_path}.tmp.$SELF_PID"
	printf 'v1\tadopted\t%s\t%s\t\t%s\t%s\t\t\t\t\t\n' \
		"$lease_operation" "$lease_modem" "$SELF_PID" "$lease_worker_birth" \
		>"$lease_tmp" 2>/dev/null || return 1
	mv "$lease_tmp" "$lease_path" 2>/dev/null || { rm -f "$lease_tmp"; return 1; }
}

action_mark_orphan_recovered() {
	mark_dir="$1"
	mark_operation="$2"
	mark_line="$(sed -n '1p' "$mark_dir/state.tsv" 2>/dev/null || :)"
	[ "$(field "$mark_line" 10)" = "$mark_operation" ] || return 0
	mark_finished="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)"
	OPERATION_TRANSPORT_SECURITY="$(field "$mark_line" 16)"
	OPERATION_TRANSPORT_RETRY_ALLOWED="$(field "$mark_line" 17)"
	OPERATION_NOTIFICATION_DELIVERY="$(field "$mark_line" 18)"
	action_write_state "$mark_dir" failed "$(field "$mark_line" 3)" \
		"$(field "$mark_line" 4)" "$(field "$mark_line" 5)" "$mark_finished" 1 \
		"background worker stopped unexpectedly; its orphaned modem inhibit was released" \
		"$(field "$mark_line" 9)" "$mark_operation" "$(field "$mark_line" 11)" \
		orphan_inhibit_recovered "$(field "$mark_line" 13)" "$(field "$mark_line" 14)" \
		"$(field "$mark_line" 15)" || :
}

# Every entry point performs this cheap sweep after configuration is loaded.
# The ordinary path reads one absent filename. A recovery takes its own guard,
# re-reads the same lease and proves worker, watchdog and holder identities
# again before signalling anything.
recover_orphan_inhibits() {
	[ -d "$ACTION_STATE_DIR" ] || return 0
	for recover_lease in "$ACTION_STATE_DIR"/*/inhibit.tsv; do
		[ -f "$recover_lease" ] || continue
		recover_line="$(sed -n '1p' "$recover_lease" 2>/dev/null || :)"
		[ "$(field "$recover_line" 1)" = v1 ] || continue
		recover_kind="$(field "$recover_line" 2)"
		recover_operation="$(field "$recover_line" 3)"
		recover_modem="$(field "$recover_line" 4)"
		recover_uid="$(field "$recover_line" 5)"
		recover_worker="$(field "$recover_line" 6)"
		recover_worker_birth="$(field "$recover_line" 7)"
		case "$recover_kind:$recover_operation:$recover_modem" in
			created:?*:?*|adopted:?*:?*) : ;;
			*) continue ;;
		esac
		process_matches "$recover_worker" "$recover_worker_birth" && continue

		recover_dir="${recover_lease%/inhibit.tsv}"
		recover_guard="${recover_dir}.inhibit-recovery"
		lock_try_acquire_or_reclaim "$recover_guard" || continue
		recover_again="$(sed -n '1p' "$recover_lease" 2>/dev/null || :)"
		if [ "$recover_again" != "$recover_line" ] || \
			process_matches "$recover_worker" "$recover_worker_birth"; then
			lock_release "$recover_guard"
			continue
		fi
		if [ "$recover_kind" = adopted ]; then
			rm -f "$recover_lease"
			lock_release "$recover_guard"
			continue
		fi

		recover_holder="$(field "$recover_line" 8)"
		recover_holder_birth="$(field "$recover_line" 9)"
		recover_watchdog="$(field "$recover_line" 10)"
		recover_watchdog_birth="$(field "$recover_line" 11)"
		recover_mmcli="$(field "$recover_line" 12)"
		stop_exact_process "$recover_watchdog" "$recover_watchdog_birth" TERM
		if process_matches "$recover_holder" "$recover_holder_birth"; then
			if process_has_exact_arg "$recover_holder" "--inhibit-device=$recover_uid" && \
				process_has_exact_arg "$recover_holder" "$recover_mmcli"; then
				stop_exact_process "$recover_holder" "$recover_holder_birth" TERM
				recover_waited=0
				while process_matches "$recover_holder" "$recover_holder_birth" && \
					[ "$recover_waited" -lt 2 ]; do
					"$SLEEP" 1 2>/dev/null || break
					recover_waited=$((recover_waited + 1))
				done
				stop_exact_process "$recover_holder" "$recover_holder_birth" KILL
			else
				log err "refusing to release an orphaned inhibit whose recorded process identity no longer matches"
				lock_release "$recover_guard"
				continue
			fi
		fi
		action_mark_orphan_recovered "$recover_dir" "$recover_operation"
		rm -f "$recover_lease"
		lock_release "$recover_guard"
		log warning "released an orphaned inhibit for $(mask_modem_id "$recover_modem")"
	done
}

action_status_values() {
	status_modem="$1"
	ACTION_STATUS=idle
	ACTION_ACTION=""
	ACTION_PID=""
	ACTION_STARTED=""
	ACTION_FINISHED=""
	ACTION_EXIT_CODE=""
	ACTION_MESSAGE=""
	ACTION_ENDPOINT=""
	ACTION_OPERATION_ID=""
	ACTION_STAGES=""
	ACTION_REASON=""
	ACTION_PROFILE=""
	ACTION_SEQUENCE=""
	ACTION_TRANSPORT_SECURITY=""
	ACTION_TRANSPORT_RETRY_ALLOWED=false
	ACTION_NOTIFICATION_DELIVERY=""
	ACTION_BUSY=false
	status_dir="$(action_state_dir_for "$status_modem")"
	status_snapshot_attempt=0
	status_line="$(sed -n '1p' "$status_dir/state.tsv" 2>/dev/null || :)"
	while [ -n "$status_line" ]; do
		ACTION_STATUS="$(field "$status_line" 2)"
		ACTION_ACTION="$(field "$status_line" 3)"
		ACTION_PID="$(field "$status_line" 4)"
		ACTION_STARTED="$(field "$status_line" 5)"
		ACTION_FINISHED="$(field "$status_line" 6)"
		ACTION_EXIT_CODE="$(field "$status_line" 7)"
		ACTION_MESSAGE="$(field "$status_line" 8)"
		ACTION_ENDPOINT="$(field "$status_line" 9)"
		ACTION_OPERATION_ID="$(field "$status_line" 10)"
		ACTION_STAGES="$(field "$status_line" 11)"
		ACTION_REASON="$(field "$status_line" 12)"
		ACTION_PROFILE="$(field "$status_line" 13)"
		ACTION_SEQUENCE="$(field "$status_line" 14)"
		ACTION_TRANSPORT_SECURITY="$(field "$status_line" 16)"
		ACTION_TRANSPORT_RETRY_ALLOWED="$(field "$status_line" 17)"
		case "$ACTION_TRANSPORT_RETRY_ALLOWED" in true|false) : ;; *) ACTION_TRANSPORT_RETRY_ALLOWED=false ;; esac
		ACTION_NOTIFICATION_DELIVERY="$(field "$status_line" 18)"
		case "$ACTION_NOTIFICATION_DELIVERY" in
			''|none|delivered|delivered_unverified|partial|pending|unknown) : ;;
			*) ACTION_NOTIFICATION_DELIVERY=unknown ;;
		esac
		case "$ACTION_STATUS" in
			starting|running)
				# The launcher records `starting` under its own PID and then
				# exits; the accepted worker owns the start lock from the moment
				# it is forked until it writes a terminal result. Judging
				# liveness by the state PID alone reports that handoff as a dead
				# worker. Our own start lock does not count: a launcher holding
				# it is deciding whether to start, not observing a handoff.
				handoff_pid="$(lock_owner_pid "${status_dir}.start-lock" 2>/dev/null || :)"
				[ "$handoff_pid" = "$SELF_PID" ] && handoff_pid=""
				if process_is_alive "$ACTION_PID"; then
					ACTION_BUSY=true
				elif process_is_alive "$handoff_pid"; then
					ACTION_BUSY=true
				else
					# The worker publishes its terminal record before exiting. A
					# dead PID invalidates our earlier running snapshot: read
					# again before inventing an unexpected-exit result. Repeated
					# replacements are busy uncertainty, with a bounded reader.
					status_latest="$(sed -n '1p' "$status_dir/state.tsv" 2>/dev/null || :)"
					if [ -n "$status_latest" ] && [ "$status_latest" != "$status_line" ]; then
						status_snapshot_attempt=$((status_snapshot_attempt + 1))
						if [ "$status_snapshot_attempt" -lt 3 ]; then
							status_line="$status_latest"
							continue
						fi
						ACTION_BUSY=true
						break
					fi
					ACTION_STATUS=failed
					ACTION_EXIT_CODE=1
					ACTION_MESSAGE="background worker stopped unexpectedly"
				fi
			;;
		esac
		break
	done
	if [ "$ACTION_BUSY" = false ]; then
		# An operation started outside this API still holds the modem, and a
		# caller that cannot see it would launch a second one on top of it.
		external_pid="$(lock_owner_pid "${MODEM_LOCK_ROOT}.$(sanitize_token "$status_modem")" \
			2>/dev/null || :)"
		if process_is_alive "$external_pid" && [ "$external_pid" != "$SELF_PID" ]; then
			ACTION_STATUS=running
			ACTION_ACTION=""
			ACTION_PID="$external_pid"
			ACTION_MESSAGE="operation started outside the background action API"
			ACTION_OPERATION_ID=""
			ACTION_BUSY=true
		fi
	fi
}

print_action_json() {
	printf '{'
	json_key_string version v1; printf ','
	json_key_boolean accepted "$1"; printf ','
	json_key_boolean busy "$([ "$ACTION_BUSY" = true ] && printf 1 || printf 0)"; printf ','
	json_key_string modem_id "$2"; printf ','
	json_key_string endpoint_id "$ACTION_ENDPOINT"; printf ','
	json_key_string status "$ACTION_STATUS"; printf ','
	json_key_string action "$ACTION_ACTION"; printf ','
	json_key_string operation_id "$ACTION_OPERATION_ID"; printf ','
	json_key_string started "$ACTION_STARTED"; printf ','
	json_key_string finished "$ACTION_FINISHED"; printf ','
	json_key_number exit_code "$ACTION_EXIT_CODE"; printf ','
	json_key_string message "$ACTION_MESSAGE"; printf ','
	# Which stages completed. A result that stopped part way says where, which
	# is the difference between an operation that refused and one that changed
	# something and then could not finish.
	json_key_string stages "$ACTION_STAGES"; printf ','
	json_key_string reason "$ACTION_REASON"; printf ','
	json_key_string transport_security "$ACTION_TRANSPORT_SECURITY"; printf ','
	json_key_boolean transport_retry_allowed "$([ "$ACTION_TRANSPORT_RETRY_ALLOWED" = true ] && printf 1 || printf 0)"; printf ','
	# What the SM-DP+ was told, which is not the same question as what the card
	# holds. `pending` means a profile exists and its issuer has not heard so.
	json_key_string notification_delivery "$ACTION_NOTIFICATION_DELIVERY"; printf ','
	json_key_string profile_id "$ACTION_PROFILE"; printf ','
	json_key_number sequence "$ACTION_SEQUENCE"
	printf '}\n'
}

action_status_cmd() {
	if [ -n "$REQUESTED_OPERATION" ] && [ -z "$REQUESTED_MODEM" ]; then
		safe_token "$REQUESTED_OPERATION" || die_code "$EXIT_USAGE" "invalid operation identity"
		operation_matches=0
		operation_modem=""
		for operation_path in "$ACTION_STATE_DIR"/*/operations/"$REQUESTED_OPERATION.tsv"; do
			[ -f "$operation_path" ] || continue
			operation_matches=$((operation_matches + 1))
			operation_modem="$(field "$(sed -n '1p' "$operation_path" 2>/dev/null || :)" 15)"
		done
		[ "$operation_matches" -eq 1 ] || \
			die_code "$EXIT_BLOCKED" "no single operation matches $REQUESTED_OPERATION"
		REQUESTED_MODEM="$operation_modem"
	fi
	[ -n "$REQUESTED_MODEM" ] || die_code "$EXIT_USAGE" "action-status requires --modem or --operation"
	action_status_values "$REQUESTED_MODEM"
	if [ -n "$REQUESTED_OPERATION" ] && [ "$ACTION_OPERATION_ID" != "$REQUESTED_OPERATION" ]; then
		status_path="$(action_state_dir_for "$REQUESTED_MODEM")/operations/$REQUESTED_OPERATION.tsv"
		status_line="$(sed -n '1p' "$status_path" 2>/dev/null || :)"
		[ -n "$status_line" ] || die_code "$EXIT_BLOCKED" "operation $REQUESTED_OPERATION is not available"
		ACTION_STATUS="$(field "$status_line" 2)"
		ACTION_ACTION="$(field "$status_line" 3)"
		ACTION_PID="$(field "$status_line" 4)"
		ACTION_STARTED="$(field "$status_line" 5)"
		ACTION_FINISHED="$(field "$status_line" 6)"
		ACTION_EXIT_CODE="$(field "$status_line" 7)"
		ACTION_MESSAGE="$(field "$status_line" 8)"
		ACTION_ENDPOINT="$(field "$status_line" 9)"
		ACTION_OPERATION_ID="$(field "$status_line" 10)"
		ACTION_STAGES="$(field "$status_line" 11)"
		ACTION_REASON="$(field "$status_line" 12)"
		ACTION_PROFILE="$(field "$status_line" 13)"
		ACTION_SEQUENCE="$(field "$status_line" 14)"
		ACTION_TRANSPORT_SECURITY="$(field "$status_line" 16)"
		ACTION_TRANSPORT_RETRY_ALLOWED="$(field "$status_line" 17)"
		case "$ACTION_TRANSPORT_RETRY_ALLOWED" in true|false) : ;; *) ACTION_TRANSPORT_RETRY_ALLOWED=false ;; esac
		ACTION_NOTIFICATION_DELIVERY="$(field "$status_line" 18)"
		case "$ACTION_NOTIFICATION_DELIVERY" in
			''|none|delivered|delivered_unverified|partial|pending|unknown) : ;;
			*) ACTION_NOTIFICATION_DELIVERY=unknown ;;
		esac
		ACTION_BUSY=false
	fi
	print_action_json 0 "$REQUESTED_MODEM"
}

# ---- the read takeover ----
#
# The consented, bounded ModemManager inhibit that makes an otherwise
# unreachable eUICC readable. It is an operation, not a read: it takes the full
# lock order, it publishes an operation id and its stages, and it restores the
# exact captured state on success, failure, timeout, HUP, INT and TERM.
#
# It is never started by a poll, a page load, a boot, a hotplug event or a
# convergence worker. There is no such caller, and the only path to it is a
# deliberate `action-start read-takeover` — which is what consent means here,
# obtained by the frontend from a dialog `read-takeover-plan` filled in.

TAKEOVER_INHIBIT_PID=""
TAKEOVER_INHIBIT_CREATED=0
TAKEOVER_WATCHDOG_PID=""
TAKEOVER_INHIBIT_LEASE=""
TAKEOVER_PUBLISH_ARMED=0
TAKEOVER_STATE_DIR=""
TAKEOVER_START_LOCK=""
TAKEOVER_STAGES=""
TAKEOVER_OPERATION_ID=""
TAKEOVER_STARTED=""
EXIT_STATUS_OBSERVED=""
OPERATION_ACTION="read-takeover"
OPERATION_REASON=""
OPERATION_PROFILE=""
OPERATION_SEQUENCE=""
OPERATION_MUTATE_STARTED=0
OPERATION_TRANSPORT_SECURITY=""
OPERATION_NOTIFICATION_DELIVERY=""
OPERATION_TRANSPORT_RETRY_ALLOWED=false

worker_session_is_detached() {
	if [ -r "/proc/$SELF_PID/stat" ]; then
		worker_stat="$(cat "/proc/$SELF_PID/stat" 2>/dev/null || :)"
		worker_stat="${worker_stat##*) }"
		worker_group="$(printf '%s\n' "$worker_stat" | awk '{print $3}')"
		worker_session="$(printf '%s\n' "$worker_stat" | awk '{print $4}')"
		[ "$worker_group" = "$worker_session" ] && [ "$worker_session" != "$SELF_PID" ]
	else
		# Test-host fallback; the target's /proc proves both group and session.
		worker_group="$(ps -o pgid= -p "$SELF_PID" 2>/dev/null | tr -d ' ')"
		[ -n "$worker_group" ] && [ "$worker_group" != "$SELF_PID" ]
	fi
}

adopt_handoff_pid() {
	if [ "$REQUIRE_DETACHED_SESSION" = 1 ]; then
		worker_session_is_detached || return 1
	fi
	# The short supervisor knows its child's kernel PID from `$!` and publishes
	# it by atomically handing over the start lock. A background subshell's `$$` is not
	# portable evidence of that PID: bash keeps the parent's value there, while
	# BusyBox ash does not. The worker therefore takes its identity from the
	# handoff record before it writes any state or lock of its own.
	worker_state_line="$(sed -n '1p' "$TAKEOVER_STATE_DIR/state.tsv" 2>/dev/null || :)"
	worker_launcher_pid="$(field "$worker_state_line" 4)"
	worker_handoff_waited=0
	while [ "$worker_handoff_waited" -lt 5 ]; do
		worker_handoff_pid="$(lock_owner_pid "$TAKEOVER_START_LOCK" 2>/dev/null || :)"
		if [ -n "$worker_handoff_pid" ] && \
			[ "$worker_handoff_pid" != "$worker_launcher_pid" ] && \
			process_is_alive "$worker_handoff_pid"; then
			# The detached supervisor must name the actual worker, not
			# itself or another intermediate process.
			[ "$REQUIRE_DETACHED_SESSION" != 1 ] || \
				[ "$worker_handoff_pid" = "$SELF_PID" ] || return 1
			SELF_PID="$worker_handoff_pid"
			TMP_BASE="$TMP_DIR/$PROG.$SELF_PID"
			SLOTS_FILE="$TMP_BASE.slots"
			LPA_OUTPUT_FILE="$TMP_BASE.lpa-output"
			BOUNDED_OUTPUT_FILE="$TMP_BASE.bounded"
			BOUNDED_TIMEOUT_MARKER="$TMP_BASE.bounded-timeout"
			HTTP_BODY_FILE="$TMP_BASE.http-body"
			HTTP_REPLY_FILE="$TMP_BASE.http-reply"
			HTTP_HEADER_FILE="$TMP_BASE.http-headers"
			return 0
		fi
		"$SLEEP" 1 2>/dev/null || :
		worker_handoff_waited=$((worker_handoff_waited + 1))
	done
	return 1
}

# A state written by the actual detached worker is the launch acknowledgment.
# Do not report accepted while it still belongs to the caller's session.
wait_worker_handoff() {
	launch_supervisor="$1"
	launch_lock="$2"
	launch_operation="$3"
	launch_pid="$launch_supervisor"
	launch_waited=0
	while :; do
		launch_owner="$(lock_owner_pid "$launch_lock" 2>/dev/null || :)"
		case "$launch_owner" in ''|*[!0-9]*) : ;;
			*) [ "$launch_owner" = "$SELF_PID" ] || launch_pid="$launch_owner" ;;
		esac
		launch_state="$(sed -n '1p' "$TAKEOVER_STATE_DIR/state.tsv" 2>/dev/null || :)"
		if [ "$(field "$launch_state" 10)" = "$launch_operation" ] && \
			[ "$(field "$launch_state" 4)" != "$SELF_PID" ] && \
			[ "$(field "$launch_state" 2)" != starting ]; then
			launch_pid="$(field "$launch_state" 4)"
			[ "$(field "$launch_state" 12)" != handoff_failed ] || break
			return 0
		fi
		# The supervisor can exit between the lock and state reads. Its
		# death alone must not reject the child whose handoff just completed.
		[ "$launch_waited" -lt 5 ] || break
		"$SLEEP" 1 2>/dev/null || break
		launch_waited=$((launch_waited + 1))
	done
	reap_child "$launch_pid" TERM
	"$SLEEP" 1 2>/dev/null || :
	reap_child "$launch_pid" KILL
	wait "$launch_pid" 2>/dev/null || :
	[ "$(lock_owner_pid "$launch_lock" 2>/dev/null || :)" != "$launch_pid" ] || lock_release "$launch_lock"
	return 1
}

takeover_stage() {
	TAKEOVER_STAGES="${TAKEOVER_STAGES:+$TAKEOVER_STAGES,}$1"
}

takeover_publish() {
	[ -n "$TAKEOVER_STATE_DIR" ] || return 0
	# Every terminal path, including a failed stop, must finish restoration
	# before readers see a completed operation. The exit trap is the fallback.
	takeover_release_prepare
	if [ "$TAKEOVER_BEARER_RESTORE_FAILED" -eq 1 ]; then
		if [ "$OPERATION_MUTATE_STARTED" -eq 1 ]; then
			set -- partial "$EXIT_PARTIAL" "$3; the prior connection request could not be restored"
		else
			set -- failed "$EXIT_RETRYABLE" "$3; the prior connection request could not be restored"
		fi
		OPERATION_REASON=bearer_restore_failed
	fi
	publish_finished="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)"
	action_write_state "$TAKEOVER_STATE_DIR" \
		"$1" "$OPERATION_ACTION" "$SELF_PID" "${TAKEOVER_STARTED:-}" "$publish_finished" \
		"$2" "$3" "${REQUESTED_ENDPOINT:-}" "${TAKEOVER_OPERATION_ID:-}" \
		"${TAKEOVER_STAGES:-}" "${OPERATION_REASON:-}" "${OPERATION_PROFILE:-}" \
		"${OPERATION_SEQUENCE:-}" "${REQUESTED_MODEM:-}" || :
	TAKEOVER_PUBLISH_ARMED=0
	# The start lock is released only once a terminal result exists, so a
	# status read between the worker's death and its result still sees an owner.
	[ -z "$TAKEOVER_START_LOCK" ] || lock_release "$TAKEOVER_START_LOCK"
	TAKEOVER_START_LOCK=""
	return 0
}

# Called from the exit trap on every path, before the locks are released. The
# order is the contract's: the inhibit goes first, so the modem is back with a
# working owner before anything else is unwound.
takeover_rollback() {
	if [ -n "$TAKEOVER_WATCHDOG_PID" ]; then
		reap_child "$TAKEOVER_WATCHDOG_PID" TERM
		wait "$TAKEOVER_WATCHDOG_PID" 2>/dev/null || :
		TAKEOVER_WATCHDOG_PID=""
	fi
	if [ "$TAKEOVER_INHIBIT_CREATED" -eq 1 ] && [ -n "$TAKEOVER_INHIBIT_PID" ]; then
		# An inhibition lasts exactly as long as the process holding it, so
		# terminating the holder is the release, and the failure direction is
		# the safe one: a dead holder returns the modem to ModemManager.
		#
		# TERM and then KILL with no pause between them, deliberately. There is
		# nothing here to put down gracefully -- that argument belongs to the
		# LPA, which holds a logical channel, and not to the process whose only
		# job is to exist. And a one-second pause in this exact position was
		# observed ending the cleanup outright: the release never completed, the
		# inhibit stayed, and all four locks were left behind. No second signal
		# was delivered and a minimal reproduction of the same shape did not
		# reproduce it, so the mechanism is recorded as unexplained rather than
		# guessed at; what is established is that removing the pause makes the
		# unwind complete every time, and that the pause bought nothing.
		reap_child "$TAKEOVER_INHIBIT_PID" TERM
		reap_child "$TAKEOVER_INHIBIT_PID" KILL
		wait "$TAKEOVER_INHIBIT_PID" 2>/dev/null || :
		log notice "released the read takeover inhibit for $(mask_modem_id "${REQUESTED_MODEM:-}")"
	fi
	TAKEOVER_INHIBIT_PID=""
	TAKEOVER_INHIBIT_CREATED=0
	[ -z "$TAKEOVER_INHIBIT_LEASE" ] || rm -f "$TAKEOVER_INHIBIT_LEASE" 2>/dev/null || :
	TAKEOVER_INHIBIT_LEASE=""
	# After the inhibit and before the locks, which is the order the contract
	# fixes: the modem goes back to a working owner first, and the interface
	# this operation stopped is started again second.
	takeover_restore_bearer_stop || :
	if [ "$TAKEOVER_PUBLISH_ARMED" -eq 1 ]; then
		if [ "$OPERATION_ACTION" = download ] && [ "$OPERATION_MUTATE_STARTED" -eq 1 ]; then
			OPERATION_REASON=download_interrupted
			takeover_publish partial "$EXIT_PARTIAL" \
				"the download was interrupted after mutation began; no profile was removed"
		elif [ "$OPERATION_ACTION" = delete ] && [ "$OPERATION_MUTATE_STARTED" -eq 1 ]; then
			# Killed inside the one window in this project that cannot be
			# undone. Whether the profile is gone, and whether its issuer was
			# told, are both unread -- and a delete notification left on the
			# card is the recoverable half, so the result says to go and look
			# rather than claiming either outcome.
			OPERATION_REASON=delete_interrupted
			takeover_publish partial "$EXIT_PARTIAL" \
				"the operation was interrupted after the delete request was issued; whether the profile is gone and whether its issuer was told have not been read back, so read the endpoint and send any notification waiting there. Nothing else was removed"
		elif [ "$OPERATION_MUTATE_STARTED" -eq 1 ]; then
			# A switching verb, killed after the card or the slot was told to
			# change. Which subscription is active is now whatever the card
			# last accepted, and this process is in no position to find out --
			# so it says that rather than guessing in either direction. The
			# inhibit above has already been released, so the modem is back
			# with a working owner and an ordinary reconcile can follow.
			OPERATION_REASON=switch_interrupted
			takeover_publish partial "$EXIT_PARTIAL" \
				"the operation was interrupted after the change was sent to the modem; which subscription is active now has not been read back, and nothing was removed"
		elif [ "${PROBE_DEADLINE_EXPIRED:-0}" -eq 1 ]; then
			OPERATION_REASON=probe_timeout
			takeover_publish failed "$EXIT_RETRYABLE" \
				"the card probe exceeded its time budget; cleanup and restoration were attempted"
		else
			OPERATION_REASON=interrupted
			takeover_publish failed "${EXIT_STATUS_OBSERVED:-143}" \
				"the operation ended without publishing a result (exit ${EXIT_STATUS_OBSERVED:-unknown})"
		fi
	fi
	return 0
}

prepare_download_secret_fd() {
	[ -n "$CAPTURED_ACTIVATION_CODE" ] || \
		die_code "$EXIT_USAGE" "download requires an activation code in the protected request environment"
	secret_document=""
	for secret_pair in \
		"activation_code=$CAPTURED_ACTIVATION_CODE" \
		"confirmation_code=$CAPTURED_CONFIRMATION_CODE" \
		"matching_id=$CAPTURED_MATCHING_ID"; do
		secret_value="${secret_pair#*=}"
		[ -n "$secret_value" ] || continue
		case "$secret_value" in
			*"$NEWLINE"*) die_code "$EXIT_USAGE" "a protected request value contains a newline" ;;
		esac
		secret_document="${secret_document}${secret_pair}${NEWLINE}"
	done
	[ "${#secret_document}" -le 8192 ] || die_code "$EXIT_USAGE" "the protected request is too large"
	ACTION_SECRET_DIR="$STATE_DIR/secret.$SELF_PID"
	( umask 077 && mkdir -p "$STATE_DIR" && mkdir "$ACTION_SECRET_DIR" ) || \
		die "cannot create the protected request channel"
	( umask 077 && mkfifo "$ACTION_SECRET_DIR/params" ) || \
		die "cannot create the protected request channel"
	# `printf` is a shell builtin. The value exists in the forked shell's memory,
	# never in its argv or environment, and the FIFO stores no bytes at rest.
	printf '%s' "$secret_document" >"$ACTION_SECRET_DIR/params" &
	secret_writer_pid=$!
	ACTION_SECRET_FD_OPEN=1
	exec 5<"$ACTION_SECRET_DIR/params" || die "cannot open the protected request channel"
	wait "$secret_writer_pid" 2>/dev/null || die "cannot fill the protected request channel"
	secret_document=""
	CAPTURED_ACTIVATION_CODE=""
	CAPTURED_CONFIRMATION_CODE=""
	CAPTURED_MATCHING_ID=""
	rm -f "$ACTION_SECRET_DIR/params" 2>/dev/null || :
	rmdir "$ACTION_SECRET_DIR" 2>/dev/null || :
	ACTION_SECRET_DIR=""
}

action_start_cmd() {
	action_verb="${1:-}"
	case "$action_verb" in
		read-takeover|download|nickname|notification-send|notification-remove) : ;;
		enable|disable) : ;;
		# The plan is a job because it reads a card and no page can hold a
		# request open for that. It destroys nothing; the token it mints is
		# still the only way to reach a deletion.
		delete-plan) : ;;
		# The one action addressed by a modem alone. It exists to find out
		# whether there is an endpoint, so requiring one would make it
		# unaskable in exactly the state it is for.
		card-probe) : ;;
		'') die_code "$EXIT_USAGE" "action-start requires an action" ;;
		*) die_code "$EXIT_USAGE" "unknown action: $action_verb" ;;
	esac
	[ "$CAPTURED_ALLOW_UNVERIFIED_TRANSPORT" != invalid ] || \
		die_code "$EXIT_USAGE" "the unverified transport choice must be 0 or 1"
	[ "$CAPTURED_CONFIRM_DISCARD" != invalid ] || \
		die_code "$EXIT_USAGE" "the discard confirmation must be 0 or 1"
	# Removing a notification is throwing away the only copy of a message an
	# issuer has not necessarily received, and this command cannot know whether
	# it was sent. For an install that is untidy; for a deletion it is the act
	# that makes a subscription unrecoverable, which is why C5 exists. So it is
	# said out loud, per operation, and never by a bare call.
	if [ "$action_verb" = notification-remove ] && [ "$CAPTURED_CONFIRM_DISCARD" != 1 ]; then
		die_code "$EXIT_USAGE" \
			"removing a notification discards it undelivered; say so explicitly in the request environment"
	fi
	if [ "$CAPTURED_CONFIRM_DISCARD" = 1 ] && [ "$action_verb" != notification-remove ]; then
		die_code "$EXIT_USAGE" "the discard confirmation belongs to notification-remove alone"
	fi
	# The two actions that make an ES9+ request of their own. Sending a
	# notification is the other half of the mechanism a download starts: the
	# issuer learns what became of its profile from that message and from
	# nothing else, and a notification the card is holding for an issuer we
	# cannot verify would otherwise be undeliverable for ever. Permitting the
	# downgrade for the fetch and refusing it for the report implements half a
	# protocol; the maintainer decided that on 2026-08-30 and the reasoning is
	# in docs/work-items/C3-additive-lifecycle.md.
	case "$CAPTURED_ALLOW_UNVERIFIED_TRANSPORT:$action_verb" in
		1:download|1:notification-send) : ;;
		1:*)
			die_code "$EXIT_USAGE" \
				"unverified transport may be chosen only for one profile download or one notification"
		;;
	esac

	[ -n "$REQUESTED_MODEM" ] || die_code "$EXIT_USAGE" "action-start requires --modem"
	# Per action, and not an optional field. Every other action names the
	# endpoint it acts on and is refused without one; `card-probe` is refused
	# *with* one, so nothing here becomes vaguer for the operations that have
	# always known their target.
	if [ "$action_verb" = card-probe ]; then
		[ -z "$REQUESTED_ENDPOINT" ] || \
			die_code "$EXIT_USAGE" "card-probe names a modem, not an endpoint"
		[ -z "$REQUESTED_PROFILE" ] && [ -z "$REQUESTED_SEQUENCE" ] || \
			die_code "$EXIT_USAGE" "card-probe does not take a profile or sequence"
	else
		[ -n "$REQUESTED_ENDPOINT" ] || die_code "$EXIT_USAGE" "action-start requires --endpoint"
	fi
	[ -x "$ACTION_WORKER" ] || die "the action worker is not executable: $ACTION_WORKER"
	command_exists "$SETSID" || die_code "$EXIT_BLOCKED" "session isolation is unavailable; no job was started"
	case "$action_verb" in
		download|read-takeover)
			[ -z "$REQUESTED_PROFILE" ] && [ -z "$REQUESTED_SEQUENCE" ] || \
				die_code "$EXIT_USAGE" "$action_verb does not take a profile or sequence"
		;;
		delete-plan)
			[ -n "$REQUESTED_PROFILE" ] || \
				die_code "$EXIT_USAGE" "delete-plan requires --profile"
			[ -z "$REQUESTED_SEQUENCE" ] || \
				die_code "$EXIT_USAGE" "delete-plan does not take --sequence"
		;;
		nickname)
			[ -n "$REQUESTED_PROFILE" ] || die_code "$EXIT_USAGE" "nickname requires --profile"
			[ -z "$REQUESTED_SEQUENCE" ] || die_code "$EXIT_USAGE" "nickname does not take --sequence"
			[ "$CAPTURED_NICKNAME_SET" -eq 1 ] || \
				die_code "$EXIT_USAGE" "nickname requires APN_ESIM_NICKNAME in the request environment"
			[ "${#CAPTURED_NICKNAME}" -le 64 ] || die_code "$EXIT_USAGE" "nickname is too long"
			case "$CAPTURED_NICKNAME" in *"$TAB"*|*"$CR"*|*"$NEWLINE"*) \
				die_code "$EXIT_USAGE" "nickname contains a control character" ;; esac
		;;
		notification-send|notification-remove)
			[ -z "$REQUESTED_PROFILE" ] || die_code "$EXIT_USAGE" "$action_verb does not take --profile"
			case "$REQUESTED_SEQUENCE" in ''|*[!0-9]*) \
				die_code "$EXIT_USAGE" "$action_verb requires a numeric --sequence" ;; esac
		;;
		enable|disable)
			[ -n "$REQUESTED_PROFILE" ] || die_code "$EXIT_USAGE" "$action_verb requires --profile"
			[ -z "$REQUESTED_SEQUENCE" ] || die_code "$EXIT_USAGE" "$action_verb does not take --sequence"
		;;
	esac

	# Busy before target, and the order is not arbitrary.
	#
	# A running takeover holds the inhibit, so ModemManager no longer has the
	# modem and can no longer be asked for its EID -- which drops the endpoint
	# to `slot-weak` for as long as the operation lasts. Resolving the target
	# first would therefore turn a repeated start into "no such endpoint"
	# instead of the coalesced repeat the contract asks for, and would do it
	# only while an operation was running, which is the one moment it matters.
	action_status_values "$REQUESTED_MODEM"
	if [ "$ACTION_BUSY" = true ]; then
		print_action_json 0 "$REQUESTED_MODEM"
		return 0
	fi

	read_deadline_arm
	if [ "$action_verb" = card-probe ]; then
		# Everything below this block resolves and revalidates an endpoint.
		# This action has none by construction, so it proves what it can: one
		# unambiguous modem, netifd's rather than ModemManager's, whose card is
		# behind its own bearer. The worker proves all of it again under the
		# locks.
		require_modem_target
		[ "$(field "$TARGET_MODEM_LINE" 3)" != modemmanager ] || \
			die_code "$EXIT_BLOCKED" \
				"modem $(mask_modem_id "$REQUESTED_MODEM") is ModemManager's; a read takeover is the mechanism there"
		bearer_is_the_modems_own_control_port "$TARGET_MODEM_SECTION" || \
			die_code "$EXIT_BLOCKED" \
				"modem $(mask_modem_id "$REQUESTED_MODEM") has no bearer standing in front of its card"
	else
	require_endpoint_target
	# A slot-weak endpoint is read-only inventory. No operation may be started
	# against it -- not to fix it, not to read it "properly", and not to make it
	# identifiable.
	[ "$(field "$TARGET_LINE" 2)" = eid ] || \
		die_code "$EXIT_BLOCKED" "endpoint $REQUESTED_ENDPOINT is unproven; no operation may target it"
	action_reachable="$(field "$TARGET_LINE" 14)"
	case "$action_verb:$action_reachable" in
		read-takeover:requires-inhibit|read-takeover:requires-bearer-stop) : ;;
		read-takeover:yes) die_code "$EXIT_BLOCKED" "endpoint $REQUESTED_ENDPOINT is already readable" ;;
		read-takeover:*)
			# Including `not-supported`, which is why the allow list is checked
			# before the owner: an outage that ends in a refusal is worse than
			# the refusal on its own.
			die_code "$EXIT_BLOCKED" \
				"a read takeover would not make $REQUESTED_ENDPOINT readable ($action_reachable)"
		;;
		*:yes|*:requires-inhibit|*:requires-bearer-stop) : ;;
		*) die_code "$EXIT_BLOCKED" "endpoint $REQUESTED_ENDPOINT is not reachable for $action_verb ($action_reachable)"
		;;
	esac
	# A download and a notification send need the network after an inhibit has
	# removed this modem from ModemManager. Refuse the deadlock now, before an
	# inhibit process exists. Unknown is also a refusal: it is not evidence of an
	# alternate route.
	case "$action_verb:$action_reachable" in
		download:requires-inhibit|notification-send:requires-inhibit|\
		download:requires-bearer-stop|notification-send:requires-bearer-stop)
			action_section="$(modem_section_at "$(field "$TARGET_LINE" 19)")"
			action_interface="$(section_field "$action_section" interface 2)"
			[ "$(other_uplink_state "$action_interface")" = true ] || \
				die_code "$EXIT_BLOCKED" "sole_uplink: no proven alternate uplink is available"
		;;
	esac
	fi
	[ "$action_verb" != download ] || prepare_download_secret_fd
	TAKEOVER_STATE_DIR="$(action_state_dir_for "$REQUESTED_MODEM")"
	mkdir -p "$ACTION_STATE_DIR" || die "cannot create the action state parent"
	start_lock="${TAKEOVER_STATE_DIR}.start-lock"
	lock_try_acquire_or_reclaim "$start_lock"
	start_status=$?
	case "$start_status" in
		0) : ;;
		# Two simultaneous starts: exactly one takes the lock, and the other is
		# a coalesced repeat rather than a rejection.
		3) action_status_values "$REQUESTED_MODEM"; print_action_json 0 "$REQUESTED_MODEM"; return 0 ;;
		*) die "cannot record the action launch lock" ;;
	esac
	action_status_values "$REQUESTED_MODEM"
	if [ "$ACTION_BUSY" = true ]; then
		lock_release "$start_lock"
		print_action_json 0 "$REQUESTED_MODEM"
		return 0
	fi
	mkdir -p "$TAKEOVER_STATE_DIR" || {
		lock_release "$start_lock"
		die "cannot create the action state directory"
	}
	takeover_started="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)"
	takeover_operation="$(date -u +%s 2>/dev/null || printf '%s' 0)-$$"
	action_write_state "$TAKEOVER_STATE_DIR" starting "$action_verb" "$$" \
		"$takeover_started" "" "" "starting background worker" "$REQUESTED_ENDPOINT" \
		"$takeover_operation" "" "" "$REQUESTED_PROFILE" "$REQUESTED_SEQUENCE" \
		"$REQUESTED_MODEM" || die "cannot record the background operation"
	# Export before the asynchronous simple command rather than prefixing that
	# command with assignments. Some POSIX shells implement the latter as an
	# extra background subshell whose `$$` still names its parent. The worker
	# would then publish a PID that is not the process doing the operation, so a
	# service stop could terminate the recorded shell and leave the real worker,
	# its inhibit and its locks behind. These values are not activation secrets:
	# the secret itself is already on descriptor 5.
	APN_AUTOCONFIG_ESIM_NICKNAME_SET="$CAPTURED_NICKNAME_SET"
	APN_AUTOCONFIG_ESIM_NICKNAME_VALUE="$CAPTURED_NICKNAME"
	APN_ESIM_ALLOW_UNVERIFIED_TRANSPORT="$CAPTURED_ALLOW_UNVERIFIED_TRANSPORT"
	# The takeover consent, for the one action that needs it after the launcher
	# has finished with it. A plan reaches a card that may be behind an
	# inhibit, and as a job it asks that question in the worker rather than
	# here -- so the answer has to travel, and the launcher unsets the request
	# environment as soon as it has captured it. It is a consent and not a
	# secret: a flag whose disclosure costs nothing, which is why it goes in
	# the environment beside the others rather than down descriptor 5.
	APN_ESIM_ALLOW_TAKEOVER="$CAPTURED_ALLOW_TAKEOVER"
	APN_AUTOCONFIG_LPAC_SECRET_FD="$([ "$ACTION_SECRET_FD_OPEN" -eq 1 ] && printf 5 || printf '')"
	export APN_AUTOCONFIG_ESIM_NICKNAME_SET APN_AUTOCONFIG_ESIM_NICKNAME_VALUE
	export APN_ESIM_ALLOW_UNVERIFIED_TRANSPORT APN_ESIM_ALLOW_TAKEOVER
	export APN_AUTOCONFIG_LPAC_SECRET_FD
	APN_AUTOCONFIG_ESIM_DETACHED=launch
	export APN_AUTOCONFIG_ESIM_DETACHED
	(
		exec "$SETSID" /bin/sh "$ACTION_WORKER" "$action_verb" "$REQUESTED_MODEM" "$REQUESTED_ENDPOINT" \
			"$takeover_operation" "$takeover_started" "$start_lock" "$REQUESTED_PROFILE" \
			"$REQUESTED_SEQUENCE"
	) </dev/null >/dev/null 2>&1 &
	takeover_worker_pid=$!
	unset APN_AUTOCONFIG_ESIM_NICKNAME_SET APN_AUTOCONFIG_ESIM_NICKNAME_VALUE
	unset APN_ESIM_ALLOW_UNVERIFIED_TRANSPORT APN_ESIM_ALLOW_TAKEOVER
	unset APN_AUTOCONFIG_LPAC_SECRET_FD
	unset APN_AUTOCONFIG_ESIM_DETACHED
	if [ "$ACTION_SECRET_FD_OPEN" -eq 1 ]; then
		{ exec 5<&-; } 2>/dev/null || :
		ACTION_SECRET_FD_OPEN=0
	fi
	# The worker now owns the start lock and clears it when it reaches a
	# terminal state, so a status read after this launcher exits still sees a
	# live owner rather than an abandoned operation.
	if ! wait_worker_handoff "$takeover_worker_pid" "$start_lock" "$takeover_operation"; then
		lock_release_if_ours "$start_lock"
		launch_state="$(sed -n '1p' "$TAKEOVER_STATE_DIR/state.tsv" 2>/dev/null || :)"
		# The exact operation may publish between the waiter's last read and its
		# cleanup. Once it has acknowledged, this launch is accepted; it must not
		# be described as a coalesced duplicate merely because it is still busy.
		if [ "$(field "$launch_state" 10)" = "$takeover_operation" ] && \
			[ "$(field "$launch_state" 4)" != "$SELF_PID" ] && \
			[ "$(field "$launch_state" 2)" != starting ] && \
			[ "$(field "$launch_state" 12)" != handoff_failed ]; then
			TAKEOVER_STATE_DIR=""
			action_status_values "$REQUESTED_MODEM"
			print_action_json 1 "$REQUESTED_MODEM"
			return 0
		fi
		TAKEOVER_STATE_DIR=""
		action_status_values "$REQUESTED_MODEM"
		print_action_json 0 "$REQUESTED_MODEM"
		return "$EXIT_RETRYABLE"
	fi
	# Not this process's to unwind any more.
	TAKEOVER_STATE_DIR=""
	action_status_values "$REQUESTED_MODEM"
	print_action_json 1 "$REQUESTED_MODEM"
}

# The worker. Runs under the start lock its launcher handed it, takes the full
# lock order 1 -> 2 -> 3 -> 4, holds the inhibit for exactly as long as it needs
# and no longer, and publishes one terminal result naming every stage that
# completed.
takeover_run_cmd() {
	[ -n "$REQUESTED_MODEM" ] || die_code "$EXIT_USAGE" "takeover-run requires --modem"
	[ -n "$REQUESTED_ENDPOINT" ] || die_code "$EXIT_USAGE" "takeover-run requires --endpoint"
	[ -n "$REQUESTED_OPERATION" ] || die_code "$EXIT_USAGE" "takeover-run requires --operation"
	TAKEOVER_OPERATION_ID="$REQUESTED_OPERATION"
	OPERATION_ACTION=read-takeover
	TAKEOVER_STARTED="${APN_AUTOCONFIG_ESIM_STARTED:-$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)}"
	TAKEOVER_STATE_DIR="$(action_state_dir_for "$REQUESTED_MODEM")"
	TAKEOVER_START_LOCK="${APN_AUTOCONFIG_ESIM_START_LOCK:-}"
	TAKEOVER_PUBLISH_ARMED=1
	adopt_handoff_pid || {
		OPERATION_REASON=handoff_failed
		takeover_publish failed "$EXIT_RETRYABLE" "the background worker handoff could not be verified"
		return "$EXIT_RETRYABLE"
	}
	takeover_publish_running || return "$EXIT_RETRYABLE"

	# 1 and 2. The global lock is system-wide, and a takeover is exactly the
	# kind of operation it exists for: it changes who owns a modem.
	acquire_global_lock "$LOCK_WAIT_SECONDS" || {
		takeover_publish failed "$EXIT_RETRYABLE" "another operation holds the global lock"
		return "$EXIT_RETRYABLE"
	}
	acquire_modem_lock "$REQUESTED_MODEM" "$LOCK_WAIT_SECONDS" || {
		takeover_publish failed "$EXIT_RETRYABLE" "another operation holds this modem"
		return "$EXIT_RETRYABLE"
	}
	takeover_stage acquire_locks

	# Revalidation after the locks, not before them. Pre-lock validation alone
	# is a time-of-check/time-of-use race: the launcher proved this a moment
	# ago, under no lock at all.
	#
	# The declaration is what stops the revalidation seeing this operation as
	# somebody else's. The inventory read runs as a child, so its own PID does
	# not match the per-modem lock this worker holds, and without saying so the
	# modem comes back `transitioning` -- because of this operation -- and the
	# revalidation refuses. Checked on hardware, where it refused exactly that
	# way on the first real run.
	APN_AUTOCONFIG_MODEM_LOCK_OWNER_PID=$SELF_PID
	export APN_AUTOCONFIG_MODEM_LOCK_OWNER_PID
	load_modem_records "$REQUESTED_MODEM" || {
		takeover_publish failed "$EXIT_RETRYABLE" "the modem inventory could not be re-read"
		return "$EXIT_RETRYABLE"
	}
	enumerate_endpoints
	TARGET_LINE="$(awk -F '\t' -v modem="$REQUESTED_MODEM" -v endpoint="$REQUESTED_ENDPOINT" '
		$3 == modem && $1 == endpoint { print; count++ }
		END { if (count != 1) exit 3 }
	' "$ENDPOINT_FILE")" || {
		takeover_publish blocked "$EXIT_BLOCKED" "the endpoint is no longer present or is ambiguous"
		return "$EXIT_BLOCKED"
	}
	[ "$(field "$TARGET_LINE" 2)" = eid ] || {
		takeover_publish blocked "$EXIT_BLOCKED" "the endpoint is no longer proven"
		return "$EXIT_BLOCKED"
	}
	takeover_reachable="$(field "$TARGET_LINE" 14)"
	case "$takeover_reachable" in
		requires-inhibit|requires-bearer-stop) : ;;
		*)
			takeover_publish blocked "$EXIT_BLOCKED" \
				"the endpoint no longer needs a takeover, or no longer permits one"
			return "$EXIT_BLOCKED"
		;;
	esac
	takeover_stage revalidate

	takeover_section="$(modem_section_at "$(field "$TARGET_LINE" 19)")"
	if [ "$takeover_reachable" = requires-bearer-stop ]; then
		# The second mechanism: nobody owns this modem but netifd, and the
		# bearer holds the only channel there is. Stopping that one interface
		# is the takeover, and starting it again is the restore.
		takeover_stop_status=0
		takeover_acquire_bearer_stop "$(section_field "$takeover_section" interface 2)" || \
			takeover_stop_status=$?
		if [ "$takeover_stop_status" -ne 0 ]; then
			takeover_publish failed "$takeover_stop_status" \
				"the selected bearer could not be stopped for this read"
			return "$takeover_stop_status"
		fi
	else
		takeover_mm="$(section_field "$takeover_section" mm 2)"
		case "$takeover_mm" in ''|*[!0-9]*)
			takeover_publish blocked "$EXIT_BLOCKED" "ModemManager does not name this modem"
			return "$EXIT_BLOCKED"
		;; esac
		takeover_acquire_inhibit "$takeover_mm" || return $?
	fi
	takeover_stage inhibit

	# 3 and 4, and the read. The bridge takes those two itself and releases only
	# those two, so this worker keeps standing on 1 and 2 throughout. The owner
	# it is given is the one that is true *now* -- `none`, because ModemManager
	# has let go -- rather than the one the record was written with, which is
	# exactly what the inhibit changed.
	# Every port, because ModemManager has let go of all of them, and the
	# bridge picks the one that answers rather than the one numbered lowest.
	takeover_candidates="$(control_candidates "$takeover_section" "" | tr '\n' ' ')"
	[ -n "$takeover_candidates" ] || {
		takeover_publish failed "$EXIT_RETRYABLE" "no control port could be resolved after the inhibit"
		return "$EXIT_RETRYABLE"
	}
	takeover_profiles="$TMP_BASE.lpa-profiles"
	takeover_status=0
	read_profiles_through_lpa "$REQUESTED_ENDPOINT" none "$takeover_candidates" "" \
		"$takeover_profiles" || takeover_status=$?
	if [ "$takeover_status" -ne 0 ]; then
		takeover_publish failed "$takeover_status" "the eUICC could not be read under the inhibit"
		return "$takeover_status"
	fi
	takeover_stage read

	takeover_count="$(wc -l <"$takeover_profiles" | tr -d ' ')"
	# Keep what the interruption bought. Without this the operation reported a
	# count and threw the list away, so the only way to see a profile was to
	# inhibit ModemManager all over again. It is written below, once, by
	# `cache_store_card_read`, and read back from there as `cached` with an age
	# -- the takeover makes an unreadable endpoint readable once, it does not
	# make it current for ever.

	# The pending notifications, in the same inhibit, for the same reason.
	# A notification is how an SM-DP+ learns what became of the profile it
	# issued, and its sequence number -- the only way to name it -- comes from
	# nowhere else. Reading the profiles and not these left the card half
	# legible and `notification-send` undrivable behind ModemManager.
	#
	# It does not fail the takeover. The profile list is what the interruption
	# was consented to for, and an endpoint whose notifications could not be
	# read says so rather than reporting none of them.
	takeover_notifications="$TMP_BASE.lpa-notifications"
	takeover_notice="the pending notifications could not be read"
	if read_notifications_through_lpa "$REQUESTED_ENDPOINT" none "$takeover_candidates" "" \
		"$takeover_notifications"; then
		takeover_notice="$(wc -l <"$takeover_notifications" | tr -d ' ') pending notification(s)"
	else
		# Nothing to store, and the helper below must not write an empty list as
		# though the card had said it has none.
		rm -f "$takeover_notifications" 2>/dev/null || :
	fi

	# What the card says it has left, in the same inhibit and for the same
	# reason as the two reads above.
	#
	# Found on hardware 2026-09-03: collecting this only in `esim_read_endpoint`
	# meant collecting it only for an endpoint that needs no takeover -- and on
	# this router there is no such endpoint, so the figure was never gathered at
	# all. The fixtures could not see it because they drove the `reachable: yes`
	# path, which is the one composition this hardware does not have.
	takeover_free_memory=""
	takeover_installed=""
	if read_card_resource_through_lpa "$REQUESTED_ENDPOINT" none "$takeover_candidates" ""; then
		takeover_free_memory="$ENDPOINT_FREE_MEMORY"
		takeover_installed="$ENDPOINT_INSTALLED_APPLICATIONS"
	fi
	# One place writes what a read produced, so the key this cache is addressed
	# by is computed once rather than in every operation that fills it.
	cache_store_card_read "$REQUESTED_ENDPOINT" "$TARGET_LINE" "$takeover_profiles" \
		"$takeover_notifications" "$takeover_free_memory" "$takeover_installed" || :

	# Released here rather than by the trap, so the modem is back with its
	# owner -- or the interface is up again -- before the result says the
	# operation finished.
	takeover_release_prepare
	takeover_stage restore
	takeover_publish succeeded 0 \
		"read $takeover_count profile(s) and $takeover_notice under a bounded inhibit"
	return 0
}

# ---- closing the loop with the SM-DP+ ----
#
# A download is not finished when the profile is on the card. SGP.22 has the
# eUICC produce a notification for the install and the LPA deliver it to the
# issuer; until it arrives, the operator's record and the card disagree. That
# disagreement is the state in which an operator believes a profile was taken,
# the subscriber has nothing, and support has no lever to reissue -- so this
# operation delivers what it caused before it reports itself done.
#
# Only what it caused. The pending list is taken before the download and again
# afterwards, and the difference is this operation's own. Delivering everything
# pending would be a larger action than the one that was asked for, and a
# notification some earlier operation left is that operation's to explain.
#
# Removal happens only after the server has taken it. A notification dropped
# from the card first cannot be sent again, and the record it carried is gone.
OPERATION_NOTIFICATIONS_BEFORE=""
DOWNLOAD_INSTALL_OBSERVED=0
OPERATION_NOTIFY_DELIVERED=0
OPERATION_NOTIFY_PENDING=0
OPERATION_NOTIFY_UNVERIFIED=0

# Whole seconds from some fixed point, for bounding a wait.
#
# The stderr redirection is written before the input one, and the order is not
# cosmetic: redirections are applied left to right, so `</proc/uptime` placed
# first fails while stderr is still the caller's, and a host without that file
# gets a shell diagnostic on every call. Once this is asked per line of an AT
# reply, that is a diagnostic per line.
#
# /proc/uptime first, because a builtin redirect costs no process and the target
# always has it; `date` otherwise, because the fixture suite runs on a host that
# does not. A caller that gets nothing waits for nothing rather than looping
# without a bound.
monotonic_seconds() {
	if read -r monotonic_raw monotonic_ignored 2>/dev/null </proc/uptime; then
		printf '%s\n' "${monotonic_raw%%.*}"
		return 0
	fi
	monotonic_raw="$(date +%s 2>/dev/null)" || return 1
	case "$monotonic_raw" in ''|*[!0-9]*) return 1 ;; esac
	printf '%s\n' "$monotonic_raw"
	return 0
}

# Taken once, here rather than beside the traps, because it is read at load
# time and `monotonic_seconds` has to be defined by then. It lets the signal
# diagnostic say how long the process had been alive; an empty value simply
# omits that part.
SIGNAL_DIAGNOSTIC_START="$(monotonic_seconds 2>/dev/null || :)"

# Whether this operation still owns the modem it is talking to.
#
# The inhibit is bounded, the watchdog enforces that bound exactly, and the
# consent the user gave names the number. An operation that outlives it does not
# get to keep using the card: measured on the reference router, the watchdog
# released the modem at 180 s on the dot, ModemManager re-enumerated it, and the
# work carried on for another 254 seconds against a modem somebody else owned.
# So every card transaction after the first one asks again.
#
# An adopted inhibit -- one another component already held -- has no child of
# ours to watch, and its bound is not ours to enforce either.
takeover_inhibit_still_held() {
	[ "${TAKEOVER_INHIBIT_CREATED:-0}" -eq 1 ] || return 0
	[ -n "${TAKEOVER_INHIBIT_PID:-}" ] || return 1
	takeover_holder_birth="$(field "$(sed -n '1p' "$TAKEOVER_INHIBIT_LEASE" 2>/dev/null || :)" 9)"
	process_matches "$TAKEOVER_INHIBIT_PID" "$takeover_holder_birth"
}

# The pending notifications as `sequence<TAB>operation` lines. Fails rather than
# producing an empty file when the list could not be read, so "nothing new
# happened" is never manufactured out of "nothing could be read".
notification_snapshot() {
	snapshot_out="$5"
	snapshot_raw="$TMP_BASE.notify-raw"
	: >"$snapshot_out"
	read_notifications_through_lpa "$1" "$2" "$3" "$4" "$snapshot_raw" || return 1
	cut -f 1,2 <"$snapshot_raw" >"$snapshot_out" 2>/dev/null || return 1
	return 0
}

deliver_caused_notifications() {
	deliver_endpoint="$1"
	deliver_owner="$2"
	deliver_candidates="$3"
	deliver_bearer="$4"
	deliver_after_interrupt="${5:-0}"
	OPERATION_NOTIFY_DELIVERED=0
	OPERATION_NOTIFY_PENDING=0
	OPERATION_NOTIFY_UNVERIFIED=0
	DOWNLOAD_INSTALL_OBSERVED=0
	OPERATION_NOTIFICATION_DELIVERY=unknown
	[ -n "$OPERATION_NOTIFICATIONS_BEFORE" ] && [ -f "$OPERATION_NOTIFICATIONS_BEFORE" ] || return 0
	takeover_inhibit_still_held || {
		log err 'the bounded inhibit ended before the SM-DP+ could be told; stopping rather than using a modem this operation no longer owns'
		return 0
	}
	# The card may still be finishing after the LPA has given up.
	#
	# Measured on the reference router once the operation became fast enough to
	# notice: a load whose last APDU was refused had installed the profile and
	# had produced no notification yet, four seconds after the LPA reported
	# failure. Twenty seconds later both notifications were there. The earlier,
	# seven-minute version of this operation never saw the race because its own
	# slowness outlasted the card.
	#
	# So an interrupted load asks again for a while before concluding that
	# nothing happened. The uninterrupted path does not: there the LPA already
	# holds the card's installation result, so the notification exists by the
	# time this runs, and a delay would be pure cost.
	deliver_after="$TMP_BASE.notify-after"
	# Waiting inside the inhibit does not work on the reference card, and the
	# measurement that settled it is worth keeping.
	#
	# Twenty seconds of asking was not enough, so the wait became a deadline and
	# the budget went to ninety. Ninety was not enough either: the log shows
	# twelve looks over eighty-three seconds, all of them finding nothing, and
	# the very next operation -- after the inhibit was released and
	# ModemManager re-enumerated the modem -- found the profile and both of its
	# notifications. Twice, with different codes.
	#
	# So the eUICC does not finish while this operation holds the card. It
	# finishes when the modem is handed back and the card is re-initialised, and
	# no amount of waiting here reaches that. The budget therefore defaults to
	# zero: a wait that cannot succeed is pure outage. The knob remains because
	# this is one card's behaviour and another may differ, and the mechanism is
	# what a second inhibit after the hand-back would reuse.
	deliver_deadline=""
	if [ "$deliver_after_interrupt" = 1 ] && [ "$INSTALL_SETTLE_SECONDS" -gt 0 ]; then
		deliver_now="$(monotonic_seconds)" && \
			deliver_deadline=$((deliver_now + INSTALL_SETTLE_SECONDS))
	fi
	while :; do
		takeover_inhibit_still_held || {
			log err 'the bounded inhibit ended while waiting for the card to finish'
			return 0
		}
		notification_snapshot "$deliver_endpoint" "$deliver_owner" \
			"$deliver_candidates" "$deliver_bearer" "$deliver_after" || return 0
		# Collected into a list before any of it is acted on: an LPA invocation
		# in the body of a `while read` loop competes with it for standard input.
		deliver_new="$(awk -F '\t' '
			NR == FNR { seen[$1] = 1; next }
			$1 != "" && !($1 in seen) { printf "%s,%s ", $1, $2 }
		' "$OPERATION_NOTIFICATIONS_BEFORE" "$deliver_after" 2>/dev/null || :)"
		[ -z "$deliver_new" ] || break
		[ -n "$deliver_deadline" ] || break
		deliver_now="$(monotonic_seconds)" || break
		[ "$deliver_now" -lt "$deliver_deadline" ] || break
		# How long the card has been given so far. The default budget is a bound
		# with margin rather than a measured figure, and this line is what turns
		# the next interrupted load into the measurement that replaces it.
		log notice "the card has not finished the install after $((deliver_now - deliver_deadline + INSTALL_SETTLE_SECONDS)) s"
		"$SLEEP" 5 2>/dev/null || break
	done
	if [ -z "$deliver_new" ]; then
		OPERATION_NOTIFICATION_DELIVERY=none
		return 0
	fi
	deliver_sequences=""
	for deliver_item in $deliver_new; do
		deliver_sequence="${deliver_item%%,*}"
		deliver_operation="${deliver_item#*,}"
		case "$deliver_sequence" in ''|*[!0-9]*) continue ;; esac
		[ "$deliver_operation" != install ] || DOWNLOAD_INSTALL_OBSERVED=1
		deliver_sequences="$deliver_sequences $deliver_sequence"
	done
	[ -n "$deliver_sequences" ] || { OPERATION_NOTIFICATION_DELIVERY=none; return 0; }

	# One invocation for all of them, when nothing can downgrade the transport.
	#
	# lpac takes several sequence numbers and, with -r, removes each only after
	# its own `es9p_handle_notification` returned success -- which is this
	# contract's rule, enforced one layer lower. Opening and closing the card
	# costs about as much as the work inside it on this hardware, so doing that
	# once instead of twice per notification is most of what a delivery costs.
	#
	# It is not used when the consented downgrade is available for this
	# operation, because then a success might be an unverified one, and an
	# unverified acceptance must not remove anything. There the two-step loop
	# below runs and inspects each result.
	if [ "$CAPTURED_ALLOW_UNVERIFIED_TRANSPORT" != 1 ]; then
		takeover_inhibit_still_held || {
			log err 'the bounded inhibit ended before the SM-DP+ could be told'
			return 0
		}
		deliver_status=0
		# shellcheck disable=SC2086
		bridge_run "$deliver_endpoint" "$deliver_owner" "$deliver_candidates" \
			"$deliver_bearer" notification process -r $deliver_sequences || deliver_status=$?
		if [ "$deliver_status" -eq 0 ]; then
			for deliver_item in $deliver_sequences; do
				OPERATION_NOTIFY_DELIVERED=$((OPERATION_NOTIFY_DELIVERED + 1))
			done
			OPERATION_NOTIFICATION_DELIVERY=delivered
			return 0
		fi
		# lpac stops at the first one that failed, so what it managed is read
		# from the card rather than inferred: whatever is still there was not
		# delivered, or was delivered and not removed, and both of those are
		# safe to treat as still owed. The cost of being wrong that way is a
		# duplicate the issuer discards.
		log err 'a notification could not be delivered; the card keeps what is still owed'
		deliver_remaining="$TMP_BASE.notify-remaining"
		if ! notification_snapshot "$deliver_endpoint" "$deliver_owner" \
			"$deliver_candidates" "$deliver_bearer" "$deliver_remaining"; then
			OPERATION_NOTIFICATION_DELIVERY=unknown
			return 0
		fi
		for deliver_item in $deliver_sequences; do
			if awk -F '\t' -v want="$deliver_item" \
				'$1 == want { found = 1 } END { exit found ? 0 : 1 }' \
				"$deliver_remaining" 2>/dev/null; then
				OPERATION_NOTIFY_PENDING=$((OPERATION_NOTIFY_PENDING + 1))
			else
				OPERATION_NOTIFY_DELIVERED=$((OPERATION_NOTIFY_DELIVERED + 1))
			fi
		done
		if [ "$OPERATION_NOTIFY_DELIVERED" -eq 0 ]; then
			OPERATION_NOTIFICATION_DELIVERY=pending
		else
			OPERATION_NOTIFICATION_DELIVERY=partial
		fi
		return 0
	fi

	for deliver_item in $deliver_new; do
		deliver_sequence="${deliver_item%%,*}"
		deliver_operation="${deliver_item#*,}"
		case "$deliver_sequence" in ''|*[!0-9]*) continue ;; esac
		takeover_inhibit_still_held || {
			log err 'the bounded inhibit ended with notifications still undelivered'
			OPERATION_NOTIFY_PENDING=$((OPERATION_NOTIFY_PENDING + 1))
			continue
		}
		deliver_status=0
		bridge_run "$deliver_endpoint" "$deliver_owner" "$deliver_candidates" \
			"$deliver_bearer" notification process "$deliver_sequence" || deliver_status=$?
		if [ "$deliver_status" -ne 0 ]; then
			log err "the SM-DP+ was not told about a $deliver_operation; it stays on the card"
			OPERATION_NOTIFY_PENDING=$((OPERATION_NOTIFY_PENDING + 1))
			continue
		fi
		OPERATION_NOTIFY_DELIVERED=$((OPERATION_NOTIFY_DELIVERED + 1))
		# An acceptance nobody authenticated is not proof of delivery.
		#
		# With verification off, whatever answered may not be the SM-DP+ at all,
		# and a hostile answer that says "received" would make this remove the
		# card's only copy of a message the real issuer never got. That failure
		# is silent and permanent, and it is worse than the one the downgrade
		# exists to avoid. So a notification delivered over an unverified
		# transport stays on the card, to be sent again when the issuer can be
		# verified; the cost of keeping it is a duplicate the issuer discards.
		if [ "$BRIDGE_TRANSPORT_SECURITY" = unverified ]; then
			OPERATION_NOTIFY_UNVERIFIED=$((OPERATION_NOTIFY_UNVERIFIED + 1))
			log err 'a notification was accepted over an unverified transport and is kept on the card'
			continue
		fi
		bridge_run "$deliver_endpoint" "$deliver_owner" "$deliver_candidates" \
			"$deliver_bearer" notification remove "$deliver_sequence" || \
			log err "a delivered notification could not be removed from the card"
	done
	if [ "$OPERATION_NOTIFY_PENDING" -ne 0 ] && [ "$OPERATION_NOTIFY_DELIVERED" -eq 0 ]; then
		OPERATION_NOTIFICATION_DELIVERY=pending
	elif [ "$OPERATION_NOTIFY_PENDING" -ne 0 ]; then
		OPERATION_NOTIFICATION_DELIVERY=partial
	elif [ "$OPERATION_NOTIFY_UNVERIFIED" -ne 0 ]; then
		OPERATION_NOTIFICATION_DELIVERY=delivered_unverified
	else
		OPERATION_NOTIFICATION_DELIVERY=delivered
	fi
	return 0
}

# Resolve a public profile handle back to the one raw ICCID the LPA needs,
# from a fresh device read made under the operation locks. The raw value stays
# in one unexported variable and is cleared immediately after the mutating LPA
# invocation; it is never printed, cached or written to operation state.
#
# The same read also records what the card looked like before the mutation:
# which profile was enabled, and what state the requested one was in. Both are
# part of the baseline a switch has to be able to restore, and reading them here
# costs nothing -- the list is already in hand, and on this hardware opening and
# closing the card costs about as much as the work inside it. Only public
# handles are kept: restoring one later re-resolves it from a fresh read, which
# is what the contract requires anyway.
resolve_profile_for_mutation() {
	RESOLVED_PROFILE_ICCID=""
	RESOLVED_PROFILE_STATE=""
	RESOLVED_ENABLED_PROFILE=""
	command_exists "$JSONFILTER" || return 3
	bridge_status=0
	bridge_run "$1" "$2" "$3" "$4" profile list || bridge_status=$?
	[ "$bridge_status" -eq 0 ] || return "$bridge_status"
	resolve_data="$(lpa_result_data 2>/dev/null || :)"
	[ -n "$resolve_data" ] || return 3
	resolve_count="$(json_array_length "$resolve_data")"
	resolve_index=0
	resolve_matches=0
	while [ "$resolve_index" -lt "$resolve_count" ]; do
		resolve_raw="$(normalise_iccid \
			"$(json_element_field "$resolve_data" "$resolve_index" iccid)" 2>/dev/null || :)"
		resolve_at="$resolve_index"
		resolve_index=$((resolve_index + 1))
		[ -n "$resolve_raw" ] || continue
		resolve_handle="$(profile_handle_from_iccid "$resolve_raw" 2>/dev/null || :)"
		resolve_state="$(json_element_field "$resolve_data" "$resolve_at" profileState)"
		# Which profile the card had enabled when this operation started. It is
		# the restore point of a switch, and it is kept as a public handle
		# rather than as an ICCID: a rollback re-resolves it from a fresh read,
		# which is what the contract requires of one anyway, so there is no
		# reason for the raw value to live across the operation.
		#
		# Two profiles reported enabled at once is a card contradicting itself.
		# The baseline is then unusable rather than approximately right, and an
		# empty one blocks rollback later instead of restoring the wrong one.
		if [ "$resolve_state" = enabled ]; then
			if [ -n "$RESOLVED_ENABLED_PROFILE" ]; then
				RESOLVED_ENABLED_PROFILE=ambiguous
			elif [ -n "$resolve_handle" ]; then
				RESOLVED_ENABLED_PROFILE="$resolve_handle"
			else
				RESOLVED_ENABLED_PROFILE=ambiguous
			fi
		fi
		[ "$resolve_handle" = "$REQUESTED_PROFILE" ] || {
			resolve_raw=""
			continue
		}
		case "$resolve_state" in enabled|disabled) : ;; *) resolve_raw=""; return 4 ;; esac
		resolve_matches=$((resolve_matches + 1))
		RESOLVED_PROFILE_ICCID="$resolve_raw"
		RESOLVED_PROFILE_STATE="$resolve_state"
		resolve_raw=""
	done
	[ "$resolve_matches" -eq 1 ] || { RESOLVED_PROFILE_ICCID=""; return 4; }
	return 0
}

validate_notification_for_mutation() {
	validation_file="$TMP_BASE.lpa-data"
	validation_status=0
	read_notifications_through_lpa "$1" "$2" "$3" "$4" "$validation_file" || validation_status=$?
	[ "$validation_status" -eq 0 ] || return "$validation_status"
	validation_matches="$(awk -F '\t' -v sequence="$REQUESTED_SEQUENCE" \
		'$1 == sequence { count++ } END { print count + 0 }' "$validation_file")"
	[ "$validation_matches" -eq 1 ] || return 4
	return 0
}

mutation_run_cmd() {
	case "$REQUESTED_ACTION" in download|nickname|notification-send|notification-remove) : ;;
		*) die_code "$EXIT_USAGE" "mutation-run requires an additive action" ;; esac
	[ -n "$REQUESTED_MODEM" ] || die_code "$EXIT_USAGE" "mutation-run requires --modem"
	[ -n "$REQUESTED_ENDPOINT" ] || die_code "$EXIT_USAGE" "mutation-run requires --endpoint"
	[ -n "$REQUESTED_OPERATION" ] || die_code "$EXIT_USAGE" "mutation-run requires --operation"
	OPERATION_ACTION="$REQUESTED_ACTION"
	OPERATION_PROFILE="$REQUESTED_PROFILE"
	OPERATION_SEQUENCE="$REQUESTED_SEQUENCE"
	TAKEOVER_OPERATION_ID="$REQUESTED_OPERATION"
	TAKEOVER_STARTED="${APN_AUTOCONFIG_ESIM_STARTED:-$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)}"
	TAKEOVER_STATE_DIR="$(action_state_dir_for "$REQUESTED_MODEM")"
	TAKEOVER_START_LOCK="${APN_AUTOCONFIG_ESIM_START_LOCK:-}"
	TAKEOVER_PUBLISH_ARMED=1
	adopt_handoff_pid || {
		OPERATION_REASON=handoff_failed
		takeover_publish failed "$EXIT_RETRYABLE" "the background worker handoff could not be verified"
		return "$EXIT_RETRYABLE"
	}
	takeover_publish_running || return "$EXIT_RETRYABLE"

	acquire_global_lock "$LOCK_WAIT_SECONDS" || {
		OPERATION_REASON=global_busy
		takeover_publish failed "$EXIT_RETRYABLE" "another operation holds the global lock"
		return "$EXIT_RETRYABLE"
	}
	acquire_modem_lock "$REQUESTED_MODEM" "$LOCK_WAIT_SECONDS" || {
		OPERATION_REASON=modem_busy
		takeover_publish failed "$EXIT_RETRYABLE" "another operation holds this modem"
		return "$EXIT_RETRYABLE"
	}
	takeover_stage acquire_locks

	APN_AUTOCONFIG_MODEM_LOCK_OWNER_PID=$SELF_PID
	export APN_AUTOCONFIG_MODEM_LOCK_OWNER_PID
	load_modem_records "$REQUESTED_MODEM" || {
		OPERATION_REASON=inventory_unavailable
		takeover_publish failed "$EXIT_RETRYABLE" "the modem inventory could not be re-read"
		return "$EXIT_RETRYABLE"
	}
	enumerate_endpoints
	TARGET_LINE="$(awk -F '\t' -v modem="$REQUESTED_MODEM" -v endpoint="$REQUESTED_ENDPOINT" '
		$3 == modem && $1 == endpoint { print; count++ }
		END { if (count != 1) exit 3 }
	' "$ENDPOINT_FILE")" || {
		OPERATION_REASON=endpoint_unavailable
		takeover_publish blocked "$EXIT_BLOCKED" "the endpoint is no longer present or is ambiguous"
		return "$EXIT_BLOCKED"
	}
	[ "$(field "$TARGET_LINE" 2)" = eid ] || {
		OPERATION_REASON=endpoint_unproven
		takeover_publish blocked "$EXIT_BLOCKED" "the endpoint is no longer proven"
		return "$EXIT_BLOCKED"
	}
	mutation_reachable="$(field "$TARGET_LINE" 14)"
	case "$mutation_reachable" in yes|requires-inhibit|requires-bearer-stop) : ;;
		*)
			OPERATION_REASON=endpoint_unreachable
			takeover_publish blocked "$EXIT_BLOCKED" "the endpoint no longer permits this operation"
			return "$EXIT_BLOCKED"
		;;
	esac
	takeover_stage revalidate

	mutation_section="$(modem_section_at "$(field "$TARGET_LINE" 19)")"
	mutation_owner="$(field "$TARGET_LINE" 13)"
	mutation_candidates="$(esim_transport_candidates "$TARGET_LINE")"
	mutation_bearer="$(esim_bearer_device "$TARGET_LINE")"
	if [ "$mutation_reachable" = requires-inhibit ]; then
		case "$OPERATION_ACTION" in download|notification-send)
			mutation_interface="$(section_field "$mutation_section" interface 2)"
			if [ "$(other_uplink_state "$mutation_interface")" != true ]; then
				OPERATION_REASON=sole_uplink
				takeover_publish blocked "$EXIT_BLOCKED" "sole_uplink: no proven alternate uplink is available"
				return "$EXIT_BLOCKED"
			fi
		;; esac
		mutation_mm="$(section_field "$mutation_section" mm 2)"
		case "$mutation_mm" in ''|*[!0-9]*)
			OPERATION_REASON=modemmanager_unavailable
			takeover_publish blocked "$EXIT_BLOCKED" "ModemManager does not name this modem"
			return "$EXIT_BLOCKED"
		;; esac
		takeover_acquire_inhibit "$mutation_mm" || return $?
		mutation_owner=none
		mutation_candidates="$(control_candidates "$mutation_section" "" | tr '\n' ' ')"
		mutation_bearer=""
		mutation_owner=none
		[ -n "$mutation_candidates" ] || {
			OPERATION_REASON=no_control_port
			takeover_publish failed "$EXIT_RETRYABLE" "no control port could be resolved after the inhibit"
			return "$EXIT_RETRYABLE"
		}
	elif [ "$mutation_reachable" = requires-bearer-stop ]; then
		# The other mechanism, under the same rules. The sole-uplink refusal
		# above still applies to the two actions that need the network, and it
		# applies harder here: stopping the bearer is what takes the network
		# away, so an operation that needs one has to have another.
		mutation_interface="$(section_field "$mutation_section" interface 2)"
		case "$OPERATION_ACTION" in download|notification-send)
			if [ "$(other_uplink_state "$mutation_interface")" != true ]; then
				OPERATION_REASON=sole_uplink
				takeover_publish blocked "$EXIT_BLOCKED" "sole_uplink: no proven alternate uplink is available"
				return "$EXIT_BLOCKED"
			fi
		;; esac
		mutation_stop_status=0
		takeover_acquire_bearer_stop "$mutation_interface" || mutation_stop_status=$?
		if [ "$mutation_stop_status" -ne 0 ]; then
			takeover_publish failed "$mutation_stop_status" \
				"the selected bearer could not be stopped for this operation"
			return "$mutation_stop_status"
		fi
		mutation_candidates="$(control_candidates "$mutation_section" "" | tr '\n' ' ')"
		mutation_bearer=""
		mutation_owner=none
		[ -n "$mutation_candidates" ] || {
			OPERATION_REASON=no_control_port
			takeover_publish failed "$EXIT_RETRYABLE" \
				"no control port could be resolved after the bearer was stopped"
			return "$EXIT_RETRYABLE"
		}
	fi
	takeover_stage prepare

	case "$OPERATION_ACTION" in
		nickname)
			resolve_status=0
			resolve_profile_for_mutation "$REQUESTED_ENDPOINT" "$mutation_owner" \
				"$mutation_candidates" "$mutation_bearer" || resolve_status=$?
			if [ "$resolve_status" -ne 0 ]; then
				OPERATION_REASON=profile_ambiguous
				takeover_publish blocked "$resolve_status" "the profile could not be revalidated"
				return "$resolve_status"
			fi
		;;
		notification-send|notification-remove)
			validation_status=0
			validate_notification_for_mutation "$REQUESTED_ENDPOINT" "$mutation_owner" \
				"$mutation_candidates" "$mutation_bearer" || validation_status=$?
			if [ "$validation_status" -ne 0 ]; then
				OPERATION_REASON=notification_missing
				takeover_publish blocked "$validation_status" "the notification could not be revalidated"
				return "$validation_status"
			fi
		;;
	esac

	# From this line the old cache is already a lie. Invalidation is at mutation
	# start, before the LPA request, and no optimistic replacement is written.
	cache_invalidate_endpoint "$REQUESTED_ENDPOINT"
	mutation_status=0
	# What the card already owed its issuers before this operation touched it.
	# Everything that appears after the download is this operation's to deliver.
	OPERATION_NOTIFICATIONS_BEFORE=""
	DOWNLOAD_INSTALL_OBSERVED=0
	# One operation, one authority that may be downgraded to. Set here, where
	# the operation's card work begins, rather than per LPA invocation.
	BRIDGE_UNVERIFIED_AUTHORITY=""
	if [ "$OPERATION_ACTION" = download ] && takeover_inhibit_still_held; then
		OPERATION_NOTIFICATIONS_BEFORE="$TMP_BASE.notify-before"
		notification_snapshot "$REQUESTED_ENDPOINT" "$mutation_owner" \
			"$mutation_candidates" "$mutation_bearer" \
			"$OPERATION_NOTIFICATIONS_BEFORE" || OPERATION_NOTIFICATIONS_BEFORE=""
	fi
	case "$OPERATION_ACTION" in
		download)
			bridge_run "$REQUESTED_ENDPOINT" "$mutation_owner" "$mutation_candidates" \
				"$mutation_bearer" profile download || mutation_status=$?
		;;
		nickname)
			bridge_run "$REQUESTED_ENDPOINT" "$mutation_owner" "$mutation_candidates" \
				"$mutation_bearer" profile nickname "$RESOLVED_PROFILE_ICCID" \
				"$CAPTURED_NICKNAME" || mutation_status=$?
			RESOLVED_PROFILE_ICCID=""
		;;
		notification-send)
			bridge_run "$REQUESTED_ENDPOINT" "$mutation_owner" "$mutation_candidates" \
				"$mutation_bearer" notification process "$REQUESTED_SEQUENCE" || mutation_status=$?
		;;
		notification-remove)
			bridge_run "$REQUESTED_ENDPOINT" "$mutation_owner" "$mutation_candidates" \
				"$mutation_bearer" notification remove "$REQUESTED_SEQUENCE" || mutation_status=$?
		;;
	esac
	if [ "$BRIDGE_IDENTITY_FAILED" -eq 1 ]; then
		takeover_publish blocked "$EXIT_BLOCKED" \
			"the physical card identity was not confirmed; no change was sent"
		return "$EXIT_BLOCKED"
	fi
	if [ "$OPERATION_ACTION" = download ]; then
		# Still inside the inhibit and the whole lock order, because this is
		# part of the download rather than a favour done afterwards: releasing
		# first would leave a window in which the profile exists and its issuer
		# has not been told, and the endpoint is unreachable again.
		#
		# The transport failure classes are cleared first: what follows makes
		# its own HTTPS requests, and one of those failing must not be read back
		# as the download's own TLS verdict.
		OPERATION_TRANSPORT_SECURITY="$BRIDGE_TRANSPORT_SECURITY"
		if [ "$BRIDGE_HTTP_FAILURE" = tls_untrusted_issuer ] && \
			[ "$CAPTURED_ALLOW_UNVERIFIED_TRANSPORT" != 1 ]; then
			OPERATION_TRANSPORT_RETRY_ALLOWED=true
		else
			OPERATION_TRANSPORT_RETRY_ALLOWED=false
		fi
		# An exchange that never reached the SM-DP+ cannot have made the card
		# owe anybody anything, so there is nothing to deliver and no reason to
		# spend two more card transactions finding that out.
		if [ -z "$BRIDGE_HTTP_FAILURE" ]; then
			# The download's own verdict, saved across the deliveries. Each of
			# those is a separate LPA invocation with its own HTTPS request and
			# its own result, and reading one of those back as the download's
			# would report the wrong thing about the wrong exchange.
			download_result_code="$BRIDGE_RESULT_CODE"
			download_result_message="$BRIDGE_RESULT_MESSAGE"
			download_result_detail="$BRIDGE_RESULT_DETAIL"
			download_lpa_result="$LPA_RESULT"
			download_interrupted=0
			[ "$download_result_message" != es10b_load_bound_profile_package ] || \
				download_interrupted=1
			deliver_caused_notifications "$REQUESTED_ENDPOINT" "$mutation_owner" \
				"$mutation_candidates" "$mutation_bearer" "$download_interrupted"
			BRIDGE_HTTP_FAILURE=""
			BRIDGE_RESULT_CODE="$download_result_code"
			BRIDGE_RESULT_MESSAGE="$download_result_message"
			BRIDGE_RESULT_DETAIL="$download_result_detail"
			LPA_RESULT="$download_lpa_result"
		fi
	fi
	if [ "$OPERATION_ACTION" = notification-send ]; then
		OPERATION_TRANSPORT_SECURITY="$BRIDGE_TRANSPORT_SECURITY"
		if [ "$BRIDGE_HTTP_FAILURE" = tls_untrusted_issuer ] && \
			[ "$CAPTURED_ALLOW_UNVERIFIED_TRANSPORT" != 1 ]; then
			OPERATION_TRANSPORT_RETRY_ALLOWED=true
		else
			OPERATION_TRANSPORT_RETRY_ALLOWED=false
		fi
	fi
	if [ "$mutation_status" -ne 0 ]; then
		if [ -n "$BRIDGE_RESULT_CODE" ]; then
			if [ -n "$BRIDGE_RESULT_DETAIL" ]; then
				log err "the LPA failed with code $BRIDGE_RESULT_CODE at $BRIDGE_RESULT_MESSAGE ($BRIDGE_RESULT_DETAIL)"
			else
				log err "the LPA failed with code $BRIDGE_RESULT_CODE at $BRIDGE_RESULT_MESSAGE"
			fi
		fi
		case "$LPA_RESULT" in
			*'"message":"activation_code_used"'*) OPERATION_REASON=activation_code_used ;;
			*'"message":"confirmation_code_required"'*) OPERATION_REASON=confirmation_code_required ;;
		esac
		if [ "$OPERATION_REASON" = activation_code_used ] || \
			[ "$OPERATION_REASON" = confirmation_code_required ]; then
			takeover_publish blocked "$EXIT_BLOCKED" "$OPERATION_REASON; no profile was removed"
			return "$EXIT_BLOCKED"
		elif [ -n "$BRIDGE_HTTP_FAILURE" ] && \
			{ [ "$OPERATION_ACTION" = download ] || \
				[ "$OPERATION_ACTION" = notification-send ]; }; then
			OPERATION_REASON="$BRIDGE_HTTP_FAILURE"
			case "$BRIDGE_HTTP_FAILURE" in
				tls_untrusted_issuer)
					# What is actually at risk differs by what was being sent,
					# and a consent text that misstates it is not consent.
					if [ "$OPERATION_ACTION" = notification-send ]; then
						takeover_publish failed "$mutation_status" \
							"the SM-DP+ certificate has no trusted issuer; an explicit one-operation retry is available, but whatever answers cannot then be shown to be the issuer, so the notification will be kept on the card rather than treated as delivered"
					else
						takeover_publish failed "$mutation_status" \
							"the SM-DP+ certificate has no trusted issuer; an explicit one-operation retry is available, but an unbound activation code and its purchased subscription may then be intercepted and redeemed on another eUICC"
					fi
				;;
				tls_chain_unparseable)
					# Not retryable, and saying so matters: the peer chain is
					# parsed before any verification setting is consulted, so
					# proceeding without verification would fail identically.
					takeover_publish failed "$mutation_status" \
						"this router's TLS library cannot read the certificate chain this SM-DP+ sends; the download cannot proceed and proceeding without verification would not help"
				;;
				tls_hostname|tls_time|tls_revoked|tls_verification|trust_store|authority_changed)
					takeover_publish failed "$mutation_status" \
						"the SM-DP+ certificate could not be accepted; no profile was removed"
				;;
				*)
					takeover_publish failed "$mutation_status" \
						"the HTTPS exchange failed; no profile was removed"
				;;
			esac
		elif [ "$OPERATION_ACTION" = download ] && \
			[ "$BRIDGE_RESULT_MESSAGE" = es10b_load_bound_profile_package ]; then
			# The load did not finish, and an install notification says nothing
			# about whether a profile did.
			#
			# This branch used to read a new `install` entry in the pending list
			# as the eUICC's own statement that the profile is there. It is not
			# one, and it cannot be: SGP.22's `listNotification` publishes
			# `seqNumber`, `profileManagementOperation`, `notificationAddress`
			# and `iccid` and no result at all. The outcome lives inside the
			# ProfileInstallationResult that goes to the SM-DP+ and is never
			# shown to this program -- and a **failed** install produces one of
			# these notifications exactly as a successful one does. That is what
			# the notification is for.
			#
			# Measured on the reference RM520 2026-09-02, driving a download
			# from the page: the card answered
			# `install_failed_due_to_unknown_error`, an install notification
			# appeared and was delivered over a verified transport, and the
			# profile was not on the eUICC -- read fresh under a later inhibit.
			# The result published "the profile is installed and the SM-DP+ has
			# been told". The first half was false and the second was a guess
			# about a payload nobody here can read.
			#
			# So no claim about the card is made from this path any more. What
			# happened to the notification is a separate fact and travels in the
			# field that exists for it, `notification_delivery`, where a page
			# can say it without it being read as proof of a subscription.
			#
			# Absence is not claimed either: this card finishes its work after
			# the modem is handed back, which is the whole reason
			# `download_install_uncertain` exists. The one exception is a card
			# that said why, and only reasons this project has actually seen are
			# listed -- mistaking an interruption for a definite refusal loses a
			# profile the card may be holding, which is the more expensive of
			# the two errors.
			case "$BRIDGE_RESULT_DETAIL" in
				*install_failed_due_to_insufficient_memory_for_profile*)
					OPERATION_REASON=download_refused_no_memory
					takeover_publish failed "$mutation_status" \
						"the eUICC refused the profile because it has no room for another one; nothing was installed and nothing was removed"
					return "$mutation_status"
				;;
			esac
			OPERATION_REASON=download_install_uncertain
			if [ "$DOWNLOAD_INSTALL_OBSERVED" -eq 1 ] && \
				[ "$OPERATION_NOTIFICATION_DELIVERY" = delivered ]; then
				takeover_publish partial "$EXIT_PARTIAL" \
					"the load did not finish and what is on the card is not known from here; the result the card produced has already been sent to the SM-DP+, so read the endpoint before downloading again; nothing was removed"
			elif [ "$DOWNLOAD_INSTALL_OBSERVED" -eq 1 ]; then
				# The actionable one: whatever the card decided, its own report
				# is still sitting on it and the issuer has not had it.
				takeover_publish partial "$EXIT_PARTIAL" \
					"the load did not finish and what is on the card is not known from here; the report the card produced is still waiting on it and has not reached the SM-DP+, so send it and read the endpoint; nothing was removed"
			else
				takeover_publish partial "$EXIT_PARTIAL" \
					"the profile installation was interrupted after the card began writing; on this modem the card finishes once it is handed back, so read the endpoint in a minute and send the notification that will be waiting there; nothing was removed"
			fi
			return "$EXIT_PARTIAL"
		elif [ "$OPERATION_ACTION" = download ]; then
			OPERATION_REASON=download_incomplete
			takeover_publish partial "$EXIT_PARTIAL" "the download did not complete; no profile was removed"
			return "$EXIT_PARTIAL"
		else
			OPERATION_REASON=mutation_failed
			takeover_publish failed "$mutation_status" "the additive operation failed"
		fi
		return "$mutation_status"
	fi
	takeover_stage mutate
	OPERATION_MUTATE_STARTED=0
	# Read the card once more before handing the modem back, so the page can
	# show what the operation did without asking for a second outage. It never
	# fails the operation: the mutation has already happened and its result is
	# what this is reporting.
	if [ "$OPERATION_ACTION" = download ] && takeover_inhibit_still_held; then
		mutation_after="$TMP_BASE.lpa-after"
		if read_profiles_through_lpa "$REQUESTED_ENDPOINT" "$mutation_owner" \
			"$mutation_candidates" "$mutation_bearer" "$mutation_after"; then
			mutation_free=""
			mutation_apps=""
			if read_card_resource_through_lpa "$REQUESTED_ENDPOINT" "$mutation_owner" \
				"$mutation_candidates" "$mutation_bearer"; then
				mutation_free="$ENDPOINT_FREE_MEMORY"
				mutation_apps="$ENDPOINT_INSTALLED_APPLICATIONS"
			fi
			cache_store_card_read "$REQUESTED_ENDPOINT" "$TARGET_LINE" \
				"$mutation_after" "" "$mutation_free" "$mutation_apps" || :
		fi
	fi
	takeover_release_prepare
	takeover_stage restore
	takeover_stage publish
	OPERATION_REASON=""
	# A download whose profile arrived and whose issuer was not told is not a
	# success, whatever the LPA returned. That is the exact state in which an
	# operator's record says a subscription was taken and the subscriber cannot
	# use it, and it must not be reported as done.
	if [ "$OPERATION_ACTION" = download ]; then
		case "$OPERATION_NOTIFICATION_DELIVERY" in
			pending|partial)
				OPERATION_REASON=download_install_unreported
				takeover_publish partial "$EXIT_PARTIAL" \
					"the profile was installed but the SM-DP+ has NOT been told, so the operator's record and this card disagree; the notification is still on the card and must be sent before the profile is trusted or replaced"
				return "$EXIT_PARTIAL"
			;;
			unknown)
				OPERATION_REASON=download_install_unconfirmed
				takeover_publish partial "$EXIT_PARTIAL" \
					"the profile was installed, but this operation could not read the card's pending notifications and so cannot say whether the SM-DP+ was told; read the endpoint and send anything still queued"
				return "$EXIT_PARTIAL"
			;;
		esac
	fi
	case "$OPERATION_ACTION" in
		download)
			# `none` is a real answer rather than a failure: an install
			# notification is produced only when the profile's own metadata
			# asks for one, so claiming the issuer was told would be inventing
			# a message nobody sent.
			case "$OPERATION_NOTIFICATION_DELIVERY" in
				delivered) mutation_reported="and the SM-DP+ was told" ;;
				delivered_unverified)
					mutation_reported="and the install notification was accepted over an explicitly unverified transport, so it is kept on the card and should be sent again when the issuer can be verified"
				;;
				*) mutation_reported="and this profile asked for no install notification" ;;
			esac
			if [ "$OPERATION_TRANSPORT_SECURITY" = unverified ]; then
				mutation_message="profile download completed with explicitly unverified transport, $mutation_reported; no existing profile was removed"
			else
				mutation_message="profile download completed over verified transport, $mutation_reported; no existing profile was removed"
			fi
		;;
		nickname) mutation_message="profile nickname updated" ;;
		notification-send)
			if [ "$OPERATION_TRANSPORT_SECURITY" = unverified ]; then
				mutation_message="notification accepted over an explicitly unverified transport, so it cannot be shown to have reached the issuer; it remains in the local queue and should be sent again when the issuer can be verified"
			else
				mutation_message="notification sent over verified transport; it remains in the local queue"
			fi
		;;
		# What this command did, not what did not happen before it. The old
		# wording claimed the notification had never been sent, which this verb
		# has no way to know and which was plainly false when it followed a
		# successful send -- the two-step delivery protocol's normal shape.
		*) mutation_message="notification removed from the local queue; removal does not deliver it, and one that was never delivered cannot be afterwards" ;;
	esac
	takeover_publish succeeded 0 "$mutation_message"
	return 0
}

# ---- enable, disable and the slot switch ----
#
# The first operations in this package whose success is measured by the router
# still having Internet afterwards. A download interrupts the bearer and hands
# it back unchanged; these change *which subscription the bearer is for*, so the
# APN that worked a minute ago is the wrong APN now, and the recovery is part of
# the operation rather than something the user is left to do next.
#
# Three verbs, one worker, because they differ only in what `mutate` does:
#
#   enable   a profile the card already holds becomes the active subscription
#   disable  the active subscription stops being active
#   switch   the modem's active SIM slot changes
#
# The phase order is forced by three things that were measured rather than
# assumed:
#
#   * a notification an operation causes is not always visible inside that
#     operation's own inhibit. Over AT on the reference modem it never is: the
#     card finishes when it is handed back, and ninety seconds of asking inside
#     the inhibit found nothing that the very next operation found at once. So
#     delivery is attempted *after* the hand-back, under a second short inhibit;
#   * the modem is unreachable for 7 to 13 seconds after an inhibit is released,
#     while ModemManager re-enumerates it, against a 60-second cache entry;
#   * an operation whose issuer was not told is `partial`, never a success.
#
# There is a second reason for delivering afterwards, and it is the one that
# decides the shape. A download needs the network *before* it can install
# anything, so a modem that is the only uplink deadlocks it and `sole_uplink`
# refuses it outright. An enable is the opposite: the network it needs to tell
# the issuer is the network the enable itself brings back. Refusing an enable
# for `sole_uplink` would refuse the single-modem case entirely -- which is the
# ordinary case, and the one the whole feature exists for -- so the operation
# proceeds, recovers the bearer, and only then tells the issuer. If it cannot,
# the result is `partial` and says so.
#
# The recovery is not implemented here. `apn-autoconfig-modem converge` already
# waits for the SIM, refreshes identity, reconciles that one target and restores
# the bearer the target is entitled to, under the locks that belong to it, and
# the contract forbids a second implementation of any of that.

SWITCH_REACHABLE=""
SWITCH_SECTION_RECORD=""
SWITCH_OWNER=""
SWITCH_CANDIDATES=""
SWITCH_BEARER=""
SWITCH_INTERFACE=""
SWITCH_BASELINE_PROFILE=""
SWITCH_BASELINE_BEARER_UP=0
SWITCH_DESIRED_BEARER=auto
SWITCH_MUTATED=0
SWITCH_ROLLBACK=none
SWITCH_RECOVERY=""
SWITCH_BEARER_RESTORED=0
# Set when the card holds what was asked for and the router is demonstrably
# still using the subscription it held before. It is not a failed change and
# must never be rolled back: the change is correct and the modem has not
# adopted it.
SWITCH_SUBSCRIPTION_MISMATCH=0
# The contract's `reset` stage, spent at most once. A modem that will not adopt
# a profile from a REFRESH needs a reset to notice it; a modem that adopted it
# needs nothing, and resetting anyway would be a minute of outage for nothing.
SWITCH_RESET_SPENT=0
# `performed` only where a reset actually ran. Spent-but-refused is a different
# state and owes a different sentence.
OPERATION_REASON_RESET=""
SWITCH_RESET_METHOD=none
SWITCH_RESET_BOUND=0

# Everything above the card, re-resolved now that the locks are held. Called
# once per phase, because between two phases this operation deliberately owns
# nothing: the modem went back to its owner and came back again.
switch_acquire_and_revalidate() {
	acquire_global_lock "$LOCK_WAIT_SECONDS" || {
		OPERATION_REASON=global_busy
		return "$EXIT_RETRYABLE"
	}
	acquire_modem_lock "$REQUESTED_MODEM" "$LOCK_WAIT_SECONDS" || {
		OPERATION_REASON=modem_busy
		return "$EXIT_RETRYABLE"
	}
	# The declaration is what stops the revalidation seeing this operation as
	# somebody else's: the inventory read runs as a child, whose PID does not
	# match the per-modem lock this worker holds.
	APN_AUTOCONFIG_MODEM_LOCK_OWNER_PID=$SELF_PID
	export APN_AUTOCONFIG_MODEM_LOCK_OWNER_PID
	load_modem_records "$REQUESTED_MODEM" || {
		OPERATION_REASON=inventory_unavailable
		return "$EXIT_RETRYABLE"
	}
	enumerate_endpoints
	TARGET_LINE="$(awk -F '\t' -v modem="$REQUESTED_MODEM" -v endpoint="$REQUESTED_ENDPOINT" '
		$3 == modem && $1 == endpoint { print; count++ }
		END { if (count != 1) exit 3 }
	' "$ENDPOINT_FILE")" || {
		OPERATION_REASON=endpoint_unavailable
		return "$EXIT_BLOCKED"
	}
	[ "$(field "$TARGET_LINE" 2)" = eid ] || {
		OPERATION_REASON=endpoint_unproven
		return "$EXIT_BLOCKED"
	}
	SWITCH_REACHABLE="$(field "$TARGET_LINE" 14)"
	case "$SWITCH_REACHABLE" in
		yes|requires-inhibit|requires-bearer-stop) : ;;
		*)
			OPERATION_REASON=endpoint_unreachable
			return "$EXIT_BLOCKED"
		;;
	esac
	SWITCH_SECTION_RECORD="$(modem_section_at "$(field "$TARGET_LINE" 19)")"
	SWITCH_OWNER="$(field "$TARGET_LINE" 13)"
	SWITCH_CANDIDATES="$(esim_transport_candidates "$TARGET_LINE")"
	SWITCH_BEARER="$(esim_bearer_device "$TARGET_LINE")"
	SWITCH_INTERFACE="$(section_field "$SWITCH_SECTION_RECORD" interface 2)"
	# What a reset of this modem would be, and how long it could take. Read
	# from the modem package rather than decided here: which reset a modem gets
	# is a property of the modem, and this package must not grow one of its own.
	SWITCH_RESET_METHOD="$(section_field "$SWITCH_SECTION_RECORD" reset 2)"
	[ -n "$SWITCH_RESET_METHOD" ] || SWITCH_RESET_METHOD=none
	SWITCH_RESET_BOUND="$(section_field "$SWITCH_SECTION_RECORD" reset 3)"
	case "$SWITCH_RESET_BOUND" in ''|*[!0-9]*) SWITCH_RESET_BOUND=0 ;; esac
	return 0
}

# The `prepare` stage. Where the matrix asks for an inhibit, take one and
# recompute what the card can be reached over now that nothing owns the modem.
switch_prepare_card() {
	# The bearer-stop composition: this modem is nobody's but netifd's, and the
	# bearer holds the only channel the card can be reached through. Stopping
	# that one interface frees it, and the candidate list is recomputed with no
	# bearer because there is none any more.
	if [ "$SWITCH_REACHABLE" = requires-bearer-stop ]; then
		switch_stop_status=0
		takeover_acquire_bearer_stop "$SWITCH_INTERFACE" || switch_stop_status=$?
		[ "$switch_stop_status" -eq 0 ] || return "$switch_stop_status"
		SWITCH_CANDIDATES="$(control_candidates "$SWITCH_SECTION_RECORD" "" | tr '\n' ' ')"
		SWITCH_BEARER=""
		SWITCH_OWNER=none
		[ -n "$SWITCH_CANDIDATES" ] || {
			OPERATION_REASON=no_control_port
			return "$EXIT_RETRYABLE"
		}
		return 0
	fi
	[ "$SWITCH_REACHABLE" = requires-inhibit ] || return 0
	switch_mm="$(section_field "$SWITCH_SECTION_RECORD" mm 2)"
	case "$switch_mm" in
		''|*[!0-9]*)
			OPERATION_REASON=modemmanager_unavailable
			return "$EXIT_BLOCKED"
		;;
	esac
	switch_inhibit_status=0
	takeover_acquire_inhibit "$switch_mm" || switch_inhibit_status=$?
	[ "$switch_inhibit_status" -eq 0 ] || return "$switch_inhibit_status"
	SWITCH_OWNER=none
	SWITCH_CANDIDATES="$(control_candidates "$SWITCH_SECTION_RECORD" "" | tr '\n' ' ')"
	SWITCH_BEARER=""
	[ -n "$SWITCH_CANDIDATES" ] || {
		OPERATION_REASON=no_control_port
		return "$EXIT_RETRYABLE"
	}
	return 0
}

# Hand the modem back and stand down completely: inhibit first, so the modem is
# with a working owner before anything else is unwound, then locks 4 to 1. The
# next phase takes them again from nothing, and revalidates everything.
switch_release_all() {
	takeover_release_prepare
	release_all_locks
	return 0
}

# Whether one netifd interface is up, asked of netifd rather than inferred.
switch_interface_up() {
	[ -n "$1" ] || return 1
	command_exists "$UBUS" || return 1
	command_exists "$JSONFILTER" || return 1
	switch_up_file="$TMP_BASE.bounded"
	run_bounded_to_file 5 "$switch_up_file" "$UBUS" call "network.interface.$1" status || return 1
	[ "$("$JSONFILTER" -i "$switch_up_file" -e '@.up' 2>/dev/null || :)" = true ]
}

# Wait while the modem is still working, rather than for a fixed number of
# seconds.
#
# Past the ordinary budget the modem decides. A modem that reports itself
# searching, registering or connecting has not failed and will not be helped by
# being declared broken; a modem that reports a state no bearer can come out of
# will not start again by being waited for, so that ends the wait at once
# instead of spending the ceiling on it.
#
# The ceiling remains because a wait with no ceiling is a hang.
switch_wait_for_bearer() {
	switch_bearer_waited=0
	while :; do
		switch_interface_up "$1" && return 0
		if [ "$switch_bearer_waited" -ge "$ESIM_BEARER_WAIT_SECONDS" ]; then
			[ "$switch_bearer_waited" -lt "$ESIM_BEARER_CEILING_SECONDS" ] || return 1
			switch_modem_still_working "$1" || return 1
		fi
		"$SLEEP" 2 2>/dev/null || return 1
		switch_bearer_waited=$((switch_bearer_waited + 2))
	done
}

# Whether the modem reports itself still working towards a connection.
#
# Read from the APN engine, which is where every other consumer reads modem
# state, so this waits on what a user would see rather than on a second opinion.
#
# An unreadable answer counts as "still working", deliberately. A status read
# that failed is not evidence the modem failed, and turning a transient into a
# verdict is how a working subscription gets rolled back -- which is the exact
# defect this whole change exists to remove.
switch_modem_still_working() {
	[ -n "$1" ] || return 0
	command_exists "$APN_BIN" || return 0
	command_exists "$JSONFILTER" || return 0
	switch_working_file="$TMP_BASE.bounded-status"
	run_bounded_to_file 15 "$switch_working_file" \
		"$APN_BIN" status-json --target "network:$1" || return 0
	switch_working_state="$("$JSONFILTER" -i "$switch_working_file" \
		-e '@.modem_state' 2>/dev/null || :)"
	switch_registration_state="$("$JSONFILTER" -i "$switch_working_file" \
		-e '@.registration_state' 2>/dev/null || :)"
	# QMI and MBIM deliberately expose a coarse modem_state (`enabled` until
	# registered), but their registration_state can already be a terminal
	# refusal. That fact wins over the coarse state: a denied registration will
	# not become a bearer by spending the rest of the ceiling.
	[ "$switch_registration_state" != denied ] || return 1
	case "$switch_working_state" in
		# On its way: initialising, coming up, looking for a network, attached,
		# or connected with the interface not yet up.
		initializing|enabling|enabled|searching|registered|connecting|connected) return 0 ;;
		# Nothing here becomes a bearer without something else happening first.
		failed|locked|disabled|disabling|disconnecting) return 1 ;;
		# Including the empty answer.
		*) return 0 ;;
	esac
}

# What the target is entitled to, which is not the same question as what it is
# doing. An explicit Disconnect means the bearer stays down, and a switch that
# helpfully brought it up would override a decision the user made.
switch_read_desired_bearer() {
	[ -n "$1" ] || { printf 'auto\n'; return 0; }
	command_exists "$APN_BIN" || { printf 'auto\n'; return 0; }
	switch_desired_file="$TMP_BASE.bounded"
	if run_bounded_to_file 5 "$switch_desired_file" \
		"$APN_BIN" desired-bearer-state --target "network:$1"; then
		switch_desired="$(sed -n '1p' "$switch_desired_file" 2>/dev/null || :)"
		case "$switch_desired" in auto|up|down) printf '%s\n' "$switch_desired"; return 0 ;; esac
	fi
	printf 'auto\n'
	return 0
}

# The endpoint, addressable again.
#
# After an inhibit is released ModemManager needs 7 to 13 seconds to
# re-enumerate the modem, and until it has, the endpoint resolves to nothing at
# all. Asking once and concluding the card is gone would turn every successful
# switch into a lost endpoint.
switch_wait_for_endpoint() {
	switch_reattach_waited=0
	while :; do
		switch_reattach_status=0
		switch_acquire_and_revalidate || switch_reattach_status=$?
		[ "$switch_reattach_status" -eq 0 ] && return 0
		release_all_locks
		[ "$switch_reattach_waited" -lt "$ESIM_REATTACH_WAIT_SECONDS" ] || \
			return "$switch_reattach_status"
		"$SLEEP" 3 2>/dev/null || return "$switch_reattach_status"
		switch_reattach_waited=$((switch_reattach_waited + 3))
	done
}

# The `refresh_identity`, `reconcile` and `restore_bearer` stages, which are the
# modem package's convergence and not a second copy of it. No lock of ours is
# held while it runs: the engine takes the global lock itself, and holding it
# here would make every launch a busy answer -- which is exactly the mistake the
# convergence contract records having made once.
#
# Sets SWITCH_RECOVERY to what convergence published for this modem.
switch_recover_apn() {
	SWITCH_RECOVERY=""
	[ -n "$SWITCH_INTERFACE" ] || { SWITCH_RECOVERY=no-target; return 1; }
	command_exists "$MODEM_BIN" || { SWITCH_RECOVERY=no-coordinator; return 1; }
	command_exists "$JSONFILTER" || { SWITCH_RECOVERY=no-json-reader; return 1; }
	# Which operation the modem coordinator had published before this one, so a
	# stale record cannot be read back as this switch's own recovery.
	switch_previous_operation="$(switch_recovery_field operation_id)"
	switch_plan="$(printf 'network:%s\t%s' "$SWITCH_INTERFACE" "$REQUESTED_MODEM")"
	switch_converge_file="$TMP_BASE.bounded"
	if ! run_bounded_to_file "$ESIM_RECOVERY_WAIT_SECONDS" "$switch_converge_file" \
		"$MODEM_BIN" converge --plan "$switch_plan"; then
		SWITCH_RECOVERY=unfinished
		return 1
	fi
	[ "$(switch_recovery_field action)" = converge ] || { SWITCH_RECOVERY=unreported; return 1; }
	[ "$(switch_recovery_field operation_id)" != "$switch_previous_operation" ] || {
		# Convergence declined to run at all -- it defers rather than failing
		# when an operation is already in progress on that modem -- and the
		# record still describes whatever came before.
		SWITCH_RECOVERY=deferred
		return 1
	}
	SWITCH_RECOVERY="$(switch_recovery_field state)"
	[ "$SWITCH_RECOVERY" = success ] || return 1
	return 0
}

switch_recovery_field() {
	switch_recovery_file="$TMP_BASE.bounded-status"
	run_bounded_to_file 10 "$switch_recovery_file" \
		"$MODEM_BIN" action-status --modem "$REQUESTED_MODEM" || return 0
	"$JSONFILTER" -i "$switch_recovery_file" -e "@.$1" 2>/dev/null || :
}

# Whether the router is on a working bearer for the subscription this operation
# selected. A reconcile that succeeded is the engine's own connectivity verdict
# -- it does not keep a candidate it could not use -- so what is left to check
# is that the interface the user watches is actually up.
#
# Two cases have nothing to verify, and conflating them with a failure would be
# worse than not checking at all:
#
#   * `disable` deliberately leaves the modem with no active subscription.
#     There is no bearer to come back, and treating its absence as a failed
#     switch would roll back the very thing the user asked for;
#   * an explicit Disconnect means the bearer stays down, and a switch that
#     helpfully brought it up would override a decision somebody made.
switch_verify_bearer() {
	[ "$OPERATION_ACTION" != disable ] || return 0
	[ "$SWITCH_DESIRED_BEARER" != down ] || return 0
	switch_wait_for_bearer "$SWITCH_INTERFACE" || return 1
	SWITCH_BEARER_RESTORED=1
	takeover_stage restore_bearer
	# A bearer is not the bearer that was asked for.
	#
	# Measured on the reference RM520N-GL on 2026-08-31 against the
	# maintainer's real card: an `enable` put the requested profile on the
	# eUICC, the interface came up, and the router was still using the
	# *previous* subscription -- ModemManager reported the old profile's ICCID
	# and the serving network was the old operator's. The card had changed and
	# the modem had not picked it up. The operation published `succeeded` and
	# the sentence "the connection is back on it", which was false.
	#
	# So the check is identity, not liveness: whatever the rest of the system
	# believes it is using has to be the profile this operation enabled. The
	# handle is derived from the ICCID either way, so the comparison is exact
	# and no raw identifier is held.
	[ "$OPERATION_ACTION" = enable ] || return 0
	switch_in_use="$(switch_active_subscription_handle "$SWITCH_INTERFACE")"
	[ -n "$switch_in_use" ] || return 0
	[ "$switch_in_use" != "$REQUESTED_PROFILE" ] || return 0
	# The contract's `reset` stage is what closes this -- a modem that needs
	# more than a REFRESH to adopt a profile has to be reset -- and this
	# release does not implement one. Saying so is the whole of the answer.
	SWITCH_SUBSCRIPTION_MISMATCH=1
	return 1
}

# What the rest of the system believes it is using on this target, as a profile
# handle. Read from the APN engine, which is where every other consumer reads
# it, so this measures what a user would see rather than what the card holds.
switch_active_subscription_handle() {
	[ -n "$1" ] || return 0
	command_exists "$APN_BIN" || return 0
	switch_use_file="$TMP_BASE.bounded-status"
	run_bounded_to_file 15 "$switch_use_file" \
		"$APN_BIN" status-json --target "network:$1" || return 0
	command_exists "$JSONFILTER" || return 0
	switch_use_iccid="$(normalise_iccid \
		"$("$JSONFILTER" -i "$switch_use_file" -e '@.iccid' 2>/dev/null || :)" 2>/dev/null || :)"
	[ -n "$switch_use_iccid" ] || return 0
	profile_handle_from_iccid "$switch_use_iccid" 2>/dev/null || :
	switch_use_iccid=""
	return 0
}

# The terminal result, by exit class. The class is what a consumer branches on
# and the message is what a person reads, so neither is derived from the other.
switch_publish() {
	case "$1" in
		0) takeover_publish succeeded 0 "$2" ;;
		"$EXIT_BLOCKED") takeover_publish blocked "$1" "$2" ;;
		"$EXIT_PARTIAL") takeover_publish partial "$1" "$2" ;;
		*) takeover_publish failed "$1" "$2" ;;
	esac
	return 0
}

# One card transaction that puts the requested change on the eUICC.
switch_mutate_card() {
	switch_mutate_status=0
	case "$OPERATION_ACTION" in
		enable)
			bridge_run "$REQUESTED_ENDPOINT" "$SWITCH_OWNER" "$SWITCH_CANDIDATES" \
				"$SWITCH_BEARER" profile enable "$RESOLVED_PROFILE_ICCID" || \
				switch_mutate_status=$?
		;;
		disable)
			bridge_run "$REQUESTED_ENDPOINT" "$SWITCH_OWNER" "$SWITCH_CANDIDATES" \
				"$SWITCH_BEARER" profile disable "$RESOLVED_PROFILE_ICCID" || \
				switch_mutate_status=$?
		;;
	esac
	RESOLVED_PROFILE_ICCID=""
	return "$switch_mutate_status"
}

# Whether the card now holds what this operation asked for, read from the card
# rather than inferred from what the LPA returned.
#
# It is asked even when the mutation reported success, and especially when it
# reported failure. On the reference modem an AT APDU handler gives up after
# three seconds on an exchange the card takes four to answer, and the card
# completes the work regardless -- so the LPA's verdict at that step is evidence
# about the LPA, and the card is the authority. Measured for a profile install
# in C3 and again in P4; whether an enable behaves the same way is unknown, and
# assuming it does not is the expensive direction.
SWITCH_OBSERVED_PROFILE=""
SWITCH_OBSERVED_READ=0

switch_observe_card() {
	SWITCH_OBSERVED_PROFILE=""
	SWITCH_OBSERVED_READ=0
	switch_observe_file="$TMP_BASE.lpa-profiles"
	switch_observe_status=0
	read_profiles_through_lpa "$REQUESTED_ENDPOINT" "$SWITCH_OWNER" \
		"$SWITCH_CANDIDATES" "$SWITCH_BEARER" "$switch_observe_file" || switch_observe_status=$?
	if [ "$switch_observe_status" -ne 0 ]; then
		# Named, because "the card could not say" and "the card said something
		# unusable" are different failures and a result that reports only the
		# second is unreadable afterwards.
		log err "the confirming read of the card failed (status $switch_observe_status)"
		return 1
	fi
	SWITCH_OBSERVED_READ=1
	# Two profiles reporting themselves enabled is a card contradicting itself,
	# and the answer is the same as everywhere else in this project: ambiguity
	# is not resolved to the likelier of two readings.
	switch_observe_count="$(awk -F '\t' '$3 == "enabled" { count++ } END { print count + 0 }' \
		"$switch_observe_file")"
	log notice "the card reports $switch_observe_count enabled profile(s) after the change"
	case "$switch_observe_count" in
		0) SWITCH_OBSERVED_PROFILE="" ;;
		1) SWITCH_OBSERVED_PROFILE="$(awk -F '\t' '$3 == "enabled" { print $1; exit }' \
			"$switch_observe_file")" ;;
		*) SWITCH_OBSERVED_PROFILE=ambiguous ;;
	esac
	return 0
}

# Did the card end up in the state this operation asked for?
#   0 yes, 1 no, 2 the card could not be read and nobody knows
switch_intent_met() {
	[ "$SWITCH_OBSERVED_READ" -eq 1 ] || return 2
	[ "$SWITCH_OBSERVED_PROFILE" != ambiguous ] || return 2
	case "$OPERATION_ACTION" in
		enable) [ "$SWITCH_OBSERVED_PROFILE" = "$REQUESTED_PROFILE" ] && return 0 ;;
		disable) [ "$SWITCH_OBSERVED_PROFILE" != "$REQUESTED_PROFILE" ] && return 0 ;;
	esac
	return 1
}

# Everything this verb needs to be true before anything is touched, stated as
# refusals rather than discovered as failures.
SWITCH_REFUSAL=""

switch_check_preconditions() {
	SWITCH_REFUSAL=""
	[ -n "$REQUESTED_PROFILE" ] || {
		OPERATION_REASON=profile_required
		SWITCH_REFUSAL="$OPERATION_ACTION names one profile"
		return "$EXIT_USAGE"
	}
	return 0
}

# The contract's `reset` stage: capability-gated, and only where REFRESH was
# insufficient.
#
# Measured on the reference RM520N-GL against a real card: `enable` put the
# requested profile on the eUICC, the card confirmed it, and the modem went on
# using the previous subscription -- reporting the old ICCID for the same
# eUICC, on the old operator's network. The APN was then reconciled for the old
# subscription and the bearer that came up was the old one. C4 caught that and
# published an honest `partial`; this makes it the last resort rather than the
# first outcome.
#
# It resets nothing itself. `apn-autoconfig-modem` owns every method and chooses
# by `reset_method`; a second implementation of a reset, or of the wait for
# re-enumeration, is forbidden by the contract. No lock of ours is held while it
# runs: the modem package takes the same two by the same paths, and holding them
# here would deadlock against itself.
#
# Returns 0 when the reset was performed. Spent at most once, and its own
# failure never triggers another.
switch_reset_modem() {
	[ "$SWITCH_RESET_SPENT" -eq 0 ] || return 1
	SWITCH_RESET_SPENT=1
	[ "$SWITCH_RESET_METHOD" != none ] || {
		OPERATION_REASON=reset_unavailable
		return 1
	}
	command_exists "$MODEM_BIN" || {
		OPERATION_REASON=no_coordinator
		return 1
	}
	switch_reset_file="$TMP_BASE.bounded"
	# The operation's own bound, plus the slack a delegated command needs to
	# report a result it has already reached. A reset that runs out of time here
	# has not necessarily failed -- which is why what follows is a re-read, not
	# a verdict taken from this status.
	switch_reset_status=0
	run_bounded_to_file "$((SWITCH_RESET_BOUND + 30))" "$switch_reset_file" \
		"$MODEM_BIN" reset --modem "$REQUESTED_MODEM" || switch_reset_status=$?
	[ "$switch_reset_status" -eq 0 ] || {
		OPERATION_REASON=reset_failed
		return 1
	}
	return 0
}

# The recovery half, run once after a mutation and once more after a rollback.
# Returns 0 when the target reconciled and the bearer it is entitled to is up.
switch_recover_and_verify() {
	switch_recover_status=0
	switch_recover_apn || switch_recover_status=$?
	if [ "$switch_recover_status" -ne 0 ]; then
		OPERATION_REASON="recovery_$SWITCH_RECOVERY"
		return 1
	fi
	takeover_stage reconcile
	switch_verify_bearer || {
		OPERATION_REASON=bearer_not_restored
		return 1
	}
	takeover_stage verify
	return 0
}

# Put back the profile that was enabled when this operation started.
#
# Permitted only where the contract permits it: a baseline that named exactly
# one previously enabled profile, which still resolves to exactly one profile on
# this endpoint, on an endpoint whose evidence is unchanged. Attempted at most
# once, and its own failure never triggers another attempt. Nothing is ever
# deleted to make a state consistent.
switch_attempt_rollback() {
	SWITCH_ROLLBACK=refused
	# Not for a slot change -- putting the slot back is a second slot change
	# with its own re-enumeration, and this release does not carry one -- and
	# not for a disable, whose whole request is the state a rollback would undo.
	case "$OPERATION_ACTION" in enable) : ;; *) return 1 ;; esac
	[ -n "$SWITCH_BASELINE_PROFILE" ] || return 1
	[ "$SWITCH_BASELINE_PROFILE" != ambiguous ] || return 1
	[ "$SWITCH_BASELINE_PROFILE" != "$REQUESTED_PROFILE" ] || return 1
	SWITCH_ROLLBACK=attempted
	switch_rollback_status=0
	switch_wait_for_endpoint || switch_rollback_status=$?
	[ "$switch_rollback_status" -eq 0 ] || { SWITCH_ROLLBACK=failed; return 1; }
	# Quiet, and under the short bound. A rollback that cannot take the modem
	# back must not publish a terminal result of its own: the operation still
	# owes one that says what was changed as well as what could not be undone.
	TAKEOVER_INHIBIT_QUIET=1
	TAKEOVER_INHIBIT_BOUND="$ESIM_REPORT_INHIBIT_SECONDS"
	switch_prepare_card || switch_rollback_status=$?
	TAKEOVER_INHIBIT_QUIET=0
	TAKEOVER_INHIBIT_BOUND="$ESIM_INHIBIT_MAX_SECONDS"
	if [ "$switch_rollback_status" -ne 0 ]; then
		switch_release_all
		SWITCH_ROLLBACK=failed
		return 1
	fi
	# Re-resolved from a fresh read, never from a value carried across the
	# operation: the handle is the identity and the ICCID is only what the LPA
	# needs for one command.
	switch_rollback_profile="$REQUESTED_PROFILE"
	REQUESTED_PROFILE="$SWITCH_BASELINE_PROFILE"
	resolve_profile_for_mutation "$REQUESTED_ENDPOINT" "$SWITCH_OWNER" \
		"$SWITCH_CANDIDATES" "$SWITCH_BEARER" || switch_rollback_status=$?
	if [ "$switch_rollback_status" -eq 0 ]; then
		bridge_run "$REQUESTED_ENDPOINT" "$SWITCH_OWNER" "$SWITCH_CANDIDATES" \
			"$SWITCH_BEARER" profile enable "$RESOLVED_PROFILE_ICCID" || \
			switch_rollback_status=$?
	fi
	RESOLVED_PROFILE_ICCID=""
	REQUESTED_PROFILE="$switch_rollback_profile"
	switch_release_all
	if [ "$switch_rollback_status" -ne 0 ]; then
		SWITCH_ROLLBACK=failed
		return 1
	fi
	takeover_stage rollback
	switch_recover_and_verify || { SWITCH_ROLLBACK=partial; return 1; }
	SWITCH_ROLLBACK=restored
	return 0
}

# The second short inhibit: what the card actually holds now, and the messages
# it owes its issuers because of what this operation did.
switch_report_to_issuer() {
	switch_report_status=0
	switch_wait_for_endpoint || switch_report_status=$?
	if [ "$switch_report_status" -ne 0 ]; then
		OPERATION_NOTIFICATION_DELIVERY=unknown
		return 1
	fi
	# The short one. Quiet, because a refusal here is not the whole story: the
	# card has already been changed and the result owes that fact as well.
	TAKEOVER_INHIBIT_QUIET=1
	TAKEOVER_INHIBIT_BOUND="$ESIM_REPORT_INHIBIT_SECONDS"
	switch_prepare_card || switch_report_status=$?
	TAKEOVER_INHIBIT_QUIET=0
	TAKEOVER_INHIBIT_BOUND="$ESIM_INHIBIT_MAX_SECONDS"
	if [ "$switch_report_status" -ne 0 ]; then
		switch_release_all
		OPERATION_NOTIFICATION_DELIVERY=unknown
		return 1
	fi
	# Asked again while it says nothing, up to the settle bound. A card that has
	# just changed which profile is active is re-initialising and answers
	# nothing for a while; taking that silence for an answer publishes a
	# completed change as an unknown one, which is what the reference FM350
	# did.
	switch_settle_waited=0
	until switch_observe_card; do
		# Never inside an inhibit. There the card does not finish until it is
		# handed back, so this would spend the user's outage on a wait that
		# cannot succeed.
		[ "${TAKEOVER_INHIBIT_CREATED:-0}" -eq 0 ] || break
		[ "$switch_settle_waited" -lt "$ESIM_CARD_SETTLE_SECONDS" ] || break
		"$SLEEP" 5 2>/dev/null || break
		switch_settle_waited=$((switch_settle_waited + 5))
		log notice "the card has not answered since the change after ${switch_settle_waited}s"
	done
	deliver_caused_notifications "$REQUESTED_ENDPOINT" "$SWITCH_OWNER" \
		"$SWITCH_CANDIDATES" "$SWITCH_BEARER"
	switch_release_all
	return 0
}

switch_run_cmd() {
	case "$REQUESTED_ACTION" in
		enable|disable) : ;;
		*) die_code "$EXIT_USAGE" "switch-run requires enable or disable" ;;
	esac
	[ -n "$REQUESTED_MODEM" ] || die_code "$EXIT_USAGE" "switch-run requires --modem"
	[ -n "$REQUESTED_ENDPOINT" ] || die_code "$EXIT_USAGE" "switch-run requires --endpoint"
	[ -n "$REQUESTED_OPERATION" ] || die_code "$EXIT_USAGE" "switch-run requires --operation"
	OPERATION_ACTION="$REQUESTED_ACTION"
	OPERATION_PROFILE="$REQUESTED_PROFILE"
	TAKEOVER_OPERATION_ID="$REQUESTED_OPERATION"
	TAKEOVER_STARTED="${APN_AUTOCONFIG_ESIM_STARTED:-$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)}"
	TAKEOVER_STATE_DIR="$(action_state_dir_for "$REQUESTED_MODEM")"
	TAKEOVER_START_LOCK="${APN_AUTOCONFIG_ESIM_START_LOCK:-}"
	TAKEOVER_PUBLISH_ARMED=1
	adopt_handoff_pid || {
		OPERATION_REASON=handoff_failed
		takeover_publish failed "$EXIT_RETRYABLE" \
			"the background worker handoff could not be verified"
		return "$EXIT_RETRYABLE"
	}
	takeover_publish_running || return "$EXIT_RETRYABLE"

	# ---- prove_target ----
	switch_status=0
	switch_acquire_and_revalidate || switch_status=$?
	if [ "$switch_status" -ne 0 ]; then
		switch_publish "$switch_status" \
			"the target could not be proven under the operation locks; nothing was changed"
		return "$switch_status"
	fi
	switch_status=0
	switch_check_preconditions || switch_status=$?
	if [ "$switch_status" -ne 0 ]; then
		switch_publish "$switch_status" "$SWITCH_REFUSAL; nothing was changed"
		return "$switch_status"
	fi
	takeover_stage prove_target

	# ---- capture_baseline, then prepare ----
	#
	# In that order as a name and the other way round as a sequence, and the
	# reason is the ownership rule rather than an oversight: on a modem
	# ModemManager owns, which profile is enabled cannot be read at all until
	# the inhibit exists. What is knowable without the card is captured first.
	SWITCH_DESIRED_BEARER="$(switch_read_desired_bearer "$SWITCH_INTERFACE")"
	SWITCH_BASELINE_BEARER_UP=0
	switch_interface_up "$SWITCH_INTERFACE" && SWITCH_BASELINE_BEARER_UP=1
	switch_status=0
	switch_prepare_card || switch_status=$?
	if [ "$switch_status" -ne 0 ]; then
		switch_publish "$switch_status" \
			"the modem could not be prepared for this operation; nothing was changed"
		return "$switch_status"
	fi
	takeover_stage prepare

	case "$OPERATION_ACTION" in
		enable|disable)
			switch_status=0
			resolve_profile_for_mutation "$REQUESTED_ENDPOINT" "$SWITCH_OWNER" \
				"$SWITCH_CANDIDATES" "$SWITCH_BEARER" || switch_status=$?
			if [ "$switch_status" -ne 0 ]; then
				OPERATION_REASON=profile_ambiguous
				switch_publish "$switch_status" \
					"the profile could not be resolved on this endpoint; nothing was changed"
				return "$switch_status"
			fi
			SWITCH_BASELINE_PROFILE="$RESOLVED_ENABLED_PROFILE"
			# Asked of the card, not of the request. Enabling what is already
			# enabled would take the bearer down to achieve nothing, and
			# disabling what is already disabled would do the same.
			case "$OPERATION_ACTION:$RESOLVED_PROFILE_STATE" in
				enable:disabled|disable:enabled) : ;;
				enable:*)
					RESOLVED_PROFILE_ICCID=""
					OPERATION_REASON=profile_already_enabled
					switch_publish "$EXIT_BLOCKED" \
						"that profile is already the active subscription; nothing was changed"
					return "$EXIT_BLOCKED"
				;;
				*)
					RESOLVED_PROFILE_ICCID=""
					OPERATION_REASON=profile_not_enabled
					switch_publish "$EXIT_BLOCKED" \
						"that profile is not the active subscription; nothing was changed"
					return "$EXIT_BLOCKED"
				;;
			esac
			# What the card owed its issuers before this operation touched it.
			# Everything that appears later is this operation's to deliver, and
			# somebody else's backlog is not swept into this outage.
			OPERATION_NOTIFICATIONS_BEFORE="$TMP_BASE.notify-before"
			notification_snapshot "$REQUESTED_ENDPOINT" "$SWITCH_OWNER" \
				"$SWITCH_CANDIDATES" "$SWITCH_BEARER" \
				"$OPERATION_NOTIFICATIONS_BEFORE" || {
			# Without this snapshot nothing later can tell what this operation
			# caused from what the card already owed, so delivery is skipped
			# and the result says `unknown` rather than inventing either.
			log err 'the card would not list what it already owed its issuers; this operation cannot tell its own notifications from theirs'
			OPERATION_NOTIFICATIONS_BEFORE=""
		}
		;;
	esac
	takeover_stage capture_baseline

	# ---- mutate ----
	#
	# From here the cached read is already a lie, so it goes before the write
	# rather than after it, and no optimistic replacement is written.
	cache_invalidate_endpoint "$REQUESTED_ENDPOINT"
	switch_mutate_status=0
	case "$OPERATION_ACTION" in
		enable|disable)
			switch_mutate_card || switch_mutate_status=$?
			if [ "$BRIDGE_IDENTITY_FAILED" -eq 1 ]; then
				switch_release_all
				takeover_publish blocked "$EXIT_BLOCKED" \
					"the physical card identity was not confirmed; no profile switch was sent"
				return "$EXIT_BLOCKED"
			fi
			SWITCH_MUTATED=1
			# The modem goes back to its owner before anything else happens, on
			# every path including the failed one. What follows needs the
			# network, and the network needs the modem.
			switch_release_all
		;;
	esac
	[ "$switch_mutate_status" -ne 0 ] || takeover_stage mutate
	switch_release_all

	# ---- reattach, then the recovery that belongs to the modem package ----
	switch_status=0
	switch_wait_for_endpoint || switch_status=$?
	[ "$switch_status" -ne 0 ] || takeover_stage reattach
	switch_release_all

	switch_recovered=0
	switch_recover_and_verify && switch_recovered=1

	# ---- reset, at most once, and only where REFRESH was not enough ----
	#
	# The gate is the identity check and nothing else. A modem that adopted the
	# profile is not reset: that would be a minute of outage for nothing, and
	# whether this project has a modem that adopts one is a thing worth finding
	# out rather than papering over.
	if [ "$switch_recovered" -eq 0 ] && [ "$SWITCH_SUBSCRIPTION_MISMATCH" -eq 1 ] && \
		[ "$SWITCH_RESET_SPENT" -eq 0 ] && [ "$SWITCH_RESET_METHOD" != none ]; then
		# Cleared before the attempt, so the second verification decides it
		# again from what it observes rather than inheriting the first verdict.
		SWITCH_SUBSCRIPTION_MISMATCH=0
		if switch_reset_modem; then
			OPERATION_REASON_RESET=performed
			takeover_stage reset
			switch_status=0
			switch_wait_for_endpoint || switch_status=$?
			[ "$switch_status" -ne 0 ] || takeover_stage reattach
			switch_release_all
			switch_recover_and_verify && switch_recovered=1
		else
			# The reset could not be performed. The mismatch stands, because it
			# is still true, and the reason names why nothing was tried.
			SWITCH_SUBSCRIPTION_MISMATCH=1
		fi
	fi

	# ---- rollback, at most once ----
	if [ "$switch_recovered" -eq 0 ] && [ "$SWITCH_MUTATED" -eq 1 ] && \
		[ "$SWITCH_SUBSCRIPTION_MISMATCH" -eq 0 ]; then
		switch_attempt_rollback && switch_recovered=rolled-back
	fi

	# ---- tell the issuer what happened ----
	case "$OPERATION_ACTION" in
		enable|disable) switch_report_to_issuer || : ;;
		*) OPERATION_NOTIFICATION_DELIVERY="" ;;
	esac
	takeover_stage publish
	OPERATION_MUTATE_STARTED=0
	switch_terminal_result "$switch_recovered"
}

# One terminal result, from three questions that are genuinely independent:
# did the card end up as asked, is the router on a working bearer, and does the
# issuer know. A result that collapses any two of them into one is the shape
# this project has already been burned by.
switch_terminal_result() {
	switch_final_recovered="$1"
	switch_intent_met
	switch_final_met=$?

	# What the issuer knows, where the operation caused anything for it to know.
	# `unknown` is its own answer: the card could not be read afterwards, so
	# saying the issuer was not told would be a claim nobody checked.
	switch_final_reported=1
	case "$OPERATION_NOTIFICATION_DELIVERY" in
		''|none|delivered|delivered_unverified) : ;;
		unknown) switch_final_reported=unknown ;;
		*) switch_final_reported=0 ;;
	esac

	# The rollback case is answered before the intent, and the order is the
	# whole point: a rollback that worked leaves the card deliberately *not* in
	# the state that was asked for, so asking "did the change take effect"
	# first would report a completed restore as a change that never happened.
	if [ "$switch_final_recovered" = rolled-back ]; then
		if [ "$switch_final_met" -eq 0 ]; then
			# The card is still on the new profile after a rollback that
			# reported success. Two answers contradict each other, and neither
			# may be published as fact.
			OPERATION_REASON=rollback_contradicted
			takeover_publish partial "$EXIT_PARTIAL" \
				"the new subscription did not connect and the restore of the previous profile cannot be confirmed; read the endpoint before changing anything else, and nothing was removed"
			return "$EXIT_PARTIAL"
		fi
		OPERATION_REASON=reverted_no_bearer
		takeover_publish failed "$EXIT_RETRYABLE" \
			"the new subscription did not produce a working connection, so the previous profile is enabled again and the connection is back; nothing was removed"
		return "$EXIT_RETRYABLE"
	fi

	# A rollback that reached the card put the baseline back, so the requested
	# state is *deliberately* not the one the card holds. Judging that by
	# "did the change take effect" reports a restore as a change that never
	# happened -- which is what the reference FM350 was told, in those words,
	# after an enable that was made and then correctly undone.
	if [ "$SWITCH_ROLLBACK" = partial ]; then
		OPERATION_REASON=reverted_no_bearer_either
		takeover_publish partial "$EXIT_PARTIAL" \
			"the new subscription did not connect, so the previous profile was enabled again -- and that one did not connect either; the card is back as it was and nothing was removed"
		return "$EXIT_PARTIAL"
	fi
	if [ "$SWITCH_ROLLBACK" = failed ]; then
		OPERATION_REASON=rollback_failed
		takeover_publish partial "$EXIT_PARTIAL" \
			"the new subscription did not connect and the previous profile could not be enabled again; read the endpoint before changing anything else, and nothing was removed"
		return "$EXIT_PARTIAL"
	fi

	if [ "$SWITCH_SUBSCRIPTION_MISMATCH" -eq 1 ]; then
		# Three different states wear this one name, and telling a person
		# "it needs a reset" after one has already been spent is worse than
		# saying nothing.
		OPERATION_REASON=subscription_not_in_use
		if [ "$SWITCH_RESET_SPENT" -eq 1 ] && [ "$OPERATION_REASON_RESET" = performed ]; then
			takeover_publish partial "$EXIT_PARTIAL" \
				"the profile is enabled on the card, the modem was reset, and it is still using the previous subscription; this needs a person, and nothing was removed"
		elif [ "$SWITCH_RESET_METHOD" = none ]; then
			takeover_publish partial "$EXIT_PARTIAL" \
				"the profile is enabled on the card and the modem is still using the previous subscription; this modem has no reset method available, so nothing here can make it adopt the profile, and nothing was removed"
		else
			takeover_publish partial "$EXIT_PARTIAL" \
				"the profile is enabled on the card and the modem is still using the previous subscription; the reset that would make it adopt the profile could not be performed, and nothing was removed"
		fi
		return "$EXIT_PARTIAL"
	fi

	if [ "$switch_final_met" -eq 2 ]; then
		OPERATION_REASON=card_state_unknown
		takeover_publish partial "$EXIT_PARTIAL" \
			"the card could not be read after the change, so this operation cannot say which subscription is active now; nothing was removed"
		return "$EXIT_PARTIAL"
	fi

	if [ "$switch_final_met" -eq 1 ]; then
		# The card is as it was. That is a failure of the operation and not a
		# state anybody has to repair, provided the connection came back.
		if [ "$switch_final_recovered" = 1 ]; then
			OPERATION_REASON=change_not_applied
			takeover_publish failed "$EXIT_BLOCKED" \
				"the requested change did not take effect; the card is as it was and the connection is back"
			return "$EXIT_BLOCKED"
		fi
		OPERATION_REASON=change_not_applied_no_bearer
		takeover_publish partial "$EXIT_PARTIAL" \
			"the requested change did not take effect and the connection has not come back; nothing was removed"
		return "$EXIT_PARTIAL"
	fi

	if [ "$OPERATION_ACTION" = disable ] && [ "$switch_final_met" -eq 0 ]; then
		# A disable asked for no active subscription and got one. Whether the
		# APN target reconciled afterwards is not what it was measured by, and
		# a card with nothing enabled has no bearer to report.
		switch_final_recovered=1
	fi
	if [ "$switch_final_recovered" != 1 ]; then
		# Changed, not connected, and not put back. This is the state that
		# needs a person, which is exactly what `partial` is for.
		case "$SWITCH_ROLLBACK" in
			refused) OPERATION_REASON=changed_no_bearer_no_baseline ;;
			partial) OPERATION_REASON=changed_no_bearer_rollback_unfinished ;;
			*) OPERATION_REASON=changed_no_bearer ;;
		esac
		takeover_publish partial "$EXIT_PARTIAL" \
			"the change was made and the connection has not come back; the previous subscription was not restored, and nothing was removed"
		return "$EXIT_PARTIAL"
	fi

	if [ "$switch_final_reported" = 0 ]; then
		# The divergence this project exists to avoid: the card has done
		# something its issuer has not been told about.
		OPERATION_REASON=change_unreported
		takeover_publish partial "$EXIT_PARTIAL" \
			"the change was made, but the issuer has NOT been told; the notification is still on the card and should be sent"
		return "$EXIT_PARTIAL"
	fi
	if [ "$switch_final_reported" = unknown ]; then
		OPERATION_REASON=change_report_unconfirmed
		takeover_publish partial "$EXIT_PARTIAL" \
			"the change was made, but this operation could not read the card's pending notifications afterwards and so cannot say whether the issuer was told; read the endpoint and send anything still queued"
		return "$EXIT_PARTIAL"
	fi

	case "$OPERATION_NOTIFICATION_DELIVERY" in
		delivered) switch_final_note="and the issuer was told" ;;
		delivered_unverified)
			switch_final_note="and the notification was accepted over an explicitly unverified transport, so it is kept on the card and should be sent again when the issuer can be verified"
		;;
		none) switch_final_note="and this change asked for no notification" ;;
		*) switch_final_note="and no notification was owed" ;;
	esac
	OPERATION_REASON=""
	case "$OPERATION_ACTION" in
		enable)
			takeover_publish succeeded 0 \
				"the profile is now the active subscription, the connection is back on it, $switch_final_note; nothing was removed"
		;;
		disable)
			takeover_publish succeeded 0 \
				"the profile is no longer the active subscription, $switch_final_note; nothing was removed"
		;;
		*)
			takeover_publish succeeded 0 \
				"the active slot was changed and the connection is back on it; nothing was removed"
		;;
	esac
	return 0
}

# ---- guarded deletion ----
#
# The only operation in this suite that can destroy something a person paid for
# and cannot get back, so everything below is written from that sentence
# outwards.
#
# The mechanism that makes it dangerous is not the deletion. It is the
# notification: SGP.22 has the eUICC produce a delete notification and the LPA
# deliver it to the issuer, and that message is how an operator learns the
# subscription is free to be reissued. A profile deleted locally whose delete
# notification never arrives is a subscription that exists nowhere -- gone from
# the card, still held open in the operator's record, and generally not
# reissuable through support.
#
# The safe ordering is not available. The notification does not exist until the
# eUICC has performed the deletion, so "tell the issuer, then delete" cannot be
# written. The guarantee is therefore the one a download already keeps: the
# notification is never removed from the card until the issuer has taken it.
#
# **The address that notification must reach cannot be read before the
# deletion.** Checked on the reference eUICC on 2026-09-01 rather than assumed:
# `profile list` returns iccid, isdpAid, profileState, profileNickname,
# serviceProviderName, profileName, iconType, icon and profileClass, and the
# LPA binary carries no `notificationConfigurationInfo` at all. SGP.22 keeps the
# address in the profile's own metadata; this LPA neither asks for it nor
# exposes it. So a deletion cannot verify the issuer is reachable before
# destroying anything, and the honest design is delete-then-deliver with a loud,
# retryable unfinished state -- which is what this is.
#
# Nothing is remembered between an install and a deletion, and nothing may be.
# A deletion is separated from its installation by time, devices, firmware
# upgrades and factory resets, so there is no "this profile was installed over
# an unverified transport" flag; a deletion makes its own transport decision
# from scratch.

delete_token_dir() {
	printf '%s/delete\n' "$STATE_DIR"
}

# A token is 32 hexadecimal characters and nothing else is ever treated as one.
delete_token_valid() {
	case "${1:-}" in
		'') return 1 ;;
		*[!0-9a-f]*) return 1 ;;
	esac
	[ "${#1}" -eq 32 ] || return 1
	return 0
}

# Tokens whose deadline has passed, and claimed records whose worker is gone.
#
# Exact paths only: the glob finds candidates, and each candidate is then
# checked to be a regular file whose name this package would have written. Never
# a recursive removal of a root, and never a removal of a live operation's
# record.
delete_token_sweep() {
	sweep_dir="$(delete_token_dir)"
	[ -d "$sweep_dir" ] || return 0
	sweep_now="$(monotonic_seconds)" || return 0
	for sweep_token in "$sweep_dir"/*; do
		[ -f "$sweep_token" ] || continue
		[ -L "$sweep_token" ] && continue
		sweep_name="${sweep_token##*/}"
		sweep_pid=""
		case "$sweep_name" in
			*.claimed.*)
				sweep_pid="${sweep_name##*.claimed.}"
				sweep_name="${sweep_name%%.claimed.*}"
			;;
		esac
		delete_token_valid "$sweep_name" || continue
		case "$sweep_pid" in ''|*[!0-9]*) sweep_pid="" ;; esac
		# A claimed record whose worker is still alive is that operation's.
		[ -n "$sweep_pid" ] && process_is_alive "$sweep_pid" && continue
		sweep_expiry="$(field "$(sed -n '1p' "$sweep_token" 2>/dev/null || :)" 13)"
		case "$sweep_expiry" in ''|*[!0-9]*) sweep_expiry=0 ;; esac
		[ "$sweep_now" -gt "$sweep_expiry" ] || continue
		rm -f "$sweep_token" 2>/dev/null || :
	done
	return 0
}

# Thirty-two hexadecimal characters whose entropy is /dev/urandom's, and nothing
# else's. A token derived from a PID, a clock or a counter is guessable by
# whoever else is on this router, and what it authorises cannot be undone.
#
# The digest is a formatter, not a security property: the reference router has
# no `od` and no `hexdump`, so there is no portable way to print raw bytes as
# hex here. Sixty-four bytes go in and the first 128 bits of the digest come
# out, which is a token nobody can search for.
delete_mint_token() {
	mint_value="$(dd if=/dev/urandom bs=64 count=1 2>/dev/null | "$SHA256" 2>/dev/null |
		sed -n '1s/^\([0-9a-f]*\).*/\1/p' | cut -c1-32)"
	delete_token_valid "$mint_value" || return 1
	printf '%s\n' "$mint_value"
	return 0
}

# Whether the profile this plan names is the subscription a target on this
# router is actually using, whatever the card says its state is.
#
# Asked of the APN engine, which is the one component that knows which SIM is
# serving which interface, and asked of every target rather than of the one this
# modem happens to own: a removable eUICC can be in either modem.
#
#   0  it is in use
#   1  it is not
#   2  nobody could say, which is not the same answer as "no"
#
# The third value is the whole reason this is not a boolean. An engine that
# cannot be asked leaves the question open, and an open question about an
# irreversible operation is a stop -- silently reading it as "not in use" would
# make the check disappear exactly when the system is already unwell.
delete_profile_in_use() {
	command_exists "$APN_BIN" || return 2
	command_exists "$JSONFILTER" || return 2
	use_targets="$TMP_BASE.bounded"
	run_bounded_to_file 15 "$use_targets" "$APN_BIN" targets-json || return 2
	# That the document parsed at all, asked separately from what is in it. A
	# router may genuinely have no targets, and that is an answer -- nothing is
	# using this profile. An answer this shell could not read is not, and the
	# two produce the same empty list.
	[ "$("$JSONFILTER" -i "$use_targets" -e '@.version' 2>/dev/null || :)" = v2 ] || return 2
	use_ids="$("$JSONFILTER" -i "$use_targets" -e '@.targets[*].id' 2>/dev/null || :)"
	for use_id in $use_ids; do
		case "$use_id" in network:*) : ;; *) continue ;; esac
		# A subscription on this card can only be in use by the modem holding
		# this card. Asking every other target costs an engine status read of a
		# modem that could not possibly be the answer, and on the reference
		# router that read is the whole problem: the AT-dialled FM350, whose
		# embedded eUICC has no enabled profile, answers anywhere between two
		# and twenty-one seconds, so the fifteen-second bound below turned into
		# a timeout often enough that deleting a profile on the *RM520* refused
		# with `in_use_unknown` about half the time. A modem that cannot hold
		# this card is skipped before it is asked.
		#
		# Only on a resolved, unambiguous mismatch. A target whose modem cannot
		# be resolved is still asked, because "I could not tell whose modem
		# this is" must not become "it is not using the profile" in front of
		# something irreversible.
		use_target_modem="$TMP_BASE.bounded-modem"
		use_modem_code=0
		run_bounded_to_file 10 "$use_target_modem" "$MODEM_BIN" resolve \
			--interface "${use_id#network:}" || use_modem_code=$?
		if [ "$use_modem_code" -eq 0 ]; then
			use_modem_id="$(sed -n '1p' "$use_target_modem" 2>/dev/null | tr -d ' \t\r')"
			if [ -n "$use_modem_id" ] && [ "$use_modem_id" != "$REQUESTED_MODEM" ]; then
				continue
			fi
		fi
		use_status="$TMP_BASE.bounded-status"
		use_status_code=0
		# The one caller that asks for the absent-SIM class, because it is the
		# one deciding something irreversible. Everyone else keeps the engine's
		# older behaviour, where an absent SIM is "try later".
		run_bounded_to_file 15 "$use_status" "$APN_BIN" status-json \
			--target "$use_id" --sim-absence-is-an-answer || use_status_code=$?
		case "$use_status_code" in
			0) : ;;
			# The engine's own class for "the modem answered and has no SIM".
			# Named rather than written as a digit because this package's own
			# EXIT_PARTIAL is also 5 and means something entirely different.
			#
			# A target with no SIM is serving no subscription at all, so it is
			# certainly not serving this one -- exactly the same answer the
			# empty-ICCID case below already gives, and it must not be a
			# refusal. Before this, disabling a profile emptied the modem, the
			# status read failed, and the deletion of the very profile you had
			# just switched off became impossible: the precondition for
			# deleting made deleting unreachable. Found on the FM350-GL
			# 2026-09-03.
			"$ENGINE_EXIT_NO_SIM") continue ;;
			*) return 2 ;;
		esac
		# A successful command is not proof of a readable identity document.
		# Missing, malformed or invalid fields must not become an empty SIM:
		# that would authorize deletion without establishing it is unused.
		[ "$("$JSONFILTER" -i "$use_status" -e '@.version' 2>/dev/null || :)" = v2 ] || return 2
		use_iccid="$("$JSONFILTER" -i "$use_status" -e '@.iccid' 2>/dev/null)" || return 2
		# Only a successfully read, explicitly empty identity is an answer
		# that this target serves no subscription. The engine's NO_SIM exit
		# class is handled separately above.
		[ -n "$use_iccid" ] || continue
		use_iccid="$(normalise_iccid "$use_iccid" 2>/dev/null)" || return 2
		use_handle="$(profile_handle_from_iccid "$use_iccid" 2>/dev/null)" || return 2
		[ -n "$use_handle" ] || return 2
		use_iccid=""
		[ "$use_handle" = "$REQUESTED_PROFILE" ] || continue
		log err "the profile named for deletion is the subscription $use_id is using"
		return 0
	done
	return 1
}

# The plan document. Printed on every path, refusal included, because a caller
# that gets an exit code and no document cannot tell a refusal from a crash.
DELETE_PLAN_REASON=""
DELETE_PLAN_AVAILABLE=0
DELETE_PLAN_TOKEN=""
DELETE_PLAN_OPERATION=""
DELETE_PLAN_REQUIRES_TAKEOVER=0
DELETE_PLAN_TOOK_TAKEOVER=0
DELETE_PLAN_STATE=""
DELETE_PLAN_CLASS=""
DELETE_PLAN_SUFFIX=""
DELETE_PLAN_NICKNAME=""
DELETE_PLAN_NAME=""
DELETE_PLAN_PROVIDER=""
DELETE_PLAN_GENERATION=""
DELETE_PLAN_SLOT=""
DELETE_PLAN_SLOT_ACTIVE=""
DELETE_PLAN_ACTIVE_SLOT=""
DELETE_PLAN_OWNER=""
DELETE_PLAN_INTERFACE=""

delete_plan_print() {
	# The modem goes back to its owner before the document is written, on every
	# path including a refusal. A plan that held an inhibit open while it
	# formatted JSON would be charging the user for the printing.
	takeover_release_prepare
	printf '{'
	json_key_string version v1; printf ','
	json_key_string endpoint_id "$REQUESTED_ENDPOINT"; printf ','
	json_key_string modem_id "$REQUESTED_MODEM"; printf ','
	json_key_string profile_id "$REQUESTED_PROFILE"; printf ','
	json_key_boolean available "$DELETE_PLAN_AVAILABLE"; printf ','
	json_key_string refusal_reason "$DELETE_PLAN_REASON"; printf ','
	# Consent is not a preference here and the document says so in the shape a
	# frontend can branch on: there is no argument, flag or setting that turns
	# the second step off.
	json_key_boolean consent_required 1; printf ','
	json_key_boolean irreversible 1; printf ','
	json_key_boolean requires_takeover "$DELETE_PLAN_REQUIRES_TAKEOVER"; printf ','
	json_key_boolean took_takeover "$DELETE_PLAN_TOOK_TAKEOVER"; printf ','
	# What the confirmation must show. Only the masked suffix, exactly as every
	# other document in this package: four characters is what a person compares
	# against a screen and the whole of what a display gets.
	printf '"profile":{'
	json_key_string iccid_suffix "$DELETE_PLAN_SUFFIX"; printf ','
	json_key_string state "$DELETE_PLAN_STATE"; printf ','
	json_key_string class "$DELETE_PLAN_CLASS"; printf ','
	json_key_string nickname "$DELETE_PLAN_NICKNAME"; printf ','
	json_key_string profile_name "$DELETE_PLAN_NAME"; printf ','
	json_key_string provider_name "$DELETE_PLAN_PROVIDER"
	printf '},'
	# Every identity the token binds, published so the confirmation shows the
	# same state it was issued against.
	printf '"bound":{'
	json_key_number attachment_generation "$DELETE_PLAN_GENERATION"; printf ','
	json_key_string slot "$DELETE_PLAN_SLOT"; printf ','
	json_key_string slot_active "$DELETE_PLAN_SLOT_ACTIVE"; printf ','
	json_key_string active_slot "$DELETE_PLAN_ACTIVE_SLOT"; printf ','
	json_key_string owner_state "$DELETE_PLAN_OWNER"
	printf '},'
	# Whether the issuer can be checked before anything is destroyed. It cannot:
	# the address lives inside the notification, which does not exist until the
	# eUICC has performed the deletion. A frontend that promises otherwise
	# promises something no LPA on this router can do.
	printf '"issuer":{'
	json_key_boolean address_known_before_deletion 0; printf ','
	json_key_string told_at after-deletion; printf ','
	# The deletion itself is verified-only. It cannot be retried -- the token
	# is spent and the profile is gone -- so a downgrade chosen in advance
	# would be a downgrade nobody could withdraw. What the unknown-issuer
	# failure leaves behind is a notification on the card, and that is
	# retryable: `notification-send` carries the same consented downgrade a
	# download does, which is where the offer belongs.
	json_key_string transport verified-only; printf ','
	json_key_string unverified_retry_verb notification-send
	printf '},'
	json_key_string operation_id "$DELETE_PLAN_OPERATION"; printf ','
	json_key_number expires_in_seconds "$DELETE_PLAN_TTL_SECONDS"; printf ','
	json_key_string interrupts_interface "$DELETE_PLAN_INTERFACE"; printf ','
	json_key_string other_uplink_up "$(other_uplink_state "$DELETE_PLAN_INTERFACE")"; printf ','
	# What the *deletion* will hold the modem for, which is the number a person
	# is being asked to consent to. It is one inhibit: the delete request, the
	# confirming read of the card and the delivery all happen inside it, and
	# nothing here waits for a bearer -- a deletion changes no subscription, so
	# there is no recovery to bound.
	json_key_number worst_case_seconds "$ESIM_INHIBIT_MAX_SECONDS"; printf ','
	# And what reading the card for this plan may already have cost, published
	# separately because it is a different outage that has already happened by
	# the time anybody reads this. A frontend that wants to warn before asking
	# for a plan has the number here.
	json_key_number plan_takeover_seconds \
		"$([ "$DELETE_PLAN_REQUIRES_TAKEOVER" -eq 1 ] && printf '%s' "$ESIM_INHIBIT_MAX_SECONDS" || printf 0)"; printf ','
	json_key_string token "$DELETE_PLAN_TOKEN"
	printf '}\n'
}

delete_plan_refuse() {
	DELETE_PLAN_REASON="$1"
	DELETE_PLAN_AVAILABLE=0
	DELETE_PLAN_TOKEN=""
	# The operation id stays, and it used to be cleared here.
	#
	# It had one meaning then -- "there is something to confirm" -- and a
	# refusal has nothing, so clearing it was right. Since the plan became a
	# job it has a second meaning: it is the *address* of the answer. The
	# reader hands a stored document only to the operation that made it, so a
	# refusal without an id is a refusal the caller who asked for it cannot
	# collect, and would read back as some other operation's document.
	#
	# Nothing is loosened by keeping it. `available:false` is what says there
	# is nothing to confirm, and `delete-confirm` resolves a token record that
	# a refusal never wrote: an id from a refused plan confirms nothing,
	# because there is no token to find.
	delete_plan_print
	return 0
}

# Two consents that belong to other operations and must not be given to this
# one. Refused rather than ignored: a caller who set one asked for something
# this verb will not do, and silently doing something else is how a consent
# stops meaning anything.
delete_refuse_foreign_consents() {
	[ "$CAPTURED_ALLOW_UNVERIFIED_TRANSPORT" != 1 ] || \
		die_code "$EXIT_USAGE" \
			"a deletion is verified-only; the consented downgrade belongs to notification-send, which can retry what a deletion leaves on the card"
	[ "$CAPTURED_CONFIRM_DISCARD" != 1 ] || \
		die_code "$EXIT_USAGE" "the discard confirmation belongs to notification-remove alone"
	return 0
}

delete_plan_cmd() {
	# Claimed before anything can refuse. Every document this prints carries an
	# operation id, refusals included, because the reader is bound to it: a
	# refusal with an empty id is a refusal the caller that asked for it cannot
	# collect, and it would read as another operation's document instead.
	[ -z "$REQUESTED_OPERATION" ] || DELETE_PLAN_OPERATION="$REQUESTED_OPERATION"
	require_endpoint_target
	[ -n "$REQUESTED_PROFILE" ] || die_code "$EXIT_USAGE" "delete-plan requires --profile"
	[ "$CAPTURED_ALLOW_TAKEOVER" != invalid ] || \
		die_code "$EXIT_USAGE" "the takeover consent must be 0 or 1"
	delete_refuse_foreign_consents
	plan_section="$(modem_section_at "$(field "$TARGET_LINE" 19)")"
	DELETE_PLAN_INTERFACE="$(section_field "$plan_section" interface 2)"
	DELETE_PLAN_GENERATION="$(field "$TARGET_LINE" 4)"
	DELETE_PLAN_SLOT="$(field "$TARGET_LINE" 5)"
	[ -n "$DELETE_PLAN_SLOT" ] || DELETE_PLAN_SLOT=none
	DELETE_PLAN_SLOT_ACTIVE="$(field "$TARGET_LINE" 7)"
	[ -n "$DELETE_PLAN_SLOT_ACTIVE" ] || DELETE_PLAN_SLOT_ACTIVE=none
	DELETE_PLAN_ACTIVE_SLOT="$(section_field "$plan_section" slots 4)"
	[ -n "$DELETE_PLAN_ACTIVE_SLOT" ] || DELETE_PLAN_ACTIVE_SLOT=none
	DELETE_PLAN_OWNER="$(field "$TARGET_LINE" 13)"

	# An endpoint that is not proven is read-only inventory, and this is the one
	# operation where "probably that chip" would be a subscription.
	[ "$(field "$TARGET_LINE" 2)" = eid ] || { delete_plan_refuse endpoint_unproven; return "$EXIT_BLOCKED"; }
	case "$DELETE_PLAN_OWNER" in
		conflicting|transitioning) delete_plan_refuse modem_busy; return "$EXIT_BLOCKED" ;;
	esac
	# A plan does not bind an unknown. A field that could not be read is not
	# bound as "whatever it was"; the plan refuses and the user asks again.
	case "$DELETE_PLAN_GENERATION" in
		''|*[!0-9]*) delete_plan_refuse identity_incomplete; return "$EXIT_BLOCKED" ;;
	esac
	[ -x "$LPAC_RUN" ] || { delete_plan_refuse lpa_unavailable; return "$EXIT_BLOCKED"; }

	plan_reachable="$(field "$TARGET_LINE" 14)"
	case "$plan_reachable" in
		yes) : ;;
		requires-inhibit|requires-bearer-stop)
			DELETE_PLAN_REQUIRES_TAKEOVER=1
			# The refusal the contract names, and the one place the caller has
			# a way forward: reaching this card means taking it away from its
			# owner for a moment, which is a thing to be consented to and not a
			# thing to be done because a plan was asked for.
			[ "$CAPTURED_ALLOW_TAKEOVER" = 1 ] || {
				delete_plan_refuse takeover_required
				return "$EXIT_BLOCKED"
			}
		;;
		*) delete_plan_refuse endpoint_unreachable; return "$EXIT_BLOCKED" ;;
	esac

	# Locks 1 and 2 before anything is opened, in the one order this project
	# has. A modem somebody else is operating on is `modem_busy` here rather
	# than a queue: a plan that waits behind a switch describes a card that is
	# being changed while it describes it.
	acquire_global_lock "$LOCK_WAIT_SECONDS" || { delete_plan_refuse modem_busy; return "$EXIT_BLOCKED"; }
	acquire_modem_lock "$REQUESTED_MODEM" "$LOCK_WAIT_SECONDS" || {
		delete_plan_refuse modem_busy
		return "$EXIT_BLOCKED"
	}
	APN_AUTOCONFIG_MODEM_LOCK_OWNER_PID=$SELF_PID
	export APN_AUTOCONFIG_MODEM_LOCK_OWNER_PID

	# Asked here, and the position is the whole point.
	#
	# Measured on the reference router 2026-09-01: asked after the inhibit, this
	# question has no answer. The engine learns which SIM is serving which
	# target from ModemManager, and an inhibit is precisely ModemManager not
	# having the modem -- so every plan on the only hardware there is refused
	# with `in_use_unknown`. It is asked while the engine can still answer, and
	# it needs nothing from the card: it compares the handle the caller named
	# against the subscription each target reports.
	delete_in_use=0
	delete_profile_in_use || delete_in_use=$?
	case "$delete_in_use" in
		0) delete_plan_refuse profile_in_use; return "$EXIT_BLOCKED" ;;
		2) delete_plan_refuse in_use_unknown; return "$EXIT_BLOCKED" ;;
	esac

	plan_owner="$(esim_lpa_owner "$TARGET_LINE")"
	plan_candidates="$(esim_transport_candidates "$TARGET_LINE")"
	plan_bearer="$(esim_bearer_device "$TARGET_LINE")"
	if [ "$DELETE_PLAN_REQUIRES_TAKEOVER" -eq 1 ]; then
		# Quiet, because a plan is not an operation and has no operation state
		# to publish into. The reason is still set, and it becomes the refusal.
		TAKEOVER_INHIBIT_QUIET=1
		plan_takeover_status=0
		if [ "$plan_reachable" = requires-inhibit ]; then
			plan_mm="$(section_field "$plan_section" mm 2)"
			case "$plan_mm" in
				''|*[!0-9]*) delete_plan_refuse modemmanager_unavailable; return "$EXIT_BLOCKED" ;;
			esac
			takeover_acquire_inhibit "$plan_mm" || plan_takeover_status=$?
		else
			takeover_acquire_bearer_stop "$DELETE_PLAN_INTERFACE" || plan_takeover_status=$?
		fi
		if [ "$plan_takeover_status" -ne 0 ]; then
			delete_plan_refuse "${OPERATION_REASON:-takeover_failed}"
			return "$EXIT_BLOCKED"
		fi
		DELETE_PLAN_TOOK_TAKEOVER=1
		plan_owner=none
		plan_candidates="$(control_candidates "$plan_section" "" | tr '\n' ' ')"
		plan_bearer=""
		[ -n "$plan_candidates" ] || { delete_plan_refuse no_control_port; return "$EXIT_BLOCKED"; }
	fi

	# From the device, never from the cache. A plan describes what is on the
	# card now, and a cached list is a statement about a card as it was.
	plan_profiles="$TMP_BASE.lpa-profiles"
	read_profiles_through_lpa "$REQUESTED_ENDPOINT" "$plan_owner" "$plan_candidates" \
		"$plan_bearer" "$plan_profiles" || { delete_plan_refuse read_abandoned; return "$EXIT_BLOCKED"; }
	plan_matches="$(awk -F '\t' -v handle="$REQUESTED_PROFILE" \
		'$1 == handle { count++ } END { print count + 0 }' "$plan_profiles")"
	[ "$plan_matches" -eq 1 ] || { delete_plan_refuse profile_ambiguous; return "$EXIT_BLOCKED"; }
	plan_row="$(awk -F '\t' -v handle="$REQUESTED_PROFILE" '$1 == handle { print; exit }' "$plan_profiles")"
	DELETE_PLAN_SUFFIX="$(field "$plan_row" 2)"
	DELETE_PLAN_STATE="$(field "$plan_row" 3)"
	DELETE_PLAN_CLASS="$(field "$plan_row" 4)"
	DELETE_PLAN_NICKNAME="$(field "$plan_row" 5)"
	DELETE_PLAN_NAME="$(field "$plan_row" 6)"
	DELETE_PLAN_PROVIDER="$(field "$plan_row" 7)"
	case "$DELETE_PLAN_STATE" in
		disabled) : ;;
		enabled) delete_plan_refuse profile_enabled; return "$EXIT_BLOCKED" ;;
		*) delete_plan_refuse profile_state_unknown; return "$EXIT_BLOCKED" ;;
	esac
	# The `profile_in_use` row that is not redundant with this one was answered
	# further up, before the modem was taken away from the owner that knows the
	# answer. A profile reporting `disabled` while its ICCID is the one a modem
	# on this router is registered with is a card contradicting an observation,
	# and an inconsistent observation about an irreversible operation is a stop
	# rather than a tie-break.

	# The job's own id when this plan is running as one -- claimed at entry
	# above, so this only mints one for a plan run straight from a shell.
	# `delete-confirm` resolves the single-use token by operation id, and two
	# ids for one plan would be two things to keep in step.
	[ -n "$DELETE_PLAN_OPERATION" ] || \
		DELETE_PLAN_OPERATION="$(date -u +%s 2>/dev/null || printf '%s' 0)-$$"
	plan_now="$(monotonic_seconds)" || { delete_plan_refuse no_clock; return "$EXIT_BLOCKED"; }
	plan_expiry=$((plan_now + DELETE_PLAN_TTL_SECONDS))
	delete_token_sweep
	plan_dir="$(delete_token_dir)"
	( umask 077 && mkdir -p "$plan_dir" ) || { delete_plan_refuse token_unwritable; return "$EXIT_BLOCKED"; }
	DELETE_PLAN_TOKEN="$(delete_mint_token)" || { delete_plan_refuse token_unwritable; return "$EXIT_BLOCKED"; }
	(
		umask 077
		printf 'v1\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
			"$DELETE_PLAN_OPERATION" "$REQUESTED_MODEM" "$REQUESTED_ENDPOINT" \
			"$REQUESTED_PROFILE" "$DELETE_PLAN_STATE" "$DELETE_PLAN_GENERATION" \
			"$DELETE_PLAN_SLOT" "$DELETE_PLAN_SLOT_ACTIVE" "$DELETE_PLAN_ACTIVE_SLOT" \
			"$DELETE_PLAN_OWNER" "$SELF_PID" "$plan_expiry" "$DELETE_PLAN_SUFFIX" \
			>"$plan_dir/$DELETE_PLAN_TOKEN"
	) || { delete_plan_refuse token_unwritable; return "$EXIT_BLOCKED"; }
	DELETE_PLAN_AVAILABLE=1
	delete_plan_print
	return 0
}

# What the finished plan said. A read, and the only way a caller that started
# the job gets the document the synchronous plan used to return.
#
# It publishes no token: the worker stripped it before writing, so this cannot
# hand out a capability even by mistake. It also refuses a plan belonging to
# another endpoint rather than returning it, because the file is per modem and
# a modem may carry more than one eUICC over its life.
delete_plan_result_cmd() {
	[ -n "$REQUESTED_MODEM" ] || die_code "$EXIT_USAGE" "delete-plan-result requires --modem"
	[ -n "$REQUESTED_ENDPOINT" ] || \
		die_code "$EXIT_USAGE" "delete-plan-result requires --endpoint"
	# The operation that asked. Required, and the whole reason this verb is
	# safe: the file is one per modem, so without it any earlier plan on the
	# same modem answers for the current request.
	#
	# Found on the FM350-GL 2026-09-04, and it is the worst defect this project
	# has had. A plan job died two seconds in without writing anything; the
	# page read this file and got the *previous day's* plan, for a different
	# subscription, `available: true` -- and built the confirmation dialog
	# around it. The dialog named a subscription nobody had asked to remove.
	# The token would very likely have been refused as spent, so probably
	# nothing would have been deleted; that is luck, not a design, and the
	# dialog is the one surface in this project whose entire job is to be true.
	[ -n "$REQUESTED_OPERATION" ] || \
		die_code "$EXIT_USAGE" "delete-plan-result requires --operation"
	plan_result_file="$(action_state_dir_for "$REQUESTED_MODEM")/delete-plan.json"
	if [ ! -s "$plan_result_file" ]; then
		delete_plan_result_absent no_plan
		return "$EXIT_BLOCKED"
	fi
	if ! grep -q "\"endpoint_id\":\"$REQUESTED_ENDPOINT\"" "$plan_result_file" 2>/dev/null; then
		delete_plan_result_absent other_endpoint
		return "$EXIT_BLOCKED"
	fi
	# Not "a plan for this modem": *this* plan. A document from any other
	# operation is another question's answer, and answering with it is how the
	# wrong subscription gets named.
	if ! grep -q "\"operation_id\":\"$REQUESTED_OPERATION\"" "$plan_result_file" 2>/dev/null; then
		delete_plan_result_absent other_operation
		return "$EXIT_BLOCKED"
	fi
	cat "$plan_result_file"
	# A refusal is a document *and* a non-zero exit, which is the rule the
	# synchronous plan followed and which the page's reader still depends on:
	# a caller that gets a document and a zero cannot tell a plan it may act on
	# from one it may not without parsing, and the exit class is what stops it
	# having to.
	grep -q '"available":true' "$plan_result_file" 2>/dev/null || return "$EXIT_BLOCKED"
	return 0
}

delete_plan_result_absent() {
	printf '{'
	json_key_string version v1; printf ','
	json_key_string modem_id "$REQUESTED_MODEM"; printf ','
	json_key_string endpoint_id "$REQUESTED_ENDPOINT"; printf ','
	json_key_boolean available 0; printf ','
	json_key_string refusal_reason "$1"
	printf '}\n'
	return 0
}

# ---- the plan, as an operation ----
#
# Measured on the FM350-GL 2026-09-03: a plan that runs to the end reads the
# card, and that took 24 seconds against the 20 seconds LuCI gives an RPC -- so
# a deletion could not be reached from the page at all on that modem, while the
# RM520N-GL's faster card reads had hidden it since C5. Every other long thing
# this package does is already a job. The plan was the outlier, and it is an
# outlier that reads a card and holds both locks.
#
# The work itself is unchanged: this adds the operation around it and nothing
# to it. `delete_plan_cmd` takes its own locks, so this must not take them
# again, and the document it prints is captured rather than written to a
# stdout nobody is reading.
#
# See docs/work-items/D4-a-plan-is-an-operation.md.
# The consented card probe, as a job.
#
# It has to be a job and not a read verb: `ESIM_BEARER_STOP_SECONDS` is 30 and
# `READ_DEADLINE_SECONDS` must stay under the rpcd exec budget, so taking an
# interface down, asking a card and putting the interface back cannot fit in a
# request a page holds open. D4 made the delete plan a job for the same
# arithmetic and this follows it.
#
# What it leaves behind is not a document. A successful probe stores the
# endpoint identity record for this attachment, and the next ordinary inventory
# read builds the endpoint from that record without opening the card again --
# so the result of this operation is that the page starts having something to
# show, and the terminal action result says whether it does.
# The timer belongs only to the consented modem-addressed read. It signals
# the worker, whose normal cleanup stops card access before restoring netifd.
# A separate shell makes its sleep a known child and lets cancellation reap it.
card_probe_deadline_arm() {
	PROBE_DEADLINE_EXPIRED=0
	/bin/sh -c '
		trap "kill -TERM \${timer_pid:-\$!} 2>/dev/null || :; wait \${timer_pid:-\$!} 2>/dev/null || :; exit 0" TERM
		"$1" "$2" &
		timer_pid=$!
		wait "$timer_pid" || exit 0
		kill -USR1 "$3" 2>/dev/null || :
	' probe-timer "$SLEEP" "$ESIM_INHIBIT_MAX_SECONDS" "$SELF_PID" </dev/null >/dev/null 2>&1 &
	PROBE_WATCHDOG_PID=$!
}

card_probe_deadline_cancel() {
	[ -n "${PROBE_WATCHDOG_PID:-}" ] || return 0
	kill -TERM "$PROBE_WATCHDOG_PID" 2>/dev/null || :
	wait "$PROBE_WATCHDOG_PID" 2>/dev/null || :
	PROBE_WATCHDOG_PID=""
}

card_probe_run_cmd() {
	[ -n "$REQUESTED_MODEM" ] || die_code "$EXIT_USAGE" "card-probe-run requires --modem"
	[ -n "$REQUESTED_OPERATION" ] || die_code "$EXIT_USAGE" "card-probe-run requires --operation"
	[ -z "$REQUESTED_ENDPOINT" ] || \
		die_code "$EXIT_USAGE" "card-probe-run names a modem, not an endpoint"
	TAKEOVER_OPERATION_ID="$REQUESTED_OPERATION"
	OPERATION_ACTION=card-probe
	TAKEOVER_STARTED="${APN_AUTOCONFIG_ESIM_STARTED:-$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)}"
	TAKEOVER_STATE_DIR="$(action_state_dir_for "$REQUESTED_MODEM")"
	TAKEOVER_START_LOCK="${APN_AUTOCONFIG_ESIM_START_LOCK:-}"
	TAKEOVER_PUBLISH_ARMED=1
	adopt_handoff_pid || {
		OPERATION_REASON=handoff_failed
		takeover_publish failed "$EXIT_RETRYABLE" \
			"the background worker handoff could not be verified"
		return "$EXIT_RETRYABLE"
	}
	takeover_publish_running || return "$EXIT_RETRYABLE"

	# The consent travels from the launcher, which unsets the request
	# environment as soon as it has captured it. Without it this does nothing:
	# stopping somebody's connection is not a thing to do on a bare call.
	[ "$CAPTURED_ALLOW_TAKEOVER" = 1 ] || {
		OPERATION_REASON=takeover_required
		takeover_publish blocked "$EXIT_BLOCKED" \
			"stopping the bearer to reach this card was not consented to"
		return "$EXIT_BLOCKED"
	}

	acquire_global_lock "$LOCK_WAIT_SECONDS" || {
		takeover_publish failed "$EXIT_RETRYABLE" "another operation holds the global lock"
		return "$EXIT_RETRYABLE"
	}
	acquire_modem_lock "$REQUESTED_MODEM" "$LOCK_WAIT_SECONDS" || {
		takeover_publish failed "$EXIT_RETRYABLE" "another operation holds this modem"
		return "$EXIT_RETRYABLE"
	}
	takeover_stage acquire_locks

	# Revalidation after the locks. The launcher proved this under no lock at
	# all, which is a time-of-check/time-of-use race and nothing more.
	#
	# The declaration keeps the revalidation from seeing this operation as
	# somebody else's: the inventory read runs as a child, so its PID does not
	# match the per-modem lock this worker holds, and the modem would come back
	# `transitioning` because of this very operation.
	APN_AUTOCONFIG_MODEM_LOCK_OWNER_PID=$SELF_PID
	export APN_AUTOCONFIG_MODEM_LOCK_OWNER_PID
	probe_run_status=0
	resolve_modem_target || probe_run_status=$?
	if [ "$probe_run_status" -eq 2 ]; then
		takeover_publish failed "$EXIT_RETRYABLE" \
			"the modem inventory could not be re-read"
		return "$EXIT_RETRYABLE"
	fi
	if [ "$probe_run_status" -ne 0 ]; then
		takeover_publish blocked "$EXIT_BLOCKED" \
			"the modem is no longer present or is ambiguous"
		return "$EXIT_BLOCKED"
	fi
	bearer_is_the_modems_own_control_port "$TARGET_MODEM_SECTION" || {
		takeover_publish blocked "$EXIT_BLOCKED" \
			"this modem's card is no longer behind its own bearer"
		return "$EXIT_BLOCKED"
	}
	probe_run_interface="$(section_field "$TARGET_MODEM_SECTION" interface 2)"
	probe_run_generation="$(field "$TARGET_MODEM_LINE" 6)"
	takeover_stage revalidate

	card_probe_deadline_arm
	probe_stop_status=0
	takeover_acquire_bearer_stop "$probe_run_interface" || probe_stop_status=$?
	if [ "$probe_stop_status" -ne 0 ]; then
		takeover_publish failed "$probe_stop_status" \
			"the selected bearer could not be stopped for this probe"
		return "$probe_stop_status"
	fi
	# Only now, and only for as long as this process lives. The exit trap
	# restores the interface whatever happens below, including on a signal.
	CARD_BEARER_RELEASED=1
	takeover_stage bearer_stop

	if ! read_eid_from_card "$REQUESTED_MODEM" "$TARGET_MODEM_SECTION"; then
		# A card that would not identify itself is an answer, not a crash, and
		# it is not stored: the next probe asks again rather than remembering a
		# refusal. `blocked` rather than `failed` for the same reason a refusal
		# elsewhere is -- nothing went wrong, the card did not say.
		OPERATION_REASON="$EID_CARD_REASON"
		CARD_BEARER_RELEASED=0
		takeover_restore_bearer_stop || :
		takeover_publish blocked "$EXIT_BLOCKED" \
			"the card did not identify itself with the bearer stopped"
		return "$EXIT_BLOCKED"
	fi
	probe_run_handle="$(endpoint_handle_from_eid "$ENDPOINT_EID" 2>/dev/null || :)"
	probe_run_suffix="$(suffix_of "$ENDPOINT_EID")"
	# Held no longer than it takes to derive a handle and a suffix, exactly as
	# the probe path holds it.
	ENDPOINT_EID=""
	[ -n "$probe_run_handle" ] || {
		OPERATION_REASON=eid-unreadable
		CARD_BEARER_RELEASED=0
		takeover_restore_bearer_stop || :
		takeover_publish blocked "$EXIT_BLOCKED" \
			"the card answered with something that is not an identifier"
		return "$EXIT_BLOCKED"
	}
	identity_record_store "$REQUESTED_MODEM" "$probe_run_generation" \
		"$probe_run_handle" "$probe_run_suffix" "$(identity_binding "$TARGET_MODEM_SECTION")"
	takeover_stage read

	# Restored here rather than by the trap, so the interface is up again
	# *before* the result says the operation finished. A reader who is told this
	# succeeded and then finds their connection still down has been told
	# something that is not yet true, and this is the one operation whose whole
	# cost to them is that connection.
	CARD_BEARER_RELEASED=0
	if ! takeover_restore_bearer_stop; then
		OPERATION_REASON=bearer_restore_failed
		takeover_publish failed "$EXIT_RETRYABLE" \
			"the card was identified but $probe_run_interface could not be started again"
		return "$EXIT_RETRYABLE"
	fi
	takeover_stage restore

	takeover_publish succeeded 0 \
		"the card was identified and this modem now has an endpoint"
	return 0
}

delete_plan_run_cmd() {
	[ -n "$REQUESTED_MODEM" ] || die_code "$EXIT_USAGE" "delete-plan-run requires --modem"
	[ -n "$REQUESTED_ENDPOINT" ] || die_code "$EXIT_USAGE" "delete-plan-run requires --endpoint"
	[ -n "$REQUESTED_OPERATION" ] || die_code "$EXIT_USAGE" "delete-plan-run requires --operation"
	[ -n "$REQUESTED_PROFILE" ] || die_code "$EXIT_USAGE" "delete-plan-run requires --profile"
	TAKEOVER_OPERATION_ID="$REQUESTED_OPERATION"
	OPERATION_ACTION=delete-plan
	OPERATION_PROFILE="$REQUESTED_PROFILE"
	TAKEOVER_STARTED="${APN_AUTOCONFIG_ESIM_STARTED:-$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)}"
	TAKEOVER_STATE_DIR="$(action_state_dir_for "$REQUESTED_MODEM")"
	TAKEOVER_START_LOCK="${APN_AUTOCONFIG_ESIM_START_LOCK:-}"
	TAKEOVER_PUBLISH_ARMED=1
	adopt_handoff_pid || {
		OPERATION_REASON=handoff_failed
		takeover_publish failed "$EXIT_RETRYABLE" \
			"the background worker handoff could not be verified"
		return "$EXIT_RETRYABLE"
	}
	takeover_publish_running || return "$EXIT_RETRYABLE"

	# Whatever the last plan left behind goes now, before any work begins.
	#
	# A plan job that dies -- and one did, to a SIGTERM two seconds in -- used
	# to leave the previous plan sitting in this file looking current. The
	# reader is bound to the operation id as well, so a stale file is refused
	# rather than served; this is the other half, so that there is nothing to
	# refuse. Failing to remove it is fatal to the job: continuing would leave
	# exactly the state this exists to prevent.
	plan_run_published="$(action_state_dir_for "$REQUESTED_MODEM")/delete-plan.json"
	rm -f "$plan_run_published" 2>/dev/null || :
	if [ -e "$plan_run_published" ]; then
		OPERATION_REASON=plan_unwritable
		takeover_publish failed "$EXIT_RETRYABLE" \
			"a previous plan could not be cleared, so this one did not run"
		return "$EXIT_RETRYABLE"
	fi

	# A plan taken while this runs is no longer silent. `TAKEOVER_INHIBIT_QUIET`
	# existed because a plan had no operation state to publish into; it has one
	# now, so a takeover taken in order to read the card is visible like any
	# other.
	plan_run_document="$TMP_BASE.plan-run"
	plan_run_status=0
	delete_plan_cmd >"$plan_run_document" 2>/dev/null || plan_run_status=$?

	# The token never leaves root. It is stripped here rather than by the
	# caller, because what this writes is a file a read wrapper serves to LuCI.
	( umask 077 && sed 's/,"token":"[0-9a-f]*"}$/}/' "$plan_run_document" \
		>"$plan_run_published" ) 2>/dev/null || {
		OPERATION_REASON=plan_unwritable
		takeover_publish failed "$EXIT_RETRYABLE" "the plan could not be recorded"
		return "$EXIT_RETRYABLE"
	}
	rm -f "$plan_run_document" 2>/dev/null || :

	if [ "$plan_run_status" -eq 0 ]; then
		takeover_publish succeeded 0 "the removal was planned and is waiting to be confirmed"
		return 0
	fi
	# A refusal is a result, not a crash: the document names which refusal it
	# was, and the page renders that sentence. The operation is `blocked`
	# rather than `failed` for the same reason the synchronous plan exits
	# `EXIT_BLOCKED` -- nothing went wrong, something was not permitted.
	takeover_publish blocked "$plan_run_status" "the removal was not planned"
	return "$plan_run_status"
}

# ---- the second step, which is the only way a deletion happens ----
#
# Not LuCI's dialog. LuCI's dialog is a courtesy to the person looking at it;
# this is the guarantee, and it holds for a CLI caller, a script and a mistake
# just the same.
#
# The token arrives on standard input and never as an argument. It is not a
# secret in the sense an activation code is, but it is a capability: a local
# process that reads it out of a process list within its lifetime can delete a
# subscription, so it gets the same channel a secret does.

DELETE_TOKEN_STDIN=0

delete_confirm_refuse() {
	printf '{'
	json_key_string version v1; printf ','
	json_key_boolean accepted 0; printf ','
	json_key_boolean busy 0; printf ','
	json_key_string reason "$1"; printf ','
	json_key_string message "$2"
	printf '}\n'
	return 0
}

delete_confirm_cmd() {
	[ "$DELETE_TOKEN_STDIN" -eq 1 ] || \
		die_code "$EXIT_USAGE" "delete-confirm reads its token on standard input; pass --token-stdin"
	[ "$CAPTURED_ALLOW_TAKEOVER" != invalid ] || \
		die_code "$EXIT_USAGE" "the takeover consent must be 0 or 1"
	delete_refuse_foreign_consents
	# The token carries the target. A confirm that also accepted one could be
	# pointed at a different profile than the one that was planned and shown.
	[ -z "$REQUESTED_MODEM" ] && [ -z "$REQUESTED_ENDPOINT" ] && [ -z "$REQUESTED_PROFILE" ] || \
		die_code "$EXIT_USAGE" "delete-confirm takes no target arguments; the token carries them"
	IFS= read -r confirm_token || confirm_token=""
	confirm_token="$(printf '%s' "$confirm_token" | tr -d ' \011\015\012')"
	delete_token_valid "$confirm_token" || \
		die_code "$EXIT_USAGE" "what arrived on standard input is not a delete token"

	# The claim, and it is the very first thing that happens to the filesystem:
	# before any lock, any read and any validation beyond parsing the token.
	# `rename` is atomic, so of two simultaneous confirms exactly one finds the
	# source still there -- which is the property that matters, because the
	# other outcome is two delete requests for one consent.
	confirm_dir="$(delete_token_dir)"
	confirm_claimed="$confirm_dir/$confirm_token.claimed.$SELF_PID"
	mv "$confirm_dir/$confirm_token" "$confirm_claimed" 2>/dev/null || {
		# Spent, or never issued. Deliberately one answer: distinguishing them
		# would tell a caller whether a token it guessed had ever existed.
		delete_confirm_refuse token_spent \
			"this token has already been used or was never issued; plan the deletion again"
		return "$EXIT_BLOCKED"
	}
	confirm_line="$(sed -n '1p' "$confirm_claimed" 2>/dev/null || :)"
	confirm_version="$(field "$confirm_line" 1)"
	[ "$confirm_version" = v1 ] || {
		rm -f "$confirm_claimed" 2>/dev/null || :
		delete_confirm_refuse token_unreadable "the delete token could not be read"
		return "$EXIT_BLOCKED"
	}
	confirm_operation="$(field "$confirm_line" 2)"
	REQUESTED_MODEM="$(field "$confirm_line" 3)"
	REQUESTED_ENDPOINT="$(field "$confirm_line" 4)"
	REQUESTED_PROFILE="$(field "$confirm_line" 5)"
	confirm_expiry="$(field "$confirm_line" 13)"
	case "$confirm_expiry" in ''|*[!0-9]*) confirm_expiry=0 ;; esac
	for confirm_value in "$confirm_operation" "$REQUESTED_MODEM" "$REQUESTED_ENDPOINT" \
		"$REQUESTED_PROFILE"; do
		safe_token "$confirm_value" || {
			rm -f "$confirm_claimed" 2>/dev/null || :
			delete_confirm_refuse token_unreadable "the delete token names an invalid target"
			return "$EXIT_BLOCKED"
		}
	done
	confirm_now="$(monotonic_seconds)" || confirm_now=""
	if [ -z "$confirm_now" ] || [ "$confirm_now" -gt "$confirm_expiry" ]; then
		# Spent either way. A token that has expired is not re-usable by waiting
		# for a clock to disagree, and the state it bound is exactly what a
		# deadline exists to stop being trusted.
		rm -f "$confirm_claimed" 2>/dev/null || :
		delete_confirm_refuse token_expired \
			"the delete plan has expired; plan the deletion again against the state that exists now"
		return "$EXIT_BLOCKED"
	fi

	[ -x "$ACTION_WORKER" ] || die "the action worker is not executable: $ACTION_WORKER"
	command_exists "$SETSID" || die_code "$EXIT_BLOCKED" "session isolation is unavailable; no job was started"
	action_status_values "$REQUESTED_MODEM"
	if [ "$ACTION_BUSY" = true ]; then
		# The token stays claimed. A deletion is not coalesced with whatever is
		# running and is not queued behind it: the user plans again once the
		# modem is free, against the state that exists then.
		rm -f "$confirm_claimed" 2>/dev/null || :
		delete_confirm_refuse modem_busy \
			"another operation holds this modem; plan the deletion again when it has finished"
		return "$EXIT_BLOCKED"
	fi
	TAKEOVER_STATE_DIR="$(action_state_dir_for "$REQUESTED_MODEM")"
	mkdir -p "$ACTION_STATE_DIR" || die "cannot create the action state parent"
	confirm_start_lock="${TAKEOVER_STATE_DIR}.start-lock"
	lock_try_acquire_or_reclaim "$confirm_start_lock"
	confirm_status=$?
	case "$confirm_status" in
		0) : ;;
		*)
			rm -f "$confirm_claimed" 2>/dev/null || :
			delete_confirm_refuse modem_busy "another operation is starting on this modem"
			return "$EXIT_BLOCKED"
		;;
	esac
	mkdir -p "$TAKEOVER_STATE_DIR" || {
		lock_release "$confirm_start_lock"
		die "cannot create the action state directory"
	}
	confirm_started="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)"
	# The operation id is published before the request is issued, and it is the
	# id the plan already showed. A caller that loses this answer resolves the
	# outcome with `action-status --operation`, and by nothing else: repeating
	# the confirm is impossible because the token is spent, and planning again
	# is a second deletion rather than a retry of this one.
	action_write_state "$TAKEOVER_STATE_DIR" starting delete "$$" \
		"$confirm_started" "" "" "starting background worker" "$REQUESTED_ENDPOINT" \
		"$confirm_operation" "" "" "$REQUESTED_PROFILE" "" \
		"$REQUESTED_MODEM" || die "cannot record the background operation"
	APN_AUTOCONFIG_ESIM_DELETE_RECORD="$confirm_claimed"
	APN_AUTOCONFIG_ESIM_DETACHED=launch
	export APN_AUTOCONFIG_ESIM_DELETE_RECORD APN_AUTOCONFIG_ESIM_DETACHED
	(
		exec "$SETSID" /bin/sh "$ACTION_WORKER" delete "$REQUESTED_MODEM" "$REQUESTED_ENDPOINT" \
			"$confirm_operation" "$confirm_started" "$confirm_start_lock" "$REQUESTED_PROFILE" ""
	) </dev/null >/dev/null 2>&1 &
	confirm_worker_pid=$!
	unset APN_AUTOCONFIG_ESIM_DELETE_RECORD APN_AUTOCONFIG_ESIM_DETACHED
	if ! wait_worker_handoff "$confirm_worker_pid" "$confirm_start_lock" "$confirm_operation"; then
		lock_release_if_ours "$confirm_start_lock"
		rm -f "$confirm_claimed" 2>/dev/null || :
		TAKEOVER_STATE_DIR=""
		action_status_values "$REQUESTED_MODEM"
		print_action_json 0 "$REQUESTED_MODEM"
		return "$EXIT_RETRYABLE"
	fi
	TAKEOVER_STATE_DIR=""
	action_status_values "$REQUESTED_MODEM"
	print_action_json 1 "$REQUESTED_MODEM"
	return 0
}

# Whether the card still lists the profile this operation was told to remove.
# Asked of the card rather than inferred from what the LPA returned, for the
# reason measured twice on this hardware: an APDU handler that gives up on an
# exchange the card completes makes the LPA's verdict evidence about the LPA.
DELETE_STILL_PRESENT=unknown

delete_observe_card() {
	DELETE_STILL_PRESENT=unknown
	delete_observe_file="$TMP_BASE.lpa-profiles"
	read_profiles_through_lpa "$1" "$2" "$3" "$4" "$delete_observe_file" || {
		log err 'the confirming read after the delete request failed'
		return 1
	}
	if awk -F '\t' -v handle="$REQUESTED_PROFILE" \
		'$1 == handle { found = 1 } END { exit found ? 0 : 1 }' "$delete_observe_file"; then
		DELETE_STILL_PRESENT=yes
	else
		DELETE_STILL_PRESENT=no
	fi
	return 0
}

# The endpoint the token names, once ModemManager has it again.
#
# Measured on the reference router 2026-09-01: `delete-plan` takes a bounded
# inhibit to read the card and hands the modem straight back, and a
# `delete-confirm` issued seconds later re-enumerated while ModemManager was
# still re-attaching -- no SIM object, no EID, no endpoint, and a deletion
# blocked with `endpoint_unavailable` for a card that was sitting right there.
# The switch already waits for exactly this and quotes 7 to 13 seconds; this
# waits on the same budget rather than turning a re-attachment into a refusal.
#
# It keeps the locks it holds. Levels 1 and 2 are this operation's for its whole
# life, and nothing about ModemManager re-enumerating a modem is helped by
# letting somebody else start an operation on it half way through.
delete_wait_for_endpoint() {
	delete_reattach_waited=0
	while :; do
		load_modem_records "$REQUESTED_MODEM" || return 1
		enumerate_endpoints
		TARGET_LINE="$(awk -F '\t' -v modem="$REQUESTED_MODEM" -v endpoint="$REQUESTED_ENDPOINT" '
			$3 == modem && $1 == endpoint { print; count++ }
			END { if (count != 1) exit 3 }
		' "$ENDPOINT_FILE")" && [ -n "$TARGET_LINE" ] && return 0
		[ "$delete_reattach_waited" -lt "$ESIM_REATTACH_WAIT_SECONDS" ] || return 1
		log notice "the endpoint has not come back yet; waiting for the modem to re-attach"
		"$SLEEP" 3 2>/dev/null || return 1
		delete_reattach_waited=$((delete_reattach_waited + 3))
	done
}

delete_run_cmd() {
	[ -n "$REQUESTED_MODEM" ] || die_code "$EXIT_USAGE" "delete-run requires --modem"
	[ -n "$REQUESTED_ENDPOINT" ] || die_code "$EXIT_USAGE" "delete-run requires --endpoint"
	[ -n "$REQUESTED_OPERATION" ] || die_code "$EXIT_USAGE" "delete-run requires --operation"
	[ -n "$REQUESTED_PROFILE" ] || die_code "$EXIT_USAGE" "delete-run requires --profile"
	# The claimed record is the capability. There is no path to a delete request
	# that does not carry one, which is what makes `delete-confirm` the single
	# entry point rather than merely the documented one.
	DELETE_CLAIMED_FILE="${APN_AUTOCONFIG_ESIM_DELETE_RECORD:-}"
	[ -n "$DELETE_CLAIMED_FILE" ] && [ -f "$DELETE_CLAIMED_FILE" ] || \
		die_code "$EXIT_USAGE" "delete-run requires a claimed delete plan"
	delete_line="$(sed -n '1p' "$DELETE_CLAIMED_FILE" 2>/dev/null || :)"
	[ "$(field "$delete_line" 1)" = v1 ] || die_code "$EXIT_USAGE" "the claimed delete plan is unreadable"
	delete_bound_operation="$(field "$delete_line" 2)"
	delete_bound_modem="$(field "$delete_line" 3)"
	delete_bound_endpoint="$(field "$delete_line" 4)"
	delete_bound_profile="$(field "$delete_line" 5)"
	delete_bound_state="$(field "$delete_line" 6)"
	delete_bound_generation="$(field "$delete_line" 7)"
	delete_bound_slot="$(field "$delete_line" 8)"
	delete_bound_slot_active="$(field "$delete_line" 9)"
	delete_bound_active_slot="$(field "$delete_line" 10)"
	delete_bound_owner="$(field "$delete_line" 11)"
	[ "$delete_bound_operation" = "$REQUESTED_OPERATION" ] && \
		[ "$delete_bound_modem" = "$REQUESTED_MODEM" ] && \
		[ "$delete_bound_endpoint" = "$REQUESTED_ENDPOINT" ] && \
		[ "$delete_bound_profile" = "$REQUESTED_PROFILE" ] || \
		die_code "$EXIT_USAGE" "the claimed delete plan does not name this operation"

	OPERATION_ACTION=delete
	OPERATION_PROFILE="$REQUESTED_PROFILE"
	TAKEOVER_OPERATION_ID="$REQUESTED_OPERATION"
	TAKEOVER_STARTED="${APN_AUTOCONFIG_ESIM_STARTED:-$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)}"
	TAKEOVER_STATE_DIR="$(action_state_dir_for "$REQUESTED_MODEM")"
	TAKEOVER_START_LOCK="${APN_AUTOCONFIG_ESIM_START_LOCK:-}"
	TAKEOVER_PUBLISH_ARMED=1
	adopt_handoff_pid || {
		OPERATION_REASON=handoff_failed
		takeover_publish failed "$EXIT_RETRYABLE" "the background worker handoff could not be verified"
		return "$EXIT_RETRYABLE"
	}
	takeover_publish_running || return "$EXIT_RETRYABLE"

	acquire_global_lock "$LOCK_WAIT_SECONDS" || {
		OPERATION_REASON=global_busy
		takeover_publish failed "$EXIT_RETRYABLE" "another operation holds the global lock"
		return "$EXIT_RETRYABLE"
	}
	acquire_modem_lock "$REQUESTED_MODEM" "$LOCK_WAIT_SECONDS" || {
		OPERATION_REASON=modem_busy
		takeover_publish failed "$EXIT_RETRYABLE" "another operation holds this modem"
		return "$EXIT_RETRYABLE"
	}
	takeover_stage acquire_locks
	APN_AUTOCONFIG_MODEM_LOCK_OWNER_PID=$SELF_PID
	export APN_AUTOCONFIG_MODEM_LOCK_OWNER_PID

	# Everything the plan bound is read again, from the device, after the locks
	# are held. Pre-lock validation alone is a time-of-check race, and this is
	# the operation where losing that race costs a subscription.
	if ! delete_wait_for_endpoint; then
		OPERATION_REASON=endpoint_unavailable
		takeover_publish blocked "$EXIT_BLOCKED" \
			"the endpoint is no longer present or is ambiguous; nothing was removed"
		return "$EXIT_BLOCKED"
	fi
	delete_section="$(modem_section_at "$(field "$TARGET_LINE" 19)")"
	delete_now_slot="$(field "$TARGET_LINE" 5)"
	[ -n "$delete_now_slot" ] || delete_now_slot=none
	delete_now_slot_active="$(field "$TARGET_LINE" 7)"
	[ -n "$delete_now_slot_active" ] || delete_now_slot_active=none
	delete_now_active_slot="$(section_field "$delete_section" slots 4)"
	[ -n "$delete_now_active_slot" ] || delete_now_active_slot=none
	delete_moved=""
	[ "$(field "$TARGET_LINE" 2)" = eid ] || delete_moved=evidence_tier
	[ -z "$delete_moved" ] && [ "$(field "$TARGET_LINE" 4)" != "$delete_bound_generation" ] && \
		delete_moved=attachment_generation
	[ -z "$delete_moved" ] && [ "$delete_now_slot" != "$delete_bound_slot" ] && delete_moved=slot
	[ -z "$delete_moved" ] && [ "$delete_now_slot_active" != "$delete_bound_slot_active" ] && \
		delete_moved=slot_active
	[ -z "$delete_moved" ] && [ "$delete_now_active_slot" != "$delete_bound_active_slot" ] && \
		delete_moved=active_slot
	[ -z "$delete_moved" ] && [ "$(field "$TARGET_LINE" 13)" != "$delete_bound_owner" ] && \
		delete_moved=owner_state
	if [ -n "$delete_moved" ]; then
		# The token is already spent, and that is the correct outcome: the plan
		# the user confirmed was about a different state. They plan again
		# against the one that exists now.
		OPERATION_REASON="changed_$delete_moved"
		takeover_publish blocked "$EXIT_BLOCKED" \
			"$delete_moved changed between the plan and the confirmation; no delete request was issued and nothing was removed"
		return "$EXIT_BLOCKED"
	fi
	delete_reachable="$(field "$TARGET_LINE" 14)"
	case "$delete_reachable" in yes|requires-inhibit|requires-bearer-stop) : ;;
		*)
			OPERATION_REASON=endpoint_unreachable
			takeover_publish blocked "$EXIT_BLOCKED" \
				"the endpoint no longer permits this operation; nothing was removed"
			return "$EXIT_BLOCKED"
		;;
	esac
	# Asked again, and asked before the modem is taken away from its owner:
	# under an inhibit the engine can no longer see which SIM is serving what.
	delete_in_use=0
	delete_profile_in_use || delete_in_use=$?
	if [ "$delete_in_use" -eq 0 ]; then
		OPERATION_REASON=profile_in_use
		takeover_publish blocked "$EXIT_BLOCKED" \
			"this profile is the subscription a target on this router is using; nothing was removed"
		return "$EXIT_BLOCKED"
	fi
	if [ "$delete_in_use" -eq 2 ]; then
		OPERATION_REASON=in_use_unknown
		takeover_publish blocked "$EXIT_BLOCKED" \
			"this operation could not find out whether the profile is the subscription something on this router is using; nothing was removed"
		return "$EXIT_BLOCKED"
	fi
	takeover_stage revalidate

	delete_owner="$(field "$TARGET_LINE" 13)"
	delete_candidates="$(esim_transport_candidates "$TARGET_LINE")"
	delete_bearer="$(esim_bearer_device "$TARGET_LINE")"
	delete_interface="$(section_field "$delete_section" interface 2)"
	if [ "$delete_reachable" = requires-inhibit ]; then
		delete_mm="$(section_field "$delete_section" mm 2)"
		case "$delete_mm" in ''|*[!0-9]*)
			OPERATION_REASON=modemmanager_unavailable
			takeover_publish blocked "$EXIT_BLOCKED" \
				"ModemManager does not name this modem; nothing was removed"
			return "$EXIT_BLOCKED"
		;; esac
		takeover_acquire_inhibit "$delete_mm" || return $?
		delete_owner=none
		delete_candidates="$(control_candidates "$delete_section" "" | tr '\n' ' ')"
		delete_bearer=""
		delete_owner=none
	elif [ "$delete_reachable" = requires-bearer-stop ]; then
		delete_stop_status=0
		takeover_acquire_bearer_stop "$delete_interface" || delete_stop_status=$?
		if [ "$delete_stop_status" -ne 0 ]; then
			takeover_publish failed "$delete_stop_status" \
				"the selected bearer could not be stopped for this operation; nothing was removed"
			return "$delete_stop_status"
		fi
		delete_owner=none
		delete_candidates="$(control_candidates "$delete_section" "" | tr '\n' ' ')"
		delete_bearer=""
		delete_owner=none
	fi
	if [ "$delete_reachable" != yes ] && [ -z "$delete_candidates" ]; then
		OPERATION_REASON=no_control_port
		takeover_publish failed "$EXIT_RETRYABLE" \
			"no control port could be resolved for this operation; nothing was removed"
		return "$EXIT_RETRYABLE"
	fi
	takeover_stage prepare

	# The last read before anything is destroyed, and the one that resolves the
	# public handle to the ICCID the LPA needs. Exactly one profile may match
	# and its state must still be what the plan bound, because a deletion is by
	# an exact identifier the caller named and the card confirmed -- never by
	# position, never by "the last one", never by a filter.
	delete_resolve_status=0
	resolve_profile_for_mutation "$REQUESTED_ENDPOINT" "$delete_owner" \
		"$delete_candidates" "$delete_bearer" || delete_resolve_status=$?
	if [ "$delete_resolve_status" -ne 0 ]; then
		OPERATION_REASON=profile_ambiguous
		takeover_publish blocked "$EXIT_BLOCKED" \
			"the profile could not be revalidated on the card; nothing was removed"
		return "$EXIT_BLOCKED"
	fi
	if [ "$RESOLVED_PROFILE_STATE" != "$delete_bound_state" ] || \
		[ "$RESOLVED_PROFILE_STATE" != disabled ]; then
		RESOLVED_PROFILE_ICCID=""
		OPERATION_REASON=changed_profile_state
		takeover_publish blocked "$EXIT_BLOCKED" \
			"the profile is no longer in the state the plan was made against; no delete request was issued"
		return "$EXIT_BLOCKED"
	fi

	cache_invalidate_endpoint "$REQUESTED_ENDPOINT"
	# What the card already owed its issuers before this operation touched it.
	# Everything that appears afterwards is this operation's to deliver, and
	# nothing else is: a notification an earlier operation left is that
	# operation's to explain.
	OPERATION_NOTIFICATIONS_BEFORE=""
	BRIDGE_UNVERIFIED_AUTHORITY=""
	if takeover_inhibit_still_held; then
		OPERATION_NOTIFICATIONS_BEFORE="$TMP_BASE.notify-before"
		notification_snapshot "$REQUESTED_ENDPOINT" "$delete_owner" \
			"$delete_candidates" "$delete_bearer" \
			"$OPERATION_NOTIFICATIONS_BEFORE" || OPERATION_NOTIFICATIONS_BEFORE=""
	fi

	delete_status=0
	bridge_run "$REQUESTED_ENDPOINT" "$delete_owner" "$delete_candidates" \
		"$delete_bearer" profile delete "$RESOLVED_PROFILE_ICCID" || delete_status=$?
	RESOLVED_PROFILE_ICCID=""
	if [ "$BRIDGE_IDENTITY_FAILED" -eq 1 ]; then
		takeover_publish blocked "$EXIT_BLOCKED" \
			"the physical card identity was not confirmed; no deletion was sent"
		return "$EXIT_BLOCKED"
	fi
	takeover_stage mutate
	delete_observe_status=0
	delete_observe_card "$REQUESTED_ENDPOINT" "$delete_owner" "$delete_candidates" \
		"$delete_bearer" || delete_observe_status=$?

	if [ "$DELETE_STILL_PRESENT" = yes ]; then
		OPERATION_MUTATE_STARTED=0
		if [ "$delete_status" -ne 0 ]; then
			OPERATION_REASON=delete_refused
			takeover_publish failed "$delete_status" \
				"the eUICC refused the deletion; the profile is still on the card and nothing was removed"
			return "$delete_status"
		fi
		# The LPA said it worked and the card still lists the profile. Neither
		# statement is discarded and the card is not overruled: this is
		# published as unfinished with both facts in it.
		OPERATION_REASON=delete_unconfirmed
		takeover_publish partial "$EXIT_PARTIAL" \
			"the LPA reported the deletion as done and the card still lists the profile; nothing further was attempted, and the card is the authority on what it holds"
		return "$EXIT_PARTIAL"
	fi
	if [ "$delete_observe_status" -ne 0 ] || [ "$DELETE_STILL_PRESENT" != no ]; then
		# The card could not be read back. A delete request was issued, so
		# saying "nothing happened" would be inventing an answer about the one
		# operation that cannot be undone.
		OPERATION_MUTATE_STARTED=0
		OPERATION_REASON=delete_card_unreadable
		takeover_publish partial "$EXIT_PARTIAL" \
			"the delete request was issued and this operation could not read the card back, so it cannot say whether the profile is gone or whether its issuer was told; read the endpoint and send any notification waiting there"
		return "$EXIT_PARTIAL"
	fi

	# The profile is gone. The other half of the operation is telling the
	# issuer, and until that happens the subscription is not free to be
	# reissued -- so it happens here, inside the same inhibit and the same
	# locks, before anything is reported.
	deliver_caused_notifications "$REQUESTED_ENDPOINT" "$delete_owner" \
		"$delete_candidates" "$delete_bearer" 0
	# The verdict of the delivery leg, not of the card work: the delete request
	# makes no HTTPS request of its own, so anything recorded here belongs to
	# the notification. A deletion is verified-only, so an unknown issuer is
	# always a retry the user may consent to -- through `notification-send`,
	# which is the verb that can still be repeated.
	OPERATION_TRANSPORT_SECURITY="$BRIDGE_TRANSPORT_SECURITY"
	if [ "$BRIDGE_HTTP_FAILURE" = tls_untrusted_issuer ]; then
		OPERATION_TRANSPORT_RETRY_ALLOWED=true
	else
		OPERATION_TRANSPORT_RETRY_ALLOWED=false
	fi
	OPERATION_MUTATE_STARTED=0
	takeover_release_prepare
	takeover_stage restore
	takeover_stage publish
	delete_terminal_result
	return $?
}

delete_terminal_result() {
	case "$OPERATION_NOTIFICATION_DELIVERY" in
		delivered)
			OPERATION_REASON=""
			takeover_publish succeeded 0 \
				"the profile was deleted and the SM-DP+ was told, so the subscription is free to be reissued; the delete notification was taken off the card only after the issuer accepted it"
			return 0
		;;
		delivered_unverified)
			# An acceptance nobody authenticated is not proof of delivery, and
			# for a deletion the cost of being wrong is a subscription that
			# exists nowhere. The notification stays on the card and this is
			# not called finished.
			OPERATION_REASON=delete_notification_unverified
			takeover_publish partial "$EXIT_PARTIAL" \
				"the profile was deleted and its delete notification was accepted over an explicitly unverified transport, so whatever answered cannot be shown to be the issuer; the notification is kept on the card and should be sent again when the issuer can be verified"
			return "$EXIT_PARTIAL"
		;;
		pending|partial)
			OPERATION_REASON=delete_unreported
			takeover_publish partial "$EXIT_PARTIAL" \
				"the profile was deleted but the SM-DP+ has NOT been told, so the operator still holds the subscription open and it cannot be reissued; the delete notification is still on the card and must be sent before this deletion is finished"
			return "$EXIT_PARTIAL"
		;;
		unknown)
			OPERATION_REASON=delete_report_unconfirmed
			takeover_publish partial "$EXIT_PARTIAL" \
				"the profile was deleted, but this operation could not read the card's pending notifications and so cannot say whether the SM-DP+ was told; read the endpoint and send anything still queued"
			return "$EXIT_PARTIAL"
		;;
	esac
	# `none`: nothing new appeared on the card. For an install that is a real
	# answer -- a profile asks for a notification or it does not. For a deletion
	# this operation cannot tell that apart from a card that has not published
	# the message yet, and it is measured that one transport does exactly that:
	# over AT the delete notification is invisible inside the inhibit the
	# deletion ran in and is waiting at the next read. Being wrong towards "it
	# is finished" leaves a subscription that exists nowhere, so this is never
	# a clean success.
	if [ "$BRIDGE_TRANSPORT" = at ]; then
		OPERATION_REASON=delete_notification_deferred
		takeover_publish partial "$EXIT_PARTIAL" \
			"the profile was deleted; on this transport the card does not publish its delete notification while the modem is held, so read the endpoint in a minute and send what is waiting there -- until the issuer is told, the subscription is not free to be reissued"
		return "$EXIT_PARTIAL"
	fi
	OPERATION_REASON=delete_notification_absent
	takeover_publish partial "$EXIT_PARTIAL" \
		"the profile was deleted and the card produced no delete notification for it; either this profile asked for none or it has not published one yet, and this operation cannot tell those apart -- read the endpoint and send anything waiting there"
	return "$EXIT_PARTIAL"
}

takeover_publish_running() {
	[ -n "$TAKEOVER_STATE_DIR" ] || return 0
	action_write_state "$TAKEOVER_STATE_DIR" running "$OPERATION_ACTION" "$SELF_PID" \
		"$TAKEOVER_STARTED" "" "" "taking a bounded inhibit" "$REQUESTED_ENDPOINT" \
		"$TAKEOVER_OPERATION_ID" "$TAKEOVER_STAGES" "$OPERATION_REASON" \
		"$OPERATION_PROFILE" "$OPERATION_SEQUENCE" "$REQUESTED_MODEM" || return "$EXIT_RETRYABLE"
	return 0
}

# Takes the inhibit, or adopts one that is already held, and proves that
# ownership actually moved rather than assuming the request was atomic.
#
# A refusal here is normally the end of the operation, so it publishes the
# terminal result itself. A switch takes a second, short inhibit after it has
# already changed the card, and there a refusal is not the whole story: the
# result has to say what was changed as well as what could not be finished. So
# the publish is separable, and `TAKEOVER_INHIBIT_QUIET` is what separates it --
# the reason is set either way, and the caller that asked for silence owes its
# own terminal result.
TAKEOVER_INHIBIT_QUIET=0
# Which bound this phase's inhibit is held under. Resolved in load_config,
# never here: a value frozen at parse time would be the built-in default and
# would quietly ignore the configured one.
TAKEOVER_INHIBIT_BOUND=""

# The other takeover mechanism.
#
# Where a modem is on `netifd-direct` and the bearer holds the only control
# channel there is, the card cannot be reached without stopping that bearer.
# `mbim-contract-v1.md` forbids disturbing a control session netifd opened for a
# live bearer, and an APDU exchange is not gentler than an identity query -- so
# the answer is not to take the channel from underneath netifd, but to ask
# netifd to let go of it, and to give it back.
#
# It is the same shape as the inhibit and obeys the same rules: consented, taken
# after the full lock set is held, restored before the locks are on every exit
# path including `HUP`, `INT` and `TERM`, and armed *before* the tear-down so a
# signal in the gap cannot leave an interface down with nothing to bring it up.
TAKEOVER_BEARER_STOPPED=""
TAKEOVER_BEARER_AUTOSTART=false
TAKEOVER_BEARER_RESTORE_FAILED=0

# Set once a bearer has actually been stopped for this process, so that the card
# read stops excluding the node it was holding. The exclusion is by
# configuration rather than by observation -- a modem's AT device is reported as
# the bearer's whenever an interface is configured on it, up or down -- so
# without this the operation that frees the port would free it and then decline
# to use it.
#
# The mutation paths say the same thing by recomputing their candidates with an
# empty bearer after the stop. The card read computes its own from the section,
# so it has to be told.
CARD_BEARER_RELEASED=0

takeover_read_bearer_state() {
	# The modem layer owns the proof; a missing or malformed answer is never
	# treated as permission to use a control channel.
	stop_state_interface="$1"
	if [ "${2:-0}" = 1 ]; then
		[ "$MODEM_LOCK_HELD" -eq 1 ] && [ -n "$REQUESTED_MODEM" ] || return 1
		# Only the post-ifdown phase may ask for a physical inactive-PDP
		# proof. Bound the complete discovery/AT helper as well as its I/O.
		run_bounded_to_file 45 "$TMP_BASE.bearer-state" "$MODEM_BIN" \
			bearer-state --interface "$stop_state_interface" --modem "$REQUESTED_MODEM" --probe || return 1
	else
		run_bounded_to_file 7 "$TMP_BASE.bearer-state" "$MODEM_BIN" \
			bearer-state --interface "$stop_state_interface" || return 1
	fi
	stop_state="$(cat "$TMP_BASE.bearer-state")"
	[ "$(json_query "$stop_state" '@.version')" = v1 ] || return 1
	[ "$(json_query "$stop_state" '@.interface')" = "$stop_state_interface" ] || return 1
	STOP_AUTOSTART="$(json_query "$stop_state" '@.autostart')"
	STOP_QUIESCENT="$(json_query "$stop_state" '@.quiescent')"
	case "$STOP_AUTOSTART:$STOP_QUIESCENT" in
		true:true|true:false|false:true|false:false) : ;;
		*) return 1 ;;
	esac
}

takeover_acquire_bearer_stop() {
	stop_interface="$1"
	case "$stop_interface" in ''|*[!A-Za-z0-9_]*)
		OPERATION_REASON=no_interface
		return "$EXIT_BLOCKED"
	;; esac
	command_exists "$IFDOWN" && command_exists "$IFUP" || {
		OPERATION_REASON=netifd_unavailable
		return "$EXIT_BLOCKED"
	}
	takeover_read_bearer_state "$stop_interface" || {
		OPERATION_REASON=bearer_state_unknown
		return "$EXIT_RETRYABLE"
	}
	# Arm before ifdown. autostart is netifd's runtime administrative intent,
	# including an explicit disconnect; a configured interface is not consent
	# to bring it up after this operation.
	TAKEOVER_BEARER_AUTOSTART="$STOP_AUTOSTART"
	TAKEOVER_BEARER_STOPPED="$stop_interface"
	log notice "stopping $stop_interface for the duration of this operation"
	if ! run_bounded_to_file "$ESIM_BEARER_STOP_SECONDS" "$TMP_BASE.bounded" \
		"$IFDOWN" "$stop_interface"; then
		OPERATION_REASON=bearer_stop_failed
		return "$EXIT_RETRYABLE"
	fi
	stop_deadline=$(($(date +%s) + ESIM_BEARER_STOP_SECONDS))
	while :; do
		takeover_read_bearer_state "$stop_interface" 1 || {
			OPERATION_REASON=bearer_state_unknown
			return "$EXIT_RETRYABLE"
		}
		[ "$STOP_QUIESCENT:$STOP_AUTOSTART" != true:false ] || return 0
		[ "$(date +%s)" -lt "$stop_deadline" ] || {
			OPERATION_REASON=bearer_teardown_unconfirmed
			return "$EXIT_RETRYABLE"
		}
		"$SLEEP" 1 2>/dev/null || return "$EXIT_RETRYABLE"
	done
}

takeover_restore_bearer_stop() {
	card_probe_deadline_cancel
	[ -n "$TAKEOVER_BEARER_STOPPED" ] || return 0
	stop_restore="$TAKEOVER_BEARER_STOPPED"
	TAKEOVER_BEARER_STOPPED=""
	if [ "$TAKEOVER_BEARER_AUTOSTART" = false ]; then
		log notice "left $stop_restore administratively down as it was before the operation"
		return 0
	fi
	if run_bounded_to_file "$ESIM_BEARER_STOP_SECONDS" "$TMP_BASE.bounded" \
		"$IFUP" "$stop_restore" && takeover_read_bearer_state "$stop_restore" && \
		[ "$STOP_AUTOSTART" = true ]; then
		log notice "restored $stop_restore's connection request"
		return 0
	fi
	TAKEOVER_BEARER_RESTORE_FAILED=1
	OPERATION_REASON=bearer_restore_failed
	log err "could not restore $stop_restore after the operation"
	return 1
}

takeover_inhibit_refused() {
	OPERATION_REASON="$1"
	[ "$TAKEOVER_INHIBIT_QUIET" -eq 1 ] && return 0
	takeover_publish "$2" "$3" "$4"
	return 0
}

takeover_acquire_inhibit() {
	inhibit_index="$1"
	command_exists "$MMCLI" || {
		takeover_inhibit_refused modemmanager_absent blocked "$EXIT_BLOCKED" \
			"ModemManager is not installed"
		return "$EXIT_BLOCKED"
	}
	# Background operations already have this directory and public operation id.
	# A synchronous destructive plan may also take a short inhibit, and before
	# A13 it needed neither. Give that holder the same recoverable lease without
	# pretending the plan itself is a background operation.
	if [ -z "$TAKEOVER_STATE_DIR" ]; then
		TAKEOVER_STATE_DIR="$(action_state_dir_for "$REQUESTED_MODEM")"
	fi
	( umask 077 && mkdir -p "$TAKEOVER_STATE_DIR" ) 2>/dev/null || {
		takeover_inhibit_refused inhibit_state_failed failed "$EXIT_RETRYABLE" \
			"the inhibit state directory could not be created safely"
		return "$EXIT_RETRYABLE"
	}
	if [ -z "$TAKEOVER_OPERATION_ID" ]; then
		TAKEOVER_OPERATION_ID="lease-$(date -u +%s 2>/dev/null || printf '%s' 0)-$SELF_PID"
	fi
	# An inhibit this package did not create is reused, never stopped.
	# Provisioning owns a long-lived one for a modem it dials over AT, and
	# releasing it would hand that modem back to ModemManager underneath a live
	# dial. Adopting it also means this operation's cleanup must not touch it,
	# which is what TAKEOVER_INHIBIT_CREATED records.
	inhibit_targets="$TMP_BASE.bounded"
	if run_read_bounded inhibit-targets 5 "$inhibit_targets" "$MODEM_BIN" inhibit-targets; then
		if awk -F '\t' -v modem="$REQUESTED_MODEM" \
			'$2 == modem { found = 1 } END { exit found ? 0 : 1 }' "$inhibit_targets"; then
			log notice "reusing an inhibit another component already holds"
			TAKEOVER_INHIBIT_CREATED=0
			TAKEOVER_INHIBIT_LEASE="$TAKEOVER_STATE_DIR/inhibit.tsv"
			inhibit_lease_write_adopted "$TAKEOVER_STATE_DIR" "$TAKEOVER_OPERATION_ID" \
				"$REQUESTED_MODEM" || {
				takeover_inhibit_refused inhibit_state_failed failed "$EXIT_RETRYABLE" \
					"the adopted inhibit could not be recorded safely"
				return "$EXIT_RETRYABLE"
			}
			return 0
		fi
	fi

	inhibit_uid="$(takeover_device_uid "$inhibit_index")"
	case "$inhibit_uid" in
		/sys/*) : ;;
		*)
			takeover_inhibit_refused no_device_path blocked "$EXIT_BLOCKED" \
				"the modem has no usable device path to inhibit"
			return "$EXIT_BLOCKED"
		;;
	esac

	[ -x "$INHIBIT_HELPER" ] || {
		takeover_inhibit_refused inhibit_helper_absent failed "$EXIT_RETRYABLE" \
			"the bounded inhibit helper is not executable"
		return "$EXIT_RETRYABLE"
	}
	inhibit_mmcli="$(command -v "$MMCLI" 2>/dev/null || :)"
	[ -n "$inhibit_mmcli" ] || {
		takeover_inhibit_refused modemmanager_absent blocked "$EXIT_BLOCKED" \
			"ModemManager is not installed"
		return "$EXIT_BLOCKED"
	}
	inhibit_worker_birth="$(process_birth "$SELF_PID" 2>/dev/null || :)"
	[ -n "$inhibit_worker_birth" ] || {
		takeover_inhibit_refused inhibit_identity_failed failed "$EXIT_RETRYABLE" \
			"the operation could not record its process identity"
		return "$EXIT_RETRYABLE"
	}

	# The helper writes the durable lease itself before exec turns it into mmcli.
	# That closes the SIGKILL gap between fork and a parent-side PID assignment.
	TAKEOVER_INHIBIT_CREATED=1
	TAKEOVER_INHIBIT_LEASE="$TAKEOVER_STATE_DIR/inhibit.tsv"
	rm -f "$TAKEOVER_INHIBIT_LEASE" 2>/dev/null || :
	"$INHIBIT_HELPER" "$TAKEOVER_INHIBIT_LEASE" "$TAKEOVER_OPERATION_ID" \
		"$REQUESTED_MODEM" "$inhibit_uid" "$SELF_PID" "$inhibit_worker_birth" \
		"$TAKEOVER_INHIBIT_BOUND" "$inhibit_mmcli" "$SLEEP" >/dev/null 2>&1 &
	TAKEOVER_INHIBIT_PID=$!
	log notice "taking a bounded inhibit for $(mask_modem_id "$REQUESTED_MODEM")"

	# Wait for the child-authored lease. The holder PID is the helper PID and is
	# preserved by exec; the watchdog identity comes from the same atomic record.
	inhibit_lease_waited=0
	while [ "$inhibit_lease_waited" -lt 5 ]; do
		inhibit_lease_line="$(sed -n '1p' "$TAKEOVER_INHIBIT_LEASE" 2>/dev/null || :)"
		if [ "$(field "$inhibit_lease_line" 8)" = "$TAKEOVER_INHIBIT_PID" ] && \
			[ "$(field "$inhibit_lease_line" 3)" = "$TAKEOVER_OPERATION_ID" ]; then
			TAKEOVER_WATCHDOG_PID="$(field "$inhibit_lease_line" 10)"
			break
		fi
		process_is_alive "$TAKEOVER_INHIBIT_PID" || break
		"$SLEEP" 1 2>/dev/null || break
		inhibit_lease_waited=$((inhibit_lease_waited + 1))
	done
	if [ -z "$TAKEOVER_WATCHDOG_PID" ]; then
		reap_child "$TAKEOVER_INHIBIT_PID" KILL
		wait "$TAKEOVER_INHIBIT_PID" 2>/dev/null || :
		rm -f "$TAKEOVER_INHIBIT_LEASE" 2>/dev/null || :
		TAKEOVER_INHIBIT_PID=""
		TAKEOVER_INHIBIT_CREATED=0
		takeover_inhibit_refused inhibit_state_failed failed "$EXIT_RETRYABLE" \
			"the bounded inhibit could not publish a recoverable lease"
		return "$EXIT_RETRYABLE"
	fi

	# ModemManager may win the race, exactly as it may in provisioning. This
	# verifies that ownership actually moved instead of assuming the request
	# took effect the moment it was made.
	inhibit_waited=0
	while [ "$inhibit_waited" -lt "$TAKEOVER_INHIBIT_BOUND" ]; do
		if ! process_is_alive "$TAKEOVER_INHIBIT_PID"; then
			takeover_inhibit_refused inhibit_refused failed "$EXIT_RETRYABLE" \
				"the inhibit was refused or ended immediately"
			return "$EXIT_RETRYABLE"
		fi
		inhibit_probe="$TMP_BASE.bounded"
		if ! run_bounded_to_file 5 "$inhibit_probe" \
			"$MMCLI" -m "$inhibit_index" --output-keyvalue; then
			# ModemManager no longer has the modem, which is the observable
			# consequence of the inhibition rather than a report of it.
			return 0
		fi
		"$SLEEP" 1 2>/dev/null || break
		inhibit_waited=$((inhibit_waited + 1))
	done
	takeover_inhibit_refused ownership_unmoved failed "$EXIT_RETRYABLE" \
		"ownership did not move within the inhibit bound"
	return "$EXIT_RETRYABLE"
}

# ModemManager matches an inhibition against the stable physical device path it
# publishes, so it is read from ModemManager rather than derived from sysfs by
# this package.
takeover_device_uid() {
	uid_file="$TMP_BASE.bounded"
	run_bounded_to_file 8 "$uid_file" "$MMCLI" -m "$1" --output-keyvalue || return 1
	awk -F ':' '
		{
			key = $1
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
			if (key != "modem.generic.physdev") next
			$1 = ""
			sub(/^:[[:space:]]*/, "", $0)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
			if ($0 == "--" || $0 == "unknown") next
			print $0
			exit
		}
	' "$uid_file" 2>/dev/null || :
}

# The release, as a step rather than as cleanup, so a successful operation
# hands the modem back before it reports that it finished.
takeover_rollback_inhibit() {
	if [ -n "$TAKEOVER_WATCHDOG_PID" ]; then
		reap_child "$TAKEOVER_WATCHDOG_PID" TERM
		wait "$TAKEOVER_WATCHDOG_PID" 2>/dev/null || :
		TAKEOVER_WATCHDOG_PID=""
	fi
	if [ "$TAKEOVER_INHIBIT_CREATED" -ne 1 ]; then
		[ -z "$TAKEOVER_INHIBIT_LEASE" ] || rm -f "$TAKEOVER_INHIBIT_LEASE" 2>/dev/null || :
		TAKEOVER_INHIBIT_LEASE=""
		return 0
	fi
	reap_child "$TAKEOVER_INHIBIT_PID" TERM
	"$SLEEP" 1 2>/dev/null || :
	reap_child "$TAKEOVER_INHIBIT_PID" KILL
	wait "$TAKEOVER_INHIBIT_PID" 2>/dev/null || :
	TAKEOVER_INHIBIT_PID=""
	TAKEOVER_INHIBIT_CREATED=0
	[ -z "$TAKEOVER_INHIBIT_LEASE" ] || rm -f "$TAKEOVER_INHIBIT_LEASE" 2>/dev/null || :
	TAKEOVER_INHIBIT_LEASE=""
	log notice "released the read takeover inhibit for $(mask_modem_id "$REQUESTED_MODEM")"
	return 0
}

# The release of whichever mechanism this operation used, as a step rather than
# as cleanup, so a successful operation hands everything back before it reports
# that it finished.
takeover_release_prepare() {
	BRIDGE_KEEP_TRANSPORT=0
	cleanup_bridge
	release_read_locks
	takeover_rollback_inhibit
	takeover_restore_bearer_stop || :
	return 0
}

usage() {
	cat <<EOF
Usage: $PROG <command> [--modem <modem_id>] [--endpoint <endpoint_id>]
                       [--profile <profile_id>] [--refresh]

Read-only commands. None of them writes, opens a channel it does not release,
or changes a slot, a profile, a bearer or a control owner:

  capabilities-json    What this installation can do, and what is merely
  trust-store-json     Consumer CI roots carried by the ES9+ transport
                       described. Runtime capability, implementation maturity
                       and validation evidence are three separate fields
  esim-inventory-json  Every eUICC endpoint this router can see, which modem
                       and slot it is in, whether it can be reached right now
                       and if not what would have to change. Optionally for one
                       --modem
  esim-status-json     One endpoint, with the counts a read can obtain;
                       requires --modem and --endpoint
  profiles-json        The subscriptions on one endpoint; requires --modem and
                       --endpoint
  notifications-json   The pending RSP notifications on one endpoint; requires
                       --modem and --endpoint
  read-takeover-plan   What a consented read takeover would do, what it would
                       interrupt and for how long. Requires --modem and
                       --endpoint
  card-probe-plan      What a consented card probe would do on a modem whose
                       only answering port is its own bearer's. Requires
                       --modem, and refuses --endpoint: it exists to find out
                       whether there is one
  switch-plan          What enabling, disabling or a slot change would do,
                       what it would interrupt, for how long, and whether it
                       could be undone. Requires --modem, --endpoint and
                       --action

Guarded deletion, which is the only irreversible thing here:

  delete-plan          What deleting one profile would destroy, and a token
                       that authorises exactly that deletion and no other.
                       Requires --modem, --endpoint and --profile. It reads the
                       card rather than the cache, so on a modem ModemManager
                       owns it needs one bounded inhibit, and it refuses with
                       takeover_required until APN_ESIM_ALLOW_TAKEOVER=1 is set
                       in the request environment
  delete-confirm       Performs the deletion the token names. The token is read
                       from standard input and never from an argument; pass
                       --token-stdin. It is single-use, and a second confirm
                       cannot repeat the first

  A deletion is only half finished when the profile is gone: the issuer learns
  the subscription is free to be reissued from a notification the eUICC
  produces afterwards, and until that arrives the subscription exists nowhere.
  So a deletion whose issuer was not told is reported as unfinished business
  with the notification still on the card, never as a completed deletion.

Operations:

  action-start <action> --modem <id> --endpoint <id>
                       [--profile <id>] [--sequence <n>]
  action-status (--modem <id> | --operation <id>)

  enable and disable name one --profile; switch names one --slot. All three
  change which subscription the router is on, so each recovers the APN for the
  new one and puts the previous state back if it cannot.

--refresh bypasses the cache and is reachable from a deliberate user action,
never from a poll.
EOF
}

main() {
	# First, before `rm`, inventory, logging or any other child can inherit the
	# request environment. The values remain unexported shell variables until a
	# root-only descriptor has been prepared for the accepted download.
	capture_request_inputs
	# Before anything of ours exists under these names, and on every entry
	# point, because the interrupted run that left them may have been started
	# from any of them.
	sweep_dead_scratch_files
	COMMAND_NAME="${1:-}"
	[ "$#" -eq 0 ] || shift
	case "$COMMAND_NAME" in -h|--help|help|'') usage; return 0 ;; esac
	command_argument=""
	case "$COMMAND_NAME" in
		action-start) command_argument="${1:-}"; [ "$#" -eq 0 ] || shift ;;
	esac
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--modem)
				[ "$#" -ge 2 ] || die_code "$EXIT_USAGE" "--modem needs a value"
				REQUESTED_MODEM="$2"; shift 2
			;;
			--endpoint)
				[ "$#" -ge 2 ] || die_code "$EXIT_USAGE" "--endpoint needs a value"
				REQUESTED_ENDPOINT="$2"; shift 2
			;;
			--profile)
				[ "$#" -ge 2 ] || die_code "$EXIT_USAGE" "--profile needs a value"
				REQUESTED_PROFILE="$2"; shift 2
			;;
			--sequence)
				[ "$#" -ge 2 ] || die_code "$EXIT_USAGE" "--sequence needs a value"
				REQUESTED_SEQUENCE="$2"; shift 2
			;;
			--action)
				[ "$#" -ge 2 ] || die_code "$EXIT_USAGE" "--action needs a value"
				REQUESTED_ACTION="$2"; shift 2
			;;
			--operation)
				[ "$#" -ge 2 ] || die_code "$EXIT_USAGE" "--operation needs a value"
				REQUESTED_OPERATION="$2"; shift 2
			;;
			--refresh) REQUESTED_REFRESH=1; shift ;;
			# A flag, never a value. The token itself arrives on standard input
			# because a capability that can destroy a subscription must not be
			# in a world-readable command line.
			--token-stdin) DELETE_TOKEN_STDIN=1; shift ;;
			*) die_code "$EXIT_USAGE" "unexpected argument: $1" ;;
		esac
	done
	# A secret is refused as an argument, never sanitised: by the time it could
	# be stripped the value has already been in this process's world-readable
	# command line, and removing it afterwards would hide the leak rather than
	# prevent it.
	for main_argument in "$REQUESTED_MODEM" "$REQUESTED_ENDPOINT" "$REQUESTED_PROFILE" \
		"$REQUESTED_SEQUENCE" "$REQUESTED_ACTION" "$command_argument"; do
		case "$main_argument" in
			LPA:*|*'$'*'$'*)
				die_code "$EXIT_USAGE" \
					'a secret was passed as an argument; pass it in the environment instead'
			;;
		esac
	done
	load_config
	validate_config
	# Repair only a lease this package created and whose exact worker identity is
	# gone. This runs before endpoint resolution: while an orphaned inhibit is
	# held, ModemManager cannot publish the endpoint a successor would resolve.
	recover_orphan_inhibits
	( umask 077 && mkdir -p "$STATE_DIR" ) 2>/dev/null || :
	for main_token in "$REQUESTED_MODEM" "$REQUESTED_ENDPOINT" "$REQUESTED_PROFILE"; do
		[ -n "$main_token" ] || continue
		safe_token "$main_token" || die_code "$EXIT_USAGE" "invalid identity argument"
	done
	case "$REQUESTED_SEQUENCE" in ''|*[!0-9]*)
		[ -z "$REQUESTED_SEQUENCE" ] || die_code "$EXIT_USAGE" "invalid notification sequence"
	;; esac
	case "$REQUESTED_ACTION" in
		''|download|nickname|notification-send|notification-remove) : ;;
		enable|disable) : ;;
		*) die_code "$EXIT_USAGE" "invalid internal action" ;;
	esac
	case "$COMMAND_NAME" in
		capabilities-json) capabilities_json_cmd ;;
		trust-store-json) trust_store_json_cmd ;;
		esim-inventory-json) esim_inventory_json_cmd ;;
		esim-status-json) esim_status_json_cmd ;;
		profiles-json) profiles_json_cmd ;;
		notifications-json) notifications_json_cmd ;;
		read-takeover-plan) read_takeover_plan_cmd ;;
		card-probe-plan) card_probe_plan_cmd ;;
		switch-plan) switch_plan_cmd ;;
		delete-plan) delete_plan_cmd ;;
		card-probe-run) card_probe_run_cmd ;;
		delete-plan-run) delete_plan_run_cmd ;;
		delete-plan-result) delete_plan_result_cmd ;;
		delete-confirm) delete_confirm_cmd ;;
		action-start) action_start_cmd "$command_argument" ;;
		action-status) action_status_cmd ;;
		# Internal. Reached only by this package's own worker, never by a
		# wrapper: neither LuCI-facing script knows the verb exists.
		takeover-run) takeover_run_cmd ;;
		mutation-run) mutation_run_cmd ;;
		switch-run) switch_run_cmd ;;
		delete-run) delete_run_cmd ;;
		*) usage >&2; exit "$EXIT_USAGE" ;;
	esac
}

main "$@"
