OLD_ALLOWEDAUTH_SET=0
OLD_ALLOWEDAUTH=""
OLD_IPTYPE_SET=0
OLD_IPTYPE=""
LOCK_HELD=0
LOCK_BORROWED=0
MODEM_POWER_OFF_ARMED=0
INTERFACE_RESTORE_ARMED=0
LEAVE_INTERFACE_DOWN=0
SETTLE_SLEEP_PID=""
# The per-target child of a run that covers every managed target.
FANOUT_CHILD_PID=""
BOUNDED_CHILD_PID=""
BOUNDED_WATCHDOG_PID=""
MODEM_COORDINATOR_ID=""

MODEM_STATE="unknown"
REGISTRATION_STATE="unknown"
ROAMING_STATUS="unknown"
SERVING_OPERATOR_ID=""
SERVING_OPERATOR_NAME=""
ACCESS_TECHNOLOGIES=""
SIGNAL_QUALITY=""
ROAMING_POLICY="default-allow"
ROAMING_ALLOWED=true
CONFIGURED_PLMN=""

# The identity of the SIM behind the selected target. Declared here rather than
# only where it is read, because the read path can now print a document without
# having reached the read that fills these in.
ICCID=""
IMSI=""
EID=""
OPERATOR_ID=""
OPERATOR_NAME=""
GID1=""
GID2=""
DATABASE_VERSION=""
DATABASE_FORMAT=""
DATABASE_SOURCES=""
DATABASE_REVISIONS=""

# The read deadline, armed only by status-json, detect-json and targets-json.
# Unarmed, every call below behaves exactly as it did before this existed, which
# is what keeps the mutation paths and a fast backend's documents unchanged.
READ_DEADLINE_AT=""
READ_INCOMPLETE=0
READ_INCOMPLETE_READS=""
READ_INCOMPLETE_EMITTER=""

# What the last terminal result was about, and whether it is about now.
RESULT_SCOPE_RESOLVED=0
RESULT_SCOPE_MODEM_ID=""
RESULT_SCOPE_GENERATION=""
RESULT_STATE="unknown"
RESULT_STALE_REASON="no-scope"
RESULT_SCOPE_RECORDED_GENERATION=""
RESULT_SCOPE_ICCID_KNOWN=false

# Masks a subscriber or hardware identifier down to its last four characters for
# anything that leaves this process as text a human may forward: a log line, an
# error message, a support bundle. `logread` is readable by anything on the box
# that can run it and its output is routinely pasted into issue trackers, so a
# full ICCID in a notice is a disclosure even though the state file that holds
# the same value is root-only.
#
# Four trailing characters is this project's one masking convention, not a new
# one invented here: it is what `maskedIdentifier` renders in the LuCI view and
# what the eSIM contract publishes as `iccid_suffix` and `eid_suffix`. A masked
# log line and the page therefore show the same tail, so an operator can still
# tell two SIMs apart and match a log line to what the UI is showing.
#
# A value short enough that the suffix would be the whole value is elided
# completely rather than published in full.
mask_identifier() {
	mask_value="${1:-}"
	if [ -z "$mask_value" ]; then
		printf '<unknown>'
	elif [ "${#mask_value}" -le 4 ]; then
		printf '...'
	else
		printf '...%s' "${mask_value#"${mask_value%????}"}"
	fi
}

log() {
	level="$1"
	shift
	message="$*"
	case "$level" in warning) priority="warn" ;; *) priority="$level" ;; esac
	logger -t "$PROG" -p "user.$priority" -- "$message" 2>/dev/null || :
	printf '%s: %s\n' "$PROG" "$message" >&2
}

die() {
	log err "$*"
	exit 1
}

die_code() {
	code="$1"
	shift
	# A read that ran out of time is not an error to report instead of an
	# answer. The contract requires the command to return what it did obtain,
	# name what it abandoned and exit 3, so the retryable class is handed to the
	# command's own document printer when one is registered.
	#
	# Only the three LuCI-facing read commands register one, and only while a
	# deadline is armed and something has actually been abandoned. Every other
	# failure, and every other exit class, still ends the command with nothing
	# on stdout, exactly as before.
	if [ "$code" = 3 ] && [ "$READ_INCOMPLETE" -eq 1 ] && [ -n "$READ_INCOMPLETE_EMITTER" ]; then
		incomplete_emitter="$READ_INCOMPLETE_EMITTER"
		READ_INCOMPLETE_EMITTER=""
		log warning "$*"
		"$incomplete_emitter"
		exit 3
	fi
	log err "$*"
	exit "$code"
}

cleanup_files() {
	if [ -n "$BOUNDED_WATCHDOG_PID" ]; then
		kill -TERM "$BOUNDED_WATCHDOG_PID" 2>/dev/null || :
		wait "$BOUNDED_WATCHDOG_PID" 2>/dev/null || :
		BOUNDED_WATCHDOG_PID=""
	fi
	if [ -n "$BOUNDED_CHILD_PID" ]; then
		kill -TERM "$BOUNDED_CHILD_PID" 2>/dev/null || :
		wait "$BOUNDED_CHILD_PID" 2>/dev/null || :
		BOUNDED_CHILD_PID=""
	fi
	for tmp_suffix in $TMP_SUFFIXES; do
		rm -f "$TMP_BASE.$tmp_suffix"
	done
	if [ "$LOCK_HELD" -eq 1 ]; then
		lock_release "$LOCK_DIR"
		LOCK_HELD=0
	fi
}

# No trap can cover SIGKILL, so a scratch file can always outlive the process
# that created it: rpcd SIGKILLs a LuCI helper that exceeds its exec timeout
# (30s by default), and the OOM killer asks nobody either. /tmp is RAM on the
# target, so the next run removes what a provably dead predecessor left instead
# of leaving it there until the next reboot.
#
# The glob only finds candidates. Every path this removes is one the function
# rebuilt itself from a validated PID and a known suffix, because /tmp is shared
# with the rest of the system and a wildcard removal there is exactly what this
# project forbids for its lock and state roots. A file whose PID is still alive
# is left alone: it belongs either to a concurrent apn-autoconfig or to an
# unrelated process that was given the same number, and neither is ours to
# delete.
sweep_dead_scratch_files() {
	# Deletion is the half that has to be careful, so an unusable scratch
	# directory sweeps nothing rather than resolving names against the working
	# directory.
	case "$TMP_DIR" in /*) : ;; *) return 0 ;; esac
	[ -d "$TMP_DIR" ] || return 0
	sweep_count=0
	for sweep_suffix in $TMP_SUFFIXES; do
		for sweep_path in "$TMP_DIR/$PROG."[0-9]*".$sweep_suffix"; do
			[ -e "$sweep_path" ] || continue
			sweep_pid="${sweep_path##*/}"
			sweep_pid="${sweep_pid#"$PROG."}"
			sweep_pid="${sweep_pid%".$sweep_suffix"}"
			case "$sweep_pid" in ''|*[!0-9]*) continue ;; esac
			# Our own PID can appear here after the number was reused, and those
			# files are stale by definition: nothing has been written yet.
			if [ "$sweep_pid" != "$$" ] && kill -0 "$sweep_pid" 2>/dev/null; then
				continue
			fi
			# /tmp is world-writable, so a symlink or a directory can be planted
			# under one of these names. Neither is a scratch file of ours.
			[ -L "$sweep_path" ] && continue
			[ -f "$sweep_path" ] || continue
			rm -f "$TMP_DIR/$PROG.$sweep_pid.$sweep_suffix" || continue
			sweep_count=$((sweep_count + 1))
		done
	done
	[ "$sweep_count" -eq 0 ] || \
		log notice "removed $sweep_count scratch file(s) left by an interrupted earlier run"
}

# ---- lock primitives ----
#
# A lock is a regular file whose first line is the owner PID, published
# atomically by `ln` so no competitor can ever see a created-but-unowned lock
# and mistake it for a crashed owner. apn-autoconfig-modem and
# apn-autoconfig-qmi implement the identical protocol, which is what keeps the
# shared APN operation lock and the per-device QMI identity lock mutually
# exclusive across packages.

# 0.10.0 and earlier used a directory containing "pid"; honor a live owner
# from that representation instead of deadlocking against it after an upgrade.
lock_owner_pid() {
	if [ -d "$1" ]; then
		lock_owner_value="$(sed -n '1p' "$1/pid" 2>/dev/null || :)"
	else
		lock_owner_value="$(sed -n '1p' "$1" 2>/dev/null || :)"
	fi
	case "$lock_owner_value" in ''|*[!0-9]*|0) return 1 ;; esac
	printf '%s\n' "$lock_owner_value"
}

# 0 acquired, 1 unusable path, 2 already present
lock_try_acquire() {
	acquire_path="$1"
	# `ln source directory` links *into* the directory instead of failing, so a
	# lock left behind as a 0.10.0-style directory has to be rejected here and
	# handled by the reclaim path rather than silently "acquired".
	[ -d "$acquire_path" ] && return 2
	acquire_tmp="${acquire_path}.tmp.$$"
	printf '%s\n' "$$" >"$acquire_tmp" 2>/dev/null || return 1
	if ln "$acquire_tmp" "$acquire_path" 2>/dev/null; then
		if [ -f "$acquire_path" ] && [ "$(sed -n '1p' "$acquire_path" 2>/dev/null)" = "$$" ]; then
			rm -f "$acquire_tmp"
			return 0
		fi
		# A directory appeared underneath us and took the link inside itself.
		rm -f "$acquire_path/${acquire_tmp##*/}" 2>/dev/null || :
		rm -f "$acquire_tmp"
		return 2
	fi
	rm -f "$acquire_tmp"
	return 2
}

lock_release() {
	[ -n "$1" ] || return 0
	rm -f "$1" 2>/dev/null || :
}

lock_set_owner() {
	set_owner_path="$1"
	set_owner_tmp="${set_owner_path}.own.$$"
	printf '%s\n' "$2" >"$set_owner_tmp" 2>/dev/null || return 1
	mv "$set_owner_tmp" "$set_owner_path" 2>/dev/null || {
		rm -f "$set_owner_tmp"
		return 1
	}
}

lock_reclaim_if_stale() {
	# Every name here is prefixed because POSIX shell has no local scope and
	# this function calls lock_try_acquire, which assigns its own variables.
	reclaim_path="$1"
	reclaim_guard="${reclaim_path}.reclaim"
	reclaim_guard_owner="$(lock_owner_pid "$reclaim_guard" 2>/dev/null || :)"
	if [ -n "$reclaim_guard_owner" ] && ! process_is_alive "$reclaim_guard_owner"; then
		rm -f "$reclaim_guard" 2>/dev/null || :
	fi
	lock_try_acquire "$reclaim_guard" || return 1
	reclaim_result=1
	reclaim_owner="$(lock_owner_pid "$reclaim_path" 2>/dev/null || :)"
	if [ -n "$reclaim_owner" ] && process_is_alive "$reclaim_owner"; then
		reclaim_result=1
	elif [ -d "$reclaim_path" ]; then
		rm -f "$reclaim_path/pid" 2>/dev/null || :
		rmdir "$reclaim_path" 2>/dev/null && reclaim_result=0
	else
		rm -f "$reclaim_path" 2>/dev/null && reclaim_result=0
	fi
	rm -f "$reclaim_guard" 2>/dev/null || :
	return "$reclaim_result"
}

# 0 acquired, 1 unusable path, 3 held by a live owner
lock_try_acquire_or_reclaim() {
	attempt_path="$1"
	lock_try_acquire "$attempt_path"
	attempt_status=$?
	[ "$attempt_status" -eq 0 ] && return 0
	[ "$attempt_status" -eq 1 ] && return 1
	attempt_owner="$(lock_owner_pid "$attempt_path" 2>/dev/null || :)"
	if [ -n "$attempt_owner" ] && process_is_alive "$attempt_owner"; then
		return 3
	fi
	lock_reclaim_if_stale "$attempt_path" || return 3
	lock_try_acquire "$attempt_path"
	attempt_status=$?
	[ "$attempt_status" -eq 0 ] && return 0
	[ "$attempt_status" -eq 1 ] && return 1
	return 3
}

state_value_is_safe() {
	value="$1"
	tab="$(printf '\t')"
	carriage_return="$(printf '\r')"
	case "$value" in *"$tab"*) return 1 ;; esac
	case "$value" in *"$carriage_return"*) return 1 ;; esac
	[ "$(printf '%s' "$value" | awk 'END { print NR + 0 }')" -le 1 ]
}

set_or_delete_option() {
	option="$1"
	set_flag="$2"
	value="$3"
	if [ "$set_flag" -eq 1 ]; then
		uci set "network.${INTERFACE}.${option}=$value" >/dev/null 2>&1
	else
		uci -q delete "network.${INTERFACE}.${option}" >/dev/null 2>&1 || :
	fi
}

capture_owned_profile() {
	auth_option="$1"
	ip_option="$2"
	if uci -q get "network.${INTERFACE}.apn" >/dev/null 2>&1; then
		OLD_APN_SET=1
		OLD_APN="$(uci -q get "network.${INTERFACE}.apn")"
	fi
	if uci -q get "network.${INTERFACE}.username" >/dev/null 2>&1; then
		OLD_USERNAME_SET=1
		OLD_USERNAME="$(uci -q get "network.${INTERFACE}.username")"
	fi
	if uci -q get "network.${INTERFACE}.password" >/dev/null 2>&1; then
		OLD_PASSWORD_SET=1
		OLD_PASSWORD="$(uci -q get "network.${INTERFACE}.password")"
	fi
	if uci -q get "network.${INTERFACE}.${auth_option}" >/dev/null 2>&1; then
		OLD_ALLOWEDAUTH_SET=1
		OLD_ALLOWEDAUTH="$(uci -q get "network.${INTERFACE}.${auth_option}")"
	fi
	if uci -q get "network.${INTERFACE}.${ip_option}" >/dev/null 2>&1; then
		OLD_IPTYPE_SET=1
		OLD_IPTYPE="$(uci -q get "network.${INTERFACE}.${ip_option}")"
	fi
}

capture_old_profile() {
	case "$TARGET_BACKEND" in
		modemmanager) capture_owned_profile allowedauth iptype ;;
		# MBIM shares qmi.sh's option names but not its value vocabulary; see
		# mbim_set_profile.
		qmi|mbim|atdial) capture_owned_profile auth pdptype ;;
		*) die_code 4 "backend $TARGET_BACKEND cannot read APN profiles" ;;
	esac
}

restore_owned_profile() {
	auth_option="$1"
	ip_option="$2"
	set_or_delete_option apn "$OLD_APN_SET" "$OLD_APN" || return 1
	set_or_delete_option username "$OLD_USERNAME_SET" "$OLD_USERNAME" || return 1
	set_or_delete_option password "$OLD_PASSWORD_SET" "$OLD_PASSWORD" || return 1
	set_or_delete_option "$auth_option" "$OLD_ALLOWEDAUTH_SET" "$OLD_ALLOWEDAUTH" || return 1
	set_or_delete_option "$ip_option" "$OLD_IPTYPE_SET" "$OLD_IPTYPE" || return 1
	uci commit network >/dev/null 2>&1 || return 1
	ifdown "$INTERFACE" >/dev/null 2>&1 || :
	[ "$LEAVE_INTERFACE_DOWN" -eq 1 ] && return 0
	settle_after_ifdown
	ifup "$INTERFACE" >/dev/null 2>&1 || :
}

restore_old_profile() {
	case "$TARGET_BACKEND" in
		modemmanager)
			log warning "restoring previous mobile profile for interface $INTERFACE"
			restore_owned_profile allowedauth iptype
		;;
		qmi)
			log warning "restoring previous QMI profile for interface $INTERFACE"
			restore_owned_profile auth pdptype
		;;
		mbim)
			log warning "restoring previous MBIM profile for interface $INTERFACE"
			restore_owned_profile auth pdptype
		;;
		atdial)
			log warning "restoring previous AT-dial profile for interface $INTERFACE"
			restore_owned_profile auth pdptype
		;;
		*) return 1 ;;
	esac
}

set_owned_profile() {
	apn="$1"
	username="$2"
	password="$3"
	auth_option="$4"
	auth_value="$5"
	ip_option="$6"
	ip_value="$7"

	case "$apn" in ''|*[!A-Za-z0-9._-]*) [ -z "$apn" ] || return 1 ;; esac
	state_value_is_safe "$username" || return 1
	state_value_is_safe "$password" || return 1
	state_value_is_safe "$auth_value" || return 1
	state_value_is_safe "$ip_value" || return 1

	uci set "network.${INTERFACE}.apn=$apn" >/dev/null 2>&1 || return 1
	if [ "$username" = "-" ]; then
		uci -q delete "network.${INTERFACE}.username" >/dev/null 2>&1 || :
	else
		uci set "network.${INTERFACE}.username=$username" >/dev/null 2>&1 || return 1
	fi
	if [ "$password" = "-" ]; then
		uci -q delete "network.${INTERFACE}.password" >/dev/null 2>&1 || :
	else
		uci set "network.${INTERFACE}.password=$password" >/dev/null 2>&1 || return 1
	fi
	if [ "$auth_value" = "-" ]; then
		uci -q delete "network.${INTERFACE}.${auth_option}" >/dev/null 2>&1 || :
	else
		uci set "network.${INTERFACE}.${auth_option}=$auth_value" >/dev/null 2>&1 || return 1
	fi
	if [ "$ip_value" = "-" ]; then
		uci -q delete "network.${INTERFACE}.${ip_option}" >/dev/null 2>&1 || :
	else
		uci set "network.${INTERFACE}.${ip_option}=$ip_value" >/dev/null 2>&1 || return 1
	fi
	uci commit network >/dev/null 2>&1
}

modemmanager_set_profile() {
	apn="$1"
	username="$2"
	password="$3"
	auth="$4"
	ip_type="$5"

	case "$auth" in -|none|pap|chap|pap-or-chap) : ;; *) return 1 ;; esac
	case "$ip_type" in -|ipv4|ipv6|ipv4v6) : ;; *) return 1 ;; esac
	[ "$auth" != pap-or-chap ] || auth="pap chap"
	set_owned_profile "$apn" "$username" "$password" allowedauth "$auth" iptype "$ip_type"
}

atdial_set_profile() {
	apn="$1"
	username="$2"
	password="$3"
	auth="$4"
	ip_type="$5"

	case "$auth" in -|none|pap|chap|pap-or-chap) : ;; *) return 1 ;; esac
	case "$ip_type" in -|ipv4|ipv6|ipv4v6) : ;; *) return 1 ;; esac
	# AT+CGDCONT accepts IP, IPV6 and IPV4V6 and nothing else, and the value is
	# passed to it verbatim. Writing the canonical spelling here is what keeps
	# the handler's normalisation a safety net for hand-written sections rather
	# than a path this project relies on.
	case "$ip_type" in
		ipv4) ip_type=IP ;;
		ipv6) ip_type=IPV6 ;;
		ipv4v6) ip_type=IPV4V6 ;;
	esac
	set_owned_profile "$apn" "$username" "$password" auth "$auth" pdptype "$ip_type"
}

qmi_set_profile() {
	apn="$1"
	username="$2"
	password="$3"
	auth="$4"
	ip_type="$5"

	case "$auth" in -|none|pap|chap|pap-or-chap) : ;; *) return 1 ;; esac
	case "$ip_type" in -|ipv4|ipv6|ipv4v6) : ;; *) return 1 ;; esac
	[ "$auth" != pap-or-chap ] || auth=both
	[ "$ip_type" != ipv4 ] || ip_type=ip
	set_owned_profile "$apn" "$username" "$password" auth "$auth" pdptype "$ip_type"
}

mbim_set_profile() {
	apn="$1"
	username="$2"
	password="$3"
	auth="$4"
	ip_type="$5"

	# umbim accepts exactly one authentication protocol and silently drops the
	# username and password for any other value, so a normalized pap-or-chap
	# candidate must have been expanded by the attempt planner before it gets
	# here. Writing it verbatim would dial unauthenticated with no error.
	case "$auth" in -|none|pap|chap) : ;; *) return 1 ;; esac
	# mbim.sh lowercases pdptype and passes ipv4/ipv6/ipv4v6 through to umbim;
	# anything else means "let the modem decide". qmi.sh's canonical "ip" is
	# exactly such an unrecognized value here.
	case "$ip_type" in -|ipv4|ipv6|ipv4v6) : ;; *) return 1 ;; esac
	set_owned_profile "$apn" "$username" "$password" auth "$auth" pdptype "$ip_type"
}

set_profile() {
	case "$TARGET_BACKEND" in
		modemmanager) modemmanager_set_profile "$@" ;;
		qmi) qmi_set_profile "$@" ;;
		mbim) mbim_set_profile "$@" ;;
		atdial) atdial_set_profile "$@" ;;
		*) return 1 ;;
	esac
}

on_exit() {
	on_exit_status=$?
	trap - 0 HUP INT TERM
	# PIPE is ignored rather than restored for the duration of the cleanup: the
	# reader that went away may have been reading stderr too, and a rollback
	# that logs its progress must not be killed halfway by a second SIGPIPE.
	trap '' PIPE
	if [ -n "$SETTLE_SLEEP_PID" ]; then
		kill -TERM "$SETTLE_SLEEP_PID" 2>/dev/null || :
		wait "$SETTLE_SLEEP_PID" 2>/dev/null || :
		SETTLE_SLEEP_PID=""
	fi
	# A run covering every managed target owns no state of its own, but it does
	# own the child that is mutating one right now. Terminating and reaping it
	# is what lets that child roll its own target back; leaving it would put a
	# signalled operation beyond anyone's reach.
	if [ -n "$FANOUT_CHILD_PID" ]; then
		kill -TERM "$FANOUT_CHILD_PID" 2>/dev/null || :
		wait "$FANOUT_CHILD_PID" 2>/dev/null || :
		FANOUT_CHILD_PID=""
	fi
	if [ "$MODEM_POWER_OFF_ARMED" -eq 1 ]; then
		printf '%s\n' "$MODEM_POWER_ON_VALUE" >"$MODEM_POWER_PATH" 2>/dev/null || \
			log err "failed to restore modem power after interruption"
		MODEM_POWER_OFF_ARMED=0
	fi
	if [ "$ROLLBACK_ARMED" -eq 1 ]; then
		restore_old_profile || log err "automatic rollback failed; restore the mobile profile in LuCI"
	elif [ "$INTERFACE_RESTORE_ARMED" -eq 1 ]; then
		ifup "$INTERFACE" >/dev/null 2>&1 || \
			log err "failed to restart interface $INTERFACE after modem reset failure"
	fi
	cleanup_files
	exit "$on_exit_status"
}

on_signal() {
	exit 143
}

# Death by an untrapped signal never runs the exit trap, and SIGPIPE was the one
# left out: every command gathers all of its data into scratch files before it
# writes the first byte of its answer, so a reader that has already gone away
# kills the engine at exactly the moment when there is the most to clean up.
# `status-json | head -1`, a captured pipeline whose reader exits early or an SSH
# session that dies mid-command each left the whole scratch set behind, and a
# mutation interrupted this way skipped its rollback, its modem power-on and its
# lock release as well.
#
# 141 is the status the process already reported when the default action killed
# it, so no caller sees a new one; what changes is that the exit trap now runs.
on_pipe() {
	exit 141
}

trap on_exit 0
trap on_signal HUP INT TERM
trap on_pipe PIPE

command_exists() {
	command -v "$1" >/dev/null 2>&1
}

run_bounded_to_file() {
	seconds="$1"
	output_file="$2"
	shift 2
	if command_exists "$TIMEOUT"; then
		"$TIMEOUT" "$seconds" "$@" >"$output_file" 2>/dev/null
		return
	fi
	"$@" >"$output_file" 2>/dev/null &
	BOUNDED_CHILD_PID=$!
	# The watchdog runs its sleep as a background child of its own and waits
	# for it, so that the TERM the caller sends once the call has answered
	# reaches the sleep too. Killing the subshell alone leaves the sleep it
	# forked running to the end of the budget: on the reference image, which
	# has no `timeout`, that is one stray process per bounded call, and every
	# call on the read path is bounded.
	(
		watchdog_sleep_pid=""
		trap 'kill -TERM "$watchdog_sleep_pid" 2>/dev/null; exit 0' TERM
		"$SLEEP" "$seconds" &
		watchdog_sleep_pid=$!
		wait "$watchdog_sleep_pid" 2>/dev/null || exit 0
		kill -TERM "$BOUNDED_CHILD_PID" 2>/dev/null || exit 0
		"$SLEEP" 1 &
		watchdog_sleep_pid=$!
		wait "$watchdog_sleep_pid" 2>/dev/null || exit 0
		kill -9 "$BOUNDED_CHILD_PID" 2>/dev/null || :
	) >/dev/null 2>&1 &
	BOUNDED_WATCHDOG_PID=$!
	bounded_status=0
	wait "$BOUNDED_CHILD_PID" || bounded_status=$?
	BOUNDED_CHILD_PID=""
	kill -TERM "$BOUNDED_WATCHDOG_PID" 2>/dev/null || :
	wait "$BOUNDED_WATCHDOG_PID" 2>/dev/null || :
	BOUNDED_WATCHDOG_PID=""
	return "$bounded_status"
}

# ---- the read deadline (see docs/convergence-contract-v1.md) ----
#
# rpcd's `file exec` SIGKILLs the helper it started when it exceeds rpcd's own
# timeout. No trap covers that: the page gets nothing, the exit trap does not
# run and the process's children are orphaned. The engine's read path reaches
# that budget by itself, because each of its calls is bounded and their sum is
# not.
#
# So the three commands LuCI reads observe a total, and each bounded call under
# it is given whatever is left rather than its own full budget.

read_deadline_arm() {
	case "$READ_DEADLINE_SECONDS" in
		''|*[!0-9]*) die "read_deadline_seconds must be a whole number of seconds" ;;
	esac
	case "$RPCD_EXEC_BUDGET_SECONDS" in
		''|*[!0-9]*) die "the rpcd exec budget must be a whole number of seconds" ;;
	esac
	[ "$READ_DEADLINE_SECONDS" -gt 0 ] || die "read_deadline_seconds must be greater than zero"
	# Rejected rather than obeyed. A deadline at or above the caller's budget
	# cannot keep us inside it, and a configuration that says otherwise is
	# wrong about the one thing this mechanism exists for.
	[ "$READ_DEADLINE_SECONDS" -lt "$RPCD_EXEC_BUDGET_SECONDS" ] || \
		die "read_deadline_seconds ${READ_DEADLINE_SECONDS} must stay below the ${RPCD_EXEC_BUDGET_SECONDS}s rpcd exec budget it exists to fit inside"
	READ_DEADLINE_AT=$(($(date +%s) + READ_DEADLINE_SECONDS))
}

read_deadline_remaining() {
	deadline_remaining=$((READ_DEADLINE_AT - $(date +%s)))
	[ "$deadline_remaining" -gt 0 ] || deadline_remaining=0
	printf '%s\n' "$deadline_remaining"
}

# Named once however often the same read is retried, because the document lists
# what could not be read rather than how many times it was attempted.
#
# The second argument says which clock stopped it, so the log stays true: the
# total deadline, or the reading's own budget. The document does not record the
# difference, because a reader is being told what is missing rather than which
# timer expired.
read_abandon() {
	case " $READ_INCOMPLETE_READS " in *" $1 "*) return 0 ;; esac
	READ_INCOMPLETE_READS="${READ_INCOMPLETE_READS:+$READ_INCOMPLETE_READS }$1"
	READ_INCOMPLETE=1
	case "${2:-deadline}" in
		deadline) log warning "the read deadline of ${READ_DEADLINE_SECONDS}s was reached; abandoned $1" ;;
		*) log warning "$1 ran out of its own time budget and was abandoned" ;;
	esac
}

read_was_abandoned() {
	case " $READ_INCOMPLETE_READS " in *" $1 "*) return 0 ;; esac
	return 1
}

# A bounded call on the read path.
#
# `budget` may be empty for a call that carries no bound of its own: it then
# runs unbounded when no deadline is armed, which is every mutation path and
# every CLI invocation, and is bounded by the time remaining when one is.
#
# Standard error is discarded on both paths, so a diagnostic does not appear or
# vanish depending on how much time happened to be left. Nothing is lost by it:
# neither native adapter writes to standard error at all, and the modem
# coordinator sends the same lines to syslog, which is where they are read on a
# router anyway.
run_read_bounded() {
	read_label="$1"
	read_budget="$2"
	read_output="$3"
	shift 3
	read_clipped=0
	if [ -n "$READ_DEADLINE_AT" ]; then
		read_remaining="$(read_deadline_remaining)"
		if [ "$read_remaining" -le 0 ]; then
			# Not attempted at all. Starting a call that cannot finish spends
			# the headroom the deadline exists to protect on nothing.
			read_abandon "$read_label"
			return 124
		fi
		if [ -z "$read_budget" ] || [ "$read_remaining" -lt "$read_budget" ]; then
			read_budget="$read_remaining"
			read_clipped=1
		fi
	fi
	if [ -z "$read_budget" ]; then
		"$@" >"$read_output" 2>/dev/null
		return
	fi
	read_status=0
	run_bounded_to_file "$read_budget" "$read_output" "$@" || read_status=$?
	# A reading that timed out on the read path is an abandoned reading, whether
	# the total deadline or the call's own budget stopped it. 0.15.3 first
	# marked only the deadline's own victims, on the reasoning that a call
	# killed by its smaller budget had timed out exactly as it always did. On
	# the reference router that reasoning cost the page its whole answer: with a
	# wedged ModemManager the mmcli calls die at their 9 s budget, well inside
	# the 20 s deadline, so nothing was marked, the command fell through to its
	# ordinary retryable failure and printed no document at all - which is the
	# symptom this release exists to remove. Which timer expired is a fact about
	# the engine; that the reading is missing is the fact the page needs.
	if [ -n "$READ_DEADLINE_AT" ] && [ "$read_status" -ne 0 ]; then
		case "$read_status" in
			124|137|143)
				if [ "$read_clipped" -eq 1 ]; then
					read_abandon "$read_label" deadline
				else
					read_abandon "$read_label" budget
				fi
				;;
		esac
	fi
	return "$read_status"
}

# The two fields an incomplete document carries, and the leading comma that
# attaches them. Printed only when something was abandoned, so a document from
# a backend that answered is byte-for-byte the document it produced before.
print_incomplete_fields() {
	[ "$READ_INCOMPLETE" -eq 1 ] || return 0
	printf ',"incomplete":true,"incomplete_reads":['
	incomplete_separator=""
	for incomplete_name in $READ_INCOMPLETE_READS; do
		printf '%s' "$incomplete_separator"
		json_string "$incomplete_name"
		incomplete_separator=','
	done
	printf ']'
}

load_config() {
	if ! command_exists uci; then
		die "uci is required"
	fi
	value="$(uci -q get "${CONFIG}.main.interface")" && [ -n "$value" ] && CONFIGURED_INTERFACE="$value"
	value="$(uci -q get "${CONFIG}.main.sim_index")" && [ -n "$value" ] && SIM_INDEX_FALLBACK="$value"
	value="$(uci -q get "${CONFIG}.main.device")" && [ -n "$value" ] && DEVICE="$value"
	value="$(uci -q get "${CONFIG}.main.database")" && [ -n "$value" ] && DATABASE="$value"
	value="$(uci -q get "${CONFIG}.main.cache_dir")" && [ -n "$value" ] && CACHE_DIR="$value"
	value="$(uci -q get "${CONFIG}.main.state_dir")" && [ -n "$value" ] && STATE_DIR="$value"
	value="$(uci -q get "${CONFIG}.main.test_url")" && [ -n "$value" ] && TEST_URL="$value"
	value="$(uci -q get "${CONFIG}.main.wait_seconds")" && [ -n "$value" ] && WAIT_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.registration_wait_seconds")" && [ -n "$value" ] && REGISTRATION_WAIT_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.try_empty")" && [ -n "$value" ] && TRY_EMPTY="$value"
	value="$(uci -q get "${CONFIG}.main.use_mwan3")" && [ -n "$value" ] && USE_MWAN3="$value"
	value="$(uci -q get "${CONFIG}.main.lock_dir")" && [ -n "$value" ] && LOCK_DIR="$value"
	value="$(uci -q get "${CONFIG}.main.action_state_dir")" && [ -n "$value" ] && ACTION_STATE_DIR="$value"
	value="$(uci -q get "${CONFIG}.main.modem_power_path")" && [ -n "$value" ] && MODEM_POWER_PATH="$value"
	value="$(uci -q get "${CONFIG}.main.modem_power_off_value")" && [ -n "$value" ] && MODEM_POWER_OFF_VALUE="$value"
	value="$(uci -q get "${CONFIG}.main.modem_power_on_value")" && [ -n "$value" ] && MODEM_POWER_ON_VALUE="$value"
	value="$(uci -q get "${CONFIG}.main.modem_power_off_seconds")" && [ -n "$value" ] && MODEM_POWER_OFF_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.modem_wait_seconds")" && [ -n "$value" ] && MODEM_WAIT_SECONDS="$value"
	value="$(uci -q get "${CONFIG}.main.modem_poll_seconds")" && [ -n "$value" ] && MODEM_POLL_SECONDS="$value"
	# The environment wins over UCI for this one option, because it is how the
	# suite drives the deadline and how an administrator debugging a wedged
	# backend can change it for a single command without editing config.
	if [ -z "${APN_AUTOCONFIG_READ_DEADLINE_SECONDS:-}" ]; then
		value="$(uci -q get "${CONFIG}.main.read_deadline_seconds")" && [ -n "$value" ] && READ_DEADLINE_SECONDS="$value"
	fi
	return 0
}

target_protocol_capabilities() {
	protocol="$1"
	TARGET_PROTOCOL="$protocol"
	TARGET_IDENTITY=false
	TARGET_PROFILE_READ=false
	TARGET_PROFILE_WRITE=false
	TARGET_PROFILE_APPLY=false
	TARGET_REASON="backend-not-implemented"
	TARGET_IMPLEMENTATION_STATE="unimplemented"
	TARGET_VALIDATION_STATE="none"
	TARGET_HARDWARE_VALIDATED=false
	# Roaming policy is a property of the connection manager, not of the APN
	# profile, so it is reported separately instead of being inferred from a
	# backend name. Both are plain netifd options, so neither depends on a
	# runtime command being installed.
	TARGET_ROAMING_POLICY_READ=false
	TARGET_ROAMING_POLICY_WRITE=false
	case "$protocol" in
		modemmanager)
			TARGET_BACKEND="modemmanager"
			TARGET_ROAMING_POLICY_READ=true
			TARGET_ROAMING_POLICY_WRITE=true
			TARGET_IMPLEMENTATION_STATE="stable"
			TARGET_VALIDATION_STATE="hardware"
			TARGET_HARDWARE_VALIDATED=true
			if command_exists mmcli; then
				TARGET_IDENTITY=true
				TARGET_PROFILE_READ=true
				TARGET_PROFILE_WRITE=true
				TARGET_PROFILE_APPLY=true
				TARGET_REASON=""
			else
				TARGET_REASON="backend-command-unavailable"
			fi
		;;
		qmi|uqmi)
			TARGET_BACKEND="qmi"
			TARGET_IMPLEMENTATION_STATE="stable"
			TARGET_VALIDATION_STATE="hardware"
			TARGET_HARDWARE_VALIDATED=true
			if [ ! -x "$QMI_ADAPTER" ]; then
				TARGET_REASON="adapter-unavailable"
			elif "$QMI_ADAPTER" capabilities >/dev/null 2>&1; then
				TARGET_IDENTITY=true
				TARGET_PROFILE_READ=true
				TARGET_PROFILE_WRITE=true
				TARGET_PROFILE_APPLY=true
				TARGET_REASON=""
			else
				TARGET_REASON="backend-command-unavailable"
			fi
		;;
		mbim|umbim)
			TARGET_BACKEND="mbim"
			TARGET_ROAMING_POLICY_READ=true
			TARGET_ROAMING_POLICY_WRITE=true
			# Discovery through provisioning, profile write, verified Internet
			# access, roaming policy and exact rollback passed on the WH3000
			# with an RM520N-GL in MBIM composition; see
			# docs/router-test-0.12.0.md.
			TARGET_IMPLEMENTATION_STATE="stable"
			TARGET_VALIDATION_STATE="hardware"
			TARGET_HARDWARE_VALIDATED=true
			if [ ! -x "$MBIM_ADAPTER" ]; then
				TARGET_REASON="adapter-unavailable"
			elif "$MBIM_ADAPTER" capabilities >/dev/null 2>&1; then
				TARGET_IDENTITY=true
				TARGET_PROFILE_READ=true
				TARGET_PROFILE_WRITE=true
				TARGET_PROFILE_APPLY=true
				TARGET_REASON=""
			else
				TARGET_REASON="backend-command-unavailable"
			fi
		;;
		apn_atdial)
			TARGET_BACKEND="atdial"
			# The handler enforces the policy itself by refusing to dial on a
			# roaming registration, using the same allow_roaming option as
			# ModemManager — but with the opposite default, so LuCI's labels
			# for this backend must be its own, as they already are for MBIM.
			TARGET_ROAMING_POLICY_READ=true
			TARGET_ROAMING_POLICY_WRITE=true
			# The FM350-GL path is what the hardware gate covers. The Intel XMM
			# tail inside the same handler is alpha/synthetic, and that
			# distinction lives in the modem record rather than here, because
			# it is a property of the device rather than of this backend.
			TARGET_IMPLEMENTATION_STATE="stable"
			TARGET_VALIDATION_STATE="hardware"
			TARGET_HARDWARE_VALIDATED=true
			if ! command_exists apn-autoconfig-modem; then
				TARGET_REASON="backend-command-unavailable"
			else
				TARGET_IDENTITY=true
				# The profile is a set of netifd options the handler applies.
				# This backend owns no profile fields of its own to read or
				# write, and that is permanent rather than unimplemented.
				TARGET_PROFILE_APPLY=true
				TARGET_REASON=""
			fi
		;;
		fibocom) TARGET_BACKEND="fibocom" ;;
		atc|xmm|ncm|wwan|3g) TARGET_BACKEND="at" ;;
		*) TARGET_BACKEND=""; TARGET_REASON="unsupported-protocol" ;;
	esac
}

protocol_is_cellular() {
	case "$1" in
		apn_atdial|modemmanager|qmi|uqmi|mbim|umbim|fibocom|atc|xmm|ncm|wwan|3g) return 0 ;;
		*) return 1 ;;
	esac
}

discover_targets() {
	: >"$TARGETS_DATA"
	uci -q show network 2>/dev/null | while IFS= read -r line; do
		case "$line" in network.*.proto=*) : ;; *) continue ;; esac
		section="${line#network.}"
		section="${section%%.proto=*}"
		proto="${line#*=}"
		case "$proto" in "'"*"'") proto="${proto#\'}"; proto="${proto%\'}" ;; esac
		case "$section" in ''|*[!A-Za-z0-9_]*) continue ;; esac
		case "$proto" in ''|*[!A-Za-z0-9_-]*) continue ;; esac
		protocol_is_cellular "$proto" || continue
		printf '%s\t%s\n' "$section" "$proto"
	done >"$TARGETS_DATA"
}

# An administratively disabled netifd section is never an automatic target,
# regardless of who created it. Explicit --target remains available for
# inspection and deliberate recovery, but automatic mode must not turn a
# disabled user-owned uplink back on as a side effect of APN reconciliation.
section_is_disabled() {
	disabled_section="$1"
	disabled_value="$(uci -q get "network.${disabled_section}.disabled" 2>/dev/null || :)"
	case "$disabled_value" in 1|on|true|yes|enabled) return 0 ;; esac
	return 1
}

# Every target automatic mode manages, in priority order, one section per line.
#
# A modem the administrator attached is a modem they want to use, so "automatic"
# means all of them rather than none of them. It used to mean "the only one":
# a second writable target made every command fail with "select one explicitly",
# including status, the boot reconciliation and the hardware button — the suite
# stopped working at the moment it had more to do, and the user was asked to
# make a choice that automation exists to avoid. Commands that can only act on
# one target take the first line; the rest run against all of them.
#
# Order is the route metric netifd was given, which is the administrator's own
# statement of which uplink matters, with the section name breaking a tie.
# Enumeration order decides nothing: it is not evidence of anything.
auto_targets() {
	discover_targets
	while IFS="$(printf '\t')" read -r auto_section auto_proto; do
		[ -n "$auto_section" ] || continue
		target_protocol_capabilities "$auto_proto"
		[ "$TARGET_PROFILE_APPLY" = true ] || continue
		# A disabled section is not a working target. Starting it would override
		# an administrator's explicit choice; for project-owned staging it would
		# also dial with a vendor-default profile. An explicit --target still
		# selects it, and an enabled section participates normally.
		section_is_disabled "$auto_section" && continue
		auto_metric="$(uci -q get "network.${auto_section}.metric" 2>/dev/null || :)"
		case "$auto_metric" in ''|*[!0-9]*) auto_metric=0 ;; esac
		# Zero-padded so a plain sort orders numerically, without depending on
		# how BusyBox sort splits fields.
		printf '%010d\t%s\n' "$auto_metric" "$auto_section"
	done <"$TARGETS_DATA" | sort | cut -f2
}

auto_target_count() {
	count=0
	for count_section in $1; do
		[ -n "$count_section" ] || continue
		count=$((count + 1))
	done
	printf '%s\n' "$count"
}

# The engine's own path, for a command that runs itself once per target.
engine_self_path() {
	self="$0"
	case "$self" in /*) : ;; *) self="$(command -v "$self" 2>/dev/null || :)" ;; esac
	[ -r "$self" ] || die "cannot resolve the APN engine path"
	printf '%s\n' "$self"
}

select_target() {
	configured="$CONFIGURED_INTERFACE"
	if [ -n "$REQUESTED_TARGET" ]; then
		case "$REQUESTED_TARGET" in network:*) configured="${REQUESTED_TARGET#network:}" ;; *) die_code 4 "invalid target ID" ;; esac
	fi
	case "$configured" in
		auto)
			AUTO_TARGETS="$(auto_targets)"
			AUTO_TARGET_COUNT="$(auto_target_count "$AUTO_TARGETS")"
			[ "$AUTO_TARGET_COUNT" -gt 0 ] || \
				die_code 4 "no cellular target with an implemented APN backend was found"
			# One target is chosen for the commands that can only mean one.
			# A profile the user typed, a rollback, and permission to spend
			# roaming data are not operations to spread over unnamed targets.
			case "$COMMAND_NAME:$command_argument" in
				apply-manual:*|reset:*|roaming-policy-set:*|action-start:roaming-default|action-start:roaming-allow|action-start:roaming-block)
					[ "$AUTO_TARGET_COUNT" -eq 1 ] || \
						die_code 4 "$COMMAND_NAME acts on one target; several are managed, so name one with --target"
				;;
			esac
			INTERFACE="$(printf '%s\n' "$AUTO_TARGETS" | sed -n '1p')"
			[ -n "$INTERFACE" ] || die_code 4 "no cellular target with an implemented APN backend was found"
		;;
		''|*[!A-Za-z0-9_]*) die_code 4 "invalid target interface" ;;
		*) INTERFACE="$configured" ;;
	esac
	TARGET_ID="network:$INTERFACE"
	protocol="$(uci -q get "network.${INTERFACE}.proto" 2>/dev/null || :)"
	case "$protocol" in
		'')
			[ "$COMMAND_NAME" = reset ] || die_code 4 "cannot determine a protocol for target $TARGET_ID"
			protocol="unknown"
		;;
		*[!A-Za-z0-9_-]*) die_code 4 "cannot determine a safe protocol for target $TARGET_ID" ;;
	esac
	target_protocol_capabilities "$protocol"
	if [ -z "$TARGET_BACKEND" ]; then
		[ "$COMMAND_NAME" = reset ] || die_code 4 "target $TARGET_ID uses unsupported protocol $protocol"
		TARGET_BACKEND="unknown"
	fi
	value="$(uci -q get "network.${INTERFACE}.device" 2>/dev/null || :)"
	[ -n "$value" ] && NETWORK_DEVICE="$value"
	value="$(uci -q get "network.${INTERFACE}.devpath" 2>/dev/null || :)"
	[ -n "$value" ] && NETWORK_DEVPATH="$value"
	TARGET_STATE_DIR="$STATE_DIR/targets/network_${INTERFACE}"
	BASELINE_FILE="$TARGET_STATE_DIR/baseline.tsv"
	ACTIVE_FILE="$TARGET_STATE_DIR/active.tsv"
	LEGACY_BASELINE_FILE="$STATE_DIR/baseline.tsv"
	LEGACY_ACTIVE_FILE="$STATE_DIR/active.tsv"
}

migrate_target_state() {
	legacy_owner=""
	legacy_owned=0
	if [ -r "$LEGACY_BASELINE_FILE" ]; then
		legacy_owner="$(awk -F '\t' 'NR == 1 { print $2; exit }' "$LEGACY_BASELINE_FILE")"
		if [ "$legacy_owner" = "$INTERFACE" ]; then
			legacy_owned=1
		elif [ ! -e "$BASELINE_FILE" ]; then
			die "legacy baseline belongs to interface $legacy_owner; refusing cross-target migration"
		fi
	fi
	if [ "$legacy_owned" -eq 1 ] && [ ! -e "$BASELINE_FILE" ]; then
		mkdir -p "$TARGET_STATE_DIR" || die "cannot create target state directory: $TARGET_STATE_DIR"
		mv "$LEGACY_BASELINE_FILE" "$BASELINE_FILE" || die "cannot migrate target baseline"
		log notice "migrated baseline into state namespace for $TARGET_ID"
	fi
	if [ -r "$LEGACY_ACTIVE_FILE" ] && [ ! -e "$ACTIVE_FILE" ]; then
		if [ "$legacy_owned" -eq 1 ] || { [ -z "$REQUESTED_TARGET" ] && [ "$CONFIGURED_INTERFACE" = "$INTERFACE" ]; }; then
			mkdir -p "$TARGET_STATE_DIR" || die "cannot create target state directory: $TARGET_STATE_DIR"
			mv "$LEGACY_ACTIVE_FILE" "$ACTIVE_FILE" || die "cannot migrate active target state"
			log notice "migrated active state into namespace for $TARGET_ID"
		fi
	fi
}

active_file_for_read() {
	if [ -r "$ACTIVE_FILE" ]; then
		printf '%s\n' "$ACTIVE_FILE"
	elif [ -r "$LEGACY_ACTIVE_FILE" ] && [ -z "$REQUESTED_TARGET" ] && [ "$CONFIGURED_INTERFACE" = "$INTERFACE" ]; then
		printf '%s\n' "$LEGACY_ACTIVE_FILE"
	else
		return 1
	fi
}

require_target_capability() {
	capability="$1"
	case "$capability" in
		identity) available="$TARGET_IDENTITY" ;;
		profile-read) available="$TARGET_PROFILE_READ" ;;
		profile-write) available="$TARGET_PROFILE_WRITE" ;;
		profile-apply) available="$TARGET_PROFILE_APPLY" ;;
		roaming-policy-write) available="$TARGET_ROAMING_POLICY_WRITE" ;;
		*) die "internal error: unknown target capability" ;;
	esac
	[ "$available" = true ] || die_code 4 "target $TARGET_ID ($TARGET_PROTOCOL) does not implement $capability in this release"
}

hardware_integration_name() {
	[ -r "$HARDWARE_INTEGRATION_FILE" ] || return 1
	name="$(sed -n '1p' "$HARDWARE_INTEGRATION_FILE")"
	case "$name" in huasifei-wh3000-gpio-v1) printf '%s\n' "$name" ;; *) return 1 ;; esac
}

require_hardware_integration() {
	hardware_integration_name >/dev/null 2>&1 || \
		die_code 4 "modem-reset requires an installed, supported board integration"
}

validate_config() {
	case "$INTERFACE" in *[!A-Za-z0-9_]*) die "invalid interface name: $INTERFACE" ;; esac
	case "$SIM_INDEX_FALLBACK" in auto) : ;; ''|*[!0-9]*) die "sim_index must be auto or numeric" ;; esac
	case "$DEVICE" in ''|*[!A-Za-z0-9_.:-]*) die "invalid device name: $DEVICE" ;; esac
	case "$WAIT_SECONDS" in ''|*[!0-9]*) die "wait_seconds must be numeric" ;; esac
	case "$REGISTRATION_WAIT_SECONDS" in ''|*[!0-9]*) die "registration_wait_seconds must be numeric" ;; esac
	case "$TRY_EMPTY" in 0|1) : ;; *) die "try_empty must be 0 or 1" ;; esac
	case "$USE_MWAN3" in auto|always|never) : ;; *) die "use_mwan3 must be auto, always or never" ;; esac
	case "$TEST_URL" in http://*|https://*) : ;; *) die "test_url must be an http(s) URL" ;; esac
	case "$MODEM_POWER_PATH" in "$SYSFS_ROOT"/class/gpio/*/value) : ;; *) die "modem_power_path must be a GPIO value under $SYSFS_ROOT/class/gpio" ;; esac
	case "$MODEM_POWER_OFF_VALUE" in 0|1) : ;; *) die "modem_power_off_value must be 0 or 1" ;; esac
	case "$MODEM_POWER_ON_VALUE" in 0|1) : ;; *) die "modem_power_on_value must be 0 or 1" ;; esac
	[ "$MODEM_POWER_OFF_VALUE" != "$MODEM_POWER_ON_VALUE" ] || die "modem power on/off values must differ"
	case "$MODEM_POWER_OFF_SECONDS" in ''|*[!0-9]*) die "modem_power_off_seconds must be numeric" ;; esac
	case "$MODEM_WAIT_SECONDS" in ''|*[!0-9]*) die "modem_wait_seconds must be numeric" ;; esac
	case "$MODEM_POLL_SECONDS" in ''|*[!0-9]*) die "modem_poll_seconds must be numeric" ;; esac
	case "$MMCLI_TIMEOUT_SECONDS" in ''|*[!0-9]*) die "mmcli timeout must be numeric" ;; esac
	[ "$MODEM_POWER_OFF_SECONDS" -gt 0 ] || die "modem_power_off_seconds must be greater than zero"
	[ "$MODEM_WAIT_SECONDS" -gt 0 ] || die "modem_wait_seconds must be greater than zero"
	[ "$MODEM_POLL_SECONDS" -gt 0 ] || die "modem_poll_seconds must be greater than zero"
	[ "$MMCLI_TIMEOUT_SECONDS" -gt 0 ] || die "mmcli timeout must be greater than zero"
	case "$STATE_DIR" in /|*/../*|*/..) die "unsafe state_dir" ;; /*) : ;; *) die "state_dir must be absolute" ;; esac
	case "$CACHE_DIR" in /|*/../*|*/..) die "unsafe cache_dir" ;; /*) : ;; *) die "cache_dir must be absolute" ;; esac
	case "$CACHE_DIR" in "$STATE_DIR"/?*) : ;; *) die "cache_dir must be inside state_dir" ;; esac
	case "$LOCK_DIR" in /|*/../*|*/..) die "unsafe lock_dir" ;; /*) : ;; *) die "lock_dir must be absolute" ;; esac
	case "$ACTION_STATE_DIR" in /tmp/?*) : ;; *) die "action_state_dir must be a child of /tmp" ;; esac
	case "$ACTION_STATE_DIR" in */../*|*/..) die "unsafe action_state_dir" ;; esac
	case "$COMMAND_NAME" in
		detect|detect-json|apply|reconcile|modem-reset|status|status-json)
			[ -r "$DATABASE" ] || die "database not readable: $DATABASE"
			database_format="$(database_declared_format)"
			case "$database_format" in
				''|2) : ;;
				*) die "unsupported provider database format: $database_format" ;;
			esac
		;;
	esac
	# apply-manual needs a working backend, connectivity check and netifd, but
	# deliberately not the provider database: the profile came from the user.
	case "$COMMAND_NAME" in
		detect|detect-json|apply|reconcile|modem-reset|status|status-json|apply-manual)
			case "$TARGET_BACKEND" in
				modemmanager) command_exists mmcli || die "mmcli is required" ;;
				qmi) [ -x "$QMI_ADAPTER" ] || die "QMI identity adapter is not executable" ;;
				mbim) [ -x "$MBIM_ADAPTER" ] || die "MBIM identity adapter is not executable" ;;
			esac
		;;
	esac
	case "$COMMAND_NAME" in apply|reconcile|modem-reset|apply-manual) command_exists curl || die "curl is required" ;; esac
	case "$COMMAND_NAME" in
		apply|reconcile|modem-reset|roaming-policy-set|reset|apply-manual)
			command_exists ifup || die "ifup is required"
			command_exists ifdown || die "ifdown is required"
		;;
	esac
}

database_metadata_value() {
	key="$1"
	awk -v prefix="# ${key}: " '
		index($0, prefix) == 1 {
			print substr($0, length(prefix) + 1)
			exit
		}
	' "$DATABASE"
}

database_declared_format() {
	declared_format="$(database_metadata_value database-format)"
	if [ -z "$declared_format" ]; then
		declared_format="$(sed -n 's/^# apn-autoconfig generated provider database v\([0-9][0-9]*\)$/\1/p' \
			"$DATABASE" | sed -n '1p')"
	fi
	printf '%s\n' "$declared_format"
}

read_database_metadata() {
	DATABASE_VERSION="$(database_metadata_value database-version)"
	DATABASE_FORMAT="$(database_declared_format)"
	DATABASE_SOURCES="$(database_metadata_value sources)"
	DATABASE_REVISIONS="$(database_metadata_value revisions)"
}

kv_value_from() {
	file="$1"
	keys="$2"
	awk -F ':' -v wanted="$keys" '
		BEGIN { n=split(wanted, a, " ") }
		{
			key=$1
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
			for (i=1; i<=n; i++) if (key == a[i]) {
				$1=""
				sub(/^:[[:space:]]*/, "", $0)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
				if ($0 != "--" && $0 != "unknown") { print $0; exit }
			}
		}
	' "$file"
}

kv_value() {
	kv_value_from "$SIM_DATA" "$1"
}

resolve_sim_index() {
	: >"$MODEM_LIST"
	if run_read_bounded modem-list "$MMCLI_TIMEOUT_SECONDS" "$MODEM_DATA" mmcli -L; then
		sed -n 's#^.*/Modem/\([0-9][0-9]*\).*#\1#p' "$MODEM_DATA" >"$MODEM_LIST"
	fi

	selected_sim=""
	selected_modem=""
	first_sim=""
	first_modem=""
	modem_count=0
	while IFS= read -r modem_index; do
		case "$modem_index" in ''|*[!0-9]*) continue ;; esac
		run_read_bounded modem-status "$MMCLI_TIMEOUT_SECONDS" "$MODEM_DATA" \
			mmcli -m "$modem_index" --output-keyvalue || continue
		modem_count=$((modem_count + 1))
		modem_device="$(kv_value_from "$MODEM_DATA" 'modem.generic.device')"
		modem_physdev="$(kv_value_from "$MODEM_DATA" 'modem.generic.physdev')"
		sim_path="$(kv_value_from "$MODEM_DATA" 'modem.generic.sim')"
		sim_index="${sim_path##*/}"
		case "$sim_index" in ''|*[!0-9]*) continue ;; esac
		[ -n "$first_sim" ] || first_sim="$sim_index"
		[ -n "$first_modem" ] || first_modem="$modem_index"

		if [ -z "$NETWORK_DEVICE" ] || \
			[ "$modem_device" = "$NETWORK_DEVICE" ] || \
			[ "$modem_physdev" = "$NETWORK_DEVICE" ]; then
			selected_sim="$sim_index"
			selected_modem="$modem_index"
			break
		fi
	done <"$MODEM_LIST"

	if [ -z "$selected_sim" ] && [ "$modem_count" -eq 1 ]; then
		selected_sim="$first_sim"
		selected_modem="$first_modem"
	fi
	if [ -n "$selected_sim" ]; then
		SIM_INDEX="$selected_sim"
		MODEM_INDEX="$selected_modem"
		return 0
	fi

	if [ "$SIM_INDEX_FALLBACK" != "auto" ]; then
		SIM_INDEX="$SIM_INDEX_FALLBACK"
		[ "$modem_count" -eq 1 ] && MODEM_INDEX="$first_modem"
		log warning "primary SIM could not be resolved; falling back to configured SIM $SIM_INDEX"
		return 0
	fi
	return 1
}

# OpenWrt's MBIM handler gates roaming with two options instead of one, and its
# absent default is the opposite of ModemManager's: no options means blocked.
mbim_read_roaming_policy() {
	roaming_value="$(uci -q get "network.${INTERFACE}.allow_roaming" 2>/dev/null || printf '%s' -)"
	partner_value="$(uci -q get "network.${INTERFACE}.allow_partner" 2>/dev/null || printf '%s' -)"
	case "$roaming_value:$partner_value" in
		1:1)
			ROAMING_POLICY="explicit-allow"
			ROAMING_ALLOWED=true
		;;
		0:0)
			ROAMING_POLICY="explicit-block"
			ROAMING_ALLOWED=false
		;;
		-:-)
			ROAMING_POLICY="default-block"
			ROAMING_ALLOWED=false
		;;
		*)
			# Somebody configured these two deliberately and this project does
			# not own the answer, so the pair is reported, never guessed at.
			ROAMING_POLICY="invalid"
			ROAMING_ALLOWED=false
		;;
	esac
}

read_roaming_policy() {
	CONFIGURED_PLMN="$(uci -q get "network.${INTERFACE}.plmn" 2>/dev/null || :)"
	if [ "$TARGET_BACKEND" = mbim ]; then
		mbim_read_roaming_policy
		return 0
	fi
	if [ "$TARGET_BACKEND" = atdial ]; then
		# Same option as ModemManager, read the same way, but an absent value
		# means blocked rather than allowed: the handler refuses to dial on a
		# roaming registration unless the option explicitly says otherwise.
		if value="$(uci -q get "network.${INTERFACE}.allow_roaming" 2>/dev/null)"; then
			case "$value" in
				0) ROAMING_POLICY="explicit-block"; ROAMING_ALLOWED=false ;;
				1) ROAMING_POLICY="explicit-allow"; ROAMING_ALLOWED=true ;;
				*) ROAMING_POLICY="invalid"; ROAMING_ALLOWED=false ;;
			esac
		else
			ROAMING_POLICY="default-block"
			ROAMING_ALLOWED=false
		fi
		return 0
	fi
	if [ "$TARGET_BACKEND" != modemmanager ]; then
		# Roaming policy belongs to the connection manager. QMI has no tested
		# policy mapping, so it is reported as unsupported rather than guessed.
		ROAMING_POLICY="unsupported"
		ROAMING_ALLOWED=true
		return 0
	fi
	if value="$(uci -q get "network.${INTERFACE}.allow_roaming" 2>/dev/null)"; then
		case "$value" in
			0)
				ROAMING_POLICY="explicit-block"
				ROAMING_ALLOWED=false
			;;
			1)
				ROAMING_POLICY="explicit-allow"
				ROAMING_ALLOWED=true
			;;
			*)
				ROAMING_POLICY="invalid"
				ROAMING_ALLOWED=false
			;;
		esac
	else
		# OpenWrt's ModemManager protocol handler explicitly defaults to yes.
		ROAMING_POLICY="default-allow"
		ROAMING_ALLOWED=true
	fi
}

read_access_technologies() {
	awk -F ':' '
		/^modem\.generic\.access-technologies\.value\[[0-9]+\]/ {
			value=$2
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
			if (value != "" && value != "--" && value != "unknown") {
				if (out != "") out=out ","
				out=out value
			}
		}
		END { print out }
	' "$MODEM_DATA"
}

modemmanager_refresh_modem_status() {
	MODEM_STATE="unknown"
	REGISTRATION_STATE="unknown"
	ROAMING_STATUS="unknown"
	SERVING_OPERATOR_ID=""
	SERVING_OPERATOR_NAME=""
	ACCESS_TECHNOLOGIES=""
	SIGNAL_QUALITY=""
	read_roaming_policy

	[ -n "$MODEM_INDEX" ] || return 1
	run_read_bounded modem-status "$MMCLI_TIMEOUT_SECONDS" "$MODEM_DATA" \
		mmcli -m "$MODEM_INDEX" --output-keyvalue || return 1
	MODEM_STATE="$(kv_value_from "$MODEM_DATA" 'modem.generic.state')"
	REGISTRATION_STATE="$(kv_value_from "$MODEM_DATA" 'modem.3gpp.registration-state')"
	SERVING_OPERATOR_ID="$(kv_value_from "$MODEM_DATA" 'modem.3gpp.operator-code')"
	SERVING_OPERATOR_NAME="$(kv_value_from "$MODEM_DATA" 'modem.3gpp.operator-name')"
	SIGNAL_QUALITY="$(kv_value_from "$MODEM_DATA" 'modem.generic.signal-quality.value')"
	ACCESS_TECHNOLOGIES="$(read_access_technologies)"
	[ -n "$MODEM_STATE" ] || MODEM_STATE="unknown"
	[ -n "$REGISTRATION_STATE" ] || REGISTRATION_STATE="unknown"
	case "$REGISTRATION_STATE" in
		roaming|roaming-sms-only) ROAMING_STATUS=true ;;
		home|home-sms-only) ROAMING_STATUS=false ;;
		*) ROAMING_STATUS=unknown ;;
	esac
	return 0
}

# Unlike QMI, MBIM can refresh registration during an operation, so the roaming
# guards in apply_candidate_list are live for this backend. The adapter is
# read-only and reuses netifd's open session, so re-reading mid-operation does
# not disturb the bearer being tested.
mbim_refresh_modem_status() {
	MODEM_STATE="unknown"
	REGISTRATION_STATE="unknown"
	ROAMING_STATUS="unknown"
	SERVING_OPERATOR_ID=""
	SERVING_OPERATOR_NAME=""
	ACCESS_TECHNOLOGIES=""
	SIGNAL_QUALITY=""
	read_roaming_policy

	mbim_resolve_control_device || return 1
	run_read_bounded modem-status '' "$MODEM_DATA" \
		"$MBIM_ADAPTER" identity "$NETWORK_DEVICE" || return 1
	[ "$(sed -n '1p' "$MODEM_DATA")" = "v1" ] || return 1

	MODEM_STATE="$(adapter_identity_value "$MODEM_DATA" modem_state)"
	REGISTRATION_STATE="$(adapter_identity_value "$MODEM_DATA" registration_state)"
	ROAMING_STATUS="$(adapter_identity_value "$MODEM_DATA" roaming)"
	SERVING_OPERATOR_ID="$(adapter_identity_value "$MODEM_DATA" serving_operator_id)"
	SERVING_OPERATOR_NAME="$(adapter_identity_value "$MODEM_DATA" serving_operator_name)"
	SIGNAL_QUALITY="$(adapter_identity_value "$MODEM_DATA" signal_quality)"
	[ -n "$MODEM_STATE" ] || MODEM_STATE="unknown"
	[ -n "$REGISTRATION_STATE" ] || REGISTRATION_STATE="unknown"
	case "$ROAMING_STATUS" in true|false|unknown) : ;; *) ROAMING_STATUS=unknown ;; esac
	return 0
}

refresh_modem_status() {
	case "$TARGET_BACKEND" in
		modemmanager) modemmanager_refresh_modem_status ;;
		mbim) mbim_refresh_modem_status ;;
		*) return 1 ;;
	esac
}

modemmanager_read_sim() {
	resolve_sim_index || die_code 3 "cannot yet resolve the primary SIM for interface $INTERFACE"
	run_read_bounded sim-identity "$MMCLI_TIMEOUT_SECONDS" "$SIM_DATA" \
		mmcli -i "$SIM_INDEX" --output-keyvalue || \
		die_code 3 "cannot yet read SIM $SIM_INDEX with mmcli"
	IMSI="$(kv_value 'sim.properties.imsi')"
	ICCID="$(kv_value 'sim.properties.iccid sim.properties.sim-identifier sim.properties.identifier')"
	EID="$(kv_value 'sim.properties.eid')"
	OPERATOR_ID="$(kv_value 'sim.properties.operator-id sim.properties.operator-code')"
	OPERATOR_NAME="$(kv_value 'sim.properties.operator-name')"
	GID1="$(kv_value 'sim.properties.gid1')"
	GID2="$(kv_value 'sim.properties.gid2')"
	[ -n "$ICCID" ] || die_code 3 "SIM ICCID is not available yet"
	case "$ICCID" in *[!0-9]*) die "unexpected ICCID format" ;; esac
	refresh_modem_status || :
}

# Both native adapters answer in the same v1 identity TSV.
adapter_identity_value() {
	identity_file="$1"
	key="$2"
	awk -F '\t' -v wanted="$key" '
		NR == 1 { next }
		$1 == wanted { print substr($0, length($1) + 2); exit }
	' "$identity_file"
}

qmi_identity_value() {
	adapter_identity_value "$SIM_DATA" "$1"
}

# Every name here is prefixed because POSIX shell has no local scope and this
# function is called from resolve_control_device's own loop variables.
control_device_is_safe() {
	safe_infix="$1"
	safe_device="$2"
	case "$safe_device" in /dev/*) : ;; *) return 1 ;; esac
	safe_name="${safe_device#/dev/}"
	case "$safe_name" in ''|*/*|*[!A-Za-z0-9_.-]*) return 1 ;; esac
	case "$safe_name" in
		cdc-wdm*)
			safe_index="${safe_name#cdc-wdm}"
			case "$safe_index" in ''|*[!0-9]*) return 1 ;; esac
		;;
		wwan*"$safe_infix"*)
			safe_wwan_index="${safe_name#wwan}"
			safe_wwan_index="${safe_wwan_index%%"$safe_infix"*}"
			safe_channel_index="${safe_name##*"$safe_infix"}"
			case "$safe_wwan_index:$safe_channel_index" in *[!0-9:]*) return 1 ;; esac
			[ -n "$safe_wwan_index" ] && [ -n "$safe_channel_index" ] || return 1
			[ "$safe_name" = "wwan${safe_wwan_index}${safe_infix}${safe_channel_index}" ] || return 1
		;;
		*) return 1 ;;
	esac
}

qmi_control_device_is_safe() {
	control_device_is_safe qmi "$1"
}

mbim_control_device_is_safe() {
	control_device_is_safe mbim "$1"
}

resolve_control_device() {
	protocol_infix="$1"
	if [ -n "$NETWORK_DEVICE" ]; then
		control_device_is_safe "$protocol_infix" "$NETWORK_DEVICE"
		return $?
	fi
	resolved_sysfs="$(readlink -f "$SYSFS_ROOT" 2>/dev/null)" || return 1
	resolved_devpath="$(readlink -f "$NETWORK_DEVPATH" 2>/dev/null)" || return 1
	case "$resolved_devpath" in "$resolved_sysfs"/devices/*) : ;; *) return 1 ;; esac
	NETWORK_DEVPATH="$resolved_devpath"

	resolved=""
	count=0
	for candidate in \
		"$NETWORK_DEVPATH"/usbmisc/cdc-wdm* \
		"$NETWORK_DEVPATH"/*/usbmisc/cdc-wdm* \
		"$NETWORK_DEVPATH"/*/wwan[0-9]*/wwan[0-9]*"$protocol_infix"[0-9]* \
		"$NETWORK_DEVPATH"/*/*/wwan[0-9]*/wwan[0-9]*"$protocol_infix"[0-9]*
	do
		[ -e "$candidate" ] || continue
		device="/dev/${candidate##*/}"
		control_device_is_safe "$protocol_infix" "$device" || continue
		[ "$device" = "$resolved" ] && continue
		resolved="$device"
		count=$((count + 1))
	done
	[ "$count" -eq 1 ] || return 1
	NETWORK_DEVICE="$resolved"
}

qmi_resolve_control_device() {
	resolve_control_device qmi
}

mbim_resolve_control_device() {
	resolve_control_device mbim
}

# AT identity comes from apn-autoconfig-modem, not from an adapter here.
#
# This is the decision 0.14.0 deferred until it had a caller. The protocol
# handler holds the AT port for a whole bring-up, so a second resolver and
# parser in this package would contend with both it and the modem package for
# one serial port — the failure the mandatory port lock exists to prevent. One
# implementation, one owner of the lock.
atdial_read_sim() {
	command_exists apn-autoconfig-modem || \
		die_code 3 "apn-autoconfig-modem is required to read identity for $TARGET_ID"

	# Bounded like every other read-path call: resolving an interface costs a
	# full inventory scan, which is exactly the kind of wait the deadline
	# exists to survive.
	atdial_resolve_status=0
	run_read_bounded modem-resolve '' "$READ_DATA" \
		apn-autoconfig-modem resolve --interface "$INTERFACE" || atdial_resolve_status=$?
	if [ "$atdial_resolve_status" -ne 0 ] && read_was_abandoned modem-resolve; then
		die_code 3 "resolving the modem bound to $TARGET_ID ran out of time"
	fi
	atdial_modem_id="$(sed -n '1p' "$READ_DATA" 2>/dev/null || :)"
	[ -n "$atdial_modem_id" ] || \
		die_code 4 "no unambiguous modem is bound to $TARGET_ID"
	state_value_is_safe "$atdial_modem_id" || die "unsafe modem identity for $TARGET_ID"

	atdial_status=0
	run_read_bounded sim-identity '' "$SIM_DATA" \
		apn-autoconfig-modem at-identity --modem "$atdial_modem_id" || atdial_status=$?
	case "$atdial_status" in
		0) : ;;
		# 4 is an ownership refusal — another control owner holds the modem —
		# which is a different thing from a modem that cannot answer yet.
		4) die_code 4 "another control owner holds the modem bound to $TARGET_ID" ;;
		3) die_code 3 "cannot yet read AT SIM identity for $TARGET_ID" ;;
		*)
			read_was_abandoned sim-identity && \
				die_code 3 "the AT SIM identity read for $TARGET_ID ran out of time"
			die "the AT identity backend returned invalid or incomplete data"
		;;
	esac

	native_parse_identity AT
}

qmi_read_sim() {
	native_read_sim QMI "$QMI_ADAPTER" qmi_resolve_control_device
}

mbim_read_sim() {
	native_read_sim MBIM "$MBIM_ADAPTER" mbim_resolve_control_device
}

# Both native adapters answer in the same v1 identity TSV and have the same
# failure classes, so only the adapter and its control-device resolver differ.
native_read_sim() {
	native_label="$1"
	native_adapter="$2"
	native_resolver="$3"

	"$native_resolver" || \
		die_code 4 "$native_label target $TARGET_ID requires a safe control device path"

	native_status=0
	run_read_bounded sim-identity '' "$SIM_DATA" \
		"$native_adapter" identity "$NETWORK_DEVICE" || native_status=$?
	case "$native_status" in
		0) : ;;
		3) die_code 3 "cannot yet read $native_label SIM identity for $TARGET_ID" ;;
		*)
			# An adapter the deadline cut short said nothing about the modem.
			# Reporting that as malformed output would turn "we stopped
			# listening" into a claim about the hardware.
			read_was_abandoned sim-identity && \
				die_code 3 "the $native_label SIM identity read for $TARGET_ID ran out of time"
			die "$native_label identity adapter returned invalid or incomplete data"
		;;
	esac
	native_parse_identity "$native_label"
}

# Everything after the identity has been produced. Split out because the AT-dial
# backend obtains the same v1 contract from apn-autoconfig-modem rather than
# from an adapter of its own, and duplicating this validation is exactly how the
# two would drift apart.
native_parse_identity() {
	native_label="$1"
	[ "$(sed -n '1p' "$SIM_DATA")" = "v1" ] || die "unsupported $native_label identity contract"

	SIM_INDEX="$(qmi_identity_value sim_index)"
	MODEM_INDEX="$(qmi_identity_value modem_index)"
	ICCID="$(qmi_identity_value iccid)"
	IMSI="$(qmi_identity_value imsi)"
	EID="$(qmi_identity_value eid)"
	OPERATOR_ID="$(qmi_identity_value operator_id)"
	OPERATOR_NAME="$(qmi_identity_value operator_name)"
	GID1="$(qmi_identity_value gid1)"
	GID2="$(qmi_identity_value gid2)"
	MODEM_STATE="$(qmi_identity_value modem_state)"
	REGISTRATION_STATE="$(qmi_identity_value registration_state)"
	ROAMING_STATUS="$(qmi_identity_value roaming)"
	SERVING_OPERATOR_ID="$(qmi_identity_value serving_operator_id)"
	SERVING_OPERATOR_NAME="$(qmi_identity_value serving_operator_name)"
	ACCESS_TECHNOLOGIES="$(qmi_identity_value access_technologies)"
	SIGNAL_QUALITY="$(qmi_identity_value signal_quality)"
	CONFIGURED_PLMN="$(uci -q get "network.${INTERFACE}.plmn" 2>/dev/null || :)"
	read_roaming_policy

	case "$SIM_INDEX" in ''|*[!0-9]*) die "invalid $native_label SIM index" ;; esac
	case "$ICCID" in ''|*[!0-9]*) die "unexpected $native_label ICCID format" ;; esac
	case "$IMSI" in ''|*[!0-9]*) [ -z "$IMSI" ] || die "unexpected $native_label IMSI format" ;; esac
	case "$OPERATOR_ID" in ''|*[!0-9]*) [ -z "$OPERATOR_ID" ] || die "unexpected $native_label operator ID format" ;; esac
	case "$ROAMING_STATUS" in true|false|unknown) : ;; *) die "unexpected $native_label roaming status" ;; esac
	for value in "$MODEM_INDEX" "$EID" "$OPERATOR_NAME" "$GID1" "$GID2" \
		"$MODEM_STATE" "$REGISTRATION_STATE" "$SERVING_OPERATOR_ID" \
		"$SERVING_OPERATOR_NAME" "$ACCESS_TECHNOLOGIES" "$SIGNAL_QUALITY"; do
		state_value_is_safe "$value" || die "unsafe value returned by $native_label identity adapter"
	done
}

read_sim() {
	case "$TARGET_BACKEND" in
		modemmanager) modemmanager_read_sim ;;
		qmi) qmi_read_sim ;;
		mbim) mbim_read_sim ;;
		atdial) atdial_read_sim ;;
		*) die_code 4 "backend $TARGET_BACKEND cannot read SIM identity" ;;
	esac
	for value in "$SIM_INDEX" "$MODEM_INDEX" "$ICCID" "$IMSI" "$EID" \
		"$OPERATOR_ID" "$OPERATOR_NAME" "$GID1" "$GID2" "$MODEM_STATE" \
		"$REGISTRATION_STATE" "$SERVING_OPERATOR_ID" "$SERVING_OPERATOR_NAME" \
		"$ACCESS_TECHNOLOGIES" "$SIGNAL_QUALITY" "$CONFIGURED_PLMN"; do
		state_value_is_safe "$value" || die "unsafe multiline value returned by identity backend"
	done
}

cache_file() {
	printf '%s/%s.tsv\n' "$CACHE_DIR" "$ICCID"
}

cached_apn() {
	file="$(cache_file)"
	[ -r "$file" ] || return 1
	awk -F '\t' 'NR == 1 && ($1 == "v1" || $1 == "v2") { print $2; exit }' "$file"
}

cached_provider() {
	file="$(cache_file)"
	[ -r "$file" ] || return 1
	awk -F '\t' 'NR == 1 && ($1 == "v1" || $1 == "v2") { print $3; exit }' "$file"
}

cached_version() {
	file="$(cache_file)"
	[ -r "$file" ] || return 1
	awk -F '\t' 'NR == 1 && ($1 == "v1" || $1 == "v2") { print $1; exit }' "$file"
}

cached_profile_field() {
	column="$1"
	file="$(cache_file)"
	[ -r "$file" ] || return 1
	awk -F '\t' -v column="$column" '
		NR == 1 && $1 == "v2" {
			result=$column
			if (result == "") print "-"; else print result
			exit
		}
		NR == 1 && $1 == "v1" { print "-"; exit }
	' "$file"
}

find_candidates() {
	: >"$CANDIDATES"
	awk -F '\t' \
		-v operator_id="$OPERATOR_ID" \
		-v imsi="$IMSI" \
		-v iccid="$ICCID" \
		-v gid1="$GID1" \
		-v spn="$OPERATOR_NAME" '
		function wildcard(v) { return v == "" || v == "-" || v == "*" }
		function starts(value, prefix) { return substr(value, 1, length(prefix)) == prefix }
		function digit_pattern(value, pattern, i, expected, actual) {
			if (length(value) < length(pattern)) return 0
			pattern=tolower(pattern)
			for (i=1; i<=length(pattern); i++) {
				expected=substr(pattern, i, 1)
				actual=substr(value, i, 1)
				if (expected != "x" && expected != actual) return 0
			}
			return 1
		}
		BEGIN { OFS="\t"; spn_l=tolower(spn); gid1_l=tolower(gid1) }
		/^[[:space:]]*#/ || NF < 8 { next }
		{
			mccmnc=$1; imsi_pattern=$2; iccid_pattern=$3; row_gid1=$4
			row_spn=$5; provider=$6; apn=$7; priority=$8
			username=NF >= 9 && $9 != "" ? $9 : "-"
			password=NF >= 10 && $10 != "" ? $10 : "-"
			auth=NF >= 11 && $11 != "" ? $11 : "-"
			ip_type=NF >= 12 && $12 != "" ? $12 : "-"
			if (!wildcard(mccmnc) && operator_id != mccmnc &&
			    !(operator_id == "" && starts(imsi, mccmnc))) next
			if (!wildcard(imsi_pattern) && !digit_pattern(imsi, imsi_pattern)) next
			if (!wildcard(iccid_pattern) && !digit_pattern(iccid, iccid_pattern)) next
			if (!wildcard(row_gid1) && tolower(row_gid1) != gid1_l) next
			if (!wildcard(row_spn) && spn_l != tolower(row_spn)) next
			score=0
			if (!wildcard(mccmnc)) score += 100 + length(mccmnc)
			if (!wildcard(imsi_pattern)) score += 200 + length(imsi_pattern)
			if (!wildcard(iccid_pattern)) score += 200 + length(iccid_pattern)
			if (!wildcard(row_gid1)) score += 50
			if (!wildcard(row_spn)) score += 40
			if (priority !~ /^[0-9]+$/) priority=100
			# Fixed-width inverse score makes the required order portable even on
			# BusyBox sort variants that handle per-key reverse modifiers differently.
			rank=999999-score
			printf "%06d\t%06d\t%s\t%s\t%s\t%s\t%s\t%s\n", \
				rank, priority, apn, provider, username, password, auth, ip_type
		}
	' "$DATABASE" | sort | awk -F '\t' '!seen[$3 SUBSEP $5 SUBSEP $6 SUBSEP $7 SUBSEP $8]++' >"$CANDIDATES"
}

print_identity() {
	printf 'SIM index:       %s\n' "$SIM_INDEX"
	printf 'Modem index:     %s\n' "${MODEM_INDEX:--}"
	printf 'ICCID:           %s\n' "$ICCID"
	printf 'IMSI:            %s\n' "${IMSI:--}"
	printf 'EID:             %s\n' "${EID:--}"
	printf 'Home operator:   %s\n' "${OPERATOR_ID:--}"
	printf 'Provider/SPN:    %s\n' "${OPERATOR_NAME:--}"
	printf 'GID1 / GID2:     %s / %s\n' "${GID1:--}" "${GID2:--}"
	printf 'Registration:    %s\n' "$REGISTRATION_STATE"
	printf 'Serving network: %s (%s)\n' "${SERVING_OPERATOR_NAME:--}" "${SERVING_OPERATOR_ID:--}"
	printf 'Roaming policy:  %s\n' "$ROAMING_POLICY"
	printf 'Access / signal: %s / %s%%\n' "${ACCESS_TECHNOLOGIES:--}" "${SIGNAL_QUALITY:--}"
	[ -n "$CONFIGURED_PLMN" ] && printf 'Manual PLMN:     %s\n' "$CONFIGURED_PLMN"
}

detect_cmd() {
	read_sim
	find_candidates
	print_identity
	cache="$(cached_apn 2>/dev/null || :)"
	if [ -n "$cache" ]; then
		printf 'Cached APN:      %s\n' "$cache"
	else
		printf 'Cached APN:      -\n'
	fi
	printf '\nCandidates from %s:\n' "$DATABASE"
	if [ -s "$CANDIDATES" ]; then
		awk -F '\t' '{ printf "  %d. %-28s %s\n", NR, $3, $4 }' "$CANDIDATES"
	else
		printf '  none (no matching profile is present in the provider database)\n'
	fi
}

current_apn() {
	uci -q get "network.${INTERFACE}.apn"
}

write_baseline_option() {
	file="$1"
	option="$2"
	set_flag="$3"
	value="$4"
	state_value_is_safe "$value" || die "refusing to save an unsafe $option value"
	printf 'option\t%s\t%s\t%s\n' "$option" "$set_flag" "$value" >>"$file" || \
		die "cannot write baseline option $option"
}

migrate_legacy_baseline() {
	[ -r "$BASELINE_FILE" ] || return 0
	[ "$(awk -F '\t' 'NR == 1 { print $1 }' "$BASELINE_FILE")" = "v1" ] || return 0
	[ "$TARGET_BACKEND" = modemmanager ] || \
		die "a legacy ModemManager baseline cannot be migrated to backend $TARGET_BACKEND"
	legacy_interface="$(awk -F '\t' 'NR == 1 { print $2 }' "$BASELINE_FILE")"
	legacy_set="$(awk -F '\t' 'NR == 1 { print $3 }' "$BASELINE_FILE")"
	legacy_apn="$(awk -F '\t' 'NR == 1 { print $4 }' "$BASELINE_FILE")"
	[ "$legacy_interface" = "$INTERFACE" ] || \
		die "legacy baseline belongs to interface $legacy_interface; run reset before changing interfaces"
	case "$legacy_set" in 0|1) : ;; *) die "invalid legacy baseline set flag" ;; esac
	[ "$legacy_apn" = "<empty>" ] && legacy_apn=""
	state_value_is_safe "$legacy_apn" || die "unsafe APN in legacy baseline"

	mkdir -p "$TARGET_STATE_DIR" || die "cannot create target state directory: $TARGET_STATE_DIR"
	tmp="$TARGET_STATE_DIR/.baseline.migrate.$$"
	printf 'v3\t%s\t%s\t%s\t%s\n' "$legacy_interface" "$TARGET_ID" "$TARGET_BACKEND" "$TARGET_PROTOCOL" >"$tmp" || die "cannot migrate legacy baseline"
	write_baseline_option "$tmp" apn "$legacy_set" "$legacy_apn"
	# v0.5 changed only APN, so the current optional values are still the
	# original values and can safely complete the old baseline.
	write_baseline_option "$tmp" username "$OLD_USERNAME_SET" "$OLD_USERNAME"
	write_baseline_option "$tmp" password "$OLD_PASSWORD_SET" "$OLD_PASSWORD"
	write_baseline_option "$tmp" allowedauth "$OLD_ALLOWEDAUTH_SET" "$OLD_ALLOWEDAUTH"
	write_baseline_option "$tmp" iptype "$OLD_IPTYPE_SET" "$OLD_IPTYPE"
	mv "$tmp" "$BASELINE_FILE" || die "cannot install migrated baseline"
	log notice "migrated v1 APN baseline to a complete v3 target profile baseline"
}

save_baseline() {
	[ -e "$BASELINE_FILE" ] && return 0
	mkdir -p "$TARGET_STATE_DIR" || die "cannot create target state directory: $TARGET_STATE_DIR"
	tmp="$TARGET_STATE_DIR/.baseline.tmp.$$"
	printf 'v3\t%s\t%s\t%s\t%s\n' "$INTERFACE" "$TARGET_ID" "$TARGET_BACKEND" "$TARGET_PROTOCOL" >"$tmp" || die "cannot write baseline"
	write_baseline_option "$tmp" apn "$OLD_APN_SET" "$OLD_APN"
	write_baseline_option "$tmp" username "$OLD_USERNAME_SET" "$OLD_USERNAME"
	write_baseline_option "$tmp" password "$OLD_PASSWORD_SET" "$OLD_PASSWORD"
	case "$TARGET_BACKEND" in
		modemmanager)
			write_baseline_option "$tmp" allowedauth "$OLD_ALLOWEDAUTH_SET" "$OLD_ALLOWEDAUTH"
			write_baseline_option "$tmp" iptype "$OLD_IPTYPE_SET" "$OLD_IPTYPE"
		;;
		qmi|mbim|atdial)
			write_baseline_option "$tmp" auth "$OLD_ALLOWEDAUTH_SET" "$OLD_ALLOWEDAUTH"
			write_baseline_option "$tmp" pdptype "$OLD_IPTYPE_SET" "$OLD_IPTYPE"
		;;
		*) die "cannot save a baseline for backend $TARGET_BACKEND" ;;
	esac
	mv "$tmp" "$BASELINE_FILE" || die "cannot install baseline"
	log notice "saved original mobile profile for interface $INTERFACE"
}

reset_cmd() {
	acquire_lock
	migrate_target_state
	if [ ! -r "$BASELINE_FILE" ]; then
		rm -rf "$CACHE_DIR"
		rm -f "$ACTIVE_FILE"
		rmdir "$TARGET_STATE_DIR" 2>/dev/null || :
		log notice "no saved APN baseline; cache cleared, network unchanged"
		return 0
	fi
	baseline_version="$(awk -F '\t' 'NR == 1 { print $1 }' "$BASELINE_FILE")"
	baseline_interface="$(awk -F '\t' 'NR == 1 { print $2 }' "$BASELINE_FILE")"
	baseline_backend=""
	case "$baseline_interface" in ''|*[!A-Za-z0-9_]*) die "invalid interface in baseline" ;; esac
	[ "$baseline_interface" = "$INTERFACE" ] || \
		die "baseline belongs to interface $baseline_interface, not selected interface $INTERFACE"
	case "$baseline_version" in
		v1|v2) [ "$TARGET_BACKEND" = modemmanager ] || die "legacy baseline is only valid for a ModemManager target" ;;
	esac
	if [ "$baseline_version" = v3 ]; then
		baseline_target="$(awk -F '\t' 'NR == 1 { print $3 }' "$BASELINE_FILE")"
		baseline_backend="$(awk -F '\t' 'NR == 1 { print $4 }' "$BASELINE_FILE")"
		[ "$baseline_target" = "network:$baseline_interface" ] || die "v3 baseline target does not match its interface"
		[ "$baseline_target" = "$TARGET_ID" ] || die "v3 baseline belongs to another target"
		case "$baseline_backend" in modemmanager|qmi|mbim|atdial) : ;; *) die "unsupported backend in v3 baseline" ;; esac
		[ "$baseline_backend" = "$TARGET_BACKEND" ] || die "v3 baseline backend does not match the selected target"
	fi

	INTERFACE="$baseline_interface"
	case "$baseline_version" in
		v1)
			baseline_set="$(awk -F '\t' 'NR == 1 { print $3 }' "$BASELINE_FILE")"
			baseline_apn="$(awk -F '\t' 'NR == 1 { print $4 }' "$BASELINE_FILE")"
			case "$baseline_set" in 0|1) : ;; *) die "invalid set flag in baseline" ;; esac
			[ "$baseline_apn" = "<empty>" ] && baseline_apn=""
			case "$baseline_apn" in ''|*[!A-Za-z0-9._-]*) [ -z "$baseline_apn" ] || die "invalid APN in baseline" ;; esac
			set_or_delete_option apn "$baseline_set" "$baseline_apn" || die "cannot restore baseline APN"
		;;
		v2|v3)
			while IFS="$(printf '\t')" read -r kind option set_flag value; do
				[ "$kind" = "option" ] || continue
				case "$baseline_version:$baseline_backend:$option" in
					v2::apn|v2::username|v2::password|v2::allowedauth|v2::iptype) : ;;
					v3:modemmanager:apn|v3:modemmanager:username|v3:modemmanager:password|v3:modemmanager:allowedauth|v3:modemmanager:iptype) : ;;
					v3:qmi:apn|v3:qmi:username|v3:qmi:password|v3:qmi:auth|v3:qmi:pdptype) : ;;
					v3:mbim:apn|v3:mbim:username|v3:mbim:password|v3:mbim:auth|v3:mbim:pdptype) : ;;
					v3:atdial:apn|v3:atdial:username|v3:atdial:password|v3:atdial:auth|v3:atdial:pdptype) : ;;
					*) die "invalid option in baseline" ;;
				esac
				case "$set_flag" in 0|1) : ;; *) die "invalid set flag in baseline" ;; esac
				state_value_is_safe "$value" || die "unsafe value in baseline"
			done <"$BASELINE_FILE"
			# Validate the complete file before the first UCI write so a malformed
			# trailing record can never cause a partial baseline restore.
			while IFS="$(printf '\t')" read -r kind option set_flag value; do
				[ "$kind" = "option" ] || continue
				set_or_delete_option "$option" "$set_flag" "$value" || die "cannot restore baseline $option"
			done <"$BASELINE_FILE"
		;;
		*) die "unknown baseline format" ;;
	esac
	uci commit network >/dev/null 2>&1 || die "cannot commit restored mobile profile"
	ifdown "$INTERFACE" >/dev/null 2>&1 || :
	settle_after_ifdown
	ifup "$INTERFACE" >/dev/null 2>&1 || die "restored mobile profile, but interface $INTERFACE did not start"
	rm -rf "$CACHE_DIR"
	rm -f "$ACTIVE_FILE"
	rm -f "$BASELINE_FILE"
	rmdir "$TARGET_STATE_DIR" 2>/dev/null || :
	log notice "restored original mobile profile; cache and baseline removed"
}

# Drops this engine's state for one target and nothing else. It exists because
# there was no safe way to clean up after a section was deleted: `reset` is the
# wrong tool, since its no-baseline path clears CACHE_DIR, which is shared by
# every target. Provisioning teardown needs to forget one target without
# touching another target's fast path.
forget_target_cmd() {
	[ -n "$REQUESTED_TARGET" ] || die_code 2 "forget-target requires --target"
	case "$REQUESTED_TARGET" in
		network:*) forget_section="${REQUESTED_TARGET#network:}" ;;
		*) die_code 4 "invalid target ID" ;;
	esac
	case "$forget_section" in ''|*[!A-Za-z0-9_]*) die_code 4 "invalid target interface" ;; esac
	case "$STATE_DIR" in /|*/../*|*/..) die "unsafe state_dir" ;; /*) : ;; *) die "state_dir must be absolute" ;; esac

	# A baseline is the only record of the profile this engine replaced. While
	# the section still exists, dropping it would strand a live target with no
	# way back, so this refuses rather than accepting the caller's word.
	if uci -q show network 2>/dev/null | grep -q "^network\.${forget_section}="; then
		die_code 4 "network section $forget_section still exists; forget-target only drops state for a section that is already gone"
	fi

	acquire_lock

	forget_dir="$STATE_DIR/targets/network_${forget_section}"
	if [ ! -d "$forget_dir" ]; then
		log notice "no engine state to forget for network:$forget_section"
		return 0
	fi
	# Named files only: never a recursive or wildcard delete under the state root.
	rm -f "$forget_dir/baseline.tsv" "$forget_dir/active.tsv" \
		"$forget_dir/last-result" "$forget_dir/last-result-code" \
		"$forget_dir/last-result-scope" "$forget_dir/desired-bearer-state"
	rmdir "$forget_dir" 2>/dev/null || \
		log warning "engine state directory for network:$forget_section is not empty; left in place"
	log notice "dropped engine state for network:$forget_section"
}

reset_all_cmd() {
	case "$STATE_DIR" in /|*/../*|*/..) die "unsafe state_dir" ;; /*) : ;; *) die "state_dir must be absolute" ;; esac
	self="$(engine_self_path)"
	found=0
	for target_dir in "$STATE_DIR"/targets/network_*; do
		[ -d "$target_dir" ] || continue
		section="${target_dir##*/network_}"
		case "$section" in ''|*[!A-Za-z0-9_]*) die "unsafe target state directory: $target_dir" ;; esac
		found=1
		sh "$self" reset --target "network:$section" || return $?
	done
	if [ -r "$STATE_DIR/baseline.tsv" ]; then
		section="$(awk -F '\t' 'NR == 1 { print $2; exit }' "$STATE_DIR/baseline.tsv")"
		case "$section" in ''|*[!A-Za-z0-9_]*) die "invalid interface in legacy baseline" ;; esac
		found=1
		sh "$self" reset --target "network:$section" || return $?
	fi
	if [ "$found" -eq 0 ]; then
		rm -rf "$CACHE_DIR"
		log notice "no saved target baselines; cache cleared, network unchanged"
	fi
}

interface_is_up() {
	if command_exists ubus; then
		ubus call "network.interface.${INTERFACE}" status 2>/dev/null | \
			grep -q '"up"[[:space:]]*:[[:space:]]*true'
	else
		return 1
	fi
}

refresh_l3_device() {
	L3_DEVICE=""
	command_exists ubus || return 1
	status="$(ubus call "network.interface.${INTERFACE}" status 2>/dev/null || :)"
	value="$(printf '%s\n' "$status" | sed -n 's/.*"l3_device"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | sed -n '1p')"
	[ -n "$value" ] || value="$(printf '%s\n' "$status" | sed -n 's/.*"device"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | sed -n '1p')"
	case "$value" in ''|*[!A-Za-z0-9_.:-]*) return 1 ;; esac
	L3_DEVICE="$value"
	return 0
}

connectivity_device() {
	refresh_l3_device || :
	printf '%s\n' "${L3_DEVICE:-$DEVICE}"
}

status_cmd() {
	read_sim
	read_database_metadata
	print_identity
	printf 'Engine target:   %s\n' "$TARGET_ID"
	# Which target this is one of. Reporting a single target's SIM and APN
	# without saying that another one is also being looked after would read as
	# if the other did not exist.
	if [ "${AUTO_TARGET_COUNT:-1}" -gt 1 ]; then
		printf 'Managed targets: %s\n' \
			"$(printf '%s\n' "$AUTO_TARGETS" | sed 's/^/network:/' | tr '\n' ' ' | sed 's/ $//')"
	fi
	printf 'APN database:    %s (format v%s)\n' "${DATABASE_VERSION:--}" "${DATABASE_FORMAT:--}"
	printf 'Database path:   %s\n' "$DATABASE"
	apn="$(current_apn 2>/dev/null || :)"
	printf 'Configured APN:  %s\n' "${apn:-<empty>}"
	cache="$(cached_apn 2>/dev/null || :)"
	printf 'Cached APN:      %s\n' "${cache:--}"
	if interface_is_up; then
		printf 'Interface %s:   up\n' "$INTERFACE"
	else
		printf 'Interface %s:   down or pending\n' "$INTERFACE"
	fi
	printf 'Last result:     '
	if [ -r "$CACHE_DIR/last-result" ]; then
		cat "$CACHE_DIR/last-result"
	else
		printf -- '-\n'
	fi
	printf 'Reconciled SIM:  '
	if active_state_file="$(active_file_for_read 2>/dev/null)"; then
		awk -F '\t' 'NR == 1 && ($1 == "v1" || $1 == "v2" || $1 == "v3") { printf "%s (%s)\n", $2, $3; found=1 } END { if (!found) print "invalid state" }' "$active_state_file"
	else
		printf -- '-\n'
	fi
}

json_escape() {
	awk 'BEGIN { ORS="" }
	{
		if (NR > 1) printf "\\n"
		gsub(/\\/, "\\\\")
		# A plain " needs no escape inside an awk regex, and gawk warns
		# about it loudly enough to bury real diagnostics in CI logs.
		gsub(/"/, "\\\"")
		gsub(/\t/, "\\t")
		gsub(/\r/, "\\r")
		printf "%s", $0
	}'
}

json_string() {
	printf '"'
	printf '%s' "$1" | json_escape
	printf '"'
}

json_key_string() {
	printf '"%s":' "$1"
	json_string "$2"
}

json_key_boolean_or_null() {
	printf '"%s":' "$1"
	case "$2" in true|false) printf '%s' "$2" ;; *) printf 'null' ;; esac
}

targets_json_cmd() {
	# No bounded hardware call reaches this command today: it answers from UCI
	# alone. The deadline is armed anyway, so the configuration is validated on
	# the same terms as the other two read commands and a call added here later
	# is covered without anybody having to remember this.
	read_deadline_arm
	discover_targets
	printf '{'
	json_key_string version "v2"; printf ','
	json_key_string configured_target "$([ "$CONFIGURED_INTERFACE" = auto ] && printf auto || printf 'network:%s' "$CONFIGURED_INTERFACE")"; printf ','
	printf '"targets":['
	separator=""
	while IFS="$(printf '\t')" read -r section proto; do
		[ -n "$section" ] || continue
		target_protocol_capabilities "$proto"
		printf '%s{' "$separator"
		json_key_string id "network:$section"; printf ','
		json_key_string interface "$section"; printf ','
		json_key_string protocol "$proto"; printf ','
		json_key_string backend "$TARGET_BACKEND"; printf ','
		printf '"capabilities":{'
		printf '"discover":true,'
		printf '"identity":%s,' "$TARGET_IDENTITY"
		printf '"profile_read":%s,' "$TARGET_PROFILE_READ"
		printf '"profile_write":%s,' "$TARGET_PROFILE_WRITE"
		printf '"profile_apply":%s,' "$TARGET_PROFILE_APPLY"
		printf '"roaming_policy_read":%s,' "$TARGET_ROAMING_POLICY_READ"
		printf '"roaming_policy_write":%s' "$TARGET_ROAMING_POLICY_WRITE"
		printf '},'
		json_key_string implementation_state "$TARGET_IMPLEMENTATION_STATE"; printf ','
		json_key_string validation_state "$TARGET_VALIDATION_STATE"; printf ','
		printf '"hardware_validated":%s,' "$TARGET_HARDWARE_VALIDATED"
		# Whether automatic operations act on this target. In automatic mode
		# that is every enabled writable target — a frontend needs to say which
		# modems are being looked after, and deriving it from capabilities alone
		# would silently include disabled and staged sections.
		targets_managed=false
		if [ "$CONFIGURED_INTERFACE" = auto ]; then
			if [ "$TARGET_PROFILE_APPLY" = true ] && ! section_is_disabled "$section"; then
				targets_managed=true
			fi
		elif [ "$section" = "$CONFIGURED_INTERFACE" ]; then
			targets_managed=true
		fi
		printf '"managed":%s,' "$targets_managed"
		json_key_string unavailable_reason "$TARGET_REASON"
		printf '}'
		separator=','
	done <"$TARGETS_DATA"
	printf ']'
	print_incomplete_fields
	printf '}'
	printf '\n'
	[ "$READ_INCOMPLETE" -eq 0 ] || exit 3
}

# The last result belongs to the target it describes. It lived in the shared
# cache since the single-target era, so a failure on one target was reported as
# every other target's last result. There is deliberately no fallback to the
# legacy path: an upgraded installation cannot tell which target the old result
# belonged to, and "no result yet" is true where attributing it would not be.
read_last_result() {
	if [ -r "$TARGET_STATE_DIR/last-result" ]; then
		sed -n '1p' "$TARGET_STATE_DIR/last-result"
	fi
}

read_last_result_code() {
	if [ -r "$TARGET_STATE_DIR/last-result-code" ]; then
		sed -n '1p' "$TARGET_STATE_DIR/last-result-code"
	fi
}

# ---- desired bearer state (see docs/convergence-contract-v1.md) ----
#
# The difference between an interface that is down because the modem was gone
# and an interface that is down because somebody pressed Disconnect. Without it,
# convergence would helpfully undo a deliberate decision every time the user
# unplugged and replugged something.
#
# Written only by an explicit user action — the connect and disconnect controls,
# or provisioning's requested autoconnect — and never by an automatic path.
# Absent reads as `auto`, so an upgraded installation behaves as it did.
read_desired_bearer_state() {
	desired_value="$(sed -n '1p' "$TARGET_STATE_DIR/desired-bearer-state" 2>/dev/null || :)"
	case "$desired_value" in
		auto|up|down) printf '%s\n' "$desired_value" ;;
		*) printf 'auto\n' ;;
	esac
}

desired_bearer_state_cmd() {
	read_desired_bearer_state
}

# Deliberately takes no operation lock. It records an intention about one
# target in one atomically replaced file; it touches no device, no UCI option
# and no other target. It is also called by apn-autoconfig-modem's connect and
# disconnect verbs while those already hold the global operation lock, and
# taking it again here would be a deadlock rather than a safeguard.
desired_bearer_state_set_cmd() {
	desired_requested="${1:-}"
	case "$desired_requested" in
		auto|up|down) : ;;
		*) die_code 2 "desired-bearer-state-set requires auto, up or down" ;;
	esac
	mkdir -p "$TARGET_STATE_DIR" || die "cannot create target state directory: $TARGET_STATE_DIR"
	desired_tmp="$TARGET_STATE_DIR/.desired-bearer-state.tmp.$$"
	printf '%s\n' "$desired_requested" >"$desired_tmp" || die "cannot record the desired bearer state"
	mv "$desired_tmp" "$TARGET_STATE_DIR/desired-bearer-state" || {
		rm -f "$desired_tmp"
		die "cannot persist the desired bearer state"
	}
	log notice "desired bearer state for $TARGET_ID is now $desired_requested"
	printf '%s\n' "$desired_requested"
}

# Everything the convergence worker has to know about one target before it may
# act on it, in one read-only answer, so the coordinator does not reimplement
# the engine's own idea of which targets it manages.
target_policy_cmd() {
	policy_managed=false
	if [ "$CONFIGURED_INTERFACE" = auto ]; then
		if [ "$TARGET_PROFILE_APPLY" = true ] && ! section_is_disabled "$INTERFACE"; then
			policy_managed=true
		fi
	elif [ "$INTERFACE" = "$CONFIGURED_INTERFACE" ]; then
		policy_managed=true
	fi
	policy_disabled=false
	section_is_disabled "$INTERFACE" && policy_disabled=true
	printf 'v1\n'
	printf 'target_id\t%s\n' "$TARGET_ID"
	printf 'backend\t%s\n' "$TARGET_BACKEND"
	printf 'managed\t%s\n' "$policy_managed"
	printf 'profile_apply\t%s\n' "$TARGET_PROFILE_APPLY"
	printf 'disabled\t%s\n' "$policy_disabled"
	printf 'desired_bearer_state\t%s\n' "$(read_desired_bearer_state)"
	# The administrator's own statement of which uplink matters, and the order
	# convergence reconciles several returning modems in.
	policy_metric="$(uci -q get "network.${INTERFACE}.metric" 2>/dev/null || :)"
	case "$policy_metric" in ''|*[!0-9]*) policy_metric=0 ;; esac
	printf 'metric\t%s\n' "$policy_metric"
}

# Split from the command so the same printer serves both endings: the normal
# one, and the one reached from die_code when the deadline stopped the identity
# read. Everything it does is a local read — UCI, netifd state, the engine's own
# files — so a document printed after the hardware stopped answering still says
# what is actually known.
status_json_document() {
	read_database_metadata
	apn="$(current_apn 2>/dev/null || :)"
	cache="$(cached_apn 2>/dev/null || :)"
	last_result="$(read_last_result)"
	result_code="$(read_last_result_code)"
	# After read_sim, because the SIM leg is compared against what is present.
	classify_last_result
	reconciled_iccid="$(active_iccid 2>/dev/null || :)"
	reconciled_apn="$(active_apn 2>/dev/null || :)"
	interface_up=false
	interface_is_up && interface_up=true
	refresh_l3_device || :
	# Why the interface is down, when it is. 0.15.3 gives an interface two
	# quite different reasons to be down — the modem is gone, or somebody
	# pressed Disconnect and convergence is deliberately leaving it alone — and
	# `interface_up` alone renders them identically. Publishing the recorded
	# intention is what lets the page say which one this is; the value is the
	# same one desired-bearer-state prints, read from the same place.
	desired_bearer_state="$(read_desired_bearer_state)"
	autostart="$(uci -q get "${CONFIG}.main.autostart" 2>/dev/null || printf '0')"
	button_enabled="$(uci -q get "${CONFIG}.main.button_enabled" 2>/dev/null || printf '0')"
	hardware_integration="$(hardware_integration_name 2>/dev/null || :)"

	printf '{'
	json_key_string version "v2"; printf ','
	json_key_string engine_api "v1"; printf ','
	json_key_string target_id "$TARGET_ID"; printf ','
	json_key_string target_protocol "$TARGET_PROTOCOL"; printf ','
	json_key_string target_backend "$TARGET_BACKEND"; printf ','
	printf '"target_capabilities":{'
	printf '"identity":%s,' "$TARGET_IDENTITY"
	printf '"profile_read":%s,' "$TARGET_PROFILE_READ"
	printf '"profile_write":%s,' "$TARGET_PROFILE_WRITE"
	printf '"profile_apply":%s,' "$TARGET_PROFILE_APPLY"
	printf '"roaming_policy_read":%s,' "$TARGET_ROAMING_POLICY_READ"
	printf '"roaming_policy_write":%s' "$TARGET_ROAMING_POLICY_WRITE"
	printf '},'
	json_key_string target_implementation_state "$TARGET_IMPLEMENTATION_STATE"; printf ','
	json_key_string target_validation_state "$TARGET_VALIDATION_STATE"; printf ','
	printf '"target_hardware_validated":%s,' "$TARGET_HARDWARE_VALIDATED"
	json_key_string sim_index "$SIM_INDEX"; printf ','
	json_key_string modem_index "$MODEM_INDEX"; printf ','
	json_key_string iccid "$ICCID"; printf ','
	json_key_string imsi "$IMSI"; printf ','
	json_key_string eid "$EID"; printf ','
	json_key_string operator_id "$OPERATOR_ID"; printf ','
	json_key_string operator_name "$OPERATOR_NAME"; printf ','
	json_key_string home_operator_id "$OPERATOR_ID"; printf ','
	json_key_string home_operator_name "$OPERATOR_NAME"; printf ','
	json_key_string modem_state "$MODEM_STATE"; printf ','
	json_key_string registration_state "$REGISTRATION_STATE"; printf ','
	json_key_boolean_or_null roaming "$ROAMING_STATUS"; printf ','
	json_key_string roaming_policy "$ROAMING_POLICY"; printf ','
	printf '"roaming_allowed":%s,' "$ROAMING_ALLOWED"
	json_key_string serving_operator_id "$SERVING_OPERATOR_ID"; printf ','
	json_key_string serving_operator_name "$SERVING_OPERATOR_NAME"; printf ','
	json_key_string access_technologies "$ACCESS_TECHNOLOGIES"; printf ','
	json_key_string signal_quality "$SIGNAL_QUALITY"; printf ','
	json_key_string configured_plmn "$CONFIGURED_PLMN"; printf ','
	json_key_string gid1 "$GID1"; printf ','
	json_key_string gid2 "$GID2"; printf ','
	json_key_string interface "$INTERFACE"; printf ','
	json_key_string device "$DEVICE"; printf ','
	json_key_string l3_device "$L3_DEVICE"; printf ','
	json_key_string database_path "$DATABASE"; printf ','
	json_key_string database_version "$DATABASE_VERSION"; printf ','
	json_key_string database_format "$DATABASE_FORMAT"; printf ','
	json_key_string database_sources "$DATABASE_SOURCES"; printf ','
	json_key_string database_revisions "$DATABASE_REVISIONS"; printf ','
	json_key_string configured_apn "$apn"; printf ','
	json_key_string cached_apn "$cache"; printf ','
	printf '"interface_up":%s,' "$interface_up"
	json_key_string desired_bearer_state "$desired_bearer_state"; printf ','
	json_key_string last_result "$last_result"; printf ','
	json_key_string result_code "$result_code"; printf ','
	# Whether the verdict above is about the modem and SIM that are present
	# now. `previous` and `unknown` are different states and are neither errors
	# nor interchangeable; see docs/convergence-contract-v1.md.
	json_key_string result_state "$RESULT_STATE"; printf ','
	printf '"result_scope":{"attachment_generation":%s,' \
		"${RESULT_SCOPE_RECORDED_GENERATION:-null}"
	# Only whether an ICCID was known. The value itself is never published, in
	# this document or in any log line.
	printf '"iccid_known":%s},' "$RESULT_SCOPE_ICCID_KNOWN"
	json_key_string result_stale_reason "$RESULT_STALE_REASON"; printf ','
	json_key_string reconciled_iccid "$reconciled_iccid"; printf ','
	json_key_string reconciled_apn "$reconciled_apn"; printf ','
	printf '"autostart":%s,' "$([ "$autostart" = 1 ] && printf true || printf false)"
	printf '"button_enabled":%s,' "$([ "$button_enabled" = 1 ] && printf true || printf false)"
	json_key_string hardware_integration "$hardware_integration"
	print_incomplete_fields
	printf '}\n'
}

status_json_cmd() {
	read_deadline_arm
	READ_INCOMPLETE_EMITTER=status_json_document
	read_sim
	READ_INCOMPLETE_EMITTER=""
	status_json_document
	# Retryable, and the document says which readings are missing from it.
	[ "$READ_INCOMPLETE" -eq 0 ] || exit 3
}

detect_json_document() {
	read_database_metadata
	# Candidates are matched against an identity. Without one there are no
	# candidates rather than every wildcard row in the database, because a
	# profile list derived from nothing is a recommendation nobody measured.
	[ -z "$ICCID" ] || find_candidates
	cache="$(cached_apn 2>/dev/null || :)"
	printf '{'
	json_key_string version "v2"; printf ','
	json_key_string engine_api "v1"; printf ','
	json_key_string target_id "$TARGET_ID"; printf ','
	json_key_string target_protocol "$TARGET_PROTOCOL"; printf ','
	json_key_string target_backend "$TARGET_BACKEND"; printf ','
	printf '"target_capabilities":{'
	printf '"identity":%s,' "$TARGET_IDENTITY"
	printf '"profile_read":%s,' "$TARGET_PROFILE_READ"
	printf '"profile_write":%s,' "$TARGET_PROFILE_WRITE"
	printf '"profile_apply":%s,' "$TARGET_PROFILE_APPLY"
	printf '"roaming_policy_read":%s,' "$TARGET_ROAMING_POLICY_READ"
	printf '"roaming_policy_write":%s' "$TARGET_ROAMING_POLICY_WRITE"
	printf '},'
	json_key_string target_implementation_state "$TARGET_IMPLEMENTATION_STATE"; printf ','
	json_key_string target_validation_state "$TARGET_VALIDATION_STATE"; printf ','
	printf '"target_hardware_validated":%s,' "$TARGET_HARDWARE_VALIDATED"
	json_key_string sim_index "$SIM_INDEX"; printf ','
	json_key_string modem_index "$MODEM_INDEX"; printf ','
	json_key_string iccid "$ICCID"; printf ','
	json_key_string imsi "$IMSI"; printf ','
	json_key_string eid "$EID"; printf ','
	json_key_string operator_id "$OPERATOR_ID"; printf ','
	json_key_string operator_name "$OPERATOR_NAME"; printf ','
	json_key_string home_operator_id "$OPERATOR_ID"; printf ','
	json_key_string home_operator_name "$OPERATOR_NAME"; printf ','
	json_key_string registration_state "$REGISTRATION_STATE"; printf ','
	json_key_boolean_or_null roaming "$ROAMING_STATUS"; printf ','
	json_key_string roaming_policy "$ROAMING_POLICY"; printf ','
	printf '"roaming_allowed":%s,' "$ROAMING_ALLOWED"
	json_key_string serving_operator_id "$SERVING_OPERATOR_ID"; printf ','
	json_key_string serving_operator_name "$SERVING_OPERATOR_NAME"; printf ','
	json_key_string configured_plmn "$CONFIGURED_PLMN"; printf ','
	json_key_string gid1 "$GID1"; printf ','
	json_key_string gid2 "$GID2"; printf ','
	json_key_string database_path "$DATABASE"; printf ','
	json_key_string database_version "$DATABASE_VERSION"; printf ','
	json_key_string database_format "$DATABASE_FORMAT"; printf ','
	json_key_string database_sources "$DATABASE_SOURCES"; printf ','
	json_key_string database_revisions "$DATABASE_REVISIONS"; printf ','
	json_key_string cached_apn "$cache"; printf ',"candidates":['
	separator=""
	while IFS="$(printf '\t')" read -r score priority apn provider username password auth ip_type; do
		[ -n "$apn" ] || continue
		priority="$(printf '%s\n' "$priority" | awk '{ print $1 + 0 }')"
		printf '%s{' "$separator"
		json_key_string apn "$apn"; printf ','
		json_key_string provider "$provider"; printf ','
		printf '"username_required":%s,' "$([ "$username" != - ] && printf true || printf false)"
		json_key_string authentication "$([ "$auth" = - ] && printf '' || printf '%s' "$auth")"; printf ','
		json_key_string ip_type "$([ "$ip_type" = - ] && printf '' || printf '%s' "$ip_type")"; printf ','
		printf '"priority":%s' "$priority"
		printf '}'
		separator=','
	done <"$CANDIDATES"
	printf ']'
	print_incomplete_fields
	printf '}\n'
}

detect_json_cmd() {
	read_deadline_arm
	# The printer reads this file in both endings, so it exists before the
	# identity read that may not return.
	: >"$CANDIDATES"
	READ_INCOMPLETE_EMITTER=detect_json_document
	read_sim
	READ_INCOMPLETE_EMITTER=""
	detect_json_document
	[ "$READ_INCOMPLETE" -eq 0 ] || exit 3
}

process_is_alive() {
	case "$1" in ''|*[!0-9]*|0) return 1 ;; esac
	kill -0 "$1" 2>/dev/null
}

operation_lock_pid() {
	pid="$(lock_owner_pid "$LOCK_DIR" 2>/dev/null || :)"
	process_is_alive "$pid" || return 1
	printf '%s\n' "$pid"
}

action_state_field() {
	field="$1"
	[ -r "$ACTION_STATE_DIR/state.tsv" ] || return 1
	awk -F '\t' -v field="$field" 'NR == 1 && ($1 == "v1" || $1 == "v2") { print $field; exit }' \
		"$ACTION_STATE_DIR/state.tsv"
}

action_status_values() {
	ACTION_STATUS="idle"
	ACTION_NAME=""
	ACTION_PID=""
	ACTION_STARTED=""
	ACTION_FINISHED=""
	ACTION_EXIT_CODE=""
	ACTION_MESSAGE=""
	ACTION_TARGET=""
	ACTION_BUSY=false

	if [ -r "$ACTION_STATE_DIR/state.tsv" ]; then
		ACTION_STATUS="$(action_state_field 2)"
		ACTION_NAME="$(action_state_field 3)"
		ACTION_PID="$(action_state_field 4)"
		ACTION_STARTED="$(action_state_field 5)"
		ACTION_FINISHED="$(action_state_field 6)"
		ACTION_EXIT_CODE="$(action_state_field 7)"
		ACTION_MESSAGE="$(action_state_field 8)"
		ACTION_TARGET="$(action_state_field 9)"
		case "$ACTION_STATUS" in
			starting|queued|running)
				# Launcher exited but the accepted worker still owns the start
				# lock and has not written its first record yet. Our own start
				# lock does not count: a launcher holding it is deciding whether
				# to start, not observing someone else's handoff.
				handoff_pid="$(lock_owner_pid "${ACTION_STATE_DIR}.start-lock" 2>/dev/null || :)"
				[ "$handoff_pid" = "$$" ] && handoff_pid=""
				if process_is_alive "$ACTION_PID"; then
					ACTION_BUSY=true
				elif process_is_alive "$handoff_pid"; then
					ACTION_BUSY=true
				else
					ACTION_STATUS="failed"
					ACTION_FINISHED="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)"
					ACTION_EXIT_CODE="1"
					ACTION_MESSAGE="background worker stopped unexpectedly"
				fi
			;;
		esac
	fi

	lock_pid="$(operation_lock_pid 2>/dev/null || :)"
	if [ -n "$lock_pid" ] && [ "$ACTION_BUSY" != true ]; then
		ACTION_STATUS="external"
		ACTION_NAME="operation"
		ACTION_PID="$lock_pid"
		ACTION_STARTED=""
		ACTION_FINISHED=""
		ACTION_EXIT_CODE=""
		ACTION_MESSAGE="operation started outside the job API"
		ACTION_TARGET=""
		ACTION_BUSY=true
	fi
}

print_action_json() {
	accepted="$1"
	action_status_values
	printf '{'
	json_key_string version "v2"; printf ','
	printf '"accepted":%s,' "$accepted"
	printf '"busy":%s,' "$ACTION_BUSY"
	json_key_string state "$ACTION_STATUS"; printf ','
	json_key_string action "$ACTION_NAME"; printf ','
	json_key_string target_id "$ACTION_TARGET"; printf ','
	json_key_string pid "$ACTION_PID"; printf ','
	json_key_string started_at "$ACTION_STARTED"; printf ','
	json_key_string finished_at "$ACTION_FINISHED"; printf ','
	json_key_string exit_code "$ACTION_EXIT_CODE"; printf ','
	json_key_string message "$ACTION_MESSAGE"
	printf '}\n'
}

action_status_cmd() {
	print_action_json false
}

action_start_cmd() {
	action="${1:-}"
	case "$action" in
		reconcile|modem-reset|apply-manual|roaming-default|roaming-allow|roaming-block|database-check|database-install) : ;;
		*) die "unsupported background action: $action" ;;
	esac
	[ -x "$ACTION_WORKER" ] || die "action worker is not executable: $ACTION_WORKER"

	start_lock="${ACTION_STATE_DIR}.start-lock"
	mkdir -p "$(dirname "$ACTION_STATE_DIR")" || die "cannot create action state parent"
	lock_try_acquire_or_reclaim "$start_lock"
	start_lock_status=$?
	case "$start_lock_status" in
		0) : ;;
		3) print_action_json false; return 0 ;;
		*) die "cannot record action launch lock" ;;
	esac

	action_status_values
	if [ "$ACTION_BUSY" = true ]; then
		lock_release "$start_lock"
		print_action_json false
		return 0
	fi

	mkdir -p "$ACTION_STATE_DIR" || {
		lock_release "$start_lock"
		die "cannot create action state directory"
	}
	started="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)"
	printf 'v2\tstarting\t%s\t%s\t%s\t\t\tstarting background worker\t%s\n' \
		"$action" "$$" "$started" "$TARGET_ID" >"$ACTION_STATE_DIR/state.tsv"
	"$ACTION_WORKER" "$action" "$ACTION_STATE_DIR" "$started" "$TARGET_ID" "$start_lock" \
		</dev/null >/dev/null 2>&1 &
	# Hand the start lock to the worker instead of dropping it here. It is the
	# only live token between this launcher's exit and the worker's first
	# "running" record, and without it action-status reported an accepted
	# operation as a dead worker - which the WH3000 button handler in turn
	# reads as a rejected launch rather than a coalesced duplicate release.
	lock_set_owner "$start_lock" "$!" || :
	print_action_json true
}

acquire_lock() {
	[ "$LOCK_HELD" -eq 1 ] && return 0
	[ "$LOCK_BORROWED" -eq 1 ] && return 0
	# Symmetric counterpart to APN_AUTOCONFIG_COORDINATOR_PARENT_PID: during
	# provisioning apn-autoconfig-modem owns the global lock and calls this
	# engine, the reverse of the reset direction. One global order therefore
	# still holds and neither component waits on a lock the other has. The
	# variable alone is not ownership: the lock must record exactly this PID
	# and that process must still be alive.
	borrow_pid="${APN_AUTOCONFIG_LOCK_OWNER_PID:-}"
	case "$borrow_pid" in ''|*[!0-9]*) borrow_pid="" ;; esac
	if [ -n "$borrow_pid" ]; then
		recorded_pid="$(lock_owner_pid "$LOCK_DIR" 2>/dev/null || :)"
		[ "$recorded_pid" = "$borrow_pid" ] && process_is_alive "$borrow_pid" || \
			die_code 3 "caller did not prove ownership of the operation lock"
		LOCK_BORROWED=1
		return 0
	fi
	mkdir -p "$(dirname "$LOCK_DIR")" || die "cannot create lock parent"
	lock_try_acquire_or_reclaim "$LOCK_DIR"
	operation_lock_status=$?
	case "$operation_lock_status" in
		0) : ;;
		3)
			old_pid="$(lock_owner_pid "$LOCK_DIR" 2>/dev/null || :)"
			die_code 3 "another operation is already running (PID ${old_pid:-unknown}); retry later"
		;;
		*) die "cannot acquire lock: $LOCK_DIR" ;;
	esac
	LOCK_HELD=1
}

add_candidate() {
	apn="$1"
	provider="$2"
	username="${3:--}"
	password="${4:--}"
	auth="${5:--}"
	ip_type="${6:--}"
	case "$apn" in
		''|*[!A-Za-z0-9._-]*) [ -z "$apn" ] || return 0 ;;
	esac
	state_value_is_safe "$username" || return 0
	state_value_is_safe "$password" || return 0
	case "$auth" in -|none|pap|chap|pap-or-chap) : ;; *) return 0 ;; esac
	case "$ip_type" in -|ipv4|ipv6|ipv4v6) : ;; *) return 0 ;; esac
	key="${apn:-<empty>}$(printf '\t')${username}$(printf '\t')${password}$(printf '\t')${auth}$(printf '\t')${ip_type}"
	grep -F -x -q -- "$key" "$SEEN_APNS" 2>/dev/null && return 0
	printf '%s\n' "$key" >>"$SEEN_APNS"
	printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${apn:-<empty>}" "$provider" \
		"$username" "$password" "$auth" "$ip_type" >>"${CANDIDATES}.apply"
}

matching_database_provider() {
	wanted_apn="$1"
	wanted_username="$2"
	wanted_password="$3"
	wanted_auth="$4"
	wanted_ip_type="$5"
	# A backend that can only use one authentication protocol caches the one
	# that actually worked, so the row it came from still describes it.
	expanded_auth=0
	case "$TARGET_BACKEND:$wanted_auth" in
		mbim:pap|mbim:chap) expanded_auth=1 ;;
	esac
	awk -F '\t' \
		-v wanted_apn="$wanted_apn" \
		-v wanted_username="$wanted_username" \
		-v wanted_password="$wanted_password" \
		-v wanted_auth="$wanted_auth" \
		-v wanted_ip_type="$wanted_ip_type" \
		-v expanded_auth="$expanded_auth" '
		$3 == wanted_apn &&
		$5 == wanted_username &&
		$6 == wanted_password &&
		($7 == wanted_auth || (expanded_auth == 1 && $7 == "pap-or-chap")) &&
		$8 == wanted_ip_type {
			print $4
			exit
		}
	' "$CANDIDATES"
}

build_apply_candidates() {
	: >"$SEEN_APNS"
	: >"${CANDIDATES}.apply"
	cache="$(cached_apn 2>/dev/null || :)"
	provider="$(cached_provider 2>/dev/null || :)"
	if [ "$(cached_version 2>/dev/null || :)" = "v1" ]; then
		# v0.5 cached only the APN. Preserve the optional values that belong to
		# that known-working configuration instead of deleting them on upgrade.
		username="$(uci -q get "network.${INTERFACE}.username" 2>/dev/null || printf '%s' -)"
		password="$(uci -q get "network.${INTERFACE}.password" 2>/dev/null || printf '%s' -)"
		allowedauth="$(uci -q get "network.${INTERFACE}.allowedauth" 2>/dev/null || printf '%s' -)"
		case "$allowedauth" in
			'pap chap'|'chap pap') auth="pap-or-chap" ;;
			none|pap|chap) auth="$allowedauth" ;;
			*) auth="-" ;;
		esac
		ip_type="$(uci -q get "network.${INTERFACE}.iptype" 2>/dev/null || printf '%s' -)"
		case "$ip_type" in ipv4|ipv6|ipv4v6) : ;; *) ip_type="-" ;; esac
	else
		username="$(cached_profile_field 5 2>/dev/null || printf '%s' -)"
		password="$(cached_profile_field 6 2>/dev/null || printf '%s' -)"
		auth="$(cached_profile_field 7 2>/dev/null || printf '%s' -)"
		ip_type="$(cached_profile_field 8 2>/dev/null || printf '%s' -)"
	fi
	if [ -n "$cache" ] && [ "$cache" != "<empty>" ]; then
		current_provider="$(matching_database_provider "$cache" "$username" \
			"$password" "$auth" "$ip_type" 2>/dev/null || :)"
		[ -n "$current_provider" ] && provider="$current_provider"
	fi
	if [ "$cache" = "<empty>" ]; then
		add_candidate "" "${provider:-cache}" "$username" "$password" "$auth" "$ip_type"
	elif [ -n "$cache" ]; then
		add_candidate "$cache" "${provider:-cache}" "$username" "$password" "$auth" "$ip_type"
	fi
	while IFS="$(printf '\t')" read -r _ priority apn provider username password auth ip_type; do
		[ -n "$apn" ] && add_candidate "$apn" "$provider" "$username" "$password" "$auth" "$ip_type"
	done <"$CANDIDATES"
	[ "$TRY_EMPTY" = "1" ] && add_candidate "" "empty APN fallback" - - - -
}

restart_interface() {
	ifdown "$INTERFACE" >/dev/null 2>&1 || :
	settle_after_ifdown
	ifup "$INTERFACE" >/dev/null 2>&1 || return 1
	return 0
}

settle_after_ifdown() {
	# netifd's QMI handler releases client IDs asynchronously. RM520N hardware
	# needs this bounded quiet period; a two-second delay can race SIM queries
	# and make qmi.sh power-cycle an otherwise healthy SIM.
	[ "$TARGET_BACKEND" != qmi ] && return 0
	sleep 6 &
	SETTLE_SLEEP_PID=$!
	settle_status=0
	wait "$SETTLE_SLEEP_PID" || settle_status=$?
	SETTLE_SLEEP_PID=""
	return "$settle_status"
}

wait_for_interface() {
	remaining="$WAIT_SECONDS"
	while [ "$remaining" -gt 0 ]; do
		interface_is_up && return 0
		sleep 1
		remaining=$((remaining - 1))
	done
	return 1
}

# qmi.sh and mbim.sh both leave the parent section without an address and
# publish dynamic ${interface}_4 / ${interface}_6 interfaces for the families the
# bearer actually got. An interface that is merely "up" is not yet usable.
data_interface_is_ready() {
	command_exists ubus || return 1
	for data_interface in "$INTERFACE" "${INTERFACE}_4" "${INTERFACE}_6"; do
		status="$(ubus call "network.interface.${data_interface}" status 2>/dev/null || :)"
		printf '%s\n' "$status" | grep -q '"up"[[:space:]]*:[[:space:]]*true' || continue
		printf '%s\n' "$status" | grep -q '"address"[[:space:]]*:[[:space:]]*"' && return 0
	done
	return 1
}

wait_for_data_interface() {
	remaining="$WAIT_SECONDS"
	while [ "$remaining" -gt 0 ]; do
		data_interface_is_ready && return 0
		sleep 1
		remaining=$((remaining - 1))
	done
	return 1
}

mwan3_available() {
	command_exists mwan3 || return 1
	case "$USE_MWAN3" in
		never) return 1 ;;
		always) return 0 ;;
		auto)
			mwan3 interfaces 2>/dev/null | grep -q "interface ${INTERFACE} is"
			return $?
		;;
	esac
}

test_connectivity_family() {
	family="$1"
	bind_device="$(connectivity_device)"
	if mwan3_available; then
		mwan3 use "$INTERFACE" curl "$family" --interface "$bind_device" \
			--connect-timeout 10 --max-time 15 -fsS -o /dev/null "$TEST_URL"
	else
		curl "$family" --interface "$bind_device" --connect-timeout 10 --max-time 15 \
			-fsS -o /dev/null "$TEST_URL"
	fi
}

test_connectivity() {
	case "${1:--}" in
		ipv4) test_connectivity_family -4 ;;
		ipv6) test_connectivity_family -6 ;;
		*) test_connectivity_family -4 || test_connectivity_family -6 ;;
	esac
}

save_cache() {
	apn="$1"
	provider="$2"
	username="$3"
	password="$4"
	auth="$5"
	ip_type="$6"
	mkdir -p "$CACHE_DIR" || return 1
	tmp="$CACHE_DIR/.${ICCID}.tmp.$$"
	# Provider labels are informational; profile values must remain exact.
	provider="$(printf '%s' "$provider" | tr '\t\r\n' '   ')"
	state_value_is_safe "$username" || return 1
	state_value_is_safe "$password" || return 1
	cache_apn="${apn:-<empty>}"
	printf 'v2\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$cache_apn" "$provider" \
		"$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)" \
		"$username" "$password" "$auth" "$ip_type" >"$tmp" || return 1
	mv "$tmp" "$(cache_file)"
}

# What a terminal result was about, recorded beside it.
#
# The defect this exists to fix: the FM350 held a roaming SIM, the target
# carried "blocked: registered in roaming ...", the modem was detached, its SIM
# replaced and the modem attached again. Registration refreshed; the verdict did
# not, and the page showed the two side by side as though one described the
# other. Both facts were true. Nothing recorded what the verdict had been
# *about*, so nothing could notice it was no longer about anything present.
#
# Two identities are recorded, because each covers a failure the other misses: a
# SIM swapped while the router was powered off leaves enumeration identical, and
# a modem replaced with the SIM moved across changes enumeration while the ICCID
# matches. See docs/convergence-contract-v1.md.
resolve_result_scope() {
	[ "$RESULT_SCOPE_RESOLVED" -eq 0 ] || return 0
	RESULT_SCOPE_RESOLVED=1
	# The coordinator is optional. Without it there is no attachment evidence to
	# record, and the SIM leg carries the scope on its own.
	command_exists apn-autoconfig-modem || return 0
	apn-autoconfig-modem attachment --interface "$INTERFACE" >"$SCOPE_DATA" 2>/dev/null || return 0
	[ "$(sed -n '1p' "$SCOPE_DATA")" = "v1" ] || return 0
	RESULT_SCOPE_MODEM_ID="$(adapter_identity_value "$SCOPE_DATA" modem_id)"
	RESULT_SCOPE_GENERATION="$(adapter_identity_value "$SCOPE_DATA" generation)"
	state_value_is_safe "$RESULT_SCOPE_MODEM_ID" || RESULT_SCOPE_MODEM_ID=""
	case "$RESULT_SCOPE_GENERATION" in ''|*[!0-9]*) RESULT_SCOPE_GENERATION="" ;; esac
	[ -n "$RESULT_SCOPE_MODEM_ID" ] || RESULT_SCOPE_GENERATION=""
}

write_last_result() {
	result_code="$1"
	shift
	mkdir -p "$TARGET_STATE_DIR" || return 0
	printf '%s\n' "$*" >"$TARGET_STATE_DIR/last-result"
	printf '%s\n' "$result_code" >"$TARGET_STATE_DIR/last-result-code"
	# The scope is written with the result and never separately: a scope that
	# could be re-stamped onto an older verdict would make a stale claim look
	# current again, which is the whole defect wearing different clothes.
	#
	# The ICCID is stored here for comparison only, in the same root-only
	# per-target directory that already holds it in active.tsv. It is never
	# published and never logged; status-json exposes only whether one was
	# known.
	resolve_result_scope
	scope_tmp="$TARGET_STATE_DIR/.last-result-scope.tmp.$$"
	if printf 'v1\t%s\t%s\t%s\n' \
		"$RESULT_SCOPE_MODEM_ID" "$RESULT_SCOPE_GENERATION" "$ICCID" >"$scope_tmp" 2>/dev/null; then
		mv "$scope_tmp" "$TARGET_STATE_DIR/last-result-scope" || rm -f "$scope_tmp"
	else
		rm -f "$scope_tmp"
	fi
	# Retire the shared pair once a per-target result exists, so the file that
	# used to answer for every target does not outlive the behaviour.
	rm -f "$CACHE_DIR/last-result" "$CACHE_DIR/last-result-code"
}

# current | previous | unknown, per the classification table in
# docs/convergence-contract-v1.md.
#
# `current` requires every recorded leg to be matched by an observed one and at
# least one comparison to have actually been made. A result with no recorded
# scope is `unknown`, never `current`: it is the state every installation
# upgrading from 0.15.2 starts in, and trusting it because it is probably still
# fine is precisely the behaviour being removed.
classify_last_result() {
	RESULT_STATE="unknown"
	RESULT_STALE_REASON="no-scope"
	RESULT_SCOPE_RECORDED_GENERATION=""
	RESULT_SCOPE_ICCID_KNOWN=false
	[ -r "$TARGET_STATE_DIR/last-result-scope" ] || return 0
	scope_recorded_modem="$(awk -F '\t' 'NR == 1 && $1 == "v1" { print $2; exit }' \
		"$TARGET_STATE_DIR/last-result-scope")"
	scope_recorded_generation="$(awk -F '\t' 'NR == 1 && $1 == "v1" { print $3; exit }' \
		"$TARGET_STATE_DIR/last-result-scope")"
	scope_recorded_iccid="$(awk -F '\t' 'NR == 1 && $1 == "v1" { print $4; exit }' \
		"$TARGET_STATE_DIR/last-result-scope")"
	case "$scope_recorded_generation" in ''|*[!0-9]*) scope_recorded_generation="" ;; esac
	case "$scope_recorded_iccid" in *[!0-9]*) scope_recorded_iccid="" ;; esac
	# A record that names neither identity is not a scope.
	[ -n "$scope_recorded_generation" ] || [ -n "$scope_recorded_iccid" ] || return 0
	RESULT_SCOPE_RECORDED_GENERATION="$scope_recorded_generation"
	[ -z "$scope_recorded_iccid" ] || RESULT_SCOPE_ICCID_KNOWN=true

	scope_observed_generation=""
	if [ -n "$scope_recorded_modem" ] && [ -n "$scope_recorded_generation" ] && \
	   command_exists apn-autoconfig-modem; then
		# --modem, never --interface: this runs on the read path, and resolving
		# the interface would cost a full inventory scan on every page poll.
		# Short as it is, it is still a process the read deadline has to pay
		# for, so it is bounded like the rest.
		if run_read_bounded attachment '' "$SCOPE_DATA" \
			apn-autoconfig-modem attachment --modem "$scope_recorded_modem" && \
			[ "$(sed -n '1p' "$SCOPE_DATA")" = "v1" ]; then
			scope_observed_generation="$(adapter_identity_value "$SCOPE_DATA" generation)"
			case "$scope_observed_generation" in ''|*[!0-9]*) scope_observed_generation="" ;; esac
		fi
	fi

	if [ -n "$scope_recorded_generation" ] && [ -n "$scope_observed_generation" ] && \
	   [ "$scope_recorded_generation" != "$scope_observed_generation" ]; then
		RESULT_STATE="previous"
		RESULT_STALE_REASON="attachment-changed"
		return 0
	fi
	# The SIM leg. An unreadable or unrecorded ICCID is uncertainty, not a
	# match: missing means unknown, never permitted.
	if [ -z "$scope_recorded_iccid" ] || [ -z "$ICCID" ]; then
		RESULT_STATE="unknown"
		RESULT_STALE_REASON="sim-unknown"
		return 0
	fi
	if [ "$scope_recorded_iccid" != "$ICCID" ]; then
		RESULT_STATE="previous"
		RESULT_STALE_REASON="sim-changed"
		return 0
	fi
	# A generation that was recorded and could not be observed is not a matched
	# one, whatever prevented the observation: the read deadline, a coordinator
	# that did not answer, output that did not parse, or the coordinator having
	# been removed since the result was written. `current` requires every
	# recorded leg to have been compared, and this one was not.
	#
	# This is checked after both contradictions above, because a contradiction
	# is definite and missing evidence is not: a SIM that demonstrably changed
	# makes the result `previous` even when the other leg could not be read.
	#
	# A scope recorded with no generation at all is a different case and does
	# not come here: it is the installation with no coordinator, where the SIM
	# leg carries the scope alone and a matching ICCID is `current`.
	if [ -n "$scope_recorded_generation" ] && [ -z "$scope_observed_generation" ]; then
		RESULT_STATE="unknown"
		RESULT_STALE_REASON="attachment-unknown"
		return 0
	fi
	RESULT_STATE="current"
	RESULT_STALE_REASON=""
}

registration_is_pending() {
	case "$REGISTRATION_STATE" in
		unknown|idle|searching|registering|'') return 0 ;;
		*) return 1 ;;
	esac
}

registration_preflight() {
	read_roaming_policy
	[ "$ROAMING_POLICY" != "invalid" ] || {
		write_last_result invalid-roaming-policy \
			"failed: network.${INTERFACE}.allow_roaming must be 0, 1 or absent"
		log err "network.${INTERFACE}.allow_roaming must be 0, 1 or absent"
		return 1
	}

	remaining="$REGISTRATION_WAIT_SECONDS"
	registration_start_attempted=0
	while :; do
		refresh_modem_status || :
		registration_is_pending || break
		if [ "$registration_start_attempted" -eq 0 ] && ! interface_is_up; then
			ifup "$INTERFACE" >/dev/null 2>&1 || :
			registration_start_attempted=1
			log notice "started interface $INTERFACE once to obtain mobile registration state"
		fi
		[ "$remaining" -gt 0 ] || {
			write_last_result registration-pending \
				"pending: modem registration state is ${REGISTRATION_STATE:-unknown}"
			log warning "mobile registration is still ${REGISTRATION_STATE:-unknown}; APN profiles were not changed"
			return 3
		}
		sleep 1
		remaining=$((remaining - 1))
	done

	case "$REGISTRATION_STATE" in
		roaming)
			if [ "$ROAMING_ALLOWED" != true ]; then
				if interface_is_up; then
					ifdown "$INTERFACE" >/dev/null 2>&1 || :
					log notice "stopped interface $INTERFACE to enforce the roaming-data block"
				fi
				write_last_result blocked-roaming-policy \
					"blocked: registered in roaming via ${SERVING_OPERATOR_NAME:-unknown network}, but mobile data roaming is disabled"
				log notice "registered in roaming via ${SERVING_OPERATOR_NAME:-unknown network} (${SERVING_OPERATOR_ID:--}); data roaming is explicitly blocked; APN profiles were not changed"
				return 2
			fi
			log notice "registered in roaming via ${SERVING_OPERATOR_NAME:-unknown network} (${SERVING_OPERATOR_ID:--}); policy is $ROAMING_POLICY"
		;;
		home)
			log notice "registered on the home network ${SERVING_OPERATOR_NAME:-unknown} (${SERVING_OPERATOR_ID:--})"
		;;
		denied)
			write_last_result registration-denied \
				"failed: mobile network registration was denied before APN testing"
			log err "mobile network registration was denied; APN profiles were not changed"
			return 1
		;;
		emergency-only)
			write_last_result emergency-only \
				"failed: only emergency service is available; APN profiles were not changed"
			log err "only emergency service is available; APN profiles were not changed"
			return 1
		;;
		home-sms-only|roaming-sms-only)
			write_last_result data-service-unavailable \
				"failed: registered for messaging only; packet data is unavailable"
			log err "registration state is $REGISTRATION_STATE; packet data is unavailable"
			return 1
		;;
		*)
			write_last_result registration-unusable \
				"failed: registration state '$REGISTRATION_STATE' does not allow APN testing"
			log err "registration state '$REGISTRATION_STATE' does not allow APN testing"
			return 1
		;;
	esac
	return 0
}

save_active_state() {
	apn="$1"
	username="$2"
	password="$3"
	auth="$4"
	ip_type="$5"
	mkdir -p "$TARGET_STATE_DIR" || return 1
	tmp="$TARGET_STATE_DIR/.active.tmp.$$"
	active_apn="${apn:-<empty>}"
	case "$TARGET_BACKEND:$auth" in
		*:-) allowedauth="-" ;;
		modemmanager:pap-or-chap) allowedauth="pap chap" ;;
		qmi:pap-or-chap) allowedauth="both" ;;
		*) allowedauth="$auth" ;;
	esac
	case "$TARGET_BACKEND:$ip_type" in
		qmi:ipv4) configured_iptype="ip" ;;
		*) configured_iptype="$ip_type" ;;
	esac
	printf 'v3\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$ICCID" "$active_apn" \
		"$username" "$password" "$allowedauth" "$configured_iptype" "$TARGET_ID" "$TARGET_BACKEND" >"$tmp" || return 1
	mv "$tmp" "$ACTIVE_FILE"
}

active_iccid() {
	file="$(active_file_for_read)" || return 1
	awk -F '\t' -v target="$TARGET_ID" 'NR == 1 && ($1 == "v1" || $1 == "v2" || ($1 == "v3" && $8 == target)) { print $2; exit }' "$file"
}

active_apn() {
	file="$(active_file_for_read)" || return 1
	awk -F '\t' -v target="$TARGET_ID" 'NR == 1 && ($1 == "v1" || $1 == "v2" || ($1 == "v3" && $8 == target)) { print $3; exit }' "$file"
}

configured_profile_matches_active() {
	file="$(active_file_for_read)" || return 1
	version="$(awk -F '\t' 'NR == 1 { print $1 }' "$file")"
	active_value="$(active_apn 2>/dev/null || :)"
	[ "$active_value" = "<empty>" ] && active_value=""
	[ "$(current_apn 2>/dev/null || :)" = "$active_value" ] || return 1
	[ "$version" = "v1" ] && return 0
	[ "$version" = "v2" ] || [ "$version" = "v3" ] || return 1
	[ "$version" != "v3" ] || [ "$(awk -F '\t' 'NR == 1 { print $8 }' "$file")" = "$TARGET_ID" ] || return 1

	active_username="$(awk -F '\t' 'NR == 1 { print $4 }' "$file")"
	active_password="$(awk -F '\t' 'NR == 1 { print $5 }' "$file")"
	active_allowedauth="$(awk -F '\t' 'NR == 1 { print $6 }' "$file")"
	active_iptype="$(awk -F '\t' 'NR == 1 { print $7 }' "$file")"
	configured_username="$(uci -q get "network.${INTERFACE}.username" 2>/dev/null || printf '%s' -)"
	configured_password="$(uci -q get "network.${INTERFACE}.password" 2>/dev/null || printf '%s' -)"
	case "$TARGET_BACKEND" in
		modemmanager)
			configured_allowedauth="$(uci -q get "network.${INTERFACE}.allowedauth" 2>/dev/null || printf '%s' -)"
			configured_iptype="$(uci -q get "network.${INTERFACE}.iptype" 2>/dev/null || printf '%s' -)"
		;;
		qmi|mbim|atdial)
			configured_allowedauth="$(uci -q get "network.${INTERFACE}.auth" 2>/dev/null || printf '%s' -)"
			configured_iptype="$(uci -q get "network.${INTERFACE}.pdptype" 2>/dev/null || printf '%s' -)"
		;;
		*) return 1 ;;
	esac
	[ "$configured_username" = "$active_username" ] && \
		[ "$configured_password" = "$active_password" ] && \
		[ "$configured_allowedauth" = "$active_allowedauth" ] && \
		[ "$configured_iptype" = "$active_iptype" ]
}

configured_connectivity_ip_type() {
	case "$TARGET_BACKEND" in
		modemmanager) value="$(uci -q get "network.${INTERFACE}.iptype" 2>/dev/null || printf '%s' -)" ;;
		qmi) value="$(uci -q get "network.${INTERFACE}.pdptype" 2>/dev/null || printf '%s' ip)" ;;
		# An absent MBIM pdptype means "let the modem decide", not IPv4.
		mbim) value="$(uci -q get "network.${INTERFACE}.pdptype" 2>/dev/null || printf '%s' -)" ;;
		# The AT-dial backend stores the canonical 3GPP spelling, which is
		# uppercase; an absent value means the handler's own default.
		atdial) value="$(uci -q get "network.${INTERFACE}.pdptype" 2>/dev/null | tr 'A-Z' 'a-z' || printf '%s' -)" ;;
		*) value="-" ;;
	esac
	[ -n "$value" ] || value="-"
	case "$value" in ip|ipv4) printf '%s\n' ipv4 ;; ipv6|ipv4v6) printf '%s\n' "$value" ;; *) printf '%s\n' - ;; esac
}

# Some backends cannot express one normalized candidate in a single attempt.
# QMI and MBIM both retry a rejected dual-stack bearer once with IPv4, and MBIM
# accepts exactly one authentication protocol per connection, so pap-or-chap
# becomes chap and then pap. Keeping that knowledge here stops it from spreading
# through the candidate loop as per-backend special cases, and makes the
# effective values a caller can cache explicit.
backend_attempt_plan() {
	plan_ip_type="$1"
	plan_auth="$2"
	plan_username="$3"

	plan_ip_types="$plan_ip_type"
	case "$TARGET_BACKEND:$plan_ip_type" in
		qmi:ipv4v6|mbim:ipv4v6) plan_ip_types="ipv4v6 ipv4" ;;
	esac

	# ipv6=0 is somebody else's decision about this interface. mbim.sh forces
	# IPv4 and publishes no _6 interface, so an IPv6-only candidate cannot work
	# and a dual-stack one is really an IPv4 attempt. The option is read as a
	# constraint and never rewritten.
	if [ "$TARGET_BACKEND" = mbim ] && \
		[ "$(uci -q get "network.${INTERFACE}.ipv6" 2>/dev/null || :)" = 0 ]; then
		case "$plan_ip_type" in
			ipv6) return 0 ;;
			ipv4v6) plan_ip_types="ipv4" ;;
		esac
	fi

	plan_auths="$plan_auth"
	case "$TARGET_BACKEND:$plan_auth" in
		mbim:pap-or-chap)
			case "$plan_username" in
				# umbim only carries credentials together with a protocol, so
				# without a username there is nothing to negotiate.
				-|'') plan_auths="none" ;;
				*) plan_auths="chap pap" ;;
			esac
		;;
	esac

	for plan_one_ip_type in $plan_ip_types; do
		for plan_one_auth in $plan_auths; do
			printf '%s\t%s\n' "$plan_one_ip_type" "$plan_one_auth"
		done
	done
}

# MBIM's bearer is only usable once mbim.sh has published an addressed dynamic
# interface. QMI keeps the behavior its hardware evidence was collected with.
backend_data_interface_ready() {
	[ "$TARGET_BACKEND" = mbim ] || return 0
	wait_for_data_interface
}

# The candidate loop is shared by database-driven and manual application so
# that both get the identical baseline, connectivity verification and exact
# rollback. A manual profile is one candidate, not a separate write path.
apply_candidate_list() {
	attempt_description="$1"
	exhausted_message="$2"
	capture_old_profile
	migrate_legacy_baseline
	save_baseline
	ROLLBACK_ARMED=1
	log notice "$attempt_description"
	saw_bearer_up=0

	while IFS="$(printf '\t')" read -r apn provider username password auth ip_type; do
		[ "$apn" = "<empty>" ] && apn=""
		display_apn="${apn:-<empty>}"
		log notice "trying APN '$display_apn' ($provider)"
		backend_attempt_plan "$ip_type" "$auth" "$username" >"${CANDIDATES}.attempts"
		if [ ! -s "${CANDIDATES}.attempts" ]; then
			log notice "skipping APN '$display_apn': its IP family is incompatible with this interface"
			continue
		fi
		bearer_ready=0
		effective_ip_type="$ip_type"
		effective_auth="$auth"
		while IFS="$(printf '\t')" read -r attempt_ip_type attempt_auth; do
			effective_ip_type="$attempt_ip_type"
			effective_auth="$attempt_auth"
			if [ "$ip_type:$attempt_ip_type" = ipv4v6:ipv4 ]; then
				log warning "$TARGET_BACKEND dual-stack bearer was rejected; retrying APN '$display_apn' with IPv4 only"
			fi
			if [ "$auth" != "$attempt_auth" ]; then
				log notice "trying APN '$display_apn' with $attempt_auth authentication"
			fi
			if ! set_profile "$apn" "$username" "$password" "$attempt_auth" "$attempt_ip_type"; then
				log err "failed to write mobile profile for APN '$display_apn'"
				break
			fi
			if ! restart_interface; then
				log warning "interface $INTERFACE did not restart for APN '$display_apn'"
				continue
			fi
			if wait_for_interface && backend_data_interface_ready; then
				bearer_ready=1
				break
			fi
			log warning "mobile data session did not become ready within ${WAIT_SECONDS}s for profile '$display_apn' ($attempt_ip_type)"
		done <"${CANDIDATES}.attempts"
		if [ "$bearer_ready" -ne 1 ]; then
			refresh_modem_status || :
			case "$REGISTRATION_STATE" in
				roaming)
					if [ "$ROAMING_ALLOWED" != true ]; then
						LEAVE_INTERFACE_DOWN=1
						write_last_result blocked-roaming-policy \
							"blocked: registration changed to roaming while data roaming is disabled"
						die_code 2 "registration changed to roaming; stopping profile testing and leaving $INTERFACE down"
					fi
				;;
				denied|emergency-only|home-sms-only|roaming-sms-only)
					write_last_result data-service-unavailable \
						"failed: registration state became $REGISTRATION_STATE during profile testing"
					die "registration state became $REGISTRATION_STATE; stopping profile testing"
				;;
			esac
			continue
		fi
		saw_bearer_up=1
		refresh_modem_status || :
		if [ "$REGISTRATION_STATE" = roaming ] && [ "$ROAMING_ALLOWED" != true ]; then
			LEAVE_INTERFACE_DOWN=1
			write_last_result blocked-roaming-policy \
				"blocked: registration changed to roaming while data roaming is disabled"
			die_code 2 "registration changed to roaming; stopping profile testing and leaving $INTERFACE down"
		fi
		if test_connectivity "$effective_ip_type"; then
			save_cache "$apn" "$provider" "$username" "$password" "$effective_auth" "$effective_ip_type" || \
				log warning "APN worked, but cache could not be written"
			save_active_state "$apn" "$username" "$password" "$effective_auth" "$effective_ip_type" || \
				log warning "APN worked, but reconciled SIM state could not be written"
			write_last_result success "success: $display_apn ($provider)"
			ROLLBACK_ARMED=0
			log notice "APN '$display_apn' is working; configuration kept"
			return 0
		fi
		log warning "real Internet check failed for APN '$display_apn'"
	done <"${CANDIDATES}.apply"

	if [ "$saw_bearer_up" -eq 1 ]; then
		write_last_result connectivity-failed \
			"failed: a mobile session came up, but real Internet checks failed for every profile"
	else
		write_last_result bearer-rejected \
			"failed: no tested mobile profile produced a usable data session"
	fi
	die "$exhausted_message"
}

apply_cmd() {
	read_sim
	acquire_lock
	migrate_target_state
	registration_preflight || return $?
	find_candidates
	build_apply_candidates
	[ -s "${CANDIDATES}.apply" ] || die "no APN candidates for this SIM; extend the TSV database or apply a manual profile"
	apply_candidate_list \
		"starting APN detection for ICCID $(mask_identifier "$ICCID") on $INTERFACE" \
		"all mobile profiles failed; previous profile will be restored"
}

# Applies an operator profile the user supplied instead of one the database
# matched. It is deliberately not a shortcut around the engine: the profile
# becomes a single candidate and goes through the same baseline capture,
# connectivity verification and exact rollback as a database candidate. LuCI
# and apn-autoconfig-modem must use this rather than writing profile fields.
apply_manual_cmd() {
	# Validate before touching anything. add_candidate silently skips malformed
	# database rows, which is right for a 4000-line TSV and wrong for a person
	# typing one profile: they get a specific reason instead.
	case "$MANUAL_APN" in
		'') die_code 2 "apply-manual requires --apn" ;;
		*[!A-Za-z0-9._-]*) die_code 2 "the APN may only contain letters, digits, dot, underscore and hyphen" ;;
	esac
	[ "${#MANUAL_APN}" -le 63 ] || die_code 2 "the APN is longer than 63 characters"
	state_value_is_safe "$MANUAL_USERNAME" || die_code 2 "the username contains characters this engine cannot store safely"
	state_value_is_safe "$MANUAL_PASSWORD" || die_code 2 "the password contains characters this engine cannot store safely"
	case "$MANUAL_AUTH" in
		-|none|pap|chap|pap-or-chap) : ;;
		*) die_code 2 "auth must be none, pap, chap or pap-or-chap" ;;
	esac
	case "$MANUAL_IP_TYPE" in
		-|ipv4|ipv6|ipv4v6) : ;;
		*) die_code 2 "ip-type must be ipv4, ipv6 or ipv4v6" ;;
	esac
	# A username without a password, or the reverse, is almost always a mistake
	# that would fail as an opaque bearer rejection much later.
	if [ "$MANUAL_USERNAME" = - ] && [ "$MANUAL_PASSWORD" != - ]; then
		die_code 2 "a password was given without a username"
	fi
	if [ "$MANUAL_USERNAME" != - ] && [ "$MANUAL_PASSWORD" = - ]; then
		die_code 2 "a username was given without a password"
	fi

	read_sim
	acquire_lock
	migrate_target_state
	registration_preflight || return $?

	: >"$SEEN_APNS"
	: >"${CANDIDATES}.apply"
	add_candidate "$MANUAL_APN" manual \
		"$MANUAL_USERNAME" "$MANUAL_PASSWORD" "$MANUAL_AUTH" "$MANUAL_IP_TYPE"
	[ -s "${CANDIDATES}.apply" ] || die_code 2 "the manual profile was rejected before it could be tried"

	apply_candidate_list \
		"applying a manual profile for ICCID $(mask_identifier "$ICCID") on $INTERFACE" \
		"the manual profile failed; previous profile will be restored"
}

reconcile_cmd() {
	read_sim
	acquire_lock
	migrate_target_state
	registration_preflight || return $?
	previous_iccid="$(active_iccid 2>/dev/null || :)"
	previous_apn="$(active_apn 2>/dev/null || :)"
	configured_apn="$(current_apn 2>/dev/null || :)"
	[ "$previous_apn" = "<empty>" ] && previous_apn=""

	if [ -n "$previous_iccid" ] && \
	   [ "$previous_iccid" = "$ICCID" ] && \
	   configured_profile_matches_active && \
	   interface_is_up && \
	   test_connectivity "$(configured_connectivity_ip_type)"; then
		write_last_result success "success: ${configured_apn:-<empty>} (reconciled connectivity verified)"
		log notice "SIM $(mask_identifier "$ICCID") is already reconciled with APN '${configured_apn:-<empty>}'; no changes"
		return 0
	fi

	if [ -n "$previous_iccid" ] && [ "$previous_iccid" != "$ICCID" ]; then
		log notice "SIM change detected: $(mask_identifier "$previous_iccid") -> $(mask_identifier "$ICCID")"
	elif [ -z "$previous_iccid" ]; then
		log notice "no reconciled SIM state found; applying APN for ICCID $(mask_identifier "$ICCID")"
	elif ! configured_profile_matches_active; then
		log notice "configured mobile profile differs from the reconciled profile for ICCID $(mask_identifier "$ICCID")"
	else
		log notice "reconciled WWAN connectivity is unavailable; retrying APN for ICCID $(mask_identifier "$ICCID")"
	fi

	apply_cmd
}

roaming_policy_set_cmd() {
	requested="${1:-}"
	case "$requested" in default|allow|block) : ;; *) die "roaming policy must be default, allow or block" ;; esac
	[ "$TARGET_ROAMING_POLICY_WRITE" = true ] || \
		die_code 4 "roaming policy control is not implemented for backend $TARGET_BACKEND"
	acquire_lock
	migrate_target_state
	was_up=0
	interface_is_up && was_up=1
	was_roaming=unknown
	sim_available=0
	SIM_INDEX=""
	MODEM_INDEX=""
	case "$TARGET_BACKEND" in
		modemmanager)
			if resolve_sim_index && run_bounded_to_file "$MMCLI_TIMEOUT_SECONDS" "$SIM_DATA" \
				mmcli -i "$SIM_INDEX" --output-keyvalue; then
				sim_available=1
				refresh_modem_status || :
				was_roaming="$ROAMING_STATUS"
			fi
		;;
		*)
			if refresh_modem_status; then
				sim_available=1
				was_roaming="$ROAMING_STATUS"
			fi
		;;
	esac

	case "$TARGET_BACKEND:$requested" in
		mbim:default)
			uci -q delete "network.${INTERFACE}.allow_roaming" >/dev/null 2>&1 || :
			uci -q delete "network.${INTERFACE}.allow_partner" >/dev/null 2>&1 || :
		;;
		# mbim.sh gates a preferred-partner registration with its own option, so
		# allowing roaming without it would still refuse a partner network.
		mbim:allow)
			uci set "network.${INTERFACE}.allow_roaming=1" >/dev/null 2>&1 || die "cannot allow data roaming"
			uci set "network.${INTERFACE}.allow_partner=1" >/dev/null 2>&1 || die "cannot allow partner networks"
		;;
		mbim:block)
			uci set "network.${INTERFACE}.allow_roaming=0" >/dev/null 2>&1 || die "cannot block data roaming"
			uci set "network.${INTERFACE}.allow_partner=0" >/dev/null 2>&1 || die "cannot block partner networks"
		;;
		*:default) uci -q delete "network.${INTERFACE}.allow_roaming" >/dev/null 2>&1 || : ;;
		*:allow) uci set "network.${INTERFACE}.allow_roaming=1" >/dev/null 2>&1 || die "cannot allow data roaming" ;;
		*:block) uci set "network.${INTERFACE}.allow_roaming=0" >/dev/null 2>&1 || die "cannot block data roaming" ;;
	esac
	uci commit network >/dev/null 2>&1 || die "cannot commit roaming policy"
	read_roaming_policy
	log notice "roaming policy for $INTERFACE changed to $ROAMING_POLICY"

	if [ "$requested" = block ] && [ "$was_roaming" = true ]; then
		ifdown "$INTERFACE" >/dev/null 2>&1 || :
		log notice "mobile interface $INTERFACE stopped because the modem is registered in roaming"
		return 0
	fi
	if [ "$requested" = block ] && [ "$was_roaming" = unknown ] && [ "$was_up" -eq 1 ]; then
		ifdown "$INTERFACE" >/dev/null 2>&1 || :
		log warning "mobile interface $INTERFACE stopped because roaming state could not be verified while applying the block"
		return 0
	fi

	if [ "$requested" != block ] && [ "$was_up" -eq 0 ] && [ "$sim_available" -eq 1 ]; then
		ifup "$INTERFACE" >/dev/null 2>&1 || die "roaming policy was saved, but interface $INTERFACE did not start"
		wait_for_interface || :
		reconcile_cmd
		return $?
	fi
	return 0
}

write_modem_power() {
	value="$1"
	printf '%s\n' "$value" >"$MODEM_POWER_PATH" 2>/dev/null
}

wait_for_modem() {
	remaining="$MODEM_WAIT_SECONDS"
	while [ "$remaining" -gt 0 ]; do
		case "$TARGET_BACKEND" in
			modemmanager)
				SIM_INDEX=""
				if resolve_sim_index && \
				   run_bounded_to_file "$MMCLI_TIMEOUT_SECONDS" "$SIM_DATA" \
					mmcli -i "$SIM_INDEX" --output-keyvalue; then
					ready_iccid="$(kv_value 'sim.properties.iccid sim.properties.sim-identifier sim.properties.identifier')"
					case "$ready_iccid" in ''|*[!0-9]*) : ;; *) return 0 ;; esac
				fi
			;;
			qmi)
				if qmi_resolve_control_device && \
				   "$QMI_ADAPTER" identity "$NETWORK_DEVICE" >"$SIM_DATA" 2>/dev/null; then
					ready_iccid="$(qmi_identity_value iccid)"
					case "$ready_iccid" in ''|*[!0-9]*) : ;; *) return 0 ;; esac
				fi
			;;
		esac
		sleep "$MODEM_POLL_SECONDS"
		remaining=$((remaining - MODEM_POLL_SECONDS))
	done
	return 1
}

modem_reset_inline_cmd() {
	[ -w "$MODEM_POWER_PATH" ] || die "modem power GPIO is not writable: $MODEM_POWER_PATH"
	acquire_lock
	migrate_target_state
	log notice "hardware modem reset requested; stopping interface $INTERFACE"
	INTERFACE_RESTORE_ARMED=1
	ifdown "$INTERFACE" >/dev/null 2>&1 || :

	log notice "switching modem power off for ${MODEM_POWER_OFF_SECONDS}s"
	MODEM_POWER_OFF_ARMED=1
	write_modem_power "$MODEM_POWER_OFF_VALUE" || die "failed to switch modem power off"
	sleep "$MODEM_POWER_OFF_SECONDS"
	write_modem_power "$MODEM_POWER_ON_VALUE" || die "failed to switch modem power on"
	MODEM_POWER_OFF_ARMED=0

	log notice "modem power restored; waiting up to ${MODEM_WAIT_SECONDS}s for the modem backend and SIM"
	if ! wait_for_modem; then
		die "modem or SIM did not return within ${MODEM_WAIT_SECONDS}s"
	fi
	if [ "$TARGET_BACKEND" = qmi ]; then
		# wait_for_modem ends with a direct identity transaction. Let that QMI
		# client close before handing the control device back to netifd, then
		# wait for qmi.sh to own initialization before reconcile queries status.
		settle_after_ifdown
		if ifup "$INTERFACE" >/dev/null 2>&1 && wait_for_interface && wait_for_data_interface; then
			INTERFACE_RESTORE_ARMED=0
			log notice "QMI data interface $INTERFACE is ready after modem power return"
		else
			log warning "QMI data interface $INTERFACE did not become ready before APN reconciliation"
			ifdown "$INTERFACE" >/dev/null 2>&1 || :
			settle_after_ifdown
			return 3
		fi
	fi
	log notice "modem and SIM are available again; reconciling APN"
	reconcile_cmd
	status=$?
	if [ "$status" -ne 0 ]; then
		if [ "$status" -eq 2 ] || interface_is_up; then
			INTERFACE_RESTORE_ARMED=0
		fi
		return "$status"
	fi
	INTERFACE_RESTORE_ARMED=0
	log notice "hardware modem reset and APN reconciliation completed successfully"
}

# Compatibility mapping to apn-autoconfig-modem, per docs/modem-contract-v1.md:
# when the new package is installed and can unambiguously resolve the modem
# bound to this target, it owns the power-cycle and re-enumeration wait;
# apn-autoconfig keeps its own SIM/QMI-readiness wait and reconcile step
# unchanged either way. Soft coupling for 0.10.0 means no hard package
# dependency: only an absent coordinator falls back to the released inline
# path. Once installed, unresolved identity or unsafe capability fails closed.
modem_reset_coordinator_modem_id() {
	command_exists apn-autoconfig-modem || return 1
	MODEM_COORDINATOR_ID="$(apn-autoconfig-modem resolve --interface "$INTERFACE" 2>/dev/null)" || \
		die_code 4 "apn-autoconfig-modem could not resolve one safe modem for interface $INTERFACE"
	[ -n "$MODEM_COORDINATOR_ID" ] || \
		die_code 4 "apn-autoconfig-modem returned an empty modem identity for interface $INTERFACE"
	coordinator_status_json="$(apn-autoconfig-modem status-json --modem "$MODEM_COORDINATOR_ID" 2>/dev/null)" || \
		die_code 4 "apn-autoconfig-modem could not validate modem $MODEM_COORDINATOR_ID"
	coordinator_reset_capability="$(jsonfilter -s "$coordinator_status_json" -e '@.capabilities.reset' 2>/dev/null || :)"
	[ "$coordinator_reset_capability" = true ] || \
		die_code 4 "modem $MODEM_COORDINATOR_ID is not explicitly bound to the supported board reset integration"
}

modem_reset_via_coordinator_cmd() {
	acquire_lock
	migrate_target_state
	log notice "hardware modem reset requested; delegating power-cycle to apn-autoconfig-modem for $MODEM_COORDINATOR_ID"
	coordinator_status=0
	APN_AUTOCONFIG_COORDINATOR_PARENT_PID="$$" \
		apn-autoconfig-modem reset --modem "$MODEM_COORDINATOR_ID" || coordinator_status=$?
	if [ "$coordinator_status" -ne 0 ]; then
		case "$coordinator_status" in
			3) die_code 3 "modem $MODEM_COORDINATOR_ID did not become ready again in time" ;;
			*) die_code "$coordinator_status" "apn-autoconfig-modem reset failed (exit $coordinator_status)" ;;
		esac
	fi
	if [ "$TARGET_BACKEND" = modemmanager ]; then
		log notice "control owner returned; waiting up to ${MODEM_WAIT_SECONDS}s for the primary SIM"
		if ! wait_for_modem; then
			log warning "primary SIM did not become readable after modem power return"
			return 3
		fi
		if ! wait_for_interface; then
			log warning "mobile interface $INTERFACE did not become ready after modem power return"
			return 3
		fi
	elif [ "$TARGET_BACKEND" = qmi ]; then
		if wait_for_interface && wait_for_data_interface; then
			log notice "QMI data interface $INTERFACE is ready after modem power return"
		else
			log warning "QMI data interface $INTERFACE did not become ready before APN reconciliation"
			return 3
		fi
	fi
	log notice "modem and SIM are available again; reconciling APN"
	reconcile_cmd
	status=$?
	[ "$status" -eq 0 ] || return "$status"
	log notice "hardware modem reset and APN reconciliation completed successfully"
}

modem_reset_cmd() {
	if modem_reset_coordinator_modem_id; then
		modem_reset_via_coordinator_cmd
		return $?
	fi
	modem_reset_inline_cmd
}

# Runs one command once per managed target, and says whether it did.
#
# Returns 0 when it handled the command — the aggregate status is in
# AUTO_MULTI_STATUS — and 1 when the caller should carry on with a single
# target. Each child selects, locks and rolls back its own target exactly as a
# single-target run does; this parent holds no lock and owns no state, so the
# lock order is unchanged and two targets are never mutated at once.
auto_multi_dispatch() {
	AUTO_MULTI_STATUS=0
	[ -z "$REQUESTED_TARGET" ] || return 1
	[ "$CONFIGURED_INTERFACE" = auto ] || return 1
	case "$COMMAND_NAME" in
		reconcile|apply) : ;;
		*) return 1 ;;
	esac
	multi_list="$(auto_targets)"
	[ "$(auto_target_count "$multi_list")" -gt 1 ] || return 1

	multi_self="$(engine_self_path)"
	multi_succeeded=0
	multi_blocked=0
	multi_retryable=0
	multi_failed=0
	log notice "$COMMAND_NAME: running against every managed target"
	for multi_section in $multi_list; do
		multi_child=0
		# Backgrounded and waited for so an interruption of this parent can
		# terminate the target it is in the middle of. Killing the parent alone
		# would otherwise leave a child mutating a live interface with nobody
		# left to notice.
		if [ -n "${1:-}" ]; then
			sh "$multi_self" "$COMMAND_NAME" "$1" --target "network:$multi_section" &
		else
			sh "$multi_self" "$COMMAND_NAME" --target "network:$multi_section" &
		fi
		FANOUT_CHILD_PID=$!
		wait "$FANOUT_CHILD_PID" || multi_child=$?
		FANOUT_CHILD_PID=""
		case "$multi_child" in
			0)
				multi_succeeded=$((multi_succeeded + 1))
				log notice "target network:$multi_section: $COMMAND_NAME succeeded"
			;;
			2)
				multi_blocked=$((multi_blocked + 1))
				log notice "target network:$multi_section: skipped, mobile data roaming is blocked by policy"
			;;
			3)
				multi_retryable=$((multi_retryable + 1))
				log warning "target network:$multi_section: $COMMAND_NAME may be retried"
			;;
			*)
				[ "$multi_failed" -ne 0 ] || multi_failed="$multi_child"
				log err "target network:$multi_section: $COMMAND_NAME failed with exit $multi_child"
			;;
		esac
	done

	# One target must not be able to hide another. A retryable result wins so
	# that the boot worker tries again — reconcile is idempotent, so the targets
	# that already succeeded cost nothing on the next attempt — and a hard
	# failure is reported even when another target succeeded. A target the
	# roaming policy deliberately refused is also a meaningful aggregate result:
	# reporting success would hide that one attached modem remains unavailable.
	if [ "$multi_retryable" -gt 0 ]; then
		AUTO_MULTI_STATUS=3
	elif [ "$multi_failed" -ne 0 ]; then
		AUTO_MULTI_STATUS="$multi_failed"
	elif [ "$multi_blocked" -gt 0 ]; then
		AUTO_MULTI_STATUS=2
	fi
	log notice "$COMMAND_NAME: $multi_succeeded succeeded, $multi_blocked blocked, $multi_retryable retryable, $((multi_failed != 0)) failed"
	return 0
}

usage() {
	cat <<EOF
Usage: $PROG <command> [argument] [--target network:<uci-section>]

Commands:
  targets-json  Inventory cellular netifd targets and exact capabilities
  detect   Read SIM identity and list matching APN candidates; no changes
  detect-json  Machine-readable detect output for LuCI and integrations
  apply    Try candidates, verify Internet through $DEVICE, cache success
  reconcile  Apply only when SIM/APN changed or verified connectivity failed
  modem-reset  Power-cycle the modem GPIO, wait for SIM, then reconcile APN
  status   Show SIM identity, configured/cached APN and last result
  status-json  Machine-readable status output for LuCI and integrations
  action-start <reconcile|modem-reset|apply-manual|roaming-default|roaming-allow|roaming-block|database-check|database-install>
           Start one operation in background
  action-status  Show background/external operation state as JSON
  roaming-policy-set <default|allow|block>  Change OpenWrt's canonical policy
  apply-manual --apn <apn> [--username <u> --password-stdin]
           [--auth none|pap|chap|pap-or-chap] [--ip-type ipv4|ipv6|ipv4v6]
           Apply a profile you supply through the same baseline, connectivity
           verification and rollback as a database candidate
  reset    Restore the APN state saved before the first apply; clear cache
  reset-all  Restore every target baseline; intended for safe package removal
  forget-target  Drop this engine's state for --target, whose section must
             already be gone; leaves the shared cache and other targets alone
  desired-bearer-state  Print auto|up|down for --target. Read-only
  desired-bearer-state-set <auto|up|down>  Record an explicit bearer intention
             for --target. Written only by a deliberate user action
  target-policy  Print what automatic convergence needs to know about --target
EOF
}

main() {
	# Before anything of ours exists under these names, and on every entry point,
	# because the interrupted run that left them may have been started from any
	# of them and LuCI is the one that never reaches a service restart.
	sweep_dead_scratch_files
	COMMAND_NAME="${1:-}"
	case "$COMMAND_NAME" in -h|--help|help|'') usage; return 0 ;; esac
	shift
	command_argument=""
	case "$COMMAND_NAME" in
		action-start|roaming-policy-set|desired-bearer-state-set)
			command_argument="${1:-}"
			[ "$#" -eq 0 ] || shift
		;;
	esac
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--target)
				[ "$#" -ge 2 ] || die_code 4 "--target requires a target ID"
				[ -z "$REQUESTED_TARGET" ] || die_code 4 "--target was specified more than once"
				REQUESTED_TARGET="$2"
				shift 2
			;;
			--apn)
				[ "$#" -ge 2 ] || die_code 2 "--apn requires a value"
				MANUAL_APN="$2"
				shift 2
			;;
			--username)
				[ "$#" -ge 2 ] || die_code 2 "--username requires a value"
				MANUAL_USERNAME="$2"
				shift 2
			;;
			--password-stdin)
				# The password is never an argument: argv is world-readable
				# through ps, and this engine must not leak credentials.
				IFS= read -r MANUAL_PASSWORD || MANUAL_PASSWORD=""
				[ -n "$MANUAL_PASSWORD" ] || die_code 2 "--password-stdin received an empty password"
				shift
			;;
			--auth)
				[ "$#" -ge 2 ] || die_code 2 "--auth requires a value"
				MANUAL_AUTH="$2"
				shift 2
			;;
			--ip-type)
				[ "$#" -ge 2 ] || die_code 2 "--ip-type requires a value"
				MANUAL_IP_TYPE="$2"
				shift 2
			;;
			*) die_code 4 "unexpected argument: $1" ;;
		esac
	done
	case "$COMMAND_NAME" in
		apply-manual) : ;;
		*)
			[ -z "$MANUAL_APN" ] && [ "$MANUAL_USERNAME" = - ] && \
				[ "$MANUAL_PASSWORD" = - ] && [ "$MANUAL_AUTH" = - ] && \
				[ "$MANUAL_IP_TYPE" = - ] || \
				die_code 4 "manual profile options are only valid for apply-manual"
		;;
	esac
	load_config
	if [ "$COMMAND_NAME" = targets-json ]; then
		[ -z "$REQUESTED_TARGET" ] || die_code 4 "targets-json does not accept --target"
		targets_json_cmd
		return 0
	fi
	if [ "$COMMAND_NAME" = action-status ]; then
		[ -z "$REQUESTED_TARGET" ] || die_code 4 "action-status does not accept --target"
		INTERFACE="wwan"
		validate_config
		action_status_cmd
		return 0
	fi
	if [ "$COMMAND_NAME" = reset-all ]; then
		INTERFACE="wwan"
		validate_config
		reset_all_cmd
		return $?
	fi
	if [ "$COMMAND_NAME" = forget-target ]; then
		# Deliberately before select_target: the whole point is a target whose
		# section no longer exists, which target selection cannot resolve.
		INTERFACE="wwan"
		validate_config
		forget_target_cmd
		return $?
	fi
	if [ "$COMMAND_NAME" = action-start ]; then
		case "$command_argument" in
			database-check|database-install)
				[ -z "$REQUESTED_TARGET" ] || die_code 4 "database actions do not accept --target"
				INTERFACE="wwan"
				validate_config
				action_start_cmd "$command_argument"
				return 0
			;;
		esac
	fi
	# Both of the 0.15.3 target-policy commands act on exactly one target: an
	# intention recorded for "every managed target" would be an intention
	# nobody expressed, and the convergence worker asks about one target at a
	# time by name.
	case "$COMMAND_NAME" in
		desired-bearer-state|desired-bearer-state-set|target-policy)
			[ -n "$REQUESTED_TARGET" ] || [ "$CONFIGURED_INTERFACE" != auto ] || \
				[ "$(auto_target_count "$(auto_targets)")" -le 1 ] || \
				die_code 4 "$COMMAND_NAME acts on one target; several are managed, so name one with --target"
		;;
	esac
	# Automatic mode covers every managed target, so a command that can act on
	# all of them does, before one is selected.
	if auto_multi_dispatch "$command_argument"; then
		return "$AUTO_MULTI_STATUS"
	fi
	select_target
	case "$COMMAND_NAME:$command_argument" in
		modem-reset:*|action-start:modem-reset) require_hardware_integration ;;
	esac
	# An operation that covers every managed target records "auto" rather than
	# the one target it happened to select for its capability check. Without
	# this, the button and LuCI's own "reconcile now" would each have gone to a
	# single target while the same command from the CLI covered all of them.
	case "$COMMAND_NAME:$command_argument" in
		action-start:reconcile)
			[ -n "$REQUESTED_TARGET" ] || [ "$CONFIGURED_INTERFACE" != auto ] || \
				[ "${AUTO_TARGET_COUNT:-1}" -le 1 ] || TARGET_ID="auto"
		;;
	esac
	case "$COMMAND_NAME" in
		detect|detect-json|status|status-json) require_target_capability identity ;;
		# Deliberately ungated. A target whose backend cannot apply a profile
		# today can still be one the administrator connected or disconnected,
		# and refusing to record or report that would lose the intention rather
		# than protect anything.
		desired-bearer-state|desired-bearer-state-set|target-policy) : ;;
		apply|reconcile|modem-reset|apply-manual) require_target_capability profile-apply ;;
		# Not profile-write: the roaming policy is a netifd option the handler
		# reads, not a field in the modem's own profile. Gating it on
		# profile-write refused every backend that owns no profile fields —
		# atdial among them — although its capability record advertises
		# roaming_policy_write, and both LuCI's roaming controls and the CLI
		# failed on such a target with a message about the wrong capability.
		roaming-policy-set) require_target_capability roaming-policy-write ;;
		action-start)
			case "$command_argument" in
				reconcile|modem-reset|apply-manual) require_target_capability profile-apply ;;
				roaming-default|roaming-allow|roaming-block) require_target_capability roaming-policy-write ;;
			esac
		;;
	esac
	validate_config
	case "$COMMAND_NAME" in
		detect) detect_cmd ;;
		detect-json) detect_json_cmd ;;
		apply) apply_cmd ;;
		apply-manual) apply_manual_cmd ;;
		reconcile) reconcile_cmd ;;
		modem-reset) modem_reset_cmd ;;
		status) status_cmd ;;
		status-json) status_json_cmd ;;
		action-start) action_start_cmd "$command_argument" ;;
		action-status) action_status_cmd ;;
		roaming-policy-set) roaming_policy_set_cmd "$command_argument" ;;
		desired-bearer-state) desired_bearer_state_cmd ;;
		desired-bearer-state-set) desired_bearer_state_set_cmd "$command_argument" ;;
		target-policy) target_policy_cmd ;;
		reset) reset_cmd ;;
		reset-all) reset_all_cmd ;;
		*) usage >&2; exit 2 ;;
	esac
}

main "$@"
