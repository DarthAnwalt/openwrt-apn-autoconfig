#!/bin/sh

# Narrow mutating entry point for rpcd/LuCI ACLs.

COMMAND="${APN_AUTOCONFIG_BIN:-/usr/sbin/apn-autoconfig}"

# How the manual profile gets here.
#
# It used to arrive in the request environment, and rpcd refuses `file exec`
# outright when a session-scoped caller passes one -- so that channel never
# worked from a browser, on any OpenWrt carrying the check. The profile now
# arrives as a ubus call parameter and reaches this wrapper on its standard
# input; a wrapper is an ordinary shell and may set the environment of the
# engine it executes, so the engine is unchanged and still the single place that
# decides what a profile may contain.
#
# The keys are an allowlist. Anything else is a refusal rather than a
# pass-through.
read_secrets_from_stdin() {
	secrets_allowed=" $1 "
	while IFS= read -r secrets_line; do
		[ -n "$secrets_line" ] || continue
		secrets_key="${secrets_line%%=*}"
		secrets_value="${secrets_line#*=}"
		case "$secrets_key" in
			''|*[!A-Z_]*) return 2 ;;
		esac
		case "$secrets_allowed" in
			*" $secrets_key "*) : ;;
			*) return 2 ;;
		esac
		export "$secrets_key=$secrets_value"
	done
	return 0
}

TARGET="${2:-}"
SECRETS_STDIN=0
case "${3:-}" in
	'') : ;;
	--secrets-stdin) SECRETS_STDIN=1 ;;
	*) exit 2 ;;
esac
[ "$#" -le 3 ] || exit 2

case "${1:-}" in
	apply-manual)
		# The profile itself travels in the environment and is validated by the
		# engine, which is the single place that decides what a profile may
		# contain. This wrapper only proves the target is safe and refuses a
		# password given as an argument, which would be world-readable.
		[ -n "$TARGET" ] || exit 2
		case "$TARGET" in network:*) target_interface="${TARGET#network:}" ;; *) exit 2 ;; esac
		case "$target_interface" in ''|*[!A-Za-z0-9_]*) exit 2 ;; esac
		if [ "$SECRETS_STDIN" -eq 1 ]; then
			read_secrets_from_stdin \
				"APN_AUTOCONFIG_MANUAL_APN APN_AUTOCONFIG_MANUAL_USERNAME APN_AUTOCONFIG_MANUAL_PASSWORD APN_AUTOCONFIG_MANUAL_AUTH APN_AUTOCONFIG_MANUAL_IP_TYPE" || exit 2
		fi
		[ -n "${APN_AUTOCONFIG_MANUAL_APN:-}" ] || exit 2
		exec "$COMMAND" action-start apply-manual --target "$TARGET"
	;;
	reconcile|modem-reset|roaming-default|roaming-allow|roaming-block|database-check|database-install)
		[ "$SECRETS_STDIN" -eq 0 ] || exit 2
		case "$1:$TARGET" in database-*:?*) exit 2 ;; esac
		if [ -n "$TARGET" ]; then
			case "$TARGET" in network:*) target_interface="${TARGET#network:}" ;; *) exit 2 ;; esac
			case "$target_interface" in ''|*[!A-Za-z0-9_]*) exit 2 ;; esac
			exec "$COMMAND" action-start "$1" --target "$TARGET"
		fi
		exec "$COMMAND" action-start "$1"
	;;
	*) exit 2 ;;
esac
