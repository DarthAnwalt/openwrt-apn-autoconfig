#!/bin/sh /etc/rc.common

START=90
STOP=15
USE_PROCD=1

MODEM_BIN=/usr/sbin/apn-autoconfig-modem
INHIBIT_WORKER=/usr/libexec/apn-autoconfig-modem-inhibit

# One supervised ModemManager inhibition per modem this package has provisioned
# onto the AT-dial protocol.
#
# These are declared here rather than started by the provisioning command so
# that the set of held inhibitions is derived from configuration on every start
# and reload. A holder that dies is restarted by procd; a section that is
# removed stops being declared and its inhibition is released. Provisioning and
# deprovisioning ask for a reload, and procd reconciles the difference.
start_inhibitors() {
	[ -x "$INHIBIT_WORKER" ] || return 0
	[ -x "$MODEM_BIN" ] || return 0
	# Read from a file rather than a pipe. procd builds each instance in shell
	# variables, and a `cmd | while` loop runs its body in a subshell, so every
	# instance would be assembled and then discarded — the service would start
	# with no inhibitions and no error anywhere.
	targets=/var/run/apn-autoconfig-modem.inhibit-targets
	"$MODEM_BIN" inhibit-targets >"$targets" 2>/dev/null || {
		rm -f "$targets"
		return 0
	}
	while IFS="$(printf '\t')" read -r uid modem_id; do
		[ -n "$uid" ] || continue
		instance="inhibit-$(printf '%s' "$modem_id" | tr -c 'A-Za-z0-9_.-' '_')"
		procd_open_instance "$instance"
		procd_set_param command "$INHIBIT_WORKER" "$uid" "$modem_id"
		# A holder that exits releases the modem back to ModemManager, which is
		# the safe direction, but the inhibition is meant to stand for as long
		# as the provisioning does — so procd brings it back.
		procd_set_param respawn 30 5 0
		procd_set_param term_timeout 10
		procd_close_instance
	done <"$targets"
	rm -f "$targets"
}

start_service() {
	enabled="$(uci -q get apn-autoconfig-modem.main.autostart)"
	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/apn-autoconfig-modem-boot
	procd_set_param term_timeout 20
	procd_close_instance

	start_inhibitors
}

service_triggers() {
	procd_add_reload_trigger apn-autoconfig-modem
}
