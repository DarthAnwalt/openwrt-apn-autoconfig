#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	enabled="$(uci -q get apn-autoconfig.main.autostart)"
	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/apn-autoconfig-boot
	# A bounded backend request can take 15 seconds before the shell handles
	# TERM, and QMI rollback then needs a six-second quiet period before ifup.
	procd_set_param term_timeout 30
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger apn-autoconfig
}
