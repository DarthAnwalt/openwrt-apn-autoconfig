config apn_autoconfig_modem 'main'
	option autostart '0'
	option boot_delay '10'
	option sysfs_root '/sys'
	option state_dir '/var/run/apn-autoconfig-modem'
	option lock_root '/var/lock/apn-autoconfig-modem'
	option action_state_dir '/tmp/apn-autoconfig-modem-action'
	option hotplug_coalesce_seconds '3'
	option modem_power_path '/sys/class/gpio/modem_power/value'
	option modem_power_off_value '1'
	option modem_power_on_value '0'
	option modem_power_off_seconds '5'
	option modem_wait_seconds '90'
	option modem_poll_seconds '2'
	option hardware_integration_file '/usr/share/apn-autoconfig/integrations/huasifei-wh3000'
