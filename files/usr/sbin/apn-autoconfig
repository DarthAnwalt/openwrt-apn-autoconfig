TARGET_PROFILE_APPLY=false
TARGET_REASON=""
TARGET_IMPLEMENTATION_STATE="unimplemented"
TARGET_VALIDATION_STATE="none"
TARGET_HARDWARE_VALIDATED=false
COMMAND_NAME=""
SIM_INDEX_FALLBACK="0"
SIM_INDEX=""
