MODEM_WAIT_SECONDS="90"
MODEM_POLL_SECONDS="2"
MMCLI_TIMEOUT_SECONDS="${APN_AUTOCONFIG_MMCLI_TIMEOUT_SECONDS:-8}"
# The total a LuCI-facing read may spend, and the caller's budget it exists to
# stay inside. Every bounded call on that path is individually correct and
# nothing bounds their sum, which is the number rpcd measures before it sends a
# SIGKILL no trap can cover. See docs/convergence-contract-v1.md, "The read path
# and rpcd's budget".
READ_DEADLINE_SECONDS="${APN_AUTOCONFIG_READ_DEADLINE_SECONDS:-20}"
RPCD_EXEC_BUDGET_SECONDS="${APN_AUTOCONFIG_RPCD_EXEC_BUDGET_SECONDS:-30}"
SYSFS_ROOT="${APN_AUTOCONFIG_SYSFS_ROOT:-/sys}"
QMI_ADAPTER="${APN_AUTOCONFIG_QMI_ADAPTER:-/usr/libexec/apn-autoconfig-qmi}"
MBIM_ADAPTER="${APN_AUTOCONFIG_MBIM_ADAPTER:-/usr/libexec/apn-autoconfig-mbim}"
TIMEOUT="${APN_AUTOCONFIG_TIMEOUT:-timeout}"
# The same indirection both native adapters already use. It exists for the
# watchdog in run_bounded_to_file: the fixtures replace `sleep` with a no-op to
# keep the suite fast, and a watchdog that inherits that no-op fires at once —
# so the bound it is supposed to prove is never actually waited out, and the
# assertion that it holds passes without testing anything.
SLEEP="${APN_AUTOCONFIG_SLEEP:-sleep}"
HARDWARE_INTEGRATION_FILE="${APN_AUTOCONFIG_HARDWARE_INTEGRATION:-/usr/share/apn-autoconfig/integrations/huasifei-wh3000}"

LOCK_DIR="/var/lock/apn-autoconfig.lock"
ACTION_STATE_DIR="/tmp/apn-autoconfig-action"
ACTION_WORKER="${APN_AUTOCONFIG_ACTION_WORKER:-/usr/libexec/apn-autoconfig-action}"
TMP_DIR="${APN_AUTOCONFIG_TMP_DIR:-/tmp}"
TMP_BASE="$TMP_DIR/$PROG.$$"
SIM_DATA="${TMP_BASE}.sim"
# Output of a read-path call that is captured rather than streamed. The bound
# needs somewhere to redirect, and a command substitution has nowhere.
READ_DATA="${TMP_BASE}.read"
MODEM_DATA="${TMP_BASE}.modem"
MODEM_LIST="${TMP_BASE}.modems"
CANDIDATES="${TMP_BASE}.candidates"
SEEN_APNS="${TMP_BASE}.seen"
TARGETS_DATA="${TMP_BASE}.targets"
# The attachment record read back from apn-autoconfig-modem, parsed with the
# same helper as every other v1 identity document.
SCOPE_DATA="${TMP_BASE}.scope"
# Every scratch suffix this process can create, in one list, because two
# separate things have to agree on it: the exit trap removes them by exact name,
# and sweep_dead_scratch_files identifies a dead predecessor's files by the same
# names. A suffix added to only one of the two would leak again.
TMP_SUFFIXES="sim modem modems candidates candidates.apply candidates.attempts seen targets scope read"

ROLLBACK_ARMED=0
OLD_APN_SET=0
OLD_APN=""
OLD_USERNAME_SET=0
OLD_USERNAME=""
OLD_PASSWORD_SET=0
