#!/bin/sh

# Narrow read-only entry point for rpcd/LuCI ACLs.

COMMAND="${APN_AUTOCONFIG_MODEM_BIN:-/usr/sbin/apn-autoconfig-modem}"
MODEM_ID="${2:-}"
[ "$#" -le 2 ] || exit 2

if [ -n "$MODEM_ID" ]; then
	case "$MODEM_ID" in *[!A-Za-z0-9_.:-]*) exit 2 ;; esac
fi

case "${1:-}" in
	inventory) [ -z "$MODEM_ID" ] || exit 2; exec "$COMMAND" inventory-json ;;
	status) [ -n "$MODEM_ID" ] || exit 2; exec "$COMMAND" status-json --modem "$MODEM_ID" ;;
	provision-plan) [ -n "$MODEM_ID" ] || exit 2; exec "$COMMAND" provision-plan --modem "$MODEM_ID" ;;
	action-status) [ -n "$MODEM_ID" ] || exit 2; exec "$COMMAND" action-status --modem "$MODEM_ID" ;;
	*) exit 2 ;;
esac
